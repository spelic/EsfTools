:func      name      = EN00S12           
           date      = '01/27/2011' time = '08:57:01' option = EXECUTE  
           desc      = 'prenos v R07 izdaje'
           refine    = N  
:before.
IF EN00M01.POLJE4 EQ 'S';
  MOVE EN00W03.IDENT[STEVEC] TO EN00R07.IDENT;
  MOVE EN00M01.SIFPREJE TO EN00R07.MZ;
  MOVE EN00M01.FIRMA TO EN00R07.FIRMA;
  EN00W02.SKVRED2 = EN00R07.SKCENA * EN00R07.PROSTKOL;
                                 /* stara vred.delni st
  EN00R07.ODVSTR = EN00R07.ODVSTR + ODVSTR2;
  EN00R07.SKCENA = EN00R07.SKCENA + ODVSTR2;
  EN00R07.SKVRED = EN00R07.SKCENA * EN00R07.KOLICINA;
  ;
  ; /* === novo polje zaradi delnega storna
  ;
  MOVE EN00W02.SKVRED2 TO EN00W02.SKVREDSI; /* delni storno
  EN00W02.SKVRED1 = EN00R07.SKCENA * EN00R07.PROSTKOL; /* nova vred.delni st
  ;
  ; /* === suma odv.stroškov izdaje ene pozicije
  ;
  IF ODVSTR2 < 0;                /* negativni odv.str.
    EN00W02.IZDVRED = EN00W02.SKVREDSI - EN00W02.SKVRED1;
  ELSE;                          /* pozitivni odv.str.
    EN00W02.IZDVRED = EN00W02.SKVRED1 - EN00W02.SKVREDSI;
  END;
  EN00W02.IZDVRED1 = EN00W02.IZDVRED1 + EN00W02.IZDVRED;
ELSE;                            /* posamezna pozicija
  MOVE EN00M02.FIRMA TO EN00R07.FIRMA;
  MOVE EN00M02.IDENT TO EN00R07.IDENT;
  MOVE EN00M02.SIFPREJE TO EN00R07.MZ;
  EN00W02.SKVRED2 = EN00R07.SKCENA * EN00R07.PROSTKOL;
                                 /* stara vred.delni st
  MOVE EN00W02.SKVRED2 TO EN00W02.SKVREDSI; /* delni storno
  EN00R07.ODVSTR = EN00R07.ODVSTR + ODVSTR2;
  EN00R07.SKCENA = EN00R07.SKCENA + ODVSTR2;
  EN00R07.SKVRED = EN00R07.SKCENA * EN00R07.KOLICINA;
  EN00W02.SKVRED1 = EN00R07.SKCENA * EN00R07.PROSTKOL;
                                 /* delni stor.nova vre
  ;
  ; /* === suma odv.stroškov izdaje ene pozicije
  ;
  IF ODVSTR2 < 0;                /* negativni odv.str.
    EN00W02.IZDVRED = EN00W02.SKVREDSI - EN00W02.SKVRED1;
  ELSE;                          /* pozitivni odv.str.
    EN00W02.IZDVRED = EN00W02.SKVRED1 - EN00W02.SKVREDSI;
  END;
  EN00W02.IZDVRED1 = EN00W02.IZDVRED1 + EN00W02.IZDVRED;
END;
MOVE EN00W01.ZAPRIIM TO EN00R07.MATKNJ;
TI00P99();                       /* timestamp
/***************************************************************/
/*  dodano 27.01.2011
/***************************************************************/

IF EN00R07.DATDOK  <  EN00W02.DATDOK OR
EN00R07.DATDOK  =  EN00W02.DATDOK ;
MOVE EN00W02.DATDOK TO EN00R07.DATNSTR;
IF ZAPIS = 'DA' ;  èe je knjiženje za nazaj zapiše še v zalnamis
ELSE;


END;

ELSE;
MOVE EN00R07.DATDOK TO EN00R07.DATNSTR;
END;

