:func      name      = EN00P14           
           date      = '11/03/2008' time = '07:11:14' option = CONVERSE 
           object    = EN00M02           
           desc      = 'prikaz mape detalj'
           refine    = N  
:before.
MOVE EN00W01.ZAPRIIM TO EN00M02.MATKNJ;
MOVE EN00W01.FIRMA TO EN00M02.FIRMA;
MOVE EN00W01.BESEDA1 TO EN00M02.BESEDA11;
:ebefore.
:after.
TEST EZEAID PF3 EZERTN;
TEST EZEAID PA2 EZERTN;
IF EZEAID IS ENTER;
  EN00S10();                     /* kontrola obveznega vpisa
ELSE;
  IF EZEAID IS PF4;
    MOVE 'F4' TO FLTIPKA4;
    EN00S19();                   /* vpis novega namena
  ELSE;                          /* tipka ni f4
    IF EZEAID IS PF5;            /* zapis spremembe namena
      EN00S29();                 /* ažuriranje spremembe namena
    ELSE;
      IF EZEAID IS PF2;          /* zapis odv.stroškov
        IF EN00W02.FLTIPK2 EQ ' '; /* prvi zapis z F2
          MOVE 'TIPKA2' TO EN00W02.FLTIPK2;
        ELSE;                    /* izvršen je neuspešni zapis
          EN00S07();             /* inic.pom.polj za sumiranje z 0
        END;
        IF FLTIPKA2 EQ ' ';      /* zapis podatkov se še ni izvršil
          EN00S10();             /* kontrola obvezenga vpisa
          IF FLNAPAK1 EQ ' ';    /* vsa polja so vpisana
            EN00S04();           /* izraèun odvisnih stroškov in prenos
            IF FLCITAN EQ ' ';   /* Št.dokumenta ni znana
              MOVE EN00M01.SIFPREJE TO EN00R02.MZ;
              MOVE EN00M01.FIRMA TO EN00R02.FIRMA;
              EN00P06();         /* update parametr
              IF EN00R02 NOT ERR;
                EN00R02.STDOK = EN00R02.STDOK + 1;
                EN00R02.STDOKN = EN00R02.STDOKN + 1;
                MOVE EN00R02.STDOK TO EN00W02.STDOK;
                MOVE EN00R02.STDOKN TO EN00W02.STDOKN;
                MOVE 00 TO EN00W02.POZDOK;
                EN00P12();       /* replace parametr
                IF EN00R02 NOT ERR;
                  MOVE 0 TO EN00W02.TEKSTEV;
                  EZEREPLY = 1;
                  EZECOMIT();
                ELSE;            /* repl parametr
                  MOVE "Neuspešno ažuriranje številke dokumenta (PARAMET)" MSG64;
                  MOVE 'NAPAKA' TO FLNAPAK1;
                  EZEREPLY = 1;
                  EZEROLLB();
                END;             /* repl parametr ni
              ELSE;
                MOVE "Napaka pri èitanju za ažuriranje (PARAMETR)" MSG64;
                MOVE 'NAPAKA' TO FLNAPAK1;
                EZEREPLY = 1;
                EZEROLLB();
              END;
            ELSE;                /* stdok je že znana in je v w02
            END;
            IF FLNAPAK1 EQ ' ';  /* tab.parametr. je uspešno ažurirana
              MOVE EN00M02.IDENT TO EN00R05.IDENT;
              MOVE EN00M02.SIFPREJE TO EN00R05.MZ;
              MOVE EN00M02.FIRMA TO EN00R05.FIRMA;
              EN00P10();         /* update skladisc
              IF EN00R05 NOT ERR;
                EN00R05.TEKSTEV = EN00R05.TEKSTEV + 1;
                MOVE EN00R05.TEKSTEV TO EN00W02.TEKSTEV;
                EN00S05();       /* prenos odv.str 122
                EN00P07();       /* add 122 - odvstr
                IF EN00R04 NOT ERR;
                  MOVE EN00M02.IDENT TO EN00R12.IDENT;
                  MOVE EN00M02.FIRMA TO EN00R12.FIRMA;
                  MOVE EN00M02.SIFPREJE TO EN00R12.MZ;
                  MOVE EN00M02.STDOK1 TO EN00R12.STDOK;
                  MOVE EN00M02.POZDOK1 TO EN00R12.POZDOK;
                  EN00P08();     /* update prevzem
                  IF EN00R12 NOT ERR;
                    IF EN00R12.DATURA EQ EN00W03.DATURA[STEVEC2];
                      EN00S06(); /* prenos v recd r12
                      EN00P09(); /* replace prevzem
                      IF EN00R12 NOT ERR;

/* **************************************************************/
/* doda za impolsko predelavo
/* **************************************************************/
                        IF EN00M01.FIRMA = '01' AND EN00R12.MZ = '10020' AND EN00R12.NAMEN = '2'; /* vkljuèila 8.7.2008

                          SET EN00R31 EMPTY;
                          SET EN00R24 EMPTY;
                          SET EN00R90 EMPTY;
                          SET EN00R892 EMPTY;
                          SET EN00R155 EMPTY;
                          MOVE 'DA' TO FLOK3;
                          EN00P38();
                          IF FLOK3 = 'DA';
                          ELSE;

                            EZEREPLY = 1;
                            EZEROLLB();
                          END;
                        ELSE;
                        END;
/* **************************************************************/
/* konec za predelavo namen 2
/* **************************************************************/

/* **************************************************************/
/* doda za impolsko predelavo
/* **************************************************************/
                        IF EN00M01.FIRMA = '01' AND EN00R12.MZ = '10020' AND EN00R12.NAMEN NE '2';
                          IF EN00M01.FIRMA = '01' AND EN00R12.MZ = '10020' AND EN00R12.NAMEN NE '3';

                            SET EN00R31 EMPTY;
                            SET EN00R24 EMPTY;
                            MOVE 'DA' TO FLOK3;
                            EN00F54();
                            IF FLOK3 = 'DA';
                            ELSE;

                              EZEREPLY = 1;
                              EZEROLLB();
                            END;
                          ELSE;
                          END;
                        ELSE;
                        END;
/* **************************************************************/
/* konec za predelavo
/* **************************************************************/


                      ELSE;      /* replace prevzem
                        MOVE 'NAPAKA' TO FLNAPAK1;
                        MOVE "Ažuriranje je neuspešno (PREVZEM)" MSG64;
                        EZEREPLY = 1;
                        EZEROLLB();
                      END;
                    ELSE;        /* slog prevzema je spremenjen
                      MOVE 'NAPAKA' TO FLNAPAK1;
                      MOVE "Slog pozicije prevzema je spremenjen (PREVZEM)" MSG64;
                      EZEREPLY = 1;
                      EZEROLLB();
                    END;
                  ELSE;          /* update prevzem
                    MOVE 'NAPAKA' TO FLNAPAK1;
                    MOVE "Èitanje za ažuriranje je neuspešno (PREVZEM)" MSG64;
                    EZEREPLY = 1;
                    EZEROLLB();
                  END;
                ELSE;            /* add odvstr - 122
                  MOVE "Zapis dokumenta 'Vrednostna razlika' je neuspešen" MSG64;
                  MOVE 'NAPAKA' TO FLNAPAK1;
                  EZEREPLY = 1;
                  EZEROLLB();
                END;
              ELSE;              /* update skladisc
                MOVE 'NAPAKA' TO FLNAPAK1;
                MOVE "Èitanje za ažuriranje je neuspešno (SKLADISC)" MSG64;
                EZEREPLY = 1;
                EZEROLLB();
              END;
              IF FLNAPAK1 EQ ' '; /* tab.skladisc,prevzem,add 122 uspešno ažuriranje
                IF FLFAKTLI EQ ' '; /* odv.str. nastopajo
                  ; /* OR en00M02.NAMEN NE en00W02.NAMEN;namen je spremenjen
                  IF FLIZDAJE EQ 'IZDAJE'; /* izdaje obstajajo
                    MOVE EN00M02.FIRMA TO EN00R07.FIRMA;
                    MOVE EN00M02.STDOK1 TO EN00R07.VEZNIDOK;
                    MOVE EN00M02.POZDOK1 TO EN00R07.POZVEDOK;
                    MOVE EN00M02.IDENT TO EN00R07.IDENT;
                    MOVE EN00M02.SIFPREJE TO EN00R07.MZ;
                    ; /* MOVE en00W02.NAMEN en00R07.NAMEN       ;iz ws zaradi sprem.
                    EN00P17();   /* setupdate izdaje
                    IF EN00R07 NOT ERR;
                      MOVE ' ' TO FLKONEC;
                      WHILE FLKONEC EQ ' ';
                        EN00P18(); /* scan izdaje
                        IF EN00R07 NOT ERR;
                          IF EN00R07.VD EQ '154'; /* izdaja je medskl.prenos
                            MOVE 'ŠIFRA SKLADIŠÈA ZA 154-PREVZEM:' EN00M02.POLJE5;
                            MOVE EN00R07.SIFPREJE TO EN00M02.SIFSKL;
                          END;
                          EN00S12(); /* prenos v recd r07 izdaje
                          EN00P19(); /* replace izdaje
                          IF EN00R07 NOT ERR;
                            ; /* v setupd izdaje obvezno oznstorn = ' '
                            ; /* IF en00M02.NAMEN NE en00W02.NAMEN      ;namen je spremenjen
                            ; /* AND ODVSTR2 EQ 0;odv.str. ne nastopajo
                            ; /* samo ažuriranje namena neglede na mesec spremembe namena
                            ; /* en00S29  ;samo sprememba namena
                            ;    /* ELSE ;
                            EN00S28(); /* dodajanje v tab. nsizdaje
                            ;    /* END ;
                          ELSE;
                            MOVE 'NAPAKA' TO FLNAPAK1;
                            MOVE 'KONEC' TO FLKONEC;
                            MOVE "Ažuriranje odv.str.nabave pri izdajah je neuspešno" MSG64;
                            EZEREPLY = 1;
                            EZEROLLB();
                          END;   /* repl izdaje
                        ELSE;    /* zadnji scan
                          MOVE 'KONEC' TO FLKONEC;
                        END;
                      END;       /* WHILE
                    ELSE;
                      MOVE "Neuspešno èitanje za ažuriranje (IZDAJE)" MSG64;
                      MOVE 'NAPAKA' TO FLNAPAK1;
                      EZEREPLY = 1;
                      EZEROLLB();
                    END;
                  ELSE;          /* izdaje ne obstajajo
                  END;
                ELSE;            /* odv.str. so 0
                END;
              ELSE;              /* flnapak1 - add 122,skadisc,prevzem
              END;
              IF FLNAPAK1 EQ ' '; /* odv.str.so dodani v tab.Prevzem in Izdaje
                EN00S15();       /* prenos v recd R05 skladisc
                EN00P11();       /* replace skladisc
                IF EN00R05 NOT ERR;
                  MOVE EN00M02.IDENT TO EN00R08.IDENT;
                  EN00P20();     /* update material
                  IF EN00R08 NOT ERR;
                    EN00S16();   /* prenos v recd R08 material
                    EN00P21();   /* replace material
                    IF EN00R08 NOT ERR;
                      IF FLFAKTLI EQ ' '; /* odv.str. nastopajo
                        MOVE 'ODVISNI STROŠKI NA ENOTO MERE :' EN00M02.POLJE1;
                        MOVE EN00W02.ODVSTR2 TO EN00M02.POLJE2;
                        MOVE "Odvisni stroški nabave so ažurirani" MSG64;
                        EN00M02.ODVSTR = EN00M02.ODVSTR + ODVSTR2;
                        EN00M02.SKVRED = EN00M02.NABCENA + EN00M02.ODVSTR;
                        EN00M02.SKVRED = EN00M02.SKVRED * EN00M02.KOLICINA;
                      ELSE;      /* odv.str so 0
                        MOVE "Faktura je likvidirana vrednostna razlika ne obstaja" MSG64;
                        MOVE ' ' TO FLFAKTLI;
                      END;
                      MOVE '*' TO EN00W03.OZNAKANS[STEVEC2];
                      MOVE '*' TO EN00M01.OZNAKANS[STEVEC];
                      MOVE EN00R04.STDOK TO EN00M02.STDOK;
                      MOVE EN00R04.POZDOK TO EN00M02.POZDOK;
                      MOVE 0 TO EN00W02.SKVREDST;
                      MOVE ' ' TO EN00W02.NAMEN;
                      EN00S07(); /* inic.pom.polj
                      EZEREPLY = 1;
                      EZECOMIT();
                      MOVE 'ZAPIS' TO FLTIPKA2; /* onemogoèa ponovni zapis
                    ELSE;        /* repl. Material
                      MOVE "Ažuriranje odv.stroškov je neuspešno (MATERIAL)" MSG64;
                      EZEREPLY = 1;
                      EZEROLLB();
                    END;
                  ELSE;          /* neuspešen update material
                    MOVE "Neuspešno èitanje za ažuriranje (MATERIAL)" MSG64;
                    EZEREPLY = 1;
                    EZEROLLB();
                  END;
                ELSE;            /* repl skladisc
                  MOVE "Ažuriranje odv.str. je neuspešno (SKLADISC)" MSG64;
                  EZEREPLY = 1;
                  EZEROLLB();
                END;
              ELSE;              /* flnapak1 repl prevzem in izdaje
              END;
            ELSE;                /* flanpak1 repl.tab.parametr ni uspešen
            END;
          ELSE;                  /* flanpak1-obvezen vpis polj
          END;
        ELSE;                    /* dokument 122 je že zapisan
          MOVE 'NAPAKA' TO FLNAPAK1;
          MOVE "Odvisni stroški za fakturo so že knjiženi" TO MSG64;
          EZEREPLY = 1;
          EZEROLLB();
        END;
      ELSE;                      /* ni f2
        MOVE "Izbira funkcijske tipke je napaèna" TO MSG64;
      END;                       /* F2
    END;                         /* F5
  END;                           /* F4
END;                             /* Enter
:eafter.
:efunc.

