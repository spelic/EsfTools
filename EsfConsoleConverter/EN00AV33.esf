:func      name      = EN00S04           
           date      = '04/14/2008' time = '11:54:20' option = EXECUTE  
           desc      = 'obraèun odv.str'
           refine    = N  
:before.
IF EN00M01.POLJE4 EQ 'S';        /* skupni odvisni stroški
  EN00W02.ODVSTR1 = EN00M01.SKODVSTR * EN00W03.NABCENA[STEVEC];
  EN00W02.ODVSTR2 = EN00W02.ODVSTR1 / EN00W02.SUMAVRED (R;
  MOVE EN00W03.SKVRED[STEVEC] TO EN00W02.SKVREDST;
  EN00W03.ODVSTR[STEVEC] = EN00W03.ODVSTR[STEVEC] + ODVSTR2;
  EN00W03.SKCENA[STEVEC] = EN00W03.SKCENA[STEVEC] + ODVSTR2;
  ODVSTR3 = EN00W03.SKCENA[STEVEC] * EN00W03.KOLICINA[STEVEC];
  MOVE ODVSTR3 TO EN00W03.SKVRED[STEVEC];
  IF ODVSTR2 < 0;                /* negativni odvisni stroški
    EN00W02.PREVRED = EN00W02.SKVREDST - EN00W03.SKVRED[STEVEC];
  ELSE;                          /* pozitivni odvisni stroški
    EN00W02.PREVRED = EN00W03.SKVRED[STEVEC] - EN00W02.SKVREDST;
  END;
  ;
  ; /* === izraèun vrednosti neodv.str. posamezne pozicije prevzema
  ;
ELSE;
  IF EN00M01.POLJE4 EQ 'P' AND EN00M01.STATUSN = 'N'; /* posamezna pozicija
    IF EN00M02.FAKTVRED EQ EN00W02.SUMAVRED
      AND EN00M02.NABCENA NE 0;  /* lahko so vpisani odvstr,vrednost pa je 0
      MOVE 'LIKFAKT' TO FLFAKTLI; /* dok.odvstr ima vrednost 0
    ELSE;
      IF EN00M02.FAKTVRED NE 0;
        IF EN00M02.NABCENA EQ 0; /* sprem.namena iz 5 ,ki nima cene
          EN00W02.ODVSTR2 = EN00M02.FAKTVRED / EN00M02.KOLICINA;
        ELSE;                    /* nabavna cena obstaja
          EN00W02.ODVSTR4 = EN00M02.FAKTVRED - EN00W02.SUMAVRED;
          EN00W02.ODVSTR1 = EN00W02.ODVSTR4 * EN00M02.NABCENA;
          EN00W02.ODVSTR2 = EN00W02.ODVSTR1 / EN00W02.SUMAVRED (R;
        END;
      ELSE;                      /* vpisani so odvisni stroški pozicije
        IF EN00M02.NABCENA EQ 0; /* sprem.namena iz 5 ,ki nima cene
          EN00W02.ODVSTR2 = EN00M02.ODVSTRP1 / EN00M02.KOLICINA;
        ELSE;                    /* nabavna cena obstaja
          EN00W02.ODVSTR1 = EN00M02.ODVSTRP1 * EN00M02.NABCENA;
          EN00W02.ODVSTR2 = EN00W02.ODVSTR1 / EN00W02.SUMAVRED (R;
        END;
      END;
      ; /* en00W02.ODVSTR2 = en00W02.ODVSTR1 / en00W02.SUMAVRED (R;
      IF EN00W02.ODVSTR2 NE 0;   /* izraèunani odvstr na enoto niso 0,00
        EN00W02.ODVSTR = EN00M02.ODVSTR + ODVSTR2; /* skupni odv.str.
        EN00W02.SKCENA = EN00W02.SKCENA + ODVSTR2;
        ODVSTR3 = EN00W02.SKCENA * EN00M02.KOLICINA; /* skupna vrednost
        MOVE ODVSTR3 TO EN00W02.SKVRED;
        ; /* === izraèun vrednosti neodv.str.posam. pozicije prevzema
        IF ODVSTR2 < 0;          /* negativni odvisni stroški
          EN00W02.PREVRED = EN00W02.SKVREDST - EN00W02.SKVRED;
        ELSE;                    /* pozitivni odvisni stroški
          EN00W02.PREVRED = EN00W02.SKVRED - EN00W02.SKVREDST;
        END;
      ELSE;                      /* izraèunani odvstr so 0,00
        MOVE 'LIKFAKT' TO FLFAKTLI; /* dok.odvstr ima vrednost 0
      END;
    END;
  ELSE;
  END;                           /* za status P+N
/* **************************************************************/
/* izraèun stroškov za pozicijo ostali stroški   p + n
/* **************************************************************/


  IF EN00M01.POLJE4 EQ 'P' AND EN00M01.STATUSN = 'D';



    IF EN00M02.FAKTVRED NE 0;
      
        EN00W02.ODVSTR2 = EN00M02.FAKTVRED / EN00M02.KOLICINA;
     
    
    ;   /* en00W02.ODVSTR2 = en00W02.ODVSTR1 / en00W02.SUMAVRED (R;
    IF EN00W02.ODVSTR2 NE 0;     /* izraèunani odvstr na enoto niso 0,00
      EN00W02.ODVSTR = EN00M02.ODVSTR + ODVSTR2; /* skupni odv.str.
      EN00W02.SKCENA = EN00W02.SKCENA + ODVSTR2;
      ODVSTR3 = EN00W02.SKCENA * EN00M02.KOLICINA; /* skupna vrednost
      MOVE ODVSTR3 TO EN00W02.SKVRED;
      ;   /* === izraèun vrednosti neodv.str.posam. pozicije prevzema
      IF ODVSTR2 < 0;            /* negativni odvisni stroški
        EN00W02.PREVRED = EN00W02.SKVREDST - EN00W02.SKVRED;
      ELSE;                      /* pozitivni odvisni stroški
        EN00W02.PREVRED = EN00W02.SKVRED - EN00W02.SKVREDST;
      END;
    ELSE;                        /* izraèunani odvstr so 0,00
      MOVE 'LIKFAKT' TO FLFAKTLI; /* dok.odvstr ima vrednost 0
    END;
ELSE;
END;


  END;
