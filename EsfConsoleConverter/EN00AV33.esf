:func      name      = EN00S26           
           date      = '06/21/2001' time = '13:59:01' option = EXECUTE  
           desc      = 'protect vrstic na mapi'
           refine    = N  
:before.
WHILE VRSTICA1 <= MAPSIZE;
  SET EN00M01.IDENT[VRSTICA1] PROTECT,BRIGHT;
  VRSTICA1 = VRSTICA1 + 1;
END;
MOVE 0 TO VRSTICA1;
