:func      name      = EN00S28           
           date      = '03/10/2011' time = '10:57:56' option = EXECUTE  
           desc      = 'dodajanje v tab. NSIZDAJE'
           refine    = N  
:before.
IF EN00R07.KOLICINA ^= EN00R07.PROSTKOL;
                                 /* delni storno ? poglej èe je 0 s
  EN00S30();                     /* ažuriranje dok 127 delni storno
END;
IF EN00M01.POLJE4 EQ 'S';
  MOVE EN00W03.IDENT[STEVEC] TO EN00R14.IDENT;
  MOVE EN00M01.SIFPREJE TO EN00R14.MZ;
  MOVE EN00M01.FIRMA TO EN00R14.FIRMA;
ELSE;                            /* posamezna pozicija iz mape M02
  MOVE EN00M02.IDENT TO EN00R14.IDENT;
  MOVE EN00M02.SIFPREJE TO EN00R14.MZ;
  MOVE EN00M01.FIRMA TO EN00R14.FIRMA;
END;
EN00R14.SKVRED = ODVSTR2 * EN00R07.KOLICINA;
                                 /* delni storno se ne upošteva
MOVE EN00R07.SIFPREJE TO EN00R14.SIFPREJE;
MOVE EN00R07.SIFIZDAJ TO EN00R14.SIFIZDAJ;
MOVE EN00R07.TECAJDOL TO EN00R14.TECDOL;
