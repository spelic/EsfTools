:func      name      = EN00S01           
           date      = '03/10/2011' time = '11:06:28' option = EXECUTE  
           desc      = 'vpis Št.prevzema'
           refine    = N  
:before.
MOVE 'DRUGIC' TO FLDRUGIC;
MOVE ' ' TO FLNAPAK1;
MOVE EN00M01.STDOK1 TO EN00R01.STDOK;
MOVE EN00M01.SIFPREJE TO EN00R01.MZ;
MOVE EN00M01.FIRMA TO EN00R01.FIRMA;
EN00P03();                       /* setinq prevzem
IF EN00R01 NOT ERR;
  MOVE ' ' TO FLKONEC;
  MOVE 0 TO EN00W02.STEVEC;
  WHILE FLKONEC EQ ' ';
    EN00P04();                   /* scan

    IF EN00R01 NOT ERR;
      EN00W02.STEVEC = EN00W02.STEVEC + 1;
      IF EN00W02.STEVEC < 46;    /* pet map po 9 slogov
        MOVE EN00R01.IDENT TO EN00W03.IDENT[STEVEC];
        MOVE EN00R01.POZDOK TO EN00W03.POZDOK[STEVEC];
        MOVE EN00R01.NAZIV TO EN00W03.NAZIV[STEVEC];
        MOVE EN00R01.DATURA TO EN00W03.DATURA[STEVEC];
        MOVE EN00R01.INDPREN TO EN00W03.INDPREN[STEVEC];
        MOVE EN00R01.SIFPREJE TO EN00M01.PREJEMNIK;
        MOVE ' ' TO EN00W03.OZNAKANS[STEVEC];
      ELSE;                      /* stevec = 10
        MOVE 'KONEC' TO FLKONEC;
      END;
    ELSE;                        /* scan
      IF EN00W02.STEVEC EQ 0;
        MOVE "Številka prevzema na skladišèu ne obstaja" TO MSG64;
        MOVE 'KONEC' TO FLKONEC;
        MOVE 'NAPAKA' TO FLNAPAK1;
      END;
      MOVE 'KONEC' TO FLKONEC;
      MOVE EN00W02.STEVEC TO EN00W02.RECDCOUN;
                                 /* Število preèitanih slogov
    END;
  END;                           /* while
  MOVE "S kursorjem izberi ident in pritisni F5" TO MSG64;
  SET EN00M01.POLJEDO1 CURSOR,BRIGHT;
ELSE;                            /* setinq
  MOVE 'NAPAKA' TO FLNAPAK1;
  MOVE ' ' TO FLDRUGIC;
  MOVE "Številka prevzema na skladišèu ne obstaja" TO MSG64;
END;
:ebefore.
:efunc.

:func      name      = EN00S02           
           date      = '10/28/2008' time = '08:45:41' option = EXECUTE  
           desc      = 'kontrola obveznega vpisa'
           refine    = N  
:before.
MOVE ' ' TO FLNAPAK1;
IF EN00M01.POLJE4 EQ 'S';


  IF EN00M01.STDOK1 EQ 0;
    MOVE "Vnesi številko prevzema in skladišèa" TO MSG64;
    SET EN00M01.STDOKP1 CURSOR,BRIGHT;
    MOVE 'NAPAKA' TO FLNAPAK1;

  ELSE;


    IF EN00M01.SIFPREJE EQ ' ';
      MOVE "Vnesi šifro skladišèa" TO MSG64;
      SET EN00M01.SIFPREJE CURSOR,BRIGHT;
      MOVE 'NAPAKA' TO FLNAPAK1;
    ELSE;
      IF EN00M01.VP EQ ' ';
        MOVE "Vnesi vrsto prometa" TO MSG64;
        SET EN00M01.VP CURSOR,BRIGHT;
        MOVE 'NAPAKA' TO FLNAPAK1;
      ELSE;
        IF FLNAPAK3 NE ' ';
          MOVE "Šifra Vrste prometa ni pravilna" TO MSG64;
          SET EN00M01.VP CURSOR,BRIGHT;
          MOVE 'NAPAKA' TO FLNAPAK1;
        ELSE;
          IF EN00M01.POLJEDO1 EQ ' '; /* stfakt
            MOVE "Vnesi številko fakture" TO MSG64;
            SET EN00M01.POLJEDO1 CURSOR,BRIGHT;
            MOVE 'NAPAKA' TO FLNAPAK1;
          ELSE;
            IF EN00M01.SKODVSTR EQ 0;
              IF EN00M01.INDIKLIK EQ ' '; /* indikator likvidacije dok.122 ne nastane
                MOVE "Vnesi vrednost skupnih odvis.stroškov ali indik.likvid." MSG64;
                SET EN00M01.SKODVSTR CURSOR,BRIGHT;
                MOVE 'NAPAKA' TO FLNAPAK1;
              ELSE;
              END;
            ELSE;
            END;
          END;
        END;

      END;
    END;
  END;
ELSE;                            /* polje4 je P
  IF EN00M01.STDOKP1 NOT MODIFIED;
    MOVE "Vnesi številko prevzema in skladišèa" TO MSG64;
    SET EN00M01.STDOKP1 CURSOR,BRIGHT;
    MOVE 'NAPAKA' TO FLNAPAK1;
  ELSE;
    IF EN00M01.SIFPREJE EQ ' ';
      MOVE "Vnesi šifro skladišèa" TO MSG64;
      SET EN00M01.SIFPREJE CURSOR,BRIGHT;
      MOVE 'NAPAKA' TO FLNAPAK1;
    ELSE;
      IF EN00M01.POLJEDO1 EQ ' '; /* stfakt
        MOVE "Vnesi številko fakture" TO MSG64;
        SET EN00M01.POLJEDO1 CURSOR,BRIGHT;
        MOVE 'NAPAKA' TO FLNAPAK1;
      END;
    END;
  END;
  SET EN00M01.VP PROTECT,BRIGHT;
END;
IF EN00M01.STATUSN NE 'N';
  IF EN00M01.STATUSN NE 'D';
    MOVE "Vnesi pravilen status stroška N ali D " TO MSG64;
    SET EN00M01.STATUSN CURSOR,BRIGHT;
    MOVE 'NAPAKA' TO FLNAPAK1;
  ELSE;
  END;
END;
:ebefore.
:efunc.

:func      name      = EN00S03           
           date      = '12/14/2007' time = '08:37:11' option = EXECUTE  
           desc      = 'prenos prevz. v ws'
           refine    = N  
:before.
MOVE EN00R01.IDENT TO EN00W03.IDENT[STEVEC];
MOVE EN00R01.POZDOK TO EN00W03.POZDOK[STEVEC];
MOVE EN00R01.KOLICINA TO EN00W03.KOLICINA[STEVEC];
MOVE EN00R01.PROSTKOL TO EN00W03.PROSTKOL[STEVEC];
MOVE EN00R01.NABCENA TO EN00W03.NABCENA[STEVEC];
MOVE EN00R01.ODVSTR TO EN00W03.ODVSTR[STEVEC];
