MOVE 1 TO START1;                /* prva pozicija prve mape
MOVE 0 TO LASTBOT;               /* zadnja pozicija sloga na mapi
MOVE 1 TO LASTTOP;               /* prva pozicija prve mape
MOVE ' ' TO EN00M01.NAPREJ;
MOVE ' ' TO EN00M01.NAZAJ;
MOVE 0 TO VRSTICA;               /* Števec vrstic na mapi
