EN00S13();                       /* protect identov
IF EN00W01.PODRGOV = 'S';
MOVE "Vpiši indik. obdelave S ali P in pritisni ENTER" EN00M01.EZEMSG;
ELSE;
END;
IF EN00W01.PODRGOV = 'H';
MOVE "Upišite indik. obrade S ili P in pritisnite ENTER" EN00M01.EZEMSG;
ELSE;
END;

SET EN00M01.POLJE4 CURSOR,BRIGHT;
IF EN00W01.PODRGOV = 'S';
MOVE "S-skupni, P-pozicija odvisnih stroškov" TO EN00M01.POLJE3;
ELSE;
END;
IF EN00W01.PODRGOV = 'H';
MOVE "S-ukupni, P-pozicija odvisnih troškova" TO EN00M01.POLJE3;
ELSE;
END;

MOVE EN00W01.SDOK TO EN00M01.VD; /* odvisni stroški
WHILE FLIND EQ ' ';
  EN00P02();                     /* converse
  TEST EZEAID PA2 EZECLOS;
  IF EZEAID IS PF3;              /* vrnitev v predhodno aplikacijo
    STEVAPPL = STEVAPPL - 1;
    MOVE EN00W01.APPL[STEVAPPL] TO EZEAPP;
    DXFR EZEAPP EN00W01;
  END;
  TEST EZEAID PF6 EZEFLO;        /* clear mape
  IF EZEAID IS ENTER;
    IF EN00M01.IDENT[1] NE 0;    /* prepreèi se ponovni prikaz na mapi
      MOVE "S kursorjem izberi ident in pritisni F5" TO MSG64;
    ELSE;
      IF EN00M01.POLJE4 EQ 'S';  /* skupni odv.stroški
        SET EN00M01.POLJE4 PROTECT,BRIGHT;
        IF FLNAPAK2 EQ ' ';      /* vpisana polja so pravilna
          IF EN00M01.SKODVSTR NE 0
            OR EN00M01.INDIKLIK NE ' ';
            SET EN00M01.STDOKP1 PROTECT,BRIGHT;
            SET EN00M01.STDOK1 PROTECT,BRIGHT;
            SET EN00M01.SIFPREJE PROTECT,BRIGHT;
            SET EN00M01.POLJE4 PROTECT,BRIGHT;
            SET EN00M01.INDIKLIK PROTECT,BRIGHT; /* ?????
            MOVE "Preveri podatke in pritisni F2" TO MSG64;
IF EN00W01.PODRGOV = 'S';
            MOVE "Skupni odvisni stroški nabave za prevzem:" EN00M01.POLJE3;
ELSE;
END;
IF EN00W01.PODRGOV = 'H';
            MOVE "Ukupni odvisni troškii nabave za primko:" EN00M01.POLJE3;
ELSE;
END;
          END;
          EN00S02();             /* kontrola vpisa
        END;                     /* flnapak2 vpisana polja
      ELSE;                      /* polje4 ni s - posamezna pozicija
        IF EN00M01.POLJE4 EQ 'P'; /* obraèun posamezne pozicije
          SET EN00M01.POLJE4 PROTECT,BRIGHT;
          IF FLNAPAK2 EQ ' ';    /* vpisana so polja
            SET EN00M01.SKODVSTR PROTECT; /* nedovoljen vpis skupnih stroškov
            SET EN00M01.INDIKLIK PROTECT; /* nedovoljen vpis indik.likvidacije
            EN00S02();           /* kontrola vpisa
            IF FLNAPAK1 EQ ' ';  /* vsi podatki so vpisani
              IF FLDRUGIC EQ ' '; /* podatki še niso v ws03
                EN00S23();       /* unprotec ident na mapi M01
                EN00S22();       /* inicial.pom.polj za listanje
                EN00S01();       /* Èitanje in prenos podatkov v w03
              ELSE;
              END;
              IF FLNAPAK1 EQ ' ' /* slogi so v WS03
                AND FLDRUGIC NE ' ';
                EN00S20();       /* prenos iz W03 na mapo
                SET EN00M01.POLJE4 PROTECT,BRIGHT;
                                 /* zašèita indik P ali S
                MOVE "S kursorjem izberi ident in pritisni F5" TO MSG64;
              END;               /* flnapak1-prenos slogov v W03
            END;                 /* flnapak1-vsi podatki so vpisani
          ELSE;                  /* flnapak2 - vpisana polja so
                                 /* nepravilna
          END;
        ELSE;                    /* polje4 ni p ali s
          MOVE "Vpiši 'S' ali 'P'" TO MSG64;
        END;
      END;                       /* indikator s
    END;                         /* ident(1) je 0
  ELSE;                          /* tipka ni enter
    IF EZEAID IS PF2;            /* zapis sumarnih odvisnih stroškov
      IF EN00M01.POLJE4 EQ 'S';  /* vpisani so skupni odv.stroški
        EN00S02();               /* kontrola vpisa
        IF FLNAPAK1 EQ ' ';      /* vsi podatki so vpisani
          IF FLTIPK2 EQ ' ';     /* zapis f2 še ni
            MOVE 'TIPKA2' TO EN00W02.FLTIPK2;
          ELSE;
            EN00S07();           /* inic.pom.polj za sume = 0
          END;
          MOVE EN00R03.SUMAVRED TO EN00W02.SUMAVRED;
          MOVE EN00M01.STDOK1 TO EN00R01.STDOK;
          MOVE EN00M01.SIFPREJE TO EN00R01.MZ;
          MOVE EN00M01.FIRMA TO EN00R01.FIRMA;
          EN00P03();             /* setinq prevzem
          IF EN00R01 NOT ERR;
            MOVE ' ' TO FLKONEC;
            MOVE 0 TO STEVEC;
            WHILE FLKONEC EQ ' ';
              EN00P04();         /* scan prevzem
              IF EN00R01 NOT ERR;
                EN00W02.STEVEC = EN00W02.STEVEC + 1;
                EN00S03();       /* prenos prevzemov v ws03
              ELSE;              /* scan napaèen
                IF EN00W02.STEVEC EQ 0;
                  MOVE "Številka prevzema na skladišèu ne obstaja" MSG64;
                  MOVE 'KONEC' TO FLKONEC;
                  MOVE 'NAPAKA' TO FLNAPAK1;
                END;
                MOVE 'KONEC' TO FLKONEC;
              END;
            END;                 /* while
            MOVE EN00W02.STEVEC TO EN00W02.STEVEC1; /* Št.prevzemov
          ELSE;                  /* setinq
            MOVE 'NAPAKA' TO FLNAPAK1;
            MOVE "Številka prevzema ne skladišèu ne obstaja" TO MSG64;
          END;
          IF FLNAPAK1 EQ ' ';    /* Èitanje tab.prevzem za suma vred je
                                 /* ok
            MOVE EN00M01.SIFPREJE TO EN00R02.MZ;
            MOVE EN00M01.FIRMA TO EN00R02.FIRMA;
            EN00P06();           /* update parametr
            IF EN00R02 NOT ERR;
              EN00R02.STDOK = EN00R02.STDOK + 1;
              EN00R02.STDOKN = EN00R02.STDOKN + 1;
              MOVE EN00R02.STDOKN TO EN00W02.STDOKN;
              EN00P12();         /* replace parametr
              IF EN00R02 NOT ERR;
                EZEREPLY = 1;
                EZECOMIT();
              ELSE;
                MOVE "Ažuriranje št.dokumenta je neuspešno (PARAMET)" MSG64;
                MOVE 'NAPAKA' TO FLNAPAK1;
                EZEREPLY = 1;
                EZEROLLB();
              END;
            ELSE;                /* update parametr
              MOVE "Neuspešno èitanje za ažuriranje (PARAMET)" TO MSG64;
              MOVE 'NAPAKA' TO FLNAPAK1;
              EZEREPLY = 1;
              EZEROLLB();
            END;
          ELSE;                  /* flanpak1- prevzemi nimajo vrednosti
          END;
          IF FLNAPAK1 EQ ' ';    /* uspešno èitanje tab.paramet
            MOVE 0 TO EN00W02.STEVEC;
            MOVE 01 TO EN00W02.POZDOK; /* prva pozicija dokumenta 122
            MOVE 0 TO EN00W02.TEKSTEV;
            WHILE EN00W02.STEVEC < STEVEC1; /* dokler so prevzemi v w03
              STEVEC = STEVEC + 1;
              IF INDIKLIK EQ ' '; /* odvisni stroški nastopajo
                EN00S04();       /* izraèun odvisnih stroškov in prenos
              ELSE;              /* preraèuna ni
              END;
              MOVE EN00W03.IDENT[STEVEC] TO EN00R05.IDENT;
              MOVE EN00M01.SIFPREJE TO EN00R05.MZ;
              MOVE EN00M01.FIRMA TO EN00R05.FIRMA;
              EN00P10();         /* update skladisc
              IF EN00R05 NOT ERR;
                EN00R05.TEKSTEV = EN00R05.TEKSTEV + 1;
                MOVE EN00R05.TEKSTEV TO EN00W02.TEKSTEV;
                EN00S05();       /* prenos odv.str 122
                EN00P07();       /* add 122 - odvstr
                IF EN00R04 NOT ERR AND FLNAPAK1 = ' '; /* èe je dodajanje uspešno in zaloga uspešno ažurirana ali dodanazalnamis
                  MOVE EN00M01.FIRMA TO EN00R12.FIRMA;
                  MOVE EN00W03.IDENT[STEVEC] TO EN00R12.IDENT;
                  MOVE EN00M01.SIFPREJE TO EN00R12.MZ;
                  MOVE EN00M01.STDOK1 TO EN00R12.STDOK;
                  MOVE EN00W03.POZDOK[STEVEC] TO EN00R12.POZDOK;
                  EN00P08();     /* update prevzem
                  IF EN00R12 NOT ERR;
                    IF EN00R12.DATURA EQ EN00W03.DATURA[STEVEC];
                      EN00S06(); /* prenos v recd r12
                      EN00P09(); /* replace prevzem
                      IF EN00R12 NOT ERR;
/* **************************************************************/
/* doda za impolsko predelavo
/* **************************************************************/
                        IF EN00M01.FIRMA = '01' AND EN00R12.MZ = '10020' AND EN00R12.NAMEN = '2';

                          SET EN00R31 EMPTY;
                          SET EN00R24 EMPTY;

                          MOVE 'DA' TO FLOK3;
                          EN00P38();
                          IF FLOK3 = 'DA';
                          ELSE;
                            MOVE 'NAPAKA' TO FLNAPAK1;
                            MOVE "Ažuriranje za predelavo je napaka" MSG64;
                            EZEREPLY = 1;
                            EZEROLLB();
                          END;
                        ELSE;
                        END;
/* **************************************************************/
/* konec za predelavo
/* **************************************************************/
/* **************************************************************/
/* doda za impolsko predelavo  seval namen 2
/* **************************************************************/
                        IF EN00M01.FIRMA = '01' AND EN00R12.MZ = '10020' AND EN00R12.NAMEN NE '2';
                          IF EN00M01.FIRMA = '01' AND EN00R12.MZ = '10020' AND EN00R12.NAMEN NE '3';

                            SET EN00R31 EMPTY;
                            SET EN00R24 EMPTY;
                            SET EN00R892 EMPTY;
                            MOVE 'DA' TO FLOK3;
                            EN00F54();
                            IF FLOK3 = 'DA';
                            ELSE;
                              MOVE 'NAPAKA' TO FLNAPAK1;
                              MOVE "Ažuriranje za predelavo je napaka" MSG64;
                              EZEREPLY = 1;
                              EZEROLLB();
                            END;
                          ELSE;
                          END;
                        ELSE;
                        END;
/* **************************************************************/
/* konec za predelavo
/* **************************************************************/


                      ELSE;      /* replace prevzem
                        MOVE 'NAPAKA' TO FLNAPAK1;
                        MOVE "Ažuriranje dok. prevzem je neuspešno (PREVZEM)" MSG64;
                        EZEREPLY = 1;
                        EZEROLLB();
                      END;
                    ELSE;        /* slog prevzema je spremenjen
                      MOVE 'NAPAKA' TO FLNAPAK1;
                      MOVE "Pozic.prevzema je spremenjena neuspešno ažuriranje" MSG64;
                      EZEREPLY = 1;
                      EZEROLLB();
                    END;
                  ELSE;          /* update prevzem
                    MOVE 'NAPAKA' TO FLNAPAK1;
                    MOVE "Èitanje za ažuriranje je neuspešno (PREVZEM)" MSG64;

                  END;
                ELSE;            /* add odvstr - 122
                  MOVE "Dodajanje Vrednostne razlike nabave je neuspešno" MSG64;
                  MOVE 'NAPAKA' TO FLNAPAK1;
                  EZEREPLY = 1;
                  EZEROLLB();
                END;
              ELSE;              /* update skladisc
                MOVE 'NAPAKA' TO FLNAPAK1;
                MOVE "Èitanje za ažuriranje je neuspešno (SKLADISC)" MSG64;
                EZEREPLY = 1;
                EZEROLLB();
              END;
              IF FLNAPAK1 EQ ' '; /* odv.str.,prevzemi in tab.skladisc je ažurirana
                ; /* ============== ali so na prevzem izvršene izdaje ===========
                IF INDIKLIK EQ ' '; /* odv.str. nastopajo
                  IF EN00W03.PROSTKOL[STEVEC] < EN00W03.KOLICINA[STEVEC];
                    MOVE 'IZDAJE' TO FLIZDAJE;
                    MOVE EN00M01.STDOK1 TO EN00R07.VEZNIDOK;
                    MOVE EN00W03.POZDOK[STEVEC] TO EN00R07.POZVEDOK;
                    MOVE EN00W03.IDENT[STEVEC] TO EN00R07.IDENT;
                    MOVE EN00W03.NAMEN[STEVEC] TO EN00R07.NAMEN; /* ******
                    MOVE EN00M01.SIFPREJE TO EN00R07.MZ;
                    MOVE EN00M01.FIRMA TO EN00R07.FIRMA;
                    EN00P17();   /* setupdate izdaje
                    IF EN00R07 NOT ERR;
                      MOVE ' ' TO FLKONEC;
                      WHILE FLKONEC EQ ' ';
                        EN00P18(); /* scan izdaje
                        IF EN00R07 NOT ERR;
                          IF EN00R07.VD EQ '154';
                            MOVE 'POZICIJA IZDAJE JE MEDSKLADIŠÈNI PRENOS' EN00M01.POLJE3;
                            MOVE "Obvezna razporeditev odv.stroškov po poziciji" MSG64;
                            MOVE 'NAPAKA' TO FLNAPAK1;
                            MOVE 'KONEC' TO FLKONEC;
                            EN00W02.STEVEC = EN00W02.STEVEC1 + 1;
                            EZEREPLY = 1;
                            EZEROLLB();
                          ELSE;  /* vd ni 154
                            EN00S12(); /* prenos v recd r07 izdaje
                            EN00P19(); /* replace izdaje
                            IF EN00R07 NOT ERR;
                              EN00S28(); /* prenos sloga 122 v nsizdaje
                            ELSE;
                              MOVE 'NAPAKA' TO FLNAPAK1;
                              MOVE 'KONEC' TO FLKONEC;
                              MOVE "Ažuriranje odv. stroškov pri izdaji je neuspešno" MSG64;
                              EZEREPLY = 1;
                              EZEROLLB();
                            END; /* repl izdaje
                          END;   /* vd 154
                        ELSE;    /* zadnji scan
                          MOVE 'KONEC' TO FLKONEC;
                        END;
                      END;       /* WHILE izdaje
                    ELSE;
                      MOVE "Èitanje za ažuriranje je neuspešno (IZDAJE)" MSG64;
                      MOVE 'NAPAKA' TO FLNAPAK1;
                      EZEREPLY = 1;
                      EZEROLLB();
                    END;
                  ELSE;          /* izdaje ne obstajajo
                  END;
                ELSE;            /* odv.str so 0
                END;
                IF FLNAPAK1 EQ ' '; /* izdaje so uspešno ažurirane
                  EN00S15();     /* prenos v R05 tab.Skladisc
                  EN00P11();     /* replace skladisc
                  IF EN00R05 NOT ERR;
                    MOVE EN00W03.IDENT[STEVEC] TO EN00R08.IDENT;
                    EN00P20();   /* update tab.material
                    IF EN00R08 NOT ERR;
                      EN00S16(); /* prenos v R08 za repl. tab.Material
                      EN00P21(); /* replace tab.Material
                      IF EN00R08 NOT ERR;
                        EN00S07(); /* inic.pom.polj na 0
                      ELSE;      /* replace v tab.Material je neuspešen
                        MOVE "Neuspešno ažuriranje v tabeli MATERIAL" MSG64;
                        MOVE 'NAPAKA' TO FLNAPAK1;
                        EZEREPLY = 1;
                        EZEROLLB();
                        MOVE STEVEC1 STEVEC; /* izhod iz zanke za pozicije
                      END;
                    ELSE;        /* update tab.Material je neuspešen
                      MOVE "Neuspešno èitanje za ažuriranje (MATERIAL)" MSG64;
                      MOVE 'NAPAKA' TO FLNAPAK1;
                      EZEREPLY = 1;
                      EZEROLLB();
                      MOVE STEVEC1 TO STEVEC;
                                 /* izhod iz zanke za pozicije
                    END;
                  ELSE;          /* replace skladisc
                    MOVE "Ažuriranje je neuspešno (SKLADISC)" TO MSG64;
                    MOVE 'NAPAKA' TO FLNAPAK1;
                    EZEREPLY = 1;
                    EZEROLLB();
                    MOVE STEVEC1 TO STEVEC; /* izhod iz zanke za pozicije
                  END;
                ELSE;            /* flnapak1 izdaje niso uspešno
                                 /* ažurirane
                  MOVE STEVEC1 TO STEVEC; /* izhod iz zanke za pozicije
                END;
              ELSE;              /* flnapak1-vse tabele razen za izdaje
                MOVE STEVEC1 TO STEVEC; /* izhod iz zanke za pozicije
              END;
            END;                 /* while ena pozicija sumarnih odv.str.
            ; /* === Skupni odvisni stroški nabave so ažurirani ===
            IF FLNAPAK1 EQ ' ';  /* vse tab. so uspešno ažurirane
              IF INDIKLIK EQ ' ';
                MOVE "Skupni odvisni stroški nabave so ažurirani" MSG64;
              ELSE;              /* odv.str. so 0
                MOVE "Skupni odvisni stroški so ažurirani-vred.razlika ne obstaja" MSG64;
              END;
              MOVE EN00R02.STDOK TO EN00M01.STDOK;
              MOVE EN00R02.STDOKN TO EN00M01.STDOKN;
              EN00W02.POZDOK = EN00W02.POZDOK - 1;
              MOVE EN00W02.POZDOK TO EN00M01.POZDOK1;
              MOVE ' ' TO EN00M01.POLJE4;
              EZEREPLY = 1;
              EZECOMIT();
            ELSE;                /* flnapak1 - nekje pri poziciji
              EZEREPLY = 1;
              EZEROLLB();
            END;
          ELSE;                  /* flnapak1 - neuspešno
                                 /* ažur.tab.Parametr
          END;
        ELSE;                    /* flnapak1-vsi podatki so vpisani
        END;
      ELSE;                      /* indikator ni "S"
        MOVE "Indikator obdelave ni 'S'" TO MSG64;
      END;
    ELSE;                        /* funk.tipka ni F2
      IF EZEAID IS PF5;          /* izbira identa za obraèun odv.str.
        IF EN00M01.POLJE4 EQ 'P' AND EN00M01.STATUSN = 'N';
          MOVE 1 TO STEVEC;
          IF EN00M01.POLJEDO1 EQ EN00W02.FAKTURA
            AND EN00W02.STDOK > 0
                                 /* Èe se dok.122 ne tvori pri vsaki poz.
            AND EN00W02.POZDOK > 0;
            MOVE 'CITAJ' TO FLCITAN; /* stdok za 122 je že znana
          ELSE;
            MOVE '     ' TO FLCITAN;
            MOVE 0 TO EN00W02.SKPOZIC; /* ugotavljanje stdok
            MOVE 0 TO EN00W02.POZDOK;
          END;
          WHILE STEVEC <= MAPSIZE;
            TEST EN00M01.IDENT[STEVEC] CURSOR EN00S08;
            STEVEC = STEVEC + 1;
          END;
        ELSE;                    /* indikator ni "p"
          MOVE "Indikator obdelave ni 'P'" TO MSG64;
        END;
      ELSE;                      /* tipka ni f5
        IF EZEAID IS PF8;        /* listanje naprej
          IF EN00M01.NAPREJ NE ' '; /* listanje naprej je možno
            EN00S24();           /* clear mape
            LASTTOP = LASTTOP + MAPSIZE;
            EN00S20();           /* prenos na mapo
            MOVE "S kursorjem izberi ident in pritisni F5" TO MSG64;
          ELSE;
            MOVE "Številka prevzema na sklad. ne vsebuje veè pozicij" MSG64;
          END;
        ELSE;                    /* ni F8
          IF EZEAID IS PF7;      /* listanje nazaj
            IF EN00M01.NAZAJ NE ' '; /* listanje nazaj je možno
              EN00S24();         /* clear mape
              EN00S23();         /* unprotect ident
              EN00S21();         /* listanje nazaj
              EN00S20();         /* prenos na mapo
              MOVE "S kursorjem izberi ident in pritisni F5" TO MSG64;
            ELSE;
              MOVE "Listanje nazaj ni možno" TO MSG64;
            END;
          ELSE;                  /* funk.tipka ni F7
            MOVE "Izbira funkcijske tipke je napaèna" TO MSG64;
          END;                   /* F7
        END;                     /* F8
      END;                       /* F5
/* **************************************************************/
/* za zapis str ko je p in d stroški za pos ident
/* **************************************************************/
      IF EZEAID IS PF5;          /* izbira identa za obraèun odv.str.
        IF EN00M01.POLJE4 EQ 'P' AND EN00M01.STATUSN = 'D';
          MOVE 1 TO STEVEC;
          IF EN00M01.POLJEDO1 EQ EN00W02.FAKTURA
            AND EN00W02.STDOK > 0
                                 /* Èe se dok.122 ne tvori pri vsaki poz.
            AND EN00W02.POZDOK > 0;
            MOVE 'CITAJ' TO FLCITAN; /* stdok za 122 je že znana
          ELSE;
            MOVE '     ' TO FLCITAN;
            MOVE 0 TO EN00W02.SKPOZIC; /* ugotavljanje stdok
            MOVE 0 TO EN00W02.POZDOK;
          END;
          WHILE STEVEC <= MAPSIZE;
            TEST EN00M01.IDENT[STEVEC] CURSOR EN00S08;
            STEVEC = STEVEC + 1;
          END;
        ELSE;                    /* indikator ni "p"
          MOVE "Indikator obdelave ni 'P'" TO MSG64;
        END;
      ELSE;                      /* tipka ni f5
