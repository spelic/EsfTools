MOVE "Ažuriranje namena v dok. 122 je neuspešno (PREVZEM)" MSG64;
              MOVE 'NAPAKA' TO FLNAPAK1;
              EZEREPLY = 1;
              EZEROLLB();
            END;
          ELSE;                                /* neuspešno èitanje za ažur. prevzem
                                 /* 122
MOVE "Èitanje za ažur. namena dok.122  je neuspešno (PREVZEM)" MSG64;
            MOVE 'NAPAKA' TO FLNAPAK1;
            EZEREPLY = 1;
            EZEROLLB();
          END;
        END;                                /* dokument 122 ne obstaja
        IF FLNAPAK1 EQ ' ';      /* tab. Prevzem je uspešno ažurirana
          IF FLIZDAJE EQ 'IZDAJE';      /* izdaje obstajajo
  MOVE EN00M02.FIRMA TO EN00R18.FIRMA;
            MOVE EN00M02.IDENT TO EN00R18.IDENT;
            MOVE EN00M02.SIFPREJE TO EN00R18.MZ;
            MOVE EN00M02.STDOK1 TO EN00R18.VEZNIDOK;
            MOVE EN00M02.POZDOK1 TO EN00R18.POZVEDOK;
            EN00P35();           /* setupd izdaje
            IF EN00R18 NOT ERR;
              MOVE ' ' TO FLKONEC2;
              WHILE FLKONEC2 EQ ' ';
                EN00P37();       /* scan
                IF EN00R18 NOT ERR;
                  MOVE EN00W02.NAMENSP TO EN00R18.NAMEN;
MOVE EN00M01.NAMEN TO EN00R18.NAMEN;
                  EN00P36();            /* replace izdaje
                  IF EN00R18 NOT ERR;
IF EN00R18.DATNSTR NOT NULL;     /* slog v tab. Nsizdaje že obstaja
   MOVE EN00M02.FIRMA TO EN00R15.FIRMA;
                      MOVE EN00M02.IDENT TO EN00R15.IDENT;
                      MOVE EN00M02.SIFPREJE TO EN00R15.MZ;
                      MOVE EN00R18.STDOK TO EN00R15.VEZNIDOK;
                      MOVE EN00R18.POZDOK TO EN00R15.POZVEDOK;
                      EN00P27();        /* update tab.nsizdaje
                      IF EN00R15 NOT ERR;
                        MOVE EN00W02.NAMENSP TO EN00R15.NAMEN;
   MOVE EN00M01.NAMEN TO EN00R15.NAMEN;
                        EN00P28();      /* sqlexec replace
                        IF EN00R15 NOT ERR;
                        ELSE;                                /* neuspešen repl nsizdaje
MOVE "Ažuriranje namena je neuspešno (NSIZDAJE)" MSG64;
                          MOVE 'NAPAKA' TO FLNAPAK1;
                          MOVE 'KONEC' TO FLKONEC2;
                          EZEREPLY = 1;
                          EZEROLLB();
                        END;
                      ELSE;                                /* neuspešno èitanje za ažur. nsizdaje
MOVE "Èitanje za ažuriranje namena je neuspešno (NSIZDAJE)" MSG64;
                        MOVE 'NAPAKA' TO FLNAPAK1;
                        MOVE 'KONEC' TO FLKONEC2;
                        EZEREPLY = 1;
                        EZEROLLB();
                      END;
                    END;                                /* slog v tab. Nsizdaje ne obstaja
                  ELSE;                                /* neuspešen repl izdaje
MOVE "Ažuriranje namena je neuspešno (IZDAJE)" MSG64;
                    MOVE 'NAPAKA' TO FLNAPAK1;
                    MOVE 'KONEC' TO FLKONEC2;
                    EZEREPLY = 1;
                    EZEROLLB();
                  END;
                ELSE;                                /* zadnji scan
                  MOVE 'KONEC' TO FLKONEC2;
                END;
              END;                                /* while
            ELSE;                                /* neuspešno èitanje za ažur. izdaje
MOVE "Èitanje za ažuriranje namena je neuspešno (IZDAJE)" MSG64;
              MOVE 'NAPAKA' TO FLNAPAK1;
              EZEREPLY = 1;
              EZEROLLB();
            END;
          END;                                /* izdaje ne obstajajo
        END;                                /* flnapak1
      ELSE;                                /* neuspešen repl prevzem 120
MOVE "Ažuriranje namena v dok. 120 je neuspešno (PREVZEM)" MSG64;
        MOVE 'NAPAKA' TO FLNAPAK1;
        EZEREPLY = 1;
        EZEROLLB();
      END;
    ELSE;                                /* neuspešno èitanje za ažur. prevzem
                                 /* 120
MOVE "Èitanje za ažur. namena dok.120  je neuspešno (PREVZEM)" MSG64;
      MOVE 'NAPAKA' TO FLNAPAK1;
      EZEREPLY = 1;
      EZEROLLB();
    END;
    IF FLNAPAK1 EQ ' ';
      MOVE "Spremenjen namen je zapisan v vseh dokumentih" TO MSG64;
      SET EN00M02.NAMEN PROTECT;
      SET EN00M02.VP CURSOR,BRIGHT;
      MOVE ' ' TO FLTIPKA4;      /* kontrola na f4 se ukine
      EZEREPLY = 1;
      EZECOMIT();
      MOVE EN00M02.NAMEN TO EN00W02.NAMEN; /* onemogoèi ponovni zapis s f5
    ELSE;                                /* napaka
      MOVE EN00M01.NAMEN TO EN00M02.NAMEN;
      SET EN00M02.NAMEN PROTECT;
/*      SET EN00M02.NAMEN CURSOR,BRIGHT;
    END;
  END;                                /* flnapak1;kontrola namena
ELSE;                                /* namen ni spremenjen
MOVE "Uporaba tipke f5 ni dovoljena, ker namen ni spremenjen" MSG64;
  MOVE 'NAPAKA' TO FLNAPAK1;
END;
:ebefore.
:efunc.

:func      name      = EN00S30           
           date      = '01/18/2011' time = '12:27:48' option = EXECUTE  
           desc      = 'repl.dok.127 delni storno'
           refine    = N  
:before.
MOVE EN00R07.STDOK TO EN00R16.VEZNIDOK;
MOVE EN00R07.POZDOK TO EN00R16.POZVEDOK;
MOVE EN00R07.IDENT TO EN00R16.IDENT;
MOVE EN00R07.MZ TO EN00R16.MZ;
MOVE EN00M01.FIRMA TO EN00R16.FIRMA;
EN00P29();                       /* update dok.127 v tabeli izdaje
IF EN00R16 NOT ERR;
  MOVE EN00R07.SKCENA TO EN00R16.SKCENA;
  EN00R16.SKVRED = EN00R16.KOLICINA * EN00R07.SKCENA; /* skcena iz r07!!!
  MOVE EN00R16.SKCENA TO EN00R16.NABCENA;
  MOVE EN00R16.SKVRED TO EN00R16.VREDNOST;
  TI00P99();
MOVE EN00W02.DATDOK TO EN00R16.DATNSTR;
/*  MOVE DA10CDAT TO EN00R16.DATNSTR;

  MOVE TI26CTIM TO EN00R16.DATURA;
  EN00P30();                      /* ažuriranje dok. 127
  IF EN00R16 NOT ERR;
  ELSE;
    MOVE 'NAPAKA' TO FLNAPAK1;
    MOVE 'KONEC' TO FLKONEC;
    MOVE "Ažuriranje odv.str.nabave pri izdajah je neuspešno" TO MSG64;
    EZEREPLY = 1;
    EZEROLLB();
  END;                                /* repl izdaje dok 127 delni storno
ELSE;
  MOVE 'NAPAKA' TO FLNAPAK1;
  MOVE 'KONEC' TO FLKONEC;
  MOVE "Èitanje za ažur. delni storno - IZDAJE je neuspešno" TO MSG64;
  EZEREPLY = 1;
  EZEROLLB();
END;                                /* update izdaje dok 127 delni storno
:ebefore.
:efunc.

:func      name      = MS00P99           
           date      = '05/22/2001' time = '07:47:44' option = EXECUTE  
           desc      = 'za sporoèila o napakah na ekr.'
           refine    = N  
:before.
; /* to je proces, ki ga v aplikacijah vkljuÈimo v primeru napake
; /* in sicer je za to potrebno:
; /* - imeti v ws polja:
;      /* - MSG78   cha/78 - celo sporoÈilo, ki gre v ezemsg
;      /* - MSG64   cha/64 - za tekstualni del sporoÈila
;      /* - MSGCOD  cha/11 - tekst ezesqcod: - ali sqlcode: -
;                         /* oz.   ezesqcod: + ali sqlcode: +
;      /* - MSG3    num/3  - Številka napake
; /* Ko pride do napake: move "tekst napake....." to ws.msg64
; /* in naredimo perform v ta proces, kjer sporoÈilo dopolnimo
; /* s kodo in ga tu poŠljemo na ekran ali v procesu od koder
; /* smo sem priŠli.
; /* PriporoÈljivo je v sporoÈilo vkljuÈiti tudi naziv tabele
; /* kjer je napaka nastala.
; /* ------------------------------------------------------------
IF MSGN31 NE 0;
  IF MSGN31 < 0;
    MOVE 'SQLCODE: -' TO MSGCOD;
    MSGN3 = MSGN31 * -1;
  ELSE;
    MOVE 'SQLCODE: +' TO MSGCOD;
    MOVE MSGN31 TO MSGN3;
  END;
  MOVE 0 TO MSGN31;
ELSE;
  IF EZESQCOD < 0;
    MOVE 'SQLCODE: -' TO MSGCOD;
    MSGN3 = EZESQCOD * -1;
  ELSE;
    MOVE 'SQLCODE: +' TO MSGCOD;
    MOVE EZESQCOD TO MSGN3;
  END;
END;
:ebefore.
:efunc.

:func      name      = TI00P99           
           date      = '05/22/2001' time = '07:47:45' option = EXECUTE  
           desc      = 'prenos timestamp'
           refine    = N  
:before.
MOVE EZEDTE TO DA6CDAT;          /* prenos sistemskega datuma num v char
                                 /* LLMMDD

IF DA6CLL = '98'
  OR DA6CLL = '99';

  MOVE '19' TO DAZZW01.DA10CL19;
ELSE;
  MOVE '20' TO DAZZW01.DA10CL19;
END;

MOVE DA6CLL TO DA10CLXX;         /* prenos num LL v char LL - drugi del
MOVE '-' TO DA10CDE1;
MOVE DA6CMM TO DA10CMM;          /* prenos num MM v char MM
MOVE '-' TO DA10CDE2;
MOVE DA6CDD TO DA10CDD;          /* prenos num DD v char DD
MOVE EZETIM TO TI8CTIM;          /* prenos HH:MM:SS
MOVE '-' TO DA10CDE3;
MOVE TI8CHH TO TI15CHH;
MOVE '.' TO TI15CPI1;
MOVE TI8CMM TO TI15CMIN;
MOVE '.' TO TI15CPI2;
MOVE TI8CSS TO TI15CSEK;
MOVE '.' TO TI15CPI3;
MOVE '000000' TO TI15CMSE;
:ebefore.
:efunc.

:func      name      = TIZZP90           
           date      = '01/23/2012' time = '11:35:42' option = EXECUTE  
           desc      = 'priprava za TIMESTAMP'
           refine    = N  
:before.
; /* *********************************************************
; /* To je proces za pripravo podatkov za timestamp polje v
; /* tabelah in se lahko standardno uporablja za vse tabele.
; /* Pred vpisom je potrebno s perform iti v ta proces in po
; /* povratku prenesti DAZZW01.TI26CTIM v polje je že spremenjen
; /* ==========================================================
MOVE EZEDTE TO DAZZW01.DA6CDAT;  /* sist.datum
MOVE EZETIM TO DAZZW01.TI15CTIM; /* sist.Èas
IF DA6CLL = '98'
OR DA6CLL = '99';

MOVE '19' TO DAZZW01.DA10CL19;
ELSE;
MOVE '20' TO DAZZW01.DA10CL19;
END;
MOVE DAZZW01.DA6CLL TO DAZZW01.DA10CLXX; /* letnica drugi par
MOVE DAZZW01.DA6CMM TO DAZZW01.DA10CMM; /* mesec
MOVE DAZZW01.DA6CDD TO DAZZW01.DA10CDD; /* dan
MOVE '000000' TO DAZZW01.TI15CMSE;      /* milisekunde
MOVE '-' TO DAZZW01.DA10CDE1;    /* pomišljaj
MOVE '-' TO DAZZW01.DA10CDE2;    /* pomišljaj
MOVE '-' TO DAZZW01.DA10CDE3;    /* pomišljaj
MOVE '.' TO DAZZW01.TI15CPI1;    /* pika
MOVE '.' TO DAZZW01.TI15CPI2;    /* pika
MOVE '.' TO DAZZW01.TI15CPI3;    /* pika
:ebefore.
:efunc.

:func      name      = TIZZP91           
           date      = '01/23/2012' time = '11:35:42' option = EXECUTE  
           desc      = 'priprava tekoÈega datuma'
           refine    = N  
:before.
; /* ********************************************************
; /* To je proces, ki pripravi tekoÈi datum za prenos v polje
; /* sloga, ki je datumskega tipa. Po izhodu iz procesa je po-
; /* trebno MOVE DA10CDAT to XYpolje.
; /* ---------------------------------------------------------
MOVE EZEDTE TO DAZZW01.DA8NDAT;  /* prenos v polje l=10,num

IF DA8NLLXX = 98 OR DA8NLLXX = 99;

  MOVE '19' TO DAZZW01.DA10CL19; /* prvi del letnice (19)
ELSE;
  MOVE '20' TO DAZZW01.DA10CL19;
END;
MOVE DA8NLLXX TO DAZZW01.DA10CLXX; /* drugi del letnice
MOVE '-' TO DAZZW01.DA10CDE1;    /* pomiŠljaj
MOVE DA8NMM TO DAZZW01.DA10CMM;  /* mesec
MOVE '-' TO DAZZW01.DA10CDE2;    /* pomiŠljaj
MOVE DA8NDD TO DAZZW01.DA10CDD;  /* dan
:ebefore.
:efunc.

:record    name      = DAZZW01
           date      = '01/23/2012'        time = '11:35:43'
           org       = WORKSTOR
           usage     = SHARED
:prol.
Skupni WS, ki ga uporabljamo za pretvorbe v razliÈne datum-
ske in Èasovne tipe polj na relaciji CSP - SQL ali SQL - CSP
Osnovna pravila oznaÈevanja polj v tem WS so :

x x x x x x x x x
--- --- - -------
 !   !  !    !
 !   !  !    ------> konÈnica - ime (LL,MM,DD,XX,19,HH,...)
 !   !  !
 !   !  -----------> oznaka tipa polja (C=char.,N=num.)
 !   !
 !   --------------> Številka dolŽine celega nivoja
 !
 ------------------> oznaka DA=datum,TI=Èas

===========================================================
