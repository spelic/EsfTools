:func      name      = EN00S17           
           date      = '03/10/2011' time = '11:15:41' option = EXECUTE  
           desc      = 'kontr.stdok prevzema,èe obsaja'
           refine    = N  
:before.
MOVE ' ' TO FLNAPAK2;
IF FLDRUGI1 EQ ' ';              /* edit rutina se ponovno obdela
  MOVE ' ' TO FLNAPAK1;
  IF EN00M01.STDOKP1 IS MODIFIED;
    IF EN00M01.SIFPREJE NE ' ';
      MOVE EN00M01.SIFPREJE TO EN00R11.SIFMZ;
      MOVE EN00M01.FIRMA TO EN00R11.FIRMA;
      EN00P25();                 /* inq. mestazad
      IF EN00R11 NOT ERR;
        MOVE EN00M01.STDOKP1 TO EN00R03.STDOKP;
        MOVE EN00M01.SIFPREJE TO EN00R03.MZ;
        MOVE EN00M01.FIRMA TO EN00R03.FIRMA;

        EN00P05();               /* inq.suma prevzem
        IF EN00R03 NOT ERR;
          MOVE EN00R03.KOMITENT TO EN00M01.KOMITENT;
          MOVE EN00R03.NAMEN TO EN00M01.NAMEN;
          MOVE EN00R03.STDOK TO EN00M01.STDOK1;
          MOVE EN00R03.SIFPREJE TO EN00M01.PREJEMNIK;

          MOVE EN00R03.SUMAVRED TO EN00M01.SUMAVRED;
          MOVE EN00R03.SUMAVRED TO EN00W02.SUMAVRED;
          MOVE EN00R03.KOMITENT TO EN00R09.KOMITENT;
          EN00P22();             /* inquiry komitent
          IF EN00R09 NOT ERR;
            MOVE EN00R09.KRNAZ TO EN00M01.KRNAZ;
            MOVE 'DRUGIC' FLDRUGI1; /* edit rutina se ne obdela dvakrat
            SET EN00M01.STDOKP1 MODIFIED;
          ELSE;
            MOVE "Dobavitelj s to šifro ne obstaja" TO MSG64;
            MOVE ' ' TO FLDRUGI1; /* edit rutina se ponovno obdela
          END;
        ELSE;                    /* Št.prevzema ne obstaja
          MOVE "Številka prevzema na skladišèu ne obstajaja" TO MSG64;
          MOVE 'NAPAKA' TO FLNAPAK2;
          MOVE ' ' TO FLDRUGI1;  /* edit rutina se ponovno obdela
        END;
      ELSE;
        MOVE "Šifra skladišèa je napaèna" TO MSG64;
        SET EN00M01.SIFPREJE CURSOR,BRIGHT;
        MOVE 'NAPAKA' TO FLNAPAK2;
        MOVE ' ' TO FLDRUGI1;    /* edit rutina se ponovno obdela
      END;
    ELSE;
      MOVE "Vnesi šifro skladišèa" TO MSG64;
      SET EN00M01.SIFPREJE CURSOR,BRIGHT;
      MOVE 'NAPAKA' TO FLNAPAK1;
      MOVE 'NAPAKA' TO FLNAPAK2;
      MOVE ' ' TO FLDRUGI1;      /* edit rutina se ponovno obdela
    END;
  ELSE;
    MOVE "Vnesi številko prevzema" TO MSG64;
    SET EN00M01.STDOKP1 CURSOR,BRIGHT;
    MOVE 'NAPAKA' TO FLNAPAK2;
    MOVE ' ' TO FLDRUGI1;        /* edit rutina se ponovno obdela
  END;
END;
