:func      name      = EN00S10           
           date      = '09/06/2001' time = '12:48:41' option = EXECUTE  
           desc      = 'kontrola obveznega vpisaNN'
           refine    = N  
:before.
MOVE ' ' TO MSG64;
MOVE ' ' TO FLNAPAK1;
IF FLTIPKA4 EQ ' ';              /* ni spremembe namena
  IF EN00M02.FAKTVRED EQ 0
    AND EN00M02.ODVSTRP1 EQ 0;
    MOVE "Vpiši fakturno vrednost ali odvisne stroške" TO MSG64;
    SET EN00M02.FAKTVRED CURSOR,BRIGHT;
    MOVE 'NAPAKA' TO FLNAPAK1;
  END;
  IF EN00M02.VP EQ ' ';
    MOVE "Vnesi vrsto prometa" TO MSG64;
    SET EN00M02.VP CURSOR,BRIGHT;
    MOVE 'NAPAKA' TO FLNAPAK1;
  END;
ELSE;                                /* namen je spremenjen
  SET EN00M02.NAMEN PROTECT,BRIGHT;
  IF EN00M02.NAMEN NE EN00W02.NAMEN;
    IF EN00M02.NAMEN EQ '1'
      OR EN00M02.NAMEN EQ '2'
      OR EN00M02.NAMEN EQ '3'
      OR EN00M02.NAMEN EQ '4'

      OR EN00M02.NAMEN EQ ' ';
      MOVE "Pritisni tipko F5 za spremembo namena" TO MSG64;
    ELSE;
      MOVE "Spremenjen namen je napaèen" TO MSG64;
      SET EN00M02.NAMEN NORMAL;
      SET EN00M02.NAMEN CURSOR,BRIGHT;
      MOVE 'NAPAKA' TO FLNAPAK1;
    END;
  END;
END;
:ebefore.
