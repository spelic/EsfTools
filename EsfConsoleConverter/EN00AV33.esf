:func      name      = EN00S24           
           date      = '06/21/2001' time = '13:59:01' option = EXECUTE  
           desc      = 'clear mape'
           refine    = N  
:before.
MOVE 1 TO VRSTICA;
WHILE VRSTICA <= MAPSIZE;
  MOVE 0 TO EN00M01.IDENT[VRSTICA];
  MOVE 0 TO EN00M01.POZDOK[VRSTICA];
  MOVE ' ' TO EN00M01.OZNAKANS[VRSTICA];
  MOVE ' ' TO EN00M01.NAZIV[VRSTICA];
  VRSTICA = VRSTICA + 1;
END;
