:func      name      = EN00P42           
           date      = '01/18/2011' time = '12:05:40' option = EXECUTE  
           desc      = 'DODAJA V PREDELAVAVEZE'
           refine    = N  
:before.
IF EN00W02.PRENOS = 'NE';        /* zapis za dok 120
  MOVE EN00R892.TEKSTEV TO EN00R90.TEKSTEV;
ELSE;
  
END;
EN00F71();
EN00W02.A = 1;
MOVE 0 TO EN00W02.STPOZICIJA;    /* ÈITA CE JE PREVZEM ŽE BIL PRODAN  SEETINQ  R90
IF EZESQCOD = 0;

  WHILE EZESQCOD = 0;
    EN00F72();                   /* SCAN R90
    IF EZESQCOD = 0;


      IF EN00W02.A = 1;
        MOVE EN00R90.TEKSTEV TO EN00R155.TEKSTEV;

        EN00F99();               /* èita maksimalno stpozicijo;


        MOVE EN00R155.POZICIJA TO EN00W02.STPOZICIJA;
        MOVE 0 TO EN00W02.A;
      ELSE;
      END;
      EN00W02.STPOZICIJA = EN00W02.STPOZICIJA + 1;
      MOVE EN00W02.STPOZICIJA TO EN00R91.POZICIJA;
/***************************************************************/
/* SPREMEMBA 18.1.2010
/***************************************************************/
 IF EN00R90.DATUMF > EN00W02.DATDOK;
MOVE EN00R90.DATUMF TO EN00R91.DATUMF;
ELSE;
 MOVE EN00W02.DATDOK TO EN00R91.DATUMF;
END;
/***************************************************************/
/*
/***************************************************************/

      MOVE EN00R90.VD TO EN00R91.VD;
      MOVE 122 TO EN00R91.VD1;
      MOVE EN00W02.LETOM TO EN00W02.LEN22;
      MOVE EN00W02.LEN11 TO EN00R91.LETOF;
      MOVE EN00R90.STFAKTUR TO EN00R91.STFAKTUR;
MOVE EN00R90.POZFA TO EN00R91.POZFA;
      IF EN00W02.PRENOS = 'NE';  /* zapis za dok 120
        MOVE EN00R892.FIRMA TO EN00R91.FIRMA;
      ELSE;
        MOVE EN00R892.FIRMA TO EN00R91.FIRMA;
      END;
      MOVE EN00R90.TEKSTEV TO EN00R91.TEKSTEV;
      MOVE EN00R24.FIRMA2 TO EN00R91.FIRMA2;
      MOVE 0 TO EN00R91.KOLICINA;
      MOVE EN00R90.KOMITENT TO EN00R91.KOMITENT;
      EN00R91.VREFAKT = 0;       /* cena samo naknadnega str
      EN00R91.VREMAT = EN00R90.KOLICINA * EN00R24.CENAMAT; /* cena samo naknadnega str

/*      IF EN00M01.POLJE4 = 'S';   /* vedno ostali stroški
/*        EN00R91.VREDSTRO = EN00R90.KOLICINA * EN00R24.CENAMAT; /* /
/*
/*        MOVE 'O' TO EN00R91.NP;
/*      ELSE;
/*      END;
 IF EN00M01.POLJE4 = 'S' AND EN00M01.STATUSN = 'D'; /* ostali stroški
        EN00R91.VREDSTRO = EN00R90.KOLICINA * EN00R24.CENAMAT; /* /  dodala 28.10.2008

        MOVE 'O' TO EN00R91.NP;
      ELSE;
      END;
      IF EN00M01.POLJE4 = 'S' AND EN00M01.STATUSN = 'N'; /* stroški po osnovni fakturi
        EN00R91.VREDSTRF = EN00R90.KOLICINA * EN00R24.CENAMAT; /* /

        MOVE 'F' TO EN00R91.NP;
      ELSE;
      END;

      IF EN00M01.POLJE4 = 'P' AND EN00M01.STATUSN = 'D'; /* ostali stroški
        EN00R91.VREDSTRO = EN00R90.KOLICINA * EN00R24.CENAMAT; /* /

        MOVE 'O' TO EN00R91.NP;
      ELSE;
      END;
      IF EN00M01.POLJE4 = 'P' AND EN00M01.STATUSN = 'N'; /* stroški po osnovni fakturi
        EN00R91.VREDSTRF = EN00R90.KOLICINA * EN00R24.CENAMAT; /* /

        MOVE 'F' TO EN00R91.NP;
      ELSE;
      END;
MOVE EN00R04.POZVEDOK TO EN00R91.POZFA;
      MOVE EN00W01.ZAPRIIM TO EN00R91.VPISAL;
      MOVE EN00R90.FIRMA2 TO EN00R91.FIRMA2;

/* **************************************************************/
/* polnjenje strm
/* **************************************************************/
      IF EN00W02.PRENOS = 'NE';  /* zapis za dok 120
        MOVE EN00R892.STRM TO EN00R91.STRM;
      ELSE;
        MOVE EN00R892.STRM TO EN00R91.STRM;
      END;
/* MOVE EN00R24.STRM TO EN00R91.STRM;  spremenila 9.5.20087

/* **************************************************************/
/* konec
/* **************************************************************/

      EN00F73();                 /* doda naknadne str èe je že bil prevzem že prodan
      IF EZESQCOD = 0;

      ELSE;
        MOVE "NAPAKA PRI add R91 NAKNADNEGA STROŠKA KO JE BIL PREVZEM ŽE PRODAN " EN00M01.EZEMSG;
        MOVE 'NE' TO FLOK3;
      END;
    ELSE;
      IF EZESQCOD = 100;
      ELSE;
        MOVE "NAPAKA PRI SCAN F72 R90 ÈITANJU PRODAJNE VEZE " EN00M01.EZEMSG;
        MOVE 'NE' TO FLOK3;
      END;
    END;
  END;                           /* ZA WHILE
ELSE;
  IF EZESQCOD = 100;
  ELSE;
    MOVE "NAPAKA PRI SETINQ ÈITANJU VEZE PRODAJNE FAKTURE " EN00M01.EZEMSG;
    MOVE 'NE' TO FLOK3;
  END;
END;
:ebefore.
:efunc.

