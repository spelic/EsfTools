:func      name      = EN00S20           
           date      = '06/21/2001' time = '13:59:01' option = EXECUTE  
           desc      = 'prenos slogov na mapo M01'
           refine    = N  
:before.
MOVE 1 TO VRSTICA;               /* Števec vrstic na mapi
WHILE VRSTICA <= MAPSIZE;
  IF EN00W02.START1 <= EN00W02.RECDCOUN;
    MOVE EN00W03.POZDOK[START1] TO EN00M01.POZDOK[VRSTICA];
    MOVE EN00W03.IDENT[START1] TO EN00M01.IDENT[VRSTICA];
    MOVE EN00W03.NAZIV[START1] TO EN00M01.NAZIV[VRSTICA];
    MOVE EN00W03.OZNAKANS[START1] TO EN00M01.OZNAKANS[VRSTICA];
    VRSTICA1 = VRSTICA + 1;
    START1 = START1 + 1;
  ELSE;                                /* v ws ni veÈ vrstic
    MOVE 10 TO VRSTICA;
  END;
  VRSTICA = VRSTICA + 1;         /* pozicija sloga na mapi
END;                                /* while
LASTBOT = START1 - 1;            /* zadnja vrstica mape
IF LASTBOT < RECDCOUN;           /* v ws so še slogi
  MOVE 'F8-NAPREJ' TO EN00M01.NAPREJ;
ELSE;
  MOVE ' ' TO EN00M01.NAPREJ;
END;
IF START1 > 10;
  MOVE 'F7-NAZAJ' TO EN00M01.NAZAJ;
ELSE;
  MOVE ' ' TO EN00M01.NAZAJ;
END;
SET EN00M01.IDENT[1] CURSOR,BRIGHT;
IF VRSTICA1 < MAPSIZE;
  EN00S26();                     /* protect vrstiz za sloge na mapi
ELSE;
END;
:ebefore.
:efunc.

:func      name      = EN00S21           
           date      = '06/21/2001' time = '13:59:01' option = EXECUTE  
           desc      = 'listanje nazaj'
           refine    = N  
:before.
LASTTOP = LASTTOP - MAPSIZE;     /* prva pozicija predhodne mape
IF LASTTOP <= 0;                 /* prva mapa
  MOVE 1 TO LASTTOP;             /* zaèetna pozicija za prikaz na mapi
ELSE;
  MOVE LASTTOP TO START1;        /* zaèetna pozicija za prikaz na mapi
END;
:ebefore.
:efunc.

