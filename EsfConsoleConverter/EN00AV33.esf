MOVE EN00R07.STDOK TO EN00R14.VEZNIDOK; /* stdok izdaje
MOVE EN00R07.POZDOK TO EN00R14.POZVEDOK; /* pozicija izdaje
MOVE ' ' TO EN00R14.OZNSTORN;
MOVE '3' TO EN00R14.INDP;        /* indikator za fakturo
MOVE EN00M01.POLJEDO1 TO EN00R14.POLJEDOK; /* Številka fakture
MOVE EN00R07.DN TO EN00R14.DN;   /* delovni nalog
MOVE EN00R07.SIFIZDAJ TO EN00R14.SIFIZDAJ;
MOVE EN00R07.KONTO TO EN00R14.KONTO;
MOVE EN00R07.NAMEN TO EN00R14.NAMEN;
MOVE EN00M01.NAMEN TO EN00R14.NAMEN;

TI00P99();                       /* timestamp
MOVE EN00W02.DATDOK TO EN00R14.DATDOK;
/* **************************************************************/
/* zapisuje za mesec nazaj v zalnamis
/* **************************************************************/
/* **************************************************************/
/* dodano 27.01.2011
/* **************************************************************/

IF EN00R07.DATDOK < EN00W02.DATDOK OR
  EN00R07.DATDOK = EN00W02.DATDOK;
  MOVE EN00W02.DATDOK TO EN00R14.DATDOK;





/* **************************************************************/
/* konec za datum naknadni str za mesec nazaj
/* **************************************************************/

  IF ZAPIS = 'DA';               /* èe je knjiženje za pretekli mesec zalnamis
    SET EN00R32 EMPTY;
    MOVE EN00R14.FIRMA TO EN00R32.FIRMA;
    MOVE EN00R14.MZ TO EN00R32.MZ;
    MOVE EN00R14.NAMEN TO EN00R32.NAMEN;
    MOVE EN00M01.PREJEMNIK TO EN00R32.SIFPREJE;
    MOVE EN00R14.IDENT TO EN00R32.IDENT;
    MOVE EN00R14.DATDOK TO EN00R32.DATDOK;
    EN00P93();                   /* èita zalnamis da doda vrednost

    IF EZESQCOD = 0;
      EN00R32.VREDNOST = EN00R32.VREDNOST - EN00R14.SKVRED;

      EN00P95();                 /* sprememba r32 zalnamis
      IF EZESQCOD = 0;
      ELSE;
        MOVE 'NAPAKA' TO FLNAPAK1;

        MOVE 'KONEC' TO FLKONEC;

/* napaka
      END;

    ELSE;

      IF EZESQCOD = 100;
        MOVE EN00R14.FIRMA TO EN00R32.FIRMA;
        MOVE EN00R14.MZ TO EN00R32.MZ;
        MOVE EN00R14.NAMEN TO EN00R32.NAMEN;
        MOVE EN00M01.PREJEMNIK TO EN00R32.SIFPREJE;
        MOVE EN00R14.IDENT TO EN00R32.IDENT;
        MOVE EN00R14.DATDOK TO EN00R32.DATDOK;
/*        MOVE EN00R14.SKVRED TO EN00R32.VREDNOST;
        EN00R32.VREDNOST = EN00R32.VREDNOST - EN00R14.SKVRED;
        EN00P96();               /* doda v zalnamis vrednost

        IF EZESQCOD = 0;
        ELSE;
          MOVE 'NAPAKA' TO FLNAPAK1;


          MOVE 'KONEC' TO FLKONEC;
/* napaka
        END;

      ELSE;
        MOVE 'NAPAKA' TO FLNAPAK1;
        MOVE 'KONEC' TO FLKONEC;



/* napaka
      END;
    END;
  ELSE;
  END;

ELSE;
  MOVE EN00R07.DATDOK TO EN00R14.DATDOK; /* ne piše zaloge in da datdo
END;

