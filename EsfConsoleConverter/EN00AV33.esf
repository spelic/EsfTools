:func      name      = EN00S11           
           date      = '06/21/2001' time = '13:59:00' option = EXECUTE  
           desc      = 'konverzija meseca za indpren'
           refine    = N  
:before.
IF DA10CMM EQ '01';
  MOVE '1' TO EN00W02.INDPREN;
ELSE;
  IF DA10CMM EQ '02';
    MOVE '2' TO EN00W02.INDPREN;
  ELSE;
    IF DA10CMM EQ '03';
      MOVE '3' TO EN00W02.INDPREN;
    ELSE;
      IF DA10CMM EQ '04';
        MOVE '4' TO EN00W02.INDPREN;
      ELSE;
        IF DA10CMM EQ '05';
          MOVE '5' TO EN00W02.INDPREN;
        ELSE;
          IF DA10CMM EQ '06';
            MOVE '6' TO EN00W02.INDPREN;
          ELSE;
            IF DA10CMM EQ '07';
              MOVE '7' TO EN00W02.INDPREN;
            ELSE;
              IF DA10CMM EQ '08';
                MOVE '8' TO EN00W02.INDPREN;
              ELSE;
                IF DA10CMM EQ '09';
                  MOVE '9' TO EN00W02.INDPREN;
                ELSE;
                  IF DA10CMM EQ '10';
                    MOVE 'A' TO EN00W02.INDPREN;
                  ELSE;
                    IF DA10CMM EQ '11';
                      MOVE 'B' TO EN00W02.INDPREN;
                    ELSE;
                      IF DA10CMM EQ '12';
                        MOVE 'C' TO EN00W02.INDPREN;
                      END;
                    END;
                  END;
                END;
              END;
            END;
          END;
        END;
      END;
    END;
  END;
END;
