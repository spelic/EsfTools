MOVE IN72M01.STATUS_PREMIJE TO IN72R13.STATUS_PREMIJE;
MOVE IN72M01.STATUS_CENE_LME TO IN72R13.STATUS_CENE_LME;

MOVE IN72M01.LME TO IN72R13.LME;
IF IN72M01.STATCENE = 'Z';
  MOVE IN72M01.POS TO IN72R13.PREMIJA;
ELSE;
  MOVE IN72M01.PREMIJA TO IN72R13.PREMIJA;
END;
/* **************************************************************/
/* konec
/* **************************************************************/

/* **************************************************************/
/* dodala za statistiko
/* **************************************************************/

MOVE 'N' TO IN72R13.STATUS_ZZI_STAT;
MOVE IN72M01.DRZODPREME TO IN72R13.DRZ_ODP_SIFRA3;
MOVE IN72M01.DRZPOREKLA TO IN72R13.DRZ_POR_SIFRA3;
/* **************************************************************/
/* konec za statistiko
/* **************************************************************/

MOVE 'PREVZEM' TO IN72R13.OPOMBE;
MOVE 'PREVZEM' TO IN72R13.DN;
MOVE 'K' TO IN72R13.NACIN_PREVZEMA;
MOVE 3 TO IN72R13.ID_NABSPREVZEM_TIP;
IN72R13.VREDNOST = IN72M01.CENAM * IN72M01.KOLICM; /* še preveriti
MOVE IN72M01.STDOBAV TO IN72R13.DOB_DOBAV;

MOVE IN72W01.IDZAPST TO IN72R13.IDZAPST;
MOVE IN72W01.IDZAPST TO IN72R0014.IDZAPST;
IN72P0025();                     /* èita tt_oseba za usr
MOVE IN72R0014.LDAP_UID TO IN72R13.OSEBA_ZADNJE_SPREMEMBE;


MOVE IN72M01.ID_SKUS_ASI TO IN72R13.ID_SKUS_ASI;
MOVE IN72M01.ST_CERT TO IN72R13.ST_CERT;

MOVE IN72M01.POZNARO TO IN72R13.POZNARO;
MOVE 0 TO IN72R13.DOBAVA;
MOVE 0 TO IN72R13.TEZABRUT;
/* MOVE IN72M01.UECLIMP TO IN72R13.UECLIMP;
MOVE 0 TO IN72R13.KOLPREVZ;
MOVE IN72M01.EM TO IN72R13.EM;
MOVE IN72M01.NAZIV TO IN72R13.NAZIV;
MOVE IN72M01.IDENT TO IN72R13.IDENT;
MOVE IN72M01.LETO TO IN72R13.LETON;
IF IN72M01.ID_SKUS_ASI  > 0;
MOVE IN72M01.KOLICM TO IN72R13.KOLPREVZ;
ELSE;
END;
MOVE IN72M01.KOLICM TO IN72R13.KOLICINA;
MOVE IN72M01.KOLICM TO IN72R13.KOLICINA_KG;
MOVE IN72M01.CENAM TO IN72R13.CENA;
MOVE DAZZW01.TI26CTIM TO IN72R13.DATURA;
MOVE 1 TO IN72R13.STATUS;
IF DA8NLLXX = 99;
  MOVE 19 TO IN72W02.LEN2;
ELSE;
  MOVE 20 TO IN72W02.LEN2;
END;
MOVE DA8NLLXX TO IN72W02.LEN3;
MOVE IN72W02.LEN1 TO IN72R13.LETO;
MOVE DAZZW01.DA10CDAT TO IN72R13.DATPREVZ;
