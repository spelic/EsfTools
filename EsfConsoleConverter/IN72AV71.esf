:func      name      = IN72P61           
           date      = '08/31/2021' time = '08:56:58' option = EXECUTE  
           desc      = 'RAZKNJIŽEVANJE PREDELAVE'
           refine    = N  
:before.



/* **************************************************************/
/* zaèetek
/* **************************************************************/



MOVE 'DA' TO FLOK6;
SET IN72R33 EMPTY;
/* MOVE in72M01.FIRMA TO in72R32.FIRMA2;
/* MOVE in72M01.FIRMA TO in72R32.FIRMA2;
/*
/* MOVE in72R01.DATUM TO in72W05.DATUMEC; /* >>>>>>dodano --------------27.02.2008
/*
/* IF in72W05.MMC = 1 OR in72W05.MMC = 3 OR in72W05.MMC = 5 OR in72W05.MMC = 7 OR in72W05.MMC = 8 OR in72W05.MMC = 10 OR in72W05.MMC = 12;
/* in72W05.DDC = 31;
/* ELSE;
/* in72W05.DDC = 30;
/* IF in72W05.MMC = 2 AND (in72W05.LLC = 2008 OR in72W05.LLC = 2012 OR in72W05.LLC = 2016 OR in72W05.LLC = 2020 OR in72W05.LLC = 2024);
/* MOVE 29 TO in72W05.DDC;
/*
/* ELSE;
/* MOVE 28 TO in72W05.DDC;
/* END;
/* END;

/* **************************************************************/
/* nastavim parameter za knjiženje interne eksterne surovine za tlm   8.4.2016     1 interno,2 eksterno odpremljeno slo, 3 eksterno ni odpremljeno slo
/* **************************************************************/
MOVE 0 TO IN72W07.POSTOPEK;      /* postopek 1
IF IN72M01.KOMITENT = '47251000' AND IN72M01.NAMEN = '8'; /* impol tlm vrnjen izdelek   glavni

/* **************************************************************/
/* zaèetek za brame iz TLM 30.3.2020 -Breda
/* **************************************************************/


  SET IN72R340 EMPTY;
  MOVE IN72M01.KOMITENT TO IN72R340.PREDELOVALEC;
  MOVE IN72M01.SIFPREJE TO IN72R340.STRM;
  IN72P650();                    /* èita   kakšem je prvi prevzem za razknjižiti za najmajnši datum

  IF EZESQCOD = 0;
    SET IN72R320 EMPTY;          /* preverja vp po prvem  prevzemu VP ?
    MOVE IN72M01.KOMITENT TO IN72R320.PREDELOVALEC;
    MOVE IN72M01.SIFPREJE TO IN72R320.STRM;
    MOVE IN72R340.VP TO IN72R320.VP; /* èita za doloèen vp skupno kolièino 99 al 22


    IN72P640();                  /* èita najprej za vhodni vp   èita sumo za vhodni vp 99 ali 22
    IF EZESQCOD = 0;             /* 1 vp
      IF (IN72R320.PROSTO >= IN72M01.KOLICM); /* prosto > 0 ***
        IF IN72R320.VP = '22';   /* vp 22   nastavim prviè postopek
          MOVE 1 TO IN72W07.POSTOPEK;
        ELSE;                    /* vp22
        END;                     /* vp22
        IF IN72R320.VP = '99';   /* vp99
          MOVE 2 TO IN72W07.POSTOPEK; /* nastavim prviè postopek
        ELSE;                    /* vp99
        END;                     /* vp99

      ELSE;                      /* prosto > 0   prviè ******   premala kolièina za prviè
        MOVE IN72R320.VP TO IN72W07.VP;
        SET IN72R320 EMPTY;      /* preverja vp po prvem  prevzemu VP ?
        IF IN72W07.VP = '22';    /* nastavim drugi vp
          MOVE '99' TO IN72R320.VP;
        END;
        IF IN72W07.VP = '99';    /* nastavim 2 vp
          MOVE '22' TO IN72R320.VP;
        END;
        MOVE IN72M01.KOMITENT TO IN72R320.PREDELOVALEC;
        MOVE IN72M01.SIFPREJE TO IN72R320.STRM;
        IN72P640();              /* è   èita sumo za  2  vp vhod
        IF EZESQCOD = 0;

          IF (IN72R320.PROSTO >= IN72M01.KOLICM); /* prosto > 0  za drugi VP

            IF IN72R320.VP = '22'; /* vp 22
              MOVE 1 TO IN72W07.POSTOPEK; /* nastavim drugiè  postopek
            ELSE;                /* vp22
            END;                 /* vp22
            IF IN72R320.VP = '99'; /* vp99
              MOVE 2 TO IN72W07.POSTOPEK; /* nastavim druigiè postopek
            ELSE;                /* vp99
            END;                 /* vp99
          ELSE;                  /* za prosto 2 vp


          END;                   /* konec za prosto 2 vp


        ELSE;
          MOVE "Napaka pri  sumiranju bram za èitan 2 VP " TO IN72M01.EZEMSG;
          EZEREPLY = 0;
          EZEROLLB();
          MOVE 'NE' TO FLOK6;
          MOVE EZESQCOD TO IN72M01.KODA;

        END;

      END;                       /* prosto >0

    ELSE;                        /* 1 vp

      MOVE "Napaka pri  sumiranju bram za èitan 1 VP " TO IN72M01.EZEMSG;
      EZEREPLY = 0;
      EZEROLLB();
      MOVE 'NE' TO FLOK6;
      MOVE EZESQCOD TO IN72M01.KODA;

    END;                         /* 1 vp


  ELSE;
    MOVE "Napaka pri  preverjanju kolièine za razknjiževanje " TO IN72M01.EZEMSG;
    EZEREPLY = 0;
    EZEROLLB();
    MOVE 'NE' TO FLOK6;
    MOVE EZESQCOD TO IN72M01.KODA;
  END;
END;
/* **************************************************************/
/* konec   ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
/* **************************************************************/


/* **************************************************************/
/* KONEC ZA BRAME IZ tvt
/* **************************************************************/



MOVE '01' TO IN72R32.FIRMA;      /* DA VEDNO GRE RAZKNJIŽEVATI IMPOLSKO PREDELAVO DODALA BREDA

RA3 = IN72M01.KOLICM;

RA4 = RA3;
T1 = 0;
T2 = 0;
T3 = 0;
IN72W07.POS_SUM = 0;             /* DODALA 23.6.2015 ***********************
IN72W07.POS_POVPRECJE = 0;       /* DODALA 23.5.2015*************************
IN72W07.OST_STROSKI_POVPRECJE = 0; /* DODALA9.6.2020*************************
IN72W07.OST_STROSKI_SUM = 0;     /* DODALA 9.6.2020 ************************

IN72W07.PREMIJA_SUM = 0;
IN72W07.LME_SUM = 0;
IN72W07.PREMIJA_POVPRECJE = 0;
IN72W07.LME_POVPRECJE = 0;
IN72W07.CENA_POVPRECJE = 0;
IN72W07.INDIKATOR_CENA = 0;      /* èe je indikator 0 pomeni da je Konèna cena K , èe je idikator 1 pomeni da je  Z  zaèasna cena-.  DODELATI********

IF IN72M01.KOMITENT = '47251000' AND IN72M01.NAMEN = '8' AND IN72W07.POSTOPEK > 0; /* DOBIMO DRUGI SEZNAM
  IF IN72W07.POSTOPEK = 1;
    MOVE IN72M01.KOMITENT TO IN72R32.PREDELOVALEC;
    MOVE IN72M01.SIFPREJE TO IN72R32.STRM;
    MOVE '22' TO IN72R32.VP;
    IN72P643();                  /* setinq predelavaimp-iz tlm interne brame
  ELSE;
  END;

  IF IN72W07.POSTOPEK = 2;
    MOVE IN72M01.KOMITENT TO IN72R32.PREDELOVALEC;
    MOVE IN72M01.SIFPREJE TO IN72R32.STRM;
    MOVE '99' TO IN72R32.VP;
/* MOVE 1 TO IN72R32.ODPREMA_SLO;
    IN72P644();                  /* setinq predelavaimp-tlm eksterne brame odpremljeni iz slovenije
  ELSE;
  END;

  IF IN72W07.POSTOPEK = 3;
    MOVE IN72M01.KOMITENT TO IN72R32.PREDELOVALEC;
    MOVE IN72M01.SIFPREJE TO IN72R32.STRM;
    MOVE '99' TO IN72R32.VP;
    MOVE 2 TO IN72R32.ODPREMA_SLO;
    IN72P645();                  /* setinq predelavaimp-tlm eksterne brame niso odpremljeni iz slovenijeELSE;
  END;



ELSE;
END;

IF FLOK6 = 'DA' AND IN72W07.POSTOPEK = 0; /* POMENI VSE OK NI TLM
  MOVE IN72M01.KOMITENT TO IN72R32.PREDELOVALEC;
  MOVE IN72M01.SIFPREJE TO IN72R32.STRM;
  IN72P64();                     /* setinq predelavaimp-redno-sort datum
ELSE;

END;



IF EZESQCOD = 0;
  IN72P65();                     /* scan
  IF EZESQCOD = 0;

    WHILE T1 = 0 AND FLOK6 = 'DA';
      IF IN72R32.PROSTO >= RA3;
