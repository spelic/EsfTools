:func      name      = IN72P0022         
           date      = '06/15/2022' time = '11:37:50' option = EXECUTE  
           refine    = N  
:before.
IF EZEAID IS ENTER AND
  IN72M01.ORGEN IS MODIFIED;

  IF IN72M01.POZDOK = 1;
/* **************************************************************/
/* dodala 26.8.2014
/* **************************************************************/

    IF IN72M01.ORGEN = '011';    /* LIVNICA
      MOVE '01001' TO IN72M01.SIFPREJE;
      MOVE '11' TO IN72M01.FIRMA3;
    ELSE;
      IF IN72M01.ORGEN = '012';  /* LIVNICA
        MOVE '01201' TO IN72M01.SIFPREJE;
        MOVE '11' TO IN72M01.FIRMA3;



      ELSE;
        IF IN72M01.ORGEN = '018'; /* LIVNICA
          MOVE '01801' TO IN72M01.SIFPREJE;
          MOVE '11' TO IN72M01.FIRMA3;

        ELSE;
          IF IN72M01.ORGEN = '021'; /* LIVNICA
            MOVE '02201' TO IN72M01.SIFPREJE;
            MOVE '02' TO IN72M01.FIRMA3;

          ELSE;
            IF IN72M01.ORGEN = '031'; /* LIVNICA
              MOVE '02501' TO IN72M01.SIFPREJE;
              MOVE '02' TO IN72M01.FIRMA3;

            ELSE;
              IF IN72M01.ORGEN = '041'; /* LIVNICA
                MOVE '03301' TO IN72M01.SIFPREJE;
                MOVE '03' TO IN72M01.FIRMA3;

              ELSE;
                IF IN72M01.ORGEN = '051'; /* LIVNICA
                  MOVE '03201' TO IN72M01.SIFPREJE;
                  MOVE '03' TO IN72M01.FIRMA3;

                ELSE;
                  IF IN72M01.ORGEN = '034'; /* LIVNICA
                    MOVE '03401' TO IN72M01.SIFPREJE;
                    MOVE '03' TO IN72M01.FIRMA3;

                  ELSE;
                    IF IN72M01.ORGEN = '035'; /* LIVNICA
                      MOVE '03501' TO IN72M01.SIFPREJE;
                      MOVE '03' TO IN72M01.FIRMA3;

                    ELSE;
                      MOVE ' ' TO IN72M01.SIFPREJE;
                    END;
                  END;
                END;
              END;
            END;
          END;
        END;
      END;
    END;


    IF IN72M01.FIRMAVEZA = '11';
      MOVE 'D' TO IN72M01.ZAPIS1;
    ELSE;
      MOVE 'N' TO IN72M01.ZAPIS1;
    END;


    MOVE IN72M01.FIRMA TO IN72R17.FIRMA;
    MOVE IN72M01.SIFPREJE TO IN72R17.SIFMZ;


    IN72P80();
    IF IN72R17 IS ERR;
      MOVE ' TA ŠIFRA PREJEMNIKA NE OBSTAJA VPIŠI PRAVILNO ORG.ENOTO' TO IN72M01.EZEMSG;

      MOVE ' ' TO IN72M01.SIFPREJE;
      SET IN72M01.ORGEN CURSOR,MODIFIED,BRIGHT;
      MOVE '                                   ' TO IN72M01.NAZIVP;

      MOVE 9999 TO EZEMNO;
    ELSE;

      MOVE IN72R17.NAZIVMZ TO IN72M01.NAZIVP;
      SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;

    END;
  ELSE;                          /* drugaèe polni  nazaj iz prejemnika prve pozicije
    IF IN72M01.SIFPREJE = '01001'; /* LIVNICA
      MOVE '011' TO IN72M01.ORGEN;
      MOVE '11' TO IN72M01.FIRMA3;
/* MOVE 'D' TO IN72M01.ZAPIS1;
    END;
    IF IN72M01.SIFPREJE = '01801'; /* KASTER
      MOVE '018' TO IN72M01.ORGEN;
      MOVE '11' TO IN72M01.FIRMA3;
/* MOVE 'D' TO IN72M01.ZAPIS1;
    END;
    IF IN72M01.SIFPREJE = '02201'; /* VALJARNA
      MOVE '021' TO IN72M01.ORGEN;
      MOVE '02' TO IN72M01.FIRMA3;
/* MOVE 'N' TO IN72M01.ZAPIS1;
    END;
    IF IN72M01.SIFPREJE = '02501'; /* FOLISKA
      MOVE '031' TO IN72M01.ORGEN;
      MOVE '02' TO IN72M01.FIRMA3;
/* MOVE 'N' TO IN72M01.ZAPIS1;
    END;
    IF IN72M01.SIFPREJE = '03301'; /* PROFILI
      MOVE '041' TO IN72M01.ORGEN;
      MOVE '03' TO IN72M01.FIRMA3;
/* MOVE 'N' TO IN72M01.ZAPIS1;
    END;
    IF IN72M01.SIFPREJE = '03201'; /* cevarna sprejema pa za livnico da na predelavo
      MOVE '051' TO IN72M01.ORGEN;
      MOVE '03' TO IN72M01.FIRMA3;
/* MOVE 'D' TO IN72M01.ZAPIS1;
    END;
    IF IN72M01.SIFPREJE = '03401'; /* PROFILI
      MOVE '034' TO IN72M01.ORGEN;
      MOVE '03' TO IN72M01.FIRMA3;
/* MOVE 'N' TO IN72M01.ZAPIS1;
    END;
IF IN72M01.SIFPREJE = '03501'; /* PROFILI
      MOVE '035' TO IN72M01.ORGEN;
      MOVE '03' TO IN72M01.FIRMA3;
