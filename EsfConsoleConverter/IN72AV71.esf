:func      name      = IN72S08           
           date      = '08/31/2021' time = '08:56:59' option = EXECUTE  
           desc      = 'edit rutina na vp'
           refine    = N  
:before.
;  /* edit rutina na VP
; /* **********************
IF IN72M01.VP NE IN72W02.VP;
  MOVE IN72M01.VP TO IN72R06.SIFRAVP;
  MOVE IN72M01.VP TO IN72W02.VP;
  IN72P18();                      /* èita VP
  IF IN72R06 IS ERR;
    MOVE "VP ne obstaja" TO IN72M01.EZEMSG;
    SET IN72M01.VP CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
    MOVE '  ' TO IN72W02.VP;
  ELSE;
    IF IN72W01.SDOK = '120';
      IF IN72M01.VP = '07'
        OR IN72M01.VP = '08'
        OR IN72M01.VP = '84';
;        /* SET IN72M01.VP PROTECT,BRIGHT;
      ELSE;
        MOVE "Napaèen VP : 07, 08 ali 84" TO IN72M01.EZEMSG;
        SET IN72M01.VP CURSOR,MODIFIED,BRIGHT;
        MOVE '  ' TO IN72W02.VP;
        MOVE 'NE' TO FLOK1;      /* glava ni v redu
      END;
    END;
    IF IN72W01.SDOK = '134';
      IF IN72M01.VP = '42';
;        /* SET IN72M01.VP PROTECT,BRIGHT;
      ELSE;
        MOVE 'NE' TO FLOK1;      /* glava ni v redu
        MOVE "Napaèen VP : 42" TO IN72M01.EZEMSG;
        SET IN72M01.VP CURSOR,MODIFIED,BRIGHT;
        MOVE '  ' TO IN72W02.VP;
      END;
    ELSE;
      IF IN72W01.SDOK = '192';
        IF IN72M01.VP = '24'
          OR IN72M01.VP = '22';
;          /* SET IN72M01.VP PROTECT,BRIGHT;
        ELSE;
          MOVE 'NE' TO FLOK1;    /* glava ni v redu
          MOVE "Napaèen VP :(24 ali 22)" TO IN72M01.EZEMSG;
          SET IN72M01.VP CURSOR,MODIFIED,BRIGHT;
          MOVE '  ' TO IN72W02.VP;
        END;
      END;
    END;
  END;
END;
