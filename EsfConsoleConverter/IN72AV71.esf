:func      name      = IN72P0012         
           date      = '08/31/2021' time = '08:56:57' option = EXECUTE  
           desc      = 'ažurira dokumente z  nabavno c'
           refine    = N  
:before.
IF FLOK6 = 'DA';                 /* f1
  SET IN72R008 EMPTY;
  MOVE IN72R34.STFAKTUR TO IN72R008.STDOK;
  MOVE IN72R34.POZFA TO IN72R008.POZDOK;
  MOVE IN72M01.IDENT TO IN72R008.IDENT;
  MOVE '10020' TO IN72R008.MZ;
  MOVE '01' TO IN72R008.FIRMA;
  IN72P0013();                   /* update prevzema prevzemn
  IF EZESQCOD = 0;               /* f2
    MOVE IN72M01.CENAP TO IN72R008.NABCENA;
    MOVE IN72M01.CENAP TO IN72R008.SKCENA;
    IN72R008.VREDNOST = IN72M01.CENAP * IN72M01.KOLICM;
    IN72R008.SKVRED = IN72M01.CENAP * IN72M01.KOLICM;
    IN72P0014();                 /* replace prevzema impolskega vrednostno


    IF EZESQCOD = 0;             /* f3
      IF IN72M01.STATUS = 1;     /* status 1 knjiženje tekoèe leto   - izdaje obstajajo drugaèe ne obstajajo
        SET IN72R0011 EMPTY;
        MOVE IN72R008.STDOK TO IN72R0011.VEZNIDOK;
        MOVE IN72R008.POZDOK TO IN72R0011.POZVEDOK;
        MOVE IN72R008.MZ TO IN72R0011.MZ;
        MOVE IN72R008.FIRMA TO IN72R0011.FIRMA;
        MOVE IN72R008.IDENT TO IN72R0011.IDENT;
        IN72P0017();             /* update izdaje impol ano na predelavo
      ELSE;
      END;


      IF EZESQCOD = 0;           /* F4
        IF IN72M01.STATUS = 1;   /* status 1 knjiženje tekoèe leto   - izdaje obstajajo drugaèe ne obstajajo
          MOVE IN72M01.CENAP TO IN72R0011.NABCENA;
          MOVE IN72M01.CENAP TO IN72R0011.SKCENA;
          IN72R0011.VREDNOST = IN72M01.CENAP * IN72R0011.KOLICINA;
          IN72R0011.SKVRED = IN72M01.CENAP * IN72R0011.KOLICINA;
          IN72P0018();           /* REPLACE IZDAJE IMPOLSKE  DANE NA PERDELAVO

        ELSE;
        END;


        IF EZESQCOD = 0;         /* F5
          SET IN72R009 EMPTY;
          MOVE IN72R34.STFAKTUR TO IN72R009.STDOK;
          MOVE IN72R34.POZFA TO IN72R009.POZDOK;
          MOVE IN72M01.IDENT TO IN72R009.IDENT;
          MOVE 120 TO IN72R009.VD;
          MOVE '01' TO IN72R009.FIRMA;
          MOVE IN72R34.LETOF TO IN72R009.LETOD;
          IN72P0015();           /* zaklene predelavaimp
          IF EZESQCOD = 0;       /* F6
            IF IN72W07.POSTOPEK = 1;
              MOVE 0 TO IN72R009.KOLICINA;
              MOVE 0 TO IN72R009.PROSTO;

            ELSE;
              MOVE IN72M01.CENAP TO IN72R009.CENAMAT;
              MOVE IN72M01.CENAP TO IN72R009.SKCENA;
/* IN72R009.VREMAT = IN72M01.CENAP * IN72R0011.KOLICINA;     ++**************************************************************  do 13.2.2018
              IN72R009.VREMAT = IN72M01.CENAP * IN72R009.KOLICINA; /* ž
/***************************************************************/
/*dodala 9.6.2020 knjiži ostali strošek iz namena 2
/***************************************************************/

              IF IN72M01.NAMEN = '8';
                IN72R009.CENASTRO = IN72W07.OST_STROSKI_POVPRECJE; /* dodala  stroli ostali na enoto kg  ki so nastali na namenu2 -poslano  na predelavo material
              ELSE;
              END;
/***************************************************************/
/*  konec 9.6.2020
/***************************************************************/


            END;
            IN72P0016();         /* */ spremeni vrednosti na predelavaimp
            IF EZESQCOD = 0;     /* F7
              SET IN72R0012 EMPTY;
              MOVE IN72R34.STFAKTUR TO IN72R0012.STDOK; /* številka dokument prevzema namena 8
              MOVE IN72R34.POZFA TO IN72R0012.POZDOK;
              MOVE IN72M01.IDENT TO IN72R0012.IDENT;
/* MOVE '01' TO IN72R0012.FIRMA;
              MOVE IN72R34.LETOF TO IN72R0012.LETO;
              MOVE '10020' TO IN72R0012.MZ;
              IN72P0019();       /* */ zaklena mnpromet
              IF EZESQCOD = 0;   /* F8
                MOVE IN72M01.CENAP TO IN72R0012.CENA;
                IN72R0012.PREMIJASTREUR = IN72W07.POS_POVPRECJE + IN72M01.POS; /* DODALA 23.6.2015 *********************************

                IF IN72W07.INDIKATOR_CENA_PREMIJA = 0 AND IN72M01.STATUS_PREMIJE = 'K';
                  IN72R0012.PREMIJA = IN72W07.PREMIJA_POVPRECJE + IN72M01.PREMIJA;
                ELSE;
                  IN72R0012.PREMIJA = IN72W07.PREMIJA_POVPRECJE + IN72M01.POS;
                END;


                MOVE IN72W07.LME_POVPRECJE TO IN72R0012.LME;

                IF IN72W07.INDIKATOR_CENA_LME = 0 AND IN72M01.STATUS_CENE_LME = 'K'; /* STATUSCENE 0 PRIDE Z KONÈNO CENO VSEH INGOTOV   ÈE JE SSTATUS VENE 1 JE ŽE ZACASNA CENA
                  MOVE 'K' TO IN72R0012.STATUS_CENE_LME;
                ELSE;
                  MOVE 'Z' TO IN72R0012.STATUS_CENE_LME;
                END;

                IF IN72W07.INDIKATOR_CENA_PREMIJA = 0 AND IN72M01.STATUS_PREMIJE = 'K';
                  MOVE 'K' TO IN72R0012.STATUS_PREMIJE;
                ELSE;
                  MOVE 'Z' TO IN72R0012.STATUS_PREMIJE;
                END;

                IF IN72W07.INDIKATOR_CENA = 0 AND IN72M01.STATCENE = 'K';
                  MOVE 'K' TO IN72R0012.STATCENE;
                ELSE;
                  MOVE 'Z' TO IN72R0012.STATCENE;
                END;

                IF IN72R0012.STATCENE = 'K';
                  MOVE IN72R0012.CENA TO IN72R0012.POG_CENA;
                ELSE;
                END;

                IN72P0020();     /* spremeni mnpromet

              ELSE;
                MOVE 'NE' TO FLOK6;
              END;               /* f8
            ELSE;
              MOVE 'NE' TO FLOK6;
            END;                 /* f7
          ELSE;
            MOVE 'NE' TO FLOK6;
          END;                   /* f6
        ELSE;
          MOVE 'NE' TO FLOK6;
        END;                     /* f5
      ELSE;
        MOVE 'NE' TO FLOK6;
      END;                       /* f4
    ELSE;
      MOVE 'NE' TO FLOK6;
    END;                         /* f3
  ELSE;                          /* f2
    MOVE 'NE' TO FLOK6;
  END;                           /* f2

ELSE;
END;                             /* f1



IF FLOK6 = 'DA' AND IN72W07.POSTOPEK = 1; /* razknjiževanje dodelave na  impol ft RAZKNJIŽUJE DANO NA DODELAVO INTERNO

  IN72P6111();



ELSE;
END;

IF FLOK6 = 'DA';


ELSE;
END;
:ebefore.
:efunc.

