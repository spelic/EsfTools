:func      name      = IN72P56           
           date      = '08/31/2021' time = '08:56:58' option = EXECUTE  
           desc      = 'PRIPRAVA ZA ADD PREDELAVED'
           refine    = N  
:before.
IF FLOK3 = 'DA';
  IN72P58();                     /* ZAKLENE BERE IMPARAM ZA TEKSTEV  R31

  IF IN72R31 IS ERR;
    MOVE "NAPAKA PRI ZAKLEPANJU IMPARAM DODELAVA IMPOL "
      IN72M01.EZEMSG;
    MOVE 'NE' TO FLOK3;
  ELSE;

    IN72R31.PAR1 = IN72R31.PAR1 + 1;
    IN72P59();                   /* SPREMENI IMPARAM ZA PAR1 = TEKSTEV
    IF IN72R31 IS ERR;
      MOVE "NAPAKA PRI SPREMEMBITEKSTEV DODELAVA IMPOL " IN72M01.EZEMSG;
      MOVE 'NE' TO FLOK3;
    ELSE;
    END;

  END;

  IF FLOK3 = 'DA';

    MOVE IN72R31.PAR1 TO IN72R24.TEKSTEV;
    MOVE IN72R26.ZAPSTEV TO IN72R24.ZAPSTEV;
    MOVE IN72M01.FIRMA TO IN72R24.FIRMA;
    IF IN72M01.FIRMAVEZA = IN72M01.FIRMA3;
      MOVE IN72M01.FIRMAVEZA TO IN72R24.FIRMA2;
    ELSE;
      MOVE IN72M01.FIRMA3 TO IN72R24.FIRMA2;
    END;
    MOVE 120 TO IN72R24.VD;

    MOVE IN72W02.LEN1 TO IN72R24.LETOD;
    MOVE IN72M01.STDOK TO IN72R24.STDOK;
    MOVE IN72M01.POZDOK TO IN72R24.POZDOK;
    MOVE IN72M01.SIFPREJE TO IN72R24.STRM;
    MOVE IN72M01.KOLICM TO IN72R24.KOLICINA;
    MOVE IN72M01.KOLICM TO IN72R24.PROSTO;
    MOVE IN72M01.IDENT TO IN72R24.IDENT;
    MOVE IN72M01.NAMEN TO IN72R24.NAMEN;
    MOVE IN72M01.KOMITENT TO IN72R24.DOBAVITELJ;

    MOVE IN72M01.CENAM TO IN72R24.CENAMAT;
MOVE IN72M01.CENAM TO IN72R24.SKCENA;

    IN72R24.VREMAT = IN72M01.KOLICM * IN72M01.CENAM;
    MOVE IN72W01.ZAPRIIM TO IN72R24.VPISAL;

  ELSE;
  END;

ELSE;
END;
