:func      name      = IN72P86           
           date      = '08/31/2021' time = '08:56:58' option = EXECUTE  
           desc      = 'DODAJA ZA CARINO'
           refine    = N  
:before.
IF FLOK5 = 'DA';
  SET IN72R35 EMPTY;
  SET IN72R36 EMPTY;
  SET IN72R37 EMPTY;
  SET IN72R38 EMPTY;
  SET IN72R39 EMPTY;
  SET IN72R40 EMPTY;
  MOVE IN72M01.FIRMA TO IN72R35.FIRMA1;
  MOVE IN72M01.FIRMA3 TO IN72R35.FIRMA2;
  MOVE IN72M01.ORGEN TO IN72R35.PROGENOT;
  MOVE IN72M01.POREKLO TO IN72R35.POREKLO;
  MOVE IN72M01.KOLICM TO IN72R35.KOLICINA;
  MOVE IN72M01.CENAM TO IN72R35.CENA;
  IN72R35.VREDNOST = IN72M01.CENAM * IN72M01.KOLICM;
  MOVE IN72M01.PREVZEM TO IN72R35.SIFSKL;
  MOVE IN72M01.STDOK TO IN72R35.STDOK;
  MOVE IN72R26.ZAPSTEV TO IN72R35.ZAPSTEV;
  MOVE IN72M01.POZDOK TO IN72R35.POZICIJA;
/* **************************************************************/
/* konverzacija VD iz char v Num
/* **************************************************************/
  MOVE IN72M01.VD TO IN72W04.VD;
  MOVE IN72W04.VD2 TO IN72R35.VD;
  MOVE IN72M01.NAMEN TO IN72W04.NAMEN;
  MOVE IN72W04.NAMEN1 TO IN72R35.NAMEN;
  MOVE IN72M01.VP TO IN72R35.VP;
  MOVE IN72M01.SIFPREJE TO IN72R35.STRM;
  MOVE IN72M01.IDENT TO IN72R35.IDENT;
  MOVE IN72M01.LETO TO IN72R35.LETOS;
  MOVE IN72M01.STNAROC TO IN72R35.STNAROCS;
  MOVE IN72M01.KOMITENT TO IN72R35.DOBAVITELJ;
  MOVE IN72M01.POZNARO TO IN72R35.POZNAROS;
  MOVE IN72W01.ZAPRIIM TO IN72R35.IME;
  MOVE IN72W02.LEN1 TO IN72R35.LETO;
MOVE DAZZW01.TI26CTIM TO IN72R35.DATURAVHO;
MOVE DAZZW01.DA10CDAT TO IN72R35.DATUM;
/* **************************************************************/
/* add
/* **************************************************************/
  IN72P87();                     /* DODAJA V CAR_VHODSUR ADD
  IF EZESQCOD = 0;
    MOVE IN72R35.DATUM TO IN72R36.DATUM;
    MOVE IN72R35.FIRMA1 TO IN72R36.FIRMA1;
    MOVE IN72R35.FIRMA2 TO IN72R36.FIRMA2;

    MOVE IN72R35.POREKLO TO IN72R36.POREKLO;
    MOVE 1 TO IN72R36.VRSTASTANJA;
    IN72P88();                   /* èita stanje porekla za carino  r36
    IF EZESQCOD = 0;             /* DODAJA
      MOVE IN72R35.DATUM TO IN72R37.DATUM;
      MOVE IN72R35.FIRMA1 TO IN72R37.FIRMA1;
      MOVE IN72R35.FIRMA2 TO IN72R37.FIRMA2;
      MOVE IN72R35.POREKLO TO IN72R37.POREKLO;
      MOVE 1 TO IN72R37.VRSTASTANJA;
      IN72P89();                 /* zaklene  stanje porekla za carino  r37

      IF EZESQCOD = 0;
/* **************************************************************/
/* polni za spremembo staNJA ZA CARINO
/* **************************************************************/
        IN72R37.KOLPREVZ = IN72R37.KOLPREVZ + IN72R35.KOLICINA;
        IN72R37.VREPREVZ = IN72R37.VREPREVZ + IN72R35.VREDNOST;
        IN72R37.IME = IN72R35.IME;

        IN72P19();               /* spremeni stanje surovine za carino R37
        IF EZESQCOD = 0;
        ELSE;
          MOVE 'NE' TO FLOK5;
          MOVE "Napaka pri spremembi stanja za carino " IN72M01.EZEMSG;
          MOVE EZESQCOD TO IN72M01.KODA;
        END;
      ELSE;
        MOVE 'NE' TO FLOK5;
        MOVE "Napaka pri zaklepanju stanja za carino " IN72M01.EZEMSG;
        MOVE EZESQCOD TO IN72M01.KODA;
      END;
    ELSE;
      IF EZESQCOD = 100;
/* **************************************************************/
/* ÈE ŠE ZA TEKOÈI DATUM NI ZAPISA
/* **************************************************************/
        MOVE IN72R35.FIRMA1 TO IN72R38.FIRMA1;
        MOVE IN72R35.FIRMA2 TO IN72R38.FIRMA2;
        MOVE IN72R35.POREKLO TO IN72R38.POREKLO;
        MOVE 1 TO IN72R38.VRSTASTANJA;
        IN72P74();               /* INQ MAKSIMALNI DATU ZA ZALOGO PO KLJUÈU
        IF EZESQCOD = 0;
          MOVE IN72R35.FIRMA1 TO IN72R39.FIRMA1;
          MOVE IN72R35.FIRMA2 TO IN72R39.FIRMA2;
          MOVE IN72R35.POREKLO TO IN72R39.POREKLO;
          MOVE 1 TO IN72R39.VRSTASTANJA;
          MOVE IN72R38.DATUM TO IN72R39.DATUM;
          IN72P75();             /* èita celoten slog po maksimalnem datumu
          IF EZESQCOD = 0;
            MOVE IN72R35.FIRMA1 TO IN72R40.FIRMA1;
            MOVE IN72R35.FIRMA2 TO IN72R40.FIRMA2;
            MOVE IN72R35.POREKLO TO IN72R40.POREKLO;
            MOVE 1 TO IN72R40.VRSTASTANJA;
            MOVE IN72R39.KOLKS TO IN72R40.KOLZS;
            MOVE IN72R39.VREKS TO IN72R40.VREZS;
            IN72R40.KOLPREVZ = IN72R35.KOLICINA;
            IN72R40.VREPREVZ = IN72R35.VREDNOST;
            MOVE IN72R35.IME TO IN72R40.IME;
            IN72P76();           /* ADD R50 STANJE CAEINA
            IF EZESQCOD = 0;
            ELSE;
              MOVE 'NE' TO FLOK5;
              MOVE "Napaka pri dodajanju sloga za stanje carine " IN72M01.EZEMSG;
              MOVE EZESQCOD TO IN72M01.KODA;
            END;
          ELSE;
            MOVE 'NE' TO FLOK5;
            MOVE "Napaka pri èitanju  celotnega sloga za max.datuma " IN72M01.EZEMSG;
            MOVE EZESQCOD TO IN72M01.KODA;
          END;
        ELSE;
          MOVE 'NE' TO FLOK5;
          MOVE "Napaka pri èitanju  max.datuma za zalogo carina " IN72M01.EZEMSG;
          MOVE EZESQCOD TO IN72M01.KODA;
        END;

/* **************************************************************/
/* KONEC
/* **************************************************************/
      ELSE;
        MOVE 'NE' TO FLOK5;
        MOVE "Napaka pri èitanju stanja surovine za carino " IN72M01.EZEMSG;
        MOVE EZESQCOD TO IN72M01.KODA;
      END;
    END;
  ELSE;
