:func      name      = IN72S13           
           date      = '05/23/2024' time = '12:16:15' option = EXECUTE  
           desc      = 'RUTINA NA poz NAROÈILA'
           refine    = N  
:before.
IF EZEAID IS ENTER AND
  IN72M01.POZNARO IS MODIFIED;
  SET IN72R15 EMPTY;

/* **************************************************************/
/* indikatorji 0 = zaèasna cena ' 1 -konèna cena dodala 13.5.2014
/* **************************************************************/

/* IN72W07.INDIKATOR_CENA_LME = 0;
/* IN72W07.INDIKATOR_CENA_PREMIJA = 0;
/* IN72W07.INDIKATOR_CENA = 0;
  MOVE 0 TO IN72M01.CENAP;
  MOVE ' ' TO IN72M01.ST_CERT;
  MOVE ' ' TO IN72M01.OPIS;
  MOVE ' ' TO IN72M01.OPIS2;
  MOVE 0 TO IN72M01.ID_SKUP_ASI_NIVO_2;
  MOVE 0 TO IN72M01.ID_SKUS_ASI;
  MOVE 0 TO IN72M01.ID_SKUS_ASI_NIVO_2;

  MOVE IN72M01.POZNARO TO IN72W02.STPOZNAR;
  MOVE IN72M01.LETO TO IN72W02.LETONARO;
  MOVE IN72M01.STNAROC TO IN72W02.STNAROC;
  MOVE IN72W02.STPOZNAR TO IN72R15.POZNARO;
  MOVE IN72W02.LETONARO TO IN72R15.LETO;
  MOVE IN72W02.STNAROC TO IN72R15.STNAROC;
  IN72P42();
  IF IN72R15 IS ERR;
    MOVE ' TO NAROÈILO NE OBSTAJA' TO IN72M01.EZEMSG;

    MOVE 00 TO IN72M01.POZNARO;
    SET IN72M01.POZNARO CURSOR,MODIFIED,BRIGHT;
    MOVE '                                   ' TO IN72M01.NAZIV;
    MOVE '                  ' TO IN72M01.NAZIVDI;
    MOVE 0 TO IN72M01.EM;

    MOVE '    ' TO IN72M01.KRNAZEM;

    MOVE '                                   ' TO IN72M01.NAZIVNAR;
    MOVE 0 TO IN72M01.IDENT;
    MOVE 0 TO IN72M01.KOLICM;
    MOVE 0 TO IN72M01.CENAM;


    MOVE 9999 TO EZEMNO;
  ELSE;

/* **************************************************************/
/* dodala 15.10.2014
/* **************************************************************/


    IF IN72R15.PROIZVAJALEC = ' ' OR IN72R15.PROIZVAJALEC IS NULL;   dodala 23.5.2024
    ELSE;
      MOVE IN72R15.PROIZVAJALEC TO IN72M01.PROIZVAJALEC; /* DALA PROIZVAJALCA NA POZICIJO MAPE
    END;



    IN72W02.KOLICINA10P = 0;
    IN72W02.KOLICINA10 = 0;
    IN72W02.KOLICINA5T = 0;
    MOVE IN72M01.LETO TO IN72R0015.LETO;
    MOVE IN72M01.STNAROC TO IN72R0015.STNAROC;

    IN72P0027();                 /* èita dobavljeno na celi pogodbi  r0015
    IN72W02.KOLICINA10P = (IN72R0015.KOLICINA / 10); /* 10 proc od naroèene kolièine
    IN72W02.KOLICINA10 = ((IN72R0015.KOLICINA / 10) + IN72R0015.KOLICINA); /* kolièina z 10 proc
    IN72W02.KOLICINA5T = IN72R0015.KOLICINA + 5; /* kolièina plus 10 ton
    IF IN72W02.KOLICINA10P > 5;
      IN72W02.KOLKONTROLA = IN72W02.KOLICINA10;
    ELSE;
      IN72W02.KOLKONTROLA = IN72W02.KOLICINA5T;
    END;
/* **************************************************************/
/* konec
/* **************************************************************/



    IF (IN72R15.STATUS > 0) AND ((IN72W02.KOLKONTROLA > IN72R0015.KOLPREVZ) OR (IN72W02.KOLKONTROLA = IN72R0015.KOLPREVZ)); /* AND IN72R15.STATUS < 8 - prej preverjala tudi status  od 15.10.2014 se preverja 5 t ali 10 procentov
      MOVE IN72R15.IDENT TO IN72M01.IDENT;
/* MOVE IN72R15.PROGENOT TO IN72M01.ORGEN;
      MOVE IN72R15.PROGENOT TO IN72M01.ORGENP;
      IF IN72M01.POZDOK = 1;
        MOVE IN72R15.PROGENOT TO IN72M01.ORGEN;
/* **************************************************************/
/* dodala 26.8.2014
/* **************************************************************/

        IF IN72M01.ORGEN = '011'; /* LIVNICA
          MOVE '01001' TO IN72M01.SIFPREJE;
          MOVE '11' TO IN72M01.FIRMA3;


        END;
        IF IN72M01.ORGEN = '160'; /* impol final
          MOVE '16001' TO IN72M01.SIFPREJE;
          MOVE '03' TO IN72M01.FIRMA3;


        END;

        IF IN72M01.ORGEN = '018'; /* LIVNICA
          MOVE '01801' TO IN72M01.SIFPREJE;
          MOVE '11' TO IN72M01.FIRMA3;

        END;
        IF IN72M01.ORGEN = '021'; /* LIVNICA
          MOVE '02201' TO IN72M01.SIFPREJE;
          MOVE '02' TO IN72M01.FIRMA3;

        END;
        IF IN72M01.ORGEN = '031'; /* LIVNICA
          MOVE '02501' TO IN72M01.SIFPREJE;
          MOVE '02' TO IN72M01.FIRMA3;

        END;
        IF IN72M01.ORGEN = '041'; /* LIVNICA
          MOVE '03301' TO IN72M01.SIFPREJE;
          MOVE '03' TO IN72M01.FIRMA3;

        END;
        IF IN72M01.ORGEN = '051'; /* LIVNICA
          MOVE '03201' TO IN72M01.SIFPREJE;
          MOVE '03' TO IN72M01.FIRMA3;

        END;
        IF IN72M01.ORGEN = '034'; /* LIVNICA
          MOVE '03401' TO IN72M01.SIFPREJE;
          MOVE '03' TO IN72M01.FIRMA3;

        END;
        IF IN72M01.ORGEN = '035'; /* LIVNICA
          MOVE '03501' TO IN72M01.SIFPREJE;
          MOVE '03' TO IN72M01.FIRMA3;

        END;


        IF IN72M01.FIRMAVEZA = '11';
          MOVE 'D' TO IN72M01.ZAPIS1;
        ELSE;
          MOVE 'N' TO IN72M01.ZAPIS1;
        END;


        MOVE IN72M01.FIRMA TO IN72R17.FIRMA;
        MOVE IN72M01.SIFPREJE TO IN72R17.SIFMZ;


        IN72P80();
        IF IN72R17 IS ERR;
          MOVE ' TA ŠIFRA PREJEMNIKA NE OBSTAJA VPIŠI PRAVILNO ORG.ENOTO' TO IN72M01.EZEMSG;
          MOVE ' ' TO IN72M01.FIRMA3;
          MOVE ' ' TO IN72M01.SIFPREJE;
          SET IN72M01.ORGEN CURSOR,MODIFIED,BRIGHT;
          MOVE '                                   ' TO IN72M01.NAZIVP;

          MOVE 9999 TO EZEMNO;
        ELSE;

          MOVE IN72R17.NAZIVMZ TO IN72M01.NAZIVP;


        END;
      ELSE;
      END;


/* **************************************************************/
/* konec
/* **************************************************************/
/* **************************************************************/
/* dodala 11.3.2021  4.6.2021 èita asi  4.5.2022 DODAJALA
/* **************************************************************/
      IF IN72R15.ID_SKUS_ASI > 0 OR IN72R15.ID_SKUS_ASI = 0;
/* MOVE IN72R15.ID_SKUS_ASI TO IN72R0055.ID_SKUS_ASI;   izloèila 25.4.2022
        MOVE IN72R15.ID_SKUP_ASI_NIVO_2 TO IN72R0055.ID_SKUP_ASI_NIVO_2;
        IN72P0055();             /* èita opis za asi

        MOVE IN72R0055.ID_SKUS_ASI TO IN72M01.ID_SKUS_ASI;
        MOVE IN72R0055.OPIS TO IN72M01.OPIS2;
        MOVE IN72R0055.ID_SKUS_ASI_NIVO_2 TO IN72M01.ID_SKUS_ASI_NIVO_2;
        MOVE IN72R0055.ID_SKUP_ASI_NIVO_2 TO IN72M01.ID_SKUP_ASI_NIVO_2;

        MOVE IN72R0055.OPIS1 TO IN72M01.OPIS;
      ELSE;
      END;

/* IF IN72R15.ID_SKUS_ASI > 1 OR IN72R15.ID_SKUS_ASI = 0;
/* MOVE IN72R55.ID_SKUS_ASI TO IN72R0056.ID_SKUS_ASI;
/* IN72P0056();             /* èita opis za asi
/* MOVE IN72R15.ID_SKUS_ASI TO IN72M01.ID_SKUS_ASI;
/* MOVE IN72R0056.OPIS TO IN72M01.OPIS;
/* ELSE;
/* END;

/*  
/*  
/* **************************************************************/
/* konec
/* **************************************************************/



      MOVE IN72R15.KOLPREVZ TO IN72M01.KOLPREVZ;
      MOVE IN72R15.DRZPOR TO IN72M01.DRZPOREKLA;
      SET IN72R005 EMPTY;
      MOVE IN72R15.DRZPOR TO IN72R005.SIFRA3;
      IN72P009();
      MOVE IN72R005.NAZIVDR TO IN72M01.NDRZPOREKLA;
      MOVE IN72R15.BLAGO TO IN72M01.POREKLO;
/* MOVE IN72R15.NAZIV1 TO IN72M01.NAZIVNAR;
/* MOVE IN72R15.NAZIV2 TO IN72M01.NAZIVNAR2;

      MOVE '                                   ' TO IN72M01.NAZIV;
      MOVE '                  ' TO IN72M01.NAZIVDI;
      MOVE 0 TO IN72M01.EM;

      MOVE '    ' TO IN72M01.KRNAZEM;
      MOVE IN72R15.IDNAMEN TO IN72W02.IDNAMEN;
      MOVE IN72R15.TARIFCA TO IN72W02.TARIFAC;
      IF IN72R15.EM = 23;

        KOLEM = IN72R15.KOLICINA * 1000;
        MOVE KOLEM TO IN72M01.KOLICM;
        MOVE IN72R15.STATCENE TO IN72M01.STATCENE;
      ELSE;

        MOVE IN72R15.KOLICINA TO IN72M01.KOLICM;
        MOVE IN72R15.STATCENE TO IN72M01.STATCENE;
      END;
/* IF IN72W02.SIFVAL32 = '111';
/* **************************************************************/
/* CENA JE SIT  IZLOÈILA 27.3.2014
/* **************************************************************/

/* IF IN72W02.SIFVAL32 = '978'; /*
/* IF IN72R15.EM1 = 23;
/* CENAEM = IN72R15.CENAN / 1000;
/*  
/* MOVE CENAEM TO IN72M01.CENAM;
/*  
/* ELSE;
/* MOVE IN72R15.CENAN TO IN72M01.CENAM;
/* END;
/*  
/* ELSE;
/* **************************************************************/
/* 12.3.2014
/* **************************************************************/


/* IF IN72W02.SIFVAL32 = '111' OR IN72W02.SIFVAL32 = '705';
/* IF IN72R15.EM1 = 23;
/* CENASLT = IN72R15.CENAN / 239,640 (R; /* * IN72W02.TECAJ; DOBIMO EVRE IZ TOLARJEVI
/* CENAEM = CENASLT / 1000;
/* MOVE CENAEM TO IN72M01.CENAM;
/* ELSE;
/* CENASLT = IN72R15.CENAN / 239,640 (R;
/* MOVE CENASLT TO IN72M01.CENAM; /* CENASLT JE CENA V EVRIH
/* END;
/* ELSE;
/* IF IN72R15.EM1 = 23;
/* CENASLT = IN72R15.CENAN / IN72W02.TECAJ (R; /* teèaj iz glave na dan )
/* CENAEM = CENASLT / 1000;
/* MOVE CENAEM TO IN72M01.CENAM;
/* ELSE;
/* CENASLT = IN72R15.CENAN / IN72W02.TECAJ (R;
/* MOVE CENASLT TO IN72M01.CENAM;
/* END;
/*  
/* END;
/* **************************************************************/
/* 12.3.2014
/* **************************************************************/


/* END;
/* **************************************************************/
/* KONEC IZRAÈUN CENE
/* **************************************************************/

/* **************************************************************/
/* dodala za prenovo Nabave 17.5.2013,  7.3.2014-bREDA  za izraèun cene prevzema
/* **********************************;****************************/



      IF IN72R15.STATUS_CENE_LME = 'Z';
        IF IN72R15.LMEOP ^= 4;
          SET IN72R003 EMPTY;
          MOVE IN72W07.DATDOK TO IN72R003.DATUM;
/* MOVE DAZZW01.DA10CDAT TO IN72R003.DATUM; /* sqluser.wsdelo where sifra=2 (breda Zidovnik)    sistemski datum
          MOVE 1 TO IN72R003.DNI; /* odštejem od datuma da dobim datum za iskanje lme na doloèen datum
          IN72P006();            /* SQLEXEC   R003
          IN72P007();            /* INQ  datuma za vhod v sqluser.koledar_lme

          SET IN72R004 EMPTY;

          MOVE IN72R15.LETO TO IN72R004.LETO;
          MOVE IN72R15.STNAROC TO IN72R004.STNAROC;
          MOVE IN72R15.POZNARO TO IN72R004.POZNARO;
          MOVE IN72R003.DATUM TO IN72R004.DATUM;

          IN72P008();            /* èita lme koledar naroèilo ......  r004

          WHILE EZESQCOD = 100;
/* IN72R003.DNI = IN72R003.DNI + 1; /* odštejem od datuma da dobim datum za iskanje lme na doloèen datum
            IN72P006();          /* SQLEXEC   R003
            IN72P007();          /* INQ  datuma za vhod v sqluser.koledar_lme
            MOVE IN72R15.LETO TO IN72R004.LETO;
            MOVE IN72R15.STNAROC TO IN72R004.STNAROC;
            MOVE IN72R15.POZNARO TO IN72R004.POZNARO;
            MOVE IN72R003.DATUM TO IN72R004.DATUM;

            MOVE 1 TO IN72R004.TIP_LME;
            MOVE 1 TO IN72R004.LMEOP;

            MOVE IN72R15.STNAROC TO IN72R004.STNAROC;

            IN72P008();          /* èita lme koledar naroèilo ......  r004
          END;
          IN72M01.LME = (IN72R004.VREDNOST * 1000);


          IN72M01.POS = (IN72R15.PREMIJASTREUR);
          MOVE IN72R004.NAB_CENA TO IN72M01.CENAM;
          MOVE 'Z' TO IN72M01.STATCENE;
          MOVE IN72R15.STATUS_CENE_LME TO IN72M01.STATUS_CENE_LME;
          MOVE IN72R15.STATUS_PREMIJE TO IN72M01.STATUS_PREMIJE;

        ELSE;                    /* ko je namen 8 predelava
          MOVE 0 TO IN72M01.CENAM; /* ko je predelava ,ker je izraèun cene naknadno pri razlnjiževanju predelavaimp

        END;                     /* lme  je 4 predelava
        MOVE IN72R15.STATUS_PREMIJE TO IN72M01.STATUS_PREMIJE;
        MOVE IN72R15.STATCENE TO IN72M01.STATCENE;
        MOVE IN72R15.STATCENE TO IN72M01.STATCENE;
        MOVE IN72R15.STATUS_CENE_LME TO IN72M01.STATUS_CENE_LME;
        IN72M01.POS = (IN72R15.PREMIJASTREUR);


      ELSE;
/* **************************************************************/
/* ko je cenalme konèna
/* **************************************************************/



        IN72M01.POS = (IN72R15.PREMIJASTREUR);
        IN72M01.PREMIJA = IN72R15.PREMIJAVAL / IN72R15.TECAJPREMIJA (R;
        IN72M01.LME = IN72R15.CENALME / IN72R15.TECAJPREMIJA (R;
        MOVE IN72R15.STATUS_PREMIJE TO IN72M01.STATUS_PREMIJE;
        MOVE IN72R15.STATCENE TO IN72M01.STATCENE;
        MOVE IN72R15.STATUS_CENE_LME TO IN72M01.STATUS_CENE_LME;


        IF IN72M01.NAMEN = '8' AND IN72R15.LMEOP = 4; /* ;
          MOVE 0 TO IN72M01.CENAM;
        ELSE;
          IF IN72M01.STATUS_PREMIJE = 'K';
            IN72M01.CENAM = ((IN72M01.LME + (IN72R15.PREMIJAVAL / IN72R15.TECAJPREMIJA)) / 1000); /* KO NI PREDELAVA
          ELSE;
            IN72M01.CENAM = (IN72M01.LME + IN72R15.PREMIJASTREUR) / 1000; /* sešteje konèni lme in pos
          END;                   /* za status premije = k ali z
        END;
      END;
/* **************************************************************/
/* dodala 13.11.2014
/* **************************************************************/


      IF IN72M01.NAMEN = '4' OR IN72M01.NAMEN = '5';
        MOVE 0 TO IN72M01.CENAM;
      ELSE;
      END;


/* **************************************************************/
/* konec prenova nabave izraèun cene prevzema
/* **************************************************************/


      IF IN72M01.NAMEN = '8';
        SET IN72M01.POZICIJAF CURSOR,BRIGHT;
        SET IN72M01.IDENT BRIGHT;

      ELSE;
        SET IN72M01.IDENT CURSOR,BRIGHT;
        SET IN72M01.POZICIJAF AUTOSKIP;
      END;

/* **************************************************************/
/* dodala 11.3.2021  4.6.2021  ASI CERTIFIKAT VHOD  PREVERJALA 4.5.2022
/* **************************************************************/


      IF IN72M01.ID_SKUS_ASI > 0;
        IF IN72M01.ID_SKUP_ASI_NIVO_2 > 0;
          IF IN72M01.ID_SKUP_ASI_NIVO_2 = 3; /* POST CONSUMER    1    3
            MOVE '700' TO IN72M01.ST_CERT;
          ELSE;
          END;
          IF IN72M01.ID_SKUP_ASI_NIVO_2 = 5; /* AL IZ PREDELAVE   1   5
            MOVE '800' TO IN72M01.ST_CERT;
          ELSE;
          END;
        ELSE;
        END;
        IF IN72M01.ST_CERT = ' ';
          SET IN72M01.ST_CERT CURSOR,BRIGHT;

        ELSE;
        END;
      ELSE;
      END;


/* ********************************************/
/* dodala 6.11.2014  Breda
/* **************************************************************/

      IF IN72M01.POZDOK > 1;
        IF IN72M01.ORGEN = IN72M01.ORGENP;
        ELSE;
          MOVE "Pogodbena PP se razlikuje od vpisane PP za prevzem" TO IN72M01.EZEMSG;
        END;
      ELSE;
      END;

/* **************************************************************/
/* konec 6.11.2014
/* **************************************************************/

      SET IN72M01.KOLICM AUTOSKIP,BRIGHT;
      SET IN72M01.LETO AUTOSKIP,BRIGHT;
      SET IN72M01.STNAROC AUTOSKIP,BRIGHT;

      SET IN72M01.CENAM AUTOSKIP,BRIGHT;
    ELSE;
      MOVE "Skupna prevzemna kolièina na pogodbi presega 10% ali 5 ton naroèene kolièine" TO IN72M01.EZEMSG;
    END;
  END;
END;
:ebefore.
:efunc.

:func      name      = IN72S14           
           date      = '08/31/2021' time = '08:56:59' option = EXECUTE  
           desc      = 'RUTINA NA NAMEN'
           refine    = N  
:before.
;  /* edit rutina na namen
; /* **********************
IF IN72M01.NAMEN NE IN72W02.NAMEN;
  MOVE IN72M01.NAMEN TO IN72W02.NAMEN;
  IF IN72W01.SDOK = '120';
    IF IN72M01.NAMEN = '1'
      OR IN72M01.NAMEN = '2'

      OR IN72M01.NAMEN = '4'
      OR IN72M01.NAMEN = '5'
      OR IN72M01.NAMEN = '8'
      OR IN72M01.NAMEN = '9'
      OR IN72M01.NAMEN = '7';
      MOVE 'DA' TO FLOK1;        /* glava je vredu
/* **************************************************************/
/* DODAM ,KO JE PREJEM IZ SEVALA
/* **************************************************************/

      IF IN72M01.NAMEN = '8';
        SET IN72M01.STFAKTUR CURSOR,MODIFIED,BRIGHT;
        SET IN72M01.LETOF BRIGHT;
      ELSE;
        SET IN72M01.STDOBAV CURSOR,MODIFIED,BRIGHT;
      END;


    ELSE;
      MOVE "Namen je 1, 2 , 3 , 7,8,9" TO IN72M01.EZEMSG;
      SET IN72M01.NAMEN CURSOR,MODIFIED,BRIGHT;
      MOVE ' ' TO IN72W02.NAMEN;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    END;
  END;
END;
:ebefore.
:efunc.

:func      name      = IN72S15           
           date      = '08/31/2021' time = '08:56:59' option = EXECUTE  
           desc      = 'RUTINA ST DOKUM GLAVA'
           refine    = N  
:before.


IF EZEAID IS ENTER AND
  IN72M01.STNAROC IS MODIFIED;
  IF IN72M01.LETO = 00000;

    MOVE "  OBVEZEN VPIS LETA NAROÈILA " TO IN72M01.EZEMSG;
    SET IN72M01.LETO CURSOR,MODIFIED,BRIGHT;
    MOVE 9999 TO EZEMNO;
  END;
  IF IN72M01.STNAROC = 00000;

    MOVE "  OBVEZEN VPIS  ŠTEVILKE NAROÈILA " TO IN72M01.EZEMSG;
    SET IN72M01.STNAROC CURSOR,MODIFIED,BRIGHT;
    MOVE 9999 TO EZEMNO;

  END;


  MOVE IN72M01.LETO TO IN72W02.LETONARO;
  MOVE IN72M01.STNAROC TO IN72W02.STNAROC;
  MOVE IN72W02.LETONARO TO IN72R14.LETO;
  MOVE IN72W02.STNAROC TO IN72R14.STNAROC;
  IN72P41();
  IF IN72R14 IS ERR;
    MOVE ' TO NAROÈILO NE OBSTAJA' TO IN72M01.EZEMSG;
    MOVE 0000 TO IN72M01.LETO;
    MOVE 00000 TO IN72M01.STNAROC;
    SET IN72M01.LETO CURSOR,BRIGHT;

    MOVE 9999 TO EZEMNO;
  ELSE;

/* **************************************************************/
/* VALUTA
/* **************************************************************/


    MOVE '705' TO IN72R50.SIFRA3;
    MOVE IN72R14.SIFVAL32 TO IN72R50.SIFVAL32;
    IN72P50();                   /* èita MAKSIMALNI TEÈAJ ZA DATUM
    IF EZESQCOD = 0;
      MOVE IN72R50.DATUM TO IN72R51.DATUM;
      MOVE '705' TO IN72R51.SIFRA3;
      MOVE IN72R14.SIFVAL32 TO IN72R51.SIFVAL32;
      IN72P51();                 /* ÈITA TEÈAJ DSATUM
      MOVE IN72R51.RAZMERJE TO IN72W02.TECAJ;




    ELSE;

    END;
/* **************************************************************/
/* KONEC
/* **************************************************************/
    SET IN72R006 EMPTY;
    MOVE IN72M01.LETO TO IN72R006.LETO;
    MOVE IN72M01.STNAROC TO IN72R006.STNAROC;
    MOVE 1 TO IN72R006.POZNARO;
    IN72P010();                  /* èita pozicijo da pridem do pogodbe ID_NABPPOGODBA + carinski dokumenti IMP.NABPNAROCANJE

    IF EZESQCOD = 100;
      SET IN72R0013 EMPTY;
      MOVE IN72R14.KOMITENT TO IN72R0013.KOMITENT;
      IN72P0021();               /* ÈITA DRŽAVO ZA KOMITENTA
      MOVE IN72R0013.SIFRA3 TO IN72M01.DRZODPREME;
      MOVE IN72R0013.NAZIVDR TO IN72M01.NDRZODPREME;
      MOVE "  Preveri državo odpreme " TO IN72M01.EZEMSG;


/* MOVE '000' TO IN72M01.DRZODPREME;
    ELSE;
      MOVE IN72R006.SIFRA3 TO IN72M01.DRZODPREME;
      MOVE IN72R006.NAZIVDR TO IN72M01.NDRZODPREME;
    END;

    MOVE IN72R14.KOMITENT TO IN72M01.KOMITENT;
    IF IN72R14.PROIZVAJALEC = ' ' OR IN72R14.PROIZVAJALEC = NULL;
      MOVE IN72R14.KOMITENT TO IN72M01.PROIZVAJALEC;
    ELSE;
      MOVE IN72R14.PROIZVAJALEC TO IN72M01.PROIZVAJALEC;
    END;
    SET IN72M01.KOMITENT CURSOR,BRIGHT;
    SET IN72M01.LETO AUTOSKIP,BRIGHT;
    SET IN72M01.STNAROC AUTOSKIP,BRIGHT;
    SET IN72M01.POZNARO AUTOSKIP,BRIGHT;
/* **************************************************************/
/* dodala 23.11.2009
/* **************************************************************/

    SET IN72M01.FIRMAVEZA PROTECT;
    SET IN72M01.FIRMA3 PROTECT;
    SET IN72M01.SIFPREJE PROTECT;

/* **************************************************************/
/* konec
/* **************************************************************/

    SET IN72M01.POZICIJAF AUTOSKIP,BRIGHT;
    MOVE IN72R14.CARPOST2 TO IN72M01.CARPOST2;
    MOVE IN72R14.SIFVAL32 TO IN72W02.SIFVAL32;
/* MOVE IN72R14.SIFVAL32 TO IN72R50.SIFVAL32;
/* IN72P50();                   /* r50 èita teèaj
/*
/* MOVE IN72R50.SLTVAL1 TO IN72W02.TECAJ;
/*
/* MOVE 9999 TO EZEMNO;


  END;
END;
:ebefore.
:efunc.

:func      name      = IN72S16           
           date      = '08/31/2021' time = '08:56:59' option = EXECUTE  
           desc      = 'rutina na kzorg'
           refine    = N  
:before.
IF EZEAID IS ENTER AND
  IN72M01.KZORG IS MODIFIED;
  MOVE IN72M01.KZORG TO IN72R16.KZORG;

  IN72P99();                     /* èita kzorg
  IF IN72R16 IS ERR;
    MOVE "Kz ne obstaja vpiši pravilnega" TO IN72M01.EZEMSG;
    SET IN72M01.KZORG CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu

  ELSE;



  END;

ELSE;
END;
:ebefore.
:efunc.

