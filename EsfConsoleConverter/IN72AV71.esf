SET IN72R180 EMPTY;
IF FLOK3 = 'DA';
  MOVE IN72M01.IDENT TO IN72R180.IDENT; /* ZAKLENE SKLADIŠÈE IMPOL ZA IZDAJE
  MOVE IN72M01.PREVZEM TO IN72R180.MZ;
  MOVE IN72M01.FIRMA3 TO IN72R180.FIRMA;
  IN72F16();                     /* update skladišèa

  IF IN72R180 IS ERR;
    EZEREPLY = 0;
    EZEROLLB();                  /* vraèa staro stanje
    MOVE "Napaka pri zaklepanju skladišèa IZDAJA TRETJA FIRMA "
      IN72M01.EZEMSG;
    MOVE EZESQCOD TO IN72M01.KODA;
    MOVE 'NE' TO FLOK3;
  ELSE;
    IN72F17();                   /* priprava skladišèa
    IN72F21();                   /* replace skladišèa
    IF IN72R180 IS ERR;
      EZEREPLY = 0;
      EZEROLLB();                /* vraèa staro stanje
      MOVE "Napaka pri spremembi skladišèa IZDAJA TRETJA FIRMA"
        IN72M01.EZEMSG;
      MOVE EZESQCOD TO IN72M01.KODA;
      MOVE 'NE' TO FLOK3;
    ELSE;
SET IN72R190 EMPTY;
      IN72F25();                 /* PRIPRAVA ZA ADD IZDAJE
      IN72F27();                 /* DODA IZDAJO ZA IMPOL
      IF IN72R190 IS ERR;
        EZEREPLY = 0;
        EZEROLLB();              /* vraèa staro stanje
        MOVE "Napaka pri dodajanju izdaje TRETJA FIRMA"
          IN72M01.EZEMSG;
        MOVE EZESQCOD TO IN72M01.KODA;
        MOVE 'NE' TO FLOK3;
      ELSE;
      END;


    END;

  END;

ELSE;
END;
