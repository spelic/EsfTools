  IF IN72M01.LETO = 0000;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
    MOVE "  OBVEZEN VPIS LETA NAROÈILA " TO IN72M01.EZEMSG;
    SET IN72M01.LETO CURSOR,MODIFIED,BRIGHT;
    MOVE 999 TO EZEMNO;
  END;
  IF IN72M01.STNAROC = 00000;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
    MOVE "  OBVEZEN VPIS  ŠTEVILKE NAROÈILA " TO IN72M01.EZEMSG;
    SET IN72M01.STNAROC CURSOR,MODIFIED,BRIGHT;
    MOVE 9999 TO EZEMNO;
  END;
  IF FLOK1 = 'DA'
    AND IN72W01.SDOK = '120'
    OR IN72W01.SDOK = '134';
    IF IN72M01.KOMITENT = '        '
      OR IN72M01.KOMITENT NE IN72W02.KOMITENT;
      MOVE "Vnesi pravega dobavitelja" TO IN72M01.EZEMSG;
      SET IN72M01.KOMITENT CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    ELSE;
    END;
  END;

  IF FLOK1 = 'DA';
    IF IN72M01.KRNAZP = '      ';

      MOVE "Potrdi ali spremeni proizvajalca " TO IN72M01.EZEMSG;
      SET IN72M01.PROIZVAJALEC CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    END;
  ELSE;                          /* konto O.K.
  END;

END;

IF FLOK1 = 'DA';
  IF IN72W01.SDOK = '120'
    OR IN72W01.SDOK = '134';
    IF IN72M01.KOMITENT = '        '
      OR IN72M01.KOMITENT NE IN72W02.KOMITENT;
      MOVE "Vnesi pravega dobavitelja" TO IN72M01.EZEMSG;
      SET IN72M01.KOMITENT CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    ELSE;
    END;
  ELSE;
  END;
END;

IF FLOK1 = 'DA';
  IF IN72M01.KRNAZP = '      ';

    MOVE "Potrdi ali spremeni proizvajalca " TO IN72M01.EZEMSG;
    SET IN72M01.PROIZVAJALEC CURSOR,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
  END;
ELSE;                            /* konto O.K.
END;
IF FLOK1 = 'DA';
  IF IN72M01.NAMEN = '8';
    MOVE IN72M01.STFAKTUR TO IN72W04.STDOBAV1;
    MOVE IN72W04.STDOBAV TO IN72M01.STDOBAV;
    SET IN72M01.STDOBAV AUTOSKIP,DARK;
  ELSE;
    SET IN72M01.STDOBAV AUTOSKIP,BRIGHT;
  END;
               /* zapre glavo
/* **************************************************************/
/* dodala za najavo
/* **************************************************************/

  IF IN72M01.STPOZ > 0;
    IF IN72M01.ID_SKUP_ASI_NIVO_2 > 0;
      SET IN72M01.ST_CERT CURSOR,MODIFIED,BRIGHT;
    ELSE;

      SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
    END;
  ELSE;
    SET IN72M01.POZNARO CURSOR,MODIFIED,BRIGHT;
  END;

/* **************************************************************/
/* konec prej samo SET IN72M01.POZNARO CURSOR,MODIFIED,BRIGHT;
/* end;
/* **************************************************************/
  SET IN72M01.FIRMAVEZA AUTOSKIP,BRIGHT;

  SET IN72M01.PREVZEM AUTOSKIP,BRIGHT;
  SET IN72M01.KONTO AUTOSKIP,BRIGHT;
  SET IN72M01.KOMITENT AUTOSKIP,BRIGHT;
  SET IN72M01.LETO AUTOSKIP,BRIGHT;
  SET IN72M01.STNAROC AUTOSKIP,BRIGHT;
/* SET IN72M01.UECLIMP AUTOSKIP,BRIGHT;
/* SET IN72M01.UECLCAR AUTOSKIP,BRIGHT;
/* SET IN72M01.STDOBAV AUTOSKIP,BRIGHT;
  SET IN72M01.NAMEN AUTOSKIP,BRIGHT;
  SET IN72M01.VP AUTOSKIP,BRIGHT;
  SET IN72M01.LETOF AUTOSKIP,BRIGHT;
  SET IN72M01.STFAKTUR AUTOSKIP,BRIGHT;
ELSE;
END;
