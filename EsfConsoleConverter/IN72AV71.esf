IN72P33();                       /* ÈITA STATUS ZA IZDAJO STATUSN
MOVE IN72R21.STATUS TO IN72M01.STATUS;
/* MOVE '120' TO IN72W01.SDOK;

/* **************************************************************/
/* dodala 27.5.2013   dodala za najavo
/* **************************************************************/
/*
/* MOVE 1 TO IN72W01.R2;            /* samo za test*********************************************
/* MOVE 2014 TO IN72W01.R2;              /* damo za test
/*
IN72M01.ZAPSTEV = 0;

IF IN72W01.R2 > 0;               /* dodala 27.5.2013
  MOVE IN72W01.R2 TO IN72R001.ID_NABPNAJAVA_GL; /* + mnglanar za predelovalca in komitenta;
