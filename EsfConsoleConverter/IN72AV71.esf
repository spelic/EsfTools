:func      name      = IN72S50           
           date      = '08/31/2021' time = '08:56:59' option = EXECUTE  
           desc      = 'KONTROLA PROIZVAJALCA'
           refine    = N  
:before.
;  /* edit rutina na komitenta
; /* **************************
IF EZEAID IS ENTER AND
  IN72M01.PROIZVAJALEC IS MODIFIED;
  MOVE IN72M01.PROIZVAJALEC TO IN72R04.KOMITENT;

  IN72P13();                     /* èita komitente
  IF IN72R04 IS ERR;
    MOVE "Proizvajalec ne obstaja ne obstaj" TO IN72M01.EZEMSG;
    SET IN72M01.PROIZVAJALEC CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu

  ELSE;


    MOVE IN72R04.KRNAZ TO IN72M01.KRNAZP;
    SET IN72M01.PROIZVAJALEC PROTECT;


    IF IN72M01.DRZODPREME = ' ' OR IN72M01.DRZODPREME = '000';
      SET IN72R0013 EMPTY;
      MOVE IN72R14.KOMITENT TO IN72R0013.KOMITENT;
      IN72P0021();               /* ÈITA DRŽAVO ZA KOMITENTA
      MOVE IN72R0013.SIFRA3 TO IN72M01.DRZODPREME;
      MOVE IN72R0013.NAZIVDR TO IN72M01.NDRZODPREME;
      MOVE "  Preveri državo odpreme  " TO IN72M01.EZEMSG;


/* MOVE '000' TO IN72M01.DRZODPREME;
    ELSE;
/* MOVE IN72R006.SIFRA3 TO IN72M01.DRZODPREME;
/* MOVE IN72R006.NAZIVDR TO IN72M01.NDRZODPREME;
    END;
    ;   /* SET IN72M01.KOMITENT PROTECT,BRIGHT;




  END;

ELSE;
END;
:ebefore.
:efunc.

