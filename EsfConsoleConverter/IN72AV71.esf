:func      name      = IN72S11           
           date      = '05/24/2022' time = '11:04:16' option = EXECUTE  
           desc      = 'KONTROLA NA VPIS GLAVE'
           refine    = N  
:before.
;  /* KONTROLA  GLAVE
; /* ***************************************************
MOVE 'DA' TO FLOK1;
; /* IF FLOK1 = 'DA';
;  /* AND IN72W01.SDOK ^= '192';
;  /* IF IN72M01.STNAROC = 0;
;    /* MOVE "Vnesi številko naroèila" TO IN72M01.EZEMSG;
;    /* SET IN72M01.STNAROC CURSOR,BRIGHT;
;    /* MOVE 'NE' TO FLOK1          ;glava ni v redu
;  /* ELSE ;
;  /* END ;
; /* END ;


IF FLOK1 = 'DA';
  IF IN72M01.KONTO = '      '
    OR IN72M01.KONTO NE IN72W02.KONTO;
    MOVE "Vnesi pravi konto " TO IN72M01.EZEMSG;
    SET IN72M01.KONTO CURSOR,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
  END;
ELSE;                            /* konto O.K.
END;
IF FLOK1 = 'DA';
  IF IN72W01.SDOK = '120'
    OR IN72W01.SDOK = '134';
    IF IN72M01.NAMEN = ' '
      OR IN72M01.NAMEN NE IN72W02.NAMEN;
      MOVE "Vnesi pravi namen 1,2,3" TO IN72M01.EZEMSG;
      SET IN72M01.NAMEN CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    END;
  END;
ELSE;
END;
IF FLOK1 = 'DA';
  IF IN72M01.NAMEN = '8';
    IF IN72M01.STFAKTUR = 0;
      MOVE "Vpis številke fakture je obvezen " TO IN72M01.EZEMSG;
      SET IN72M01.STFAKTUR CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    ELSE;
    END;
  ELSE;
  END;
ELSE;                            /* konto O.K.
END;

IF FLOK1 = 'DA';
  IF IN72M01.NAMEN = '8';
    IF IN72M01.LETOF = 0;
      MOVE "Vpis leta fakture je obvezen " TO IN72M01.EZEMSG;
      SET IN72M01.LETOF CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    ELSE;
    END;
  ELSE;
  END;
ELSE;                            /* konto O.K.
END;
IF FLOK1 = 'DA';
  IF IN72M01.NAMEN NE '8';
    IF IN72M01.STDOBAV = ' ';
      MOVE "Vpiši stevilko dobavnice" TO IN72M01.EZEMSG;
      SET IN72M01.STDOBAV CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    ELSE;
    END;
  ELSE;
  END;
ELSE;                            /* konto O.K.
END;

IF FLOK1 = 'DA';
  IF IN72W01.SDOK = '120';
    IF IN72M01.VP = '07'
      OR IN72M01.VP = '08'
      OR IN72M01.VP = '84'
      OR IN72M01.VP NE IN72W02.VP;
    ELSE;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
      MOVE "Napaèen VP : 07 ali 08 ali 84 " TO IN72M01.EZEMSG;
      SET IN72M01.VP CURSOR,BRIGHT;
    END;
  END;
ELSE;
END;
; /* IF FLOK1 = 'DA';
; /* AND IN72W01.SDOK = '120'      ;kontrola za carin.ecl
; /* IF IN72M01.ECLCAR = '      ';
;   /* MOVE 'NE' TO FLOK1          ;glava ni v redu
;   /* MOVE "Vnesi Štev.carinskega ECL-a   " TO IN72M01.EZEMSG;
;   /* SET IN72M01.ECLCAR CURSOR,BRIGHT;
; /* ELSE ;
; /* END ;
; /* END ;
IF FLOK1 = 'DA'
  AND IN72W01.SDOK = '120';      /* kontrola za impol.ecl
/* IF IN72M01.UECLIMP = 000000;
/* MOVE 'NE' TO FLOK1;          /* glava ni v redu
/* MOVE "Vnesi Štev.impolskega ECL-a   " TO IN72M01.EZEMSG;
/* SET IN72M01.UECLIMP CURSOR,BRIGHT;
/* ELSE;
/* END;
  IF FLOK1 = 'DA'
    AND IN72W01.SDOK ^= '192' AND IN72M01.NAMEN NE '8';
    IF IN72M01.STDOBAV = '               ';
      MOVE "Vnesi štev. dobavnice    " TO IN72M01.EZEMSG;
      SET IN72M01.STDOBAV CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    ELSE;
    END;
  END;
/* **************************************************************/
/* izloèila 26.8.2014
/* **************************************************************/

/* IF IN72M01.SIFPREJE = '     ';
/* MOVE 'NE' TO FLOK1;          /* glava ni v redu
/* MOVE "  OBVEZEN VPIS PREJEMNIKA " TO IN72M01.EZEMSG;
/* SET IN72M01.SIFPREJE CURSOR,MODIFIED,BRIGHT;
/* MOVE 999 TO EZEMNO;
/* END;
/* **************************************************************/
/* konec
