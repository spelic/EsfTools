    MOVE '42' TO IN72M01.VP;
    MOVE '8' TO IN72M01.NAMEN;
    MOVE IN72M01.KONTO TO IN72W02.KONTO;
    MOVE IN72M01.VP TO IN72W02.VP;
    MOVE IN72M01.NAMEN TO IN72W02.NAMEN;


    ; /* SET IN72M01.STNAROC BRIGHT;
    SET IN72M01.KOMITENT BRIGHT;
  END;
  MOVE IN72W01.FIRMA TO IN72R21.FIRMA;
  IN72P33();                     /* ÈITA STATUS ZA IZDAJO STATUSN
  MOVE IN72R21.STATUS TO IN72M01.STATUS;
/* **************************************************************/
/* dodala za prenovo nabave 17.5.2013
/* **************************************************************/


  TI00P20();
  MOVE DA10CDAT TO IN72W07.DATDOK; /* dATUM ZA IZRAÈUN CENE ZA ALUMINIJ
/* **************************************************************/
/* konec za prenovo nabave
/* **************************************************************/
END;                             /* dodala 27.5.2013
:ebefore.
:efunc.

:func      name      = IN72S02           
           date      = '01/24/2025' time = '11:53:59' option = EXECUTE  
           desc      = 'ident'
           refine    = N  
:before.
;  /* edit rutina na ident
; /* **********************
IF (EZEAID IS ENTER AND IN72M01.IDENT IS MODIFIED)
  OR
  (EZEAID IS ENTER AND IN72M01.STPOZ > 0); /* dodala za najvavo surovine 26.9.2013
  MOVE 'NE' TO TABIZD;
  MOVE IN72M01 TO IN72R01;
  IN72P12();                     /* èita materiale
  IF IN72R01 IS ERR;
    IF IN72R01 IS NRF;
      IF IN72M01.IDENT >= 1      /* moje
        AND IN72M01.IDENT <= 99999; /* moje
        MOVE IN72M01.IDENT TO IN72R10.IDENT; /* moje
        MOVE 'DA' TO TABIZD;
      ELSE;
        IF IN72M01.IDENT >= 300000 /* moje
          AND IN72M01.IDENT <= 799999; /* moje
          MOVE IN72M01.IDENT TO IN72R10.IDENT; /* moje
          MOVE 'DA' TO TABIZD;
        END;
      END;
      IF TABIZD = 'DA';
        IN72PJ1();               /* cita izdelke;
        IF IN72R10 IS ERR;
          IF IN72R10 IS NRF;
            MOVE "Ident ne obstaja v IZDELKIH, vnesi novega" IN72M01.EZEMSG;
          ELSE;
            MOVE "Napaka pri èitanju tabele IZDELKI" TO IN72M01.EZEMSG;
          END;
                        /* clear pozicije
          SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
        ELSE;                    /* kreiramo naziv in dodamo v material
          MOVE IN72R10.IDENT TO IN72R01.IDENT;
          MOVE IN72R10.DIMENZ40 TO IN72R01.NAZIVDI;
          MOVE 20 TO IN72R01.EM;
          MOVE IN72R10.KLASIFI1 TO IN72W02.KLASIFI1;
          MOVE IN72R10.KLASIFI2 TO IN72W02.KLASIFI2;
          MOVE IN72R10.KLASIFI3 TO IN72W02.KLASIFI3;
          MOVE IN72R10.KLASIFI4 TO IN72W02.KLASIFI4;
          MOVE IN72R10.KLASIFI5 TO IN72W02.KLASIFI5;
          MOVE IN72R10.KLASIFI6 TO IN72W02.KLASIFI6;
          MOVE IN72R10.KLASIFI1 TO IN72R11.SIFRA;
          IN72PJ2();             /* èita klasifikacijo
          IF IN72R11 IS ERR;
            MOVE '               ' TO IN72W02.OBDELAV1;
          ELSE;
            MOVE IN72R11.OBDELAVA TO IN72W02.OBDELAV1;
          END;
          MOVE IN72R10.KLASIFI2 TO IN72R11.SIFRA;
          IN72PJ2();             /* èita klasifikacijo
          IF IN72R11 IS ERR;
            MOVE '              ' TO IN72W02.NAZIZDE1;
          ELSE;
            MOVE IN72R11.NAZIZDEL TO IN72W02.NAZIZDE1;
          END;
          MOVE IN72R10.KLASIFI3 TO IN72R11.SIFRA;
          IN72PJ2();             /* èita klasifikacijo
          IF IN72R11 IS ERR;
            MOVE '    ' TO IN72W02.ZLITINA;
          ELSE;
            MOVE IN72R11.ZLITINA TO IN72W02.ZLITINA;
          END;
          MOVE IN72W02.NAZIV TO IN72R01.NAZIV;
          MOVE IN72R01.EM TO IN72R09.SIFRAEM;
          IN72P37();             /* èita EM
          IF IN72R09 IS ERR;
            MOVE '    ' TO IN72M01.KRNAZEM;
          ELSE;
            MOVE IN72R09.KRNAZEM TO IN72M01.KRNAZEM;
          END;
          MOVE IN72R01 TO IN72M01;
          MOVE IN72W02.NAZIV TO IN72R01.NAZIV;
          TIZZP90();
          TIZZP91();
          MOVE DAZZW01.TI26CTIM TO IN72R01.DATURA;
          MOVE DAZZW01.DA10CDAT TO IN72R01.DATKRE;
          MOVE IN72M01.REFSKL TO IN72R01.REFPOTR;
          MOVE IN72W02.KLASIFIK TO IN72R01.KLASIFIK;
          MOVE IN72W02.KLASIFI6 TO IN72R01.KLASIFI2;
          MOVE 0 TO IN72R01.PLCENA;
          MOVE 0 TO IN72R01.MINZALOG;
          MOVE 0 TO IN72R01.MAKZALOG;
          MOVE 0 TO IN72R01.SKUPKOLI;
          MOVE 0 TO IN72R01.VREDNOST;
          IN72PJ3();             /* doda v material

          IF IN72R01 IS ERR;
            MOVE "Napaka pri dodajanju novega identa" TO IN72M01.EZEMSG;
            SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
            MOVE 'NE' TO FLOK1;
          ELSE;
            MOVE 'DA' TO FLOK1;
          END;
/* **************************************************************/
/* dodala za prevzem po komadih      23.11.2009 ko ident doda iz tabele izdelki
/* **************************************************************/
          SET IN72R12 EMPTY;
          MOVE IN72M01.IDENT TO IN72R12.IDENT;
/* MOVE '01' TO IN72R12.FIRMA; izloèila ,ke je ident prijavljen kot firma 13
          IN72P15();
          IF IN72R12 IS ERR;
            MOVE "Napaka pri branju identa za klasif. komada" TO IN72M01.EZEMSG;
            SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
            MOVE 'NE' TO FLOK1;
          ELSE;
            MOVE 'DA' TO FLOK1;


          END;

          IF IN72M01.STPOZ > 0;  /* dodala za najavo
          ELSE;                  /* dodala za najavo
            IF (IN72R12.KLASIFI1 = '60' OR IN72R12.KLASIFI1 = '61' OR IN72R12.KLASIFI1 = '63'  OR IN72R12.KLASIFI1 = '70')
              AND (IN72R12.KLASIFI2 = '02' OR IN72R12.KLASIFI2 = '06' OR IN72R12.KLASIFI2 = '51' OR IN72R12.KLASIFI2 = '59' OR IN72R12.KLASIFI2 = '95'  OR IN72R12.KLASIFI2 = '96'
OR IN72R12.KLASIFI2 = '97' OR IN72R12.KLASIFI2 = '92' OR IN72R12.KLASIFI2 = 'A1' OR IN72R12.KLASIFI2 = 'A2'  OR IN72R12.KLASIFI2 = 'A3'

              OR (IN72R12.KLASIFI2 = '66' AND (IN72M01.NAMEN NE '9' AND IN72M01.NAMEN NE '7')));


              MOVE 0 TO IN72M01.KOLICM;

              SET IN72M01.KOLICM PROTECT;
              SET IN72M01.KOMADI CURSOR,BRIGHT;
            ELSE;
              SET IN72M01.KOLICM CURSOR,BRIGHT;
            END;


          END;                   /* dodala za najavo
/* **************************************************************/
/* konec             23.11.2009 ko ident doda iz tabele izdelki
/* **************************************************************/

/* SET IN72M01.kolicm BRIGHT;
/* SET IN72M01.CENAM BRIGHT;
        END;                     /* err
      ELSE;                      /* tabizd='ne'
        MOVE "Ident ne obstaja v MATERIALU,vnesi novega" IN72M01.EZEMSG;
        IN72S03();               /* clear pozicije
        SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
      END;
    ELSE;
      MOVE "Napaka pri èitanju tabele MATERIAL" TO IN72M01.EZEMSG;
      IN72S03();                 /* clear pozicije
      SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
    END;
  ELSE;
    MOVE IN72R01.EM TO IN72R09.SIFRAEM;
    IN72P37();                   /* èita EM
    IF IN72R09 IS ERR;
      MOVE '    ' TO IN72M01.KRNAZEM;
    ELSE;
      MOVE IN72R09.KRNAZEM TO IN72M01.KRNAZEM;
    END;
    MOVE IN72R01 TO IN72M01;
/* **************************************************************/
/* dodala za prevzem po komadih      23.11.2009 ko je ident prijavljen v tabeli materialn
/* **************************************************************/
    SET IN72R12 EMPTY;
    MOVE IN72M01.IDENT TO IN72R12.IDENT;
/* MOVE '01' TO IN72R12.FIRMA;
    IN72P15();
    IF IN72R12 IS ERR;
      MOVE "Napaka pri branju identa za klasif. komada" TO IN72M01.EZEMSG;
      SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
      MOVE 'NE' TO FLOK1;
    ELSE;
      MOVE 'DA' TO FLOK1;


    END;

    IF IN72M01.STPOZ > 0;
    ELSE;
      IF (IN72R12.KLASIFI1 = '60' OR IN72R12.KLASIFI1 = '61' OR IN72R12.KLASIFI1 = '63' OR IN72R12.KLASIFI1 = '70')
        AND (IN72R12.KLASIFI2 = '02' OR IN72R12.KLASIFI2 = '06' OR IN72R12.KLASIFI2 = '51' OR IN72R12.KLASIFI2 = '59' OR IN72R12.KLASIFI2 = '95' OR IN72R12.KLASIFI2 = '96'
OR IN72R12.KLASIFI2 = '97' OR IN72R12.KLASIFI2 = '92' OR IN72R12.KLASIFI2 = 'A1' OR IN72R12.KLASIFI2 = 'A2'  OR IN72R12.KLASIFI2 = 'A3'


        OR (IN72R12.KLASIFI2 = '66' AND (IN72M01.NAMEN NE '9' AND IN72M01.NAMEN NE '7')));



        MOVE 0 TO IN72M01.KOLICM;
        SET IN72M01.KOLICM PROTECT;
        SET IN72M01.KOMADI CURSOR,BRIGHT;
      ELSE;
        SET IN72M01.KOLICM CURSOR,BRIGHT;
      END;

    END;
/* **************************************************************/
/* konec             23.11.2009 ko ident ibstaja v mater
/* **************************************************************/

/* SET IN72M01.KOLICM CURSOR,BRIGHT;
/* SET IN72M01.CENAM BRIGHT;
  END;
  MOVE 9999 TO EZEMNO;
END;
:ebefore.
:efunc.

:func      name      = IN72S03           
           date      = '05/26/2022' time = '14:18:03' option = EXECUTE  
           desc      = 'prazni pozicije mape'
           refine    = N  
:before.

SET IN72R0037 EMPTY;
SET IN72R0038 EMPTY;
SET IN72R0035 EMPTY;
SET IN72W06 EMPTY;
SET IN72W07 EMPTY;
MOVE 0 TO IN72M01.IDENT;
MOVE 0 TO IN72M01.KOLICM;
MOVE 0 TO IN72M01.POZICIJAF;

MOVE 0 TO IN72M01.CENAM;
MOVE 0 TO IN72M01.LME;
MOVE 0 TO IN72M01.POS;
MOVE 0 TO IN72M01.PREMIJA;
MOVE ' ' TO IN72M01.ORGENP;
MOVE ' ' TO IN72M01.ST_CERT;
MOVE ' ' TO IN72M01.OPIS;
MOVE ' ' TO IN72M01.OPIS2;

MOVE 0 TO IN72M01.ID_SKUS_ASI;
MOVE 0 TO IN72M01.ID_SKUS_ASI_NIVO_2;
MOVE 0 TO IN72M01.ID_SKUP_ASI_NIVO_2;
MOVE ' ' TO IN72M01.STATCENE;
MOVE ' ' TO IN72M01.STATUS_CENE_LME;
MOVE ' ' TO IN72M01.STATUS_PREMIJE;
SET IN72R12 EMPTY;
SET IN72W06 EMPTY;
MOVE 1 TO IN72W06.ST5;
WHILE IN72W06.ST5 <= 16;
  MOVE 0 TO IN72M01.KOMADKG[IN72W06.ST5];
  MOVE 0 TO IN72M01.POZKG[IN72W06.ST5];
  MOVE 0 TO IN72M01.TRAN_ENOTA[IN72W06.ST5];
  IN72W06.ST5 = IN72W06.ST5 + 1;

END;

MOVE 1 TO IN72M01.KOMADI;
MOVE 0 TO IN72M01.POZNARO;
MOVE 0 TO IN72M01.EM;
IN72M01.ZAPSTEV = 0;

MOVE '    ' TO IN72M01.KRNAZEM;
MOVE '                                   ' TO IN72M01.NAZIV;
MOVE '                  ' TO IN72M01.NAZIVDI;
IF IN72W01.R2 > 0;
MOVE 0 TO  IN72M01.STPOZ;

  SET IN72M01.STPOZ CURSOR,BRIGHT;
ELSE;
  SET IN72M01.POZNARO CURSOR,BRIGHT;
END;
SET IN72M01.KOLICM AUTOSKIP,BRIGHT;
SET IN72M01.CENAM AUTOSKIP,BRIGHT;
:ebefore.
:efunc.

:func      name      = IN72S04           
           date      = '08/31/2021' time = '08:56:59' option = EXECUTE  
           desc      = 'generira številke dokumentov'
           refine    = N  
:before.
;  /* generira št.dokumenta
; /* ***********************
IF CTRP = 1;
/* **************************************************************/
/* genmerira prevzem na impolu
/* **************************************************************/

  MOVE IN72M01.PREVZEM TO IN72R02.MZ;
  MOVE IN72M01.FIRMA TO IN72R02.FIRMA;
  IN72P30();                     /* èita PARAMET za replase
  IF IN72R02 IS ERR;
    MOVE "Napaka pri èitanju parametrov-ponovi" TO IN72M01.EZEMSG;
    SET IN72M01.STNAROC CURSOR,BRIGHT;
    MOVE 'NE' TO FLOK3;
    EZEREPLY = 0;
    EZEROLLB();
    SET IN72M01.PREVZEM CURSOR,BRIGHT;
  ELSE;
    IN72R02.STDOK = IN72R02.STDOK + 1;
    IN72R02.STDOKP = IN72R02.STDOKP + 1;
    IN72P32();                   /* replase PARAMET
    IF IN72R02 IS ERR;
      MOVE 'NE' TO FLOK3;
      MOVE "Napaka pri replase parametrov za prejem impol" TO IN72M01.EZEMSG;
      EZEREPLY = 0;
      EZEROLLB();
      SET IN72M01.PREVZEM CURSOR,BRIGHT;
    ELSE;
      MOVE IN72R02.STDOK TO IN72M01.STDOK;
      MOVE IN72R02.STDOKP TO IN72M01.STDOKP;
      MOVE 'DA' TO FLOK3;
    END;
  END;


/* **************************************************************/
/* konec prevzema impol
/* **************************************************************/
/* **************************************************************/
/* generira izdajo na impolu
/* **************************************************************/
  IF FLOK3 = 'DA' AND IN72M01.STATUS = 1;
    MOVE IN72M01.PREVZEM TO IN72R02.MZ;
    MOVE IN72M01.FIRMA TO IN72R02.FIRMA;
    IN72P30();                   /* èita PARAMET za replase
    IF IN72R02 IS ERR;
      MOVE "Napaka pri èitanju parametrov-ponovi" TO IN72M01.EZEMSG;
      SET IN72M01.PREVZEM CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK3;
      EZEREPLY = 0;
      EZEROLLB();
      SET IN72M01.PREVZEM CURSOR,BRIGHT;
    ELSE;
      IN72R02.STDOK = IN72R02.STDOK + 1;
      IN72R02.STDOKI = IN72R02.STDOKI + 1;
      IN72P32();                 /* replase PARAMET
      IF IN72R02 IS ERR;
        MOVE 'NE' TO FLOK3;
        MOVE "Napaka pri replase parametrov-za izdajo impol" TO IN72M01.EZEMSG;
        EZEREPLY = 0;
        EZEROLLB();
        SET IN72M01.PREVZEM CURSOR,BRIGHT;
      ELSE;
        MOVE IN72R02.STDOK TO IN72M01.STDOKIZD;
        MOVE IN72R02.STDOKI TO IN72M01.STDOKIIZD;
        MOVE 'DA' TO FLOK3;
      END;
    END;
  ELSE;
  END;
/* **************************************************************/
/* konec izdaje na impolu
/* **************************************************************/


/* *************************************************************/
/* generira prevzem druga firma
/* **************************************************************/
  IF FLOK3 = 'DA';
    MOVE IN72M01.PREVZEM TO IN72R20.MZ;
    MOVE IN72M01.FIRMAVEZA TO IN72R20.FIRMA;
    IN72P31();                   /* èita PARAMET za replase za firma veza
    IF IN72R20 IS ERR;
      MOVE "Napaka pri èitanju parametrov-druga firma" TO IN72M01.EZEMSG;
      SET IN72M01.STNAROC CURSOR,BRIGHT;
      MOVE 'NE' TO FLOK3;
      EZEREPLY = 0;
      EZEROLLB();
      SET IN72M01.PREVZEM CURSOR,BRIGHT;
    ELSE;
      IN72R20.STDOK = IN72R20.STDOK + 1;
      IN72R20.STDOKP = IN72R20.STDOKP + 1;
      IN72P29();                 /* replase PARAMET
      IF IN72R02 IS ERR;
        MOVE 'NE' TO FLOK3;
        MOVE "Napaka pri replase parametrov-za druga firma" TO IN72M01.EZEMSG;
        EZEREPLY = 0;
        EZEROLLB();
        SET IN72M01.PREVZEM CURSOR,BRIGHT;
      ELSE;
        MOVE IN72R20.STDOK TO IN72M01.STDOKD;
        MOVE IN72R20.STDOKP TO IN72M01.STDOKPD;
        MOVE 'DA' TO FLOK3;
      END;
    END;
  ELSE;
  END;
/* **************************************************************/
/* konec prevzem druga firma
/* **************************************************************/



/* *************************************************************/
/* generira prevzem na cevarni ali valjarni ko da na predelavo v livarno
/* **************************************************************/
  IF IN72M01.FIRMA3 = IN72M01.FIRMAVEZA;
  ELSE;
    IF FLOK3 = 'DA';
      MOVE IN72M01.PREVZEM TO IN72R20.MZ;
      MOVE IN72M01.FIRMA3 TO IN72R20.FIRMA;
      IN72P31();                 /* èita PARAMET za replase za firma veza
      IF IN72R20 IS ERR;
        MOVE "Napaka pri èitanju parametrov-cevarne ali valjarne" TO IN72M01.EZEMSG;
        SET IN72M01.STNAROC CURSOR,BRIGHT;
        MOVE 'NE' TO FLOK3;
        EZEREPLY = 0;
        EZEROLLB();
        SET IN72M01.PREVZEM CURSOR,BRIGHT;
      ELSE;
        IN72R20.STDOK = IN72R20.STDOK + 1;
        IN72R20.STDOKP = IN72R20.STDOKP + 1;
        IN72P29();               /* replase PARAMET
        IF IN72R02 IS ERR;
          MOVE 'NE' TO FLOK3;
          MOVE "Napaka pri replase parametrov-za cevarna-valjarna" TO IN72M01.EZEMSG;
          EZEREPLY = 0;
          EZEROLLB();
          SET IN72M01.PREVZEM CURSOR,BRIGHT;
        ELSE;
          MOVE IN72R20.STDOK TO IN72M01.STDOK3;
          MOVE IN72R20.STDOKP TO IN72M01.STDOKP3;
          MOVE 'DA' TO FLOK3;
        END;
      END;
    ELSE;
    END;
/* **************************************************************/
/* konec prevzem druga firma valjarna cevarna
/* **************************************************************/
/* **************************************************************/
/* generira izdajo na valjarna cevarna
/* **************************************************************/
    IF FLOK3 = 'DA' AND IN72M01.STATUS = 1;
      MOVE IN72M01.PREVZEM TO IN72R02.MZ;
      MOVE IN72M01.FIRMA3 TO IN72R02.FIRMA;
      IN72P30();                 /* èita PARAMET za replase
      IF IN72R02 IS ERR;
        MOVE "Napaka pri èitanju parametrov-ponovi" TO IN72M01.EZEMSG;
        SET IN72M01.PREVZEM CURSOR,BRIGHT;
        MOVE 'NE' TO FLOK3;
        EZEREPLY = 0;
        EZEROLLB();
        SET IN72M01.PREVZEM CURSOR,BRIGHT;
      ELSE;
        IN72R02.STDOK = IN72R02.STDOK + 1;
        IN72R02.STDOKI = IN72R02.STDOKI + 1;
        IN72P32();               /* replase PARAMET
        IF IN72R02 IS ERR;
          MOVE 'NE' TO FLOK3;
          MOVE "Napaka pri replase parametrov-za izdajo impol" TO IN72M01.EZEMSG;
          EZEREPLY = 0;
          EZEROLLB();
          SET IN72M01.PREVZEM CURSOR,BRIGHT;
        ELSE;
          MOVE IN72R02.STDOK TO IN72M01.STDOK31;
          MOVE IN72R02.STDOKI TO IN72M01.STDOKI31;
          MOVE 'DA' TO FLOK3;
        END;
      END;
    ELSE;
    END;





  END;                           /* èe sta firmi enaki
ELSE;
END;
:ebefore.
:efunc.

:func      name      = IN72S05           
           date      = '01/24/2025' time = '11:59:12' option = EXECUTE  
           desc      = 'kontrola pozicije'
           refine    = N  
:before.
; /* kontrola  pozicije
; /* **********************
MOVE 'DA' TO FLOK3;
IF IN72W01.SDOK ^= '192';
  IF IN72M01.POZNARO = 0;
    MOVE "Vpiši pozicijo " TO IN72M01.EZEMSG;
    SET IN72M01.POZNARO CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK3;          /* pozicija ni vredu
  ELSE;
  END;
END;
IF IN72M01.NAMEN = '8';
  IF IN72M01.POZICIJAF = 0;
    MOVE "Vpis pozicije dobavnice je za namen 8 obvezen " TO IN72M01.EZEMSG;
    SET IN72M01.POZICIJAF CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK3;          /* pozicija ni vredu
  ELSE;
  END;
END;
IF IN72M01.KZORG = ' ';

ELSE;

  MOVE IN72M01.KZORG TO IN72R16.KZORG;

  IN72P99();                     /* èita kzorg
  IF IN72R16 IS ERR;
    MOVE "Kz ne obstaja vpiši pravilnega" TO IN72M01.EZEMSG;
    SET IN72M01.KZORG CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK3;          /* glava ni v redu

  ELSE;



  END;
END;



IF FLOK3 = 'DA';
  IF IN72M01.IDENT > 0;
    IF IN72M01.KOLICM > 0;
    ELSE;

      SET IN72R12 EMPTY;
      MOVE IN72M01.IDENT TO IN72R12.IDENT;
      MOVE '01' TO IN72R12.FIRMA;
      IN72P15();

      IF EZESQCOD = 0;
        IF (IN72R12.KLASIFI1 = '60' OR IN72R12.KLASIFI1 = '61' OR IN72R12.KLASIFI1 = '63' OR IN72R12.KLASIFI1 = '70')
          AND (IN72R12.KLASIFI2 = '02' OR IN72R12.KLASIFI2 = '06' OR IN72R12.KLASIFI2 = '51' OR IN72R12.KLASIFI2 = '59' OR IN72R12.KLASIFI2 = '95'  OR IN72R12.KLASIFI2 = '96'
          OR IN72R12.KLASIFI2 = '97' OR IN72R12.KLASIFI2 = '92' OR IN72R12.KLASIFI2 = 'A1' OR IN72R12.KLASIFI2 = 'A2' OR IN72R12.KLASIFI2 = 'A3'
          OR (IN72R12.KLASIFI2 = '66' AND IN72M01.NAMEN NE '9') OR (IN72R12.KLASIFI2 = '66' AND IN72M01.NAMEN NE '7'));

          MOVE "Obvezen vpis  koliÈine po komdih ali F4- seštevek kg " TO IN72M01.EZEMSG;
          SET IN72M01.KOMADI CURSOR,BRIGHT;
          MOVE 'NE' TO FLOK3;    /* pozicija ni vredu
        ELSE;
          MOVE 'NE' TO FLOK3;    /* pozicija ni vredu
          SET IN72M01.KOLICM CURSOR,BRIGHT;
          MOVE "Obvezen vpis koliÈine " TO IN72M01.EZEMSG;
        END;
      ELSE;
        MOVE "Napaka pri èitanju izdelka za klasifikacijo pri kontroli poz. " TO IN72M01.EZEMSG;
        SET IN72M01.KOMADI CURSOR,BRIGHT;
        MOVE 'NE' TO FLOK3;      /* pozicija ni vredu
      END;
    END;
  ELSE;
    MOVE "Obvezno vnesi ident " TO IN72M01.EZEMSG;
    SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK3;          /* pozicija ni vredu
  END;
END;
IF IN72M01.NAMEN < '3';
  IF IN72M01.CENAM > 0;
/* MOVE 'DA' TO FLOK3;
  ELSE;
    MOVE "Obvezen vnos cene " TO IN72M01.EZEMSG;
    SET IN72M01.CENAM CURSOR,BRIGHT;
    MOVE 'NE' TO FLOK3;          /* pozicija ni vredu
  END;
ELSE;
END;
IF FLOK3 = 'DA';
  IF IN72M01.ZAPIS1 = 'D' OR IN72M01.ZAPIS1 = 'N ';

  ELSE;
    MOVE "Obvezno vnesi pravilen indikator za zapis tehtalne enote " TO IN72M01.EZEMSG;
    SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK3;          /* pozicija ni vredu
  END;
END;


IF IN72M01.SIFPREJE = '     ' AND IN72M01.POZDOK = 1;
  MOVE 'NE' TO FLOK1;            /* glava ni v redu
  MOVE "  Obvezen vpis pravilne organizacijske enote " TO IN72M01.EZEMSG;
  SET IN72M01.ORGEN CURSOR,MODIFIED,BRIGHT;
  MOVE 999 TO EZEMNO;
END;

/***************************************************************/
/*  preverja vpis certifikata 12.3.2021 Breda
/***************************************************************/



IF IN72M01.ID_SKUS_ASI > 0 AND IN72M01.ST_CERT = ' ';
  MOVE "Obvezen vnos certifikata " TO IN72M01.EZEMSG;
  SET IN72M01.ST_CERT CURSOR,BRIGHT;
  MOVE 'NE' TO FLOK3;            /* pozicija ni vredu

ELSE;

END;




/* **************************************************************/
/* dodala 16.10.2014   za kontrolo kolièine 10% ali 5 ton
/* **************************************************************/

IN72W02.KOLICINA10P = 0;
IN72W02.KOLICINA10 = 0;
IN72W02.KOLICINA5T = 0;
IN72W02.KOLICINAPR = 0;
MOVE IN72M01.LETO TO IN72R0015.LETO;
MOVE IN72M01.STNAROC TO IN72R0015.STNAROC;

IN72P0027();                     /* èita dobavljeno na celi pogodbi  r0015
IN72W02.KOLICINA10P = (IN72R0015.KOLICINA / 10); /* 10 proc od naroèene kolièine
IN72W02.KOLICINA10 = ((IN72R0015.KOLICINA / 10) + IN72R0015.KOLICINA); /* kolièina z 10 proc
IN72W02.KOLICINA5T = IN72R0015.KOLICINA + 5; /* kolièina plus 10 ton
IF IN72W02.KOLICINA10P > 5;
  IN72W02.KOLKONTROLA = IN72W02.KOLICINA10;
ELSE;
  IN72W02.KOLKONTROLA = IN72W02.KOLICINA5T;
END;
IN72W02.KOLICINAPR = IN72R0015.KOLPREVZ + (IN72M01.KOLICM / 1000);

IF (IN72W02.KOLKONTROLA > IN72W02.KOLICINAPR) OR (IN72W02.KOLKONTROLA = IN72W02.KOLICINAPR);

ELSE;
  MOVE "Skupna prevzemna kolièina na pogodbi presega 10% ali 5 ton skupne naroè. kolièine" TO IN72M01.EZEMSG;
  SET IN72M01.KOLICM CURSOR,BRIGHT;
  MOVE 'NE' TO FLOK3;            /* pozicija ni vredu prevelika kolièina
END;

