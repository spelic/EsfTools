           refine    = N  
:before.
MOVE IN72M01.STDOK TO IN72R13.STDOK;
MOVE IN72M01.POZDOK TO IN72R13.POZDOK;
MOVE IN72M01.STNAROC TO IN72R13.STNAROC;
