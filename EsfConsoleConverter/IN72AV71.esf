:func      name      = IN72P23           
           date      = '08/31/2021' time = '08:56:58' option = EXECUTE  
           desc      = 'PRIPRAVA ZA ZAPIS IZDAJE IMPOL'
           refine    = N  
:before.
SET IN72R18 EMPTY;
IF FLOK3 = 'DA';
  MOVE IN72M01.IDENT TO IN72R18.IDENT; /* ZAKLENE SKLADIŠÈE IMPOL ZA IZDAJE
  MOVE IN72M01.PREVZEM TO IN72R18.MZ;
  MOVE IN72M01.FIRMA TO IN72R18.FIRMA;
  IN72P16();                     /* update skladišèa

  IF IN72R18 IS ERR;
    EZEREPLY = 0;
    EZEROLLB();                  /* vraèa staro stanje
    MOVE "Napaka pri zaklepanju skladišèa IZDAJA "
      IN72M01.EZEMSG;
    MOVE EZESQCOD TO IN72M01.KODA;
    MOVE 'NE' TO FLOK3;
  ELSE;
    IN72P17();                   /* priprava skladišèa
    IN72P21();                   /* replace skladišèa
    IF IN72R18 IS ERR;
      EZEREPLY = 0;
      EZEROLLB();                /* vraèa staro stanje
      MOVE "Napaka pri spremembi skladišèa IZDAJA "
        IN72M01.EZEMSG;
      MOVE EZESQCOD TO IN72M01.KODA;
      MOVE 'NE' TO FLOK3;
    ELSE;
SET IN72R19 EMPTY;
      IN72P25();                 /* PRIPRAVA ZA ADD IZDAJE
      IN72P27();                 /* DODA IZDAJO ZA IMPOL
      IF IN72R19 IS ERR;
        EZEREPLY = 0;
        EZEROLLB();              /* vraèa staro stanje
        MOVE "Napaka pri dodajanju izdaje "
          IN72M01.EZEMSG;
        MOVE EZESQCOD TO IN72M01.KODA;
        MOVE 'NE' TO FLOK3;
      ELSE;
      END;


    END;

  END;

ELSE;
END;
:ebefore.
:efunc.

:func      name      = IN72P24           
           date      = '08/31/2021' time = '08:56:58' option = UPDATE   
           object    = IN72R07           
