:func      name      = IN72P00           
           date      = '01/27/2025' time = '09:29:50' option = EXECUTE  
           refine    = N  
:before.
MOVE 1 TO EZEFEC;
MOVE 1 TO EZESQISL;
; /* MOVE 1 TO STEVAPPL;
; /* MOVE '192' TO SDOK;
MOVE 'IN72' TO EZESEGTR;
/*
/* **************************************************************/
/* ZA TEST
/* **************************************************************/

/* MOVE '01' TO IN72W01.FIRMA;
/* MOVE 'ZIDOVNIK BREDA' TO IN72W01.ZAPRIIM;
/* MOVE '120' TO SDOK;
/*MOVE 1 TO  IN72M01.NAMEN;
/* MOVE 74 TO IN72W01.IDZAPST;

/* MOVE 24972 TO IN72W01.R2;
/* **************************************************************/
/* KONEC TEST
/* **************************************************************/

MOVE 'IN72A' TO IN72W01.APPL[STEVAPPL];
IN72S01();                       /* clear
/* **************************************************************/
/* DODALA 27.5.2013   izloèila 8.3.2014
/* **************************************************************/
/* MOVE 3699 TO IN72W01.R2;              /* za test
/*
/* IF IN72W01.R2 > 0 ;
/* SET IN72M01.POZDOK BRIGHT;     VNESE POZICIJO  NAJAVE
/* ELSE;
/* MOVE "Vnesi podatke in pritisni ENTER " TO IN72M01.EZEMSG;
/* END;


/* **************************************************************/
/* KONEC
/* **************************************************************/

MOVE 'DELAM' TO FLOK;
WHILE FLOK = 'DELAM';
  MOVE 'DA' TO FLOK1;
  IN72P01();                     /* prikaz mape
  TEST EZEAID PF3 EZEFLO;
  TEST EZEAID PA2 EZECLOS;
  IF EZEAID IS PF6;
    IN72S01();                   /* clear ekrana
    MOVE "Vnesi podatke in pritisni ENTER " TO IN72M01.EZEMSG;
  ELSE;
    IF EZEAID IS PF5;
      IN72W01.STEVAPPL = IN72W01.STEVAPPL + 1;
      DXFR ED01A IN72W01;
    ELSE;
      IF EZEAID IS ENTER;
        IF FLOK1 = 'NE';         /* glava ni OK
        ELSE;
          IN72S11();             /* kontrola glave prevzema
          IF FLOK1 = 'DA';       /* glava je v redu
            MOVE 'DA' TO FLOK2;
            MOVE 'NE' TO FLOK4;
            MOVE 1 TO CTRP;      /* števec pozicij
            MOVE CTRP TO IN72M01.POZDOK;
            WHILE FLOK2 = 'DA';  /* prikaz  pozicij
              IN72P01();         /* prikaz mape
              TEST EZEAID PF3 EZEFLO;
              TEST EZEAID PA2 EZECLOS;
              IF EZEAID IS PF6;
                IN72S01();       /* clear ekrana
                MOVE 'NE' TO FLOK2;
                MOVE 'NEDEL' TO FLOK;
              ELSE;
/* **************************************************************/
/* sumira za komadov v eno pozicijo po komadih in kontrolira ali so kolièina vpisane pri vseh komadih
/* **************************************************************/

                IF EZEAID IS PF4;
                  IF (IN72R12.KLASIFI1 = '60' OR IN72R12.KLASIFI1 = '61' OR IN72R12.KLASIFI1 = '63' OR IN72R12.KLASIFI1 = '70')
                    AND (IN72R12.KLASIFI2 = '02' OR IN72R12.KLASIFI2 = '06' OR IN72R12.KLASIFI2 = '51' OR IN72R12.KLASIFI2 = '59' OR IN72R12.KLASIFI2 = '95' OR IN72R12.KLASIFI2 = '97' OR IN72R12.KLASIFI2 = '96'
                    OR IN72R12.KLASIFI2 = '92' OR IN72R12.KLASIFI2 = 'A1' OR IN72R12.KLASIFI2 = 'A2' OR IN72R12.KLASIFI2 = 'A3'
                    OR (IN72R12.KLASIFI2 = '66' AND (IN72M01.NAMEN NE '9' AND IN72M01.NAMEN NE '7')));

                    MOVE IN72W06.ST1 TO IN72W06.ST3;
                    MOVE 'DA' TO F1;
                    IN72M01.KOLICM = 0;
                    MOVE 1 TO IN72W06.ST3;
                    WHILE IN72W06.ST3 <= IN72W06.ST1;
                      IF IN72M01.KOMADKG[ST3] > 0;
                        IN72M01.KOLICM = IN72M01.KOLICM + IN72M01.KOMADKG[ST3];
                        MOVE IN72M01.KOMADKG[ST3] TO IN72W06.KOMADKG[ST3];
                        MOVE IN72M01.POZKG[ST3] TO IN72W06.POZKG[ST3];
                        MOVE IN72M01.TRAN_ENOTA[ST3] TO IN72W06.TRAN_ENOTA[ST3];
                        IN72W06.ST3 = IN72W06.ST3 + 1;
                        SET IN72M01.KOLICM YELLOW;
                      ELSE;
                        SET IN72M01.KOMADKG[ST3] CURSOR,BRIGHT;
                        MOVE "Vnesi kolièino pri vseh komadih " TO IN72M01.EZEMSG;

                        MOVE 'NE' TO F1;
                        IN72W06.ST3 = IN72W06.ST3 + 1;

                      END;       /* ÈE JE KOLIÈINA VEÈJA OD NIÈ

                    END;         /* ZA WHILE

                    IF F1 = 'DA';

                    ELSE;
                      MOVE 0 TO IN72M01.KOLICM;
                    END;         /* za f1 je da ali ne
                  ELSE;
                  END;

                ELSE;
                END;

/* **************************************************************/
/* konec sumiranja  KOMADOV
/* **************************************************************/

                IF EZEAID IS PF2; /* zapis pozicije
                  MOVE 'DA' TO FLOK5;
                  IN72S05();     /* kontrola pozicije
                  IF FLOK3 = 'DA'; /* kontrola OK
                    MOVE 'NE' TO FLOK3;
                    TIZZP90();   /* timestamp
                    TIZZP91();   /* datum
                    IN72P20();   /* èita stanje skladišèa
                    IF IN72R07 IS ERR; /* ni stanja skladišèa
                      IF IN72R07 IS NRF;
                        IN72P06(); /* polnjenje  skladišèa
                        IN72P22(); /* ADD stanje skladišèa
                        IF IN72R07 IS ERR;
                          MOVE "Skladišè ni prijavljeno za poslovanje "
                            IN72M01.EZEMSG;
                        ELSE;
                          MOVE 'DA' TO FLOK3;
                        END;
                      ELSE;
                      END;
                    ELSE;        /* skladišèe obstaja
                      IN72P24(); /* zaklene skladiŠèe
                      IF IN72R07 IS ERR;
                      ELSE;
                        IN72P08(); /* polnjenje  skladišèa
                        IN72P26(); /* REPL skladišèa
                        IF IN72R07 IS ERR;
                          MOVE "Skladišèe ni replase -ponovi "
                            IN72M01.EZEMSG;
                        ELSE;
                          MOVE 'DA' TO FLOK3;
                        END;
                      END;
                    END;
                    IF FLOK3 = 'DA'; /* skladišèe je ažurirano
                      IN72S04(); /* gen.št.dokumenta
                    END;
/***************************************************************/
/*  zapis certifikata za asi  26.4.2022 
/***************************************************************/

 IF FLOK3 = 'DA'; /

                      IN72P0010(); /* dodakja   glavo in 

                    END;
/***************************************************************/
/*   konec
/***************************************************************/




                    IF FLOK3 = 'DA'; /* èe je generirana številka vredu

                      IN72P02(); /* polni za odložišèe on zapis za komade

                    END;

                    IF FLOK3 = 'DA'; /* parameter je ažuriran
                      IN72P10(); /* polnjenje  prevzema
                      IN72P28(); /* ADD  prevzem
                      IF IN72R08 IS ERR;
                        EZEREPLY = 0;
                        EZEROLLB(); /* vraèa staro stanje
                        MOVE "Pozicija ni prevzeta -ponovi " IN72M01.EZEMSG;
                        MOVE 'NE' TO FLOK3;
                      ELSE;
                        IN72P39(); /* polnjenje  za naroèilo
                        IN72P40(); /* ADD  v mnpromet
                        IF IN72R13 IS ERR;
                          EZEREPLY = 0;
                          EZEROLLB(); /* vraèa staro stanje
                          MOVE "Pozicija ni prevzeta v mnpromet -ponovi "
                            IN72M01.EZEMSG;
                          MOVE EZESQCOD TO IN72M01.KODA;
                        ELSE;


                          IN72P43(); /* zaklene POZICIJO NAROÈILA
                          IF IN72R15 IS ERR;
                            MOVE "NAPAKA PRI UPDATE NAROÈILA " TO
                              IN72M01.EZEMSG;
                            MOVE EZESQCOD TO IN72M01.KODA;

                            EZEREPLY = 0;
                            EZEROLLB(); /* vraèa staro stanje
                          ELSE;

                            IN72P44(); /* PRIPRAVA ZA REPLACE
                                 /* MNPOZNARO
                            IN72P45(); /* REPLACE MNPOZNARO
                            IF IN72R15 IS ERR;
                              EZEREPLY = 0;
                              EZEROLLB(); /* vraèa staro stanje
                            ELSE;


                            END;
                          END;
/* **************************************************************/
/* DODA IZDAJO ZA IMPOL
/* **************************************************************/
                          IF FLOK3 = 'DA' AND IN72M01.STATUS = 1; /* STATUS1 ZA ZAKLJUÈEK LETA
                            IN72P23();
                          ELSE;
                          END;


                          IF FLOK3 = 'DA'; /* DODA PREVZEM ZA DODELAVO NA DRUGI FIRMI
                            IN72P35();
                          ELSE;
                          END;

                          IF FLOK3 = 'DA'; /* DODA ZA LOG PREDELAVA
                            IN72P54();
                          ELSE;
                          END;

                          IF IN72M01.FIRMAVEZA = IN72M01.FIRMA3;
                          ELSE;

                            IF FLOK3 = 'DA'; /* DODA PREVZEM ZA CEVARNO PROFILARNO
                              IN72F35();
                            ELSE;
                            END;
                            IF FLOK3 = 'DA' AND IN72M01.STATUS = 1; /* DODA IZDAJO CEVARNA PROFILARNA ZAKLJUÈEK LETA
                              IN72F23();
                            ELSE;
                            END;


                          END;


/* **************************************************************/
/* razknjižuje dano surovino v sevanl na predelavo ko je namen 8
/* **************************************************************/

                          IF FLOK3 = 'DA' AND IN72M01.NAMEN = '8'; /*
                            IN72P61();
                            IF FLOK6 = 'DA';
                            ELSE;
                              MOVE 'NE' TO FLOK5;
                              MOVE 'NE' TO FLOK3;
                            END;
                          ELSE;
                          END;
/* **************************************************************/
/* konec za razknjiževanje predelave z namenom 2????
/* **************************************************************/


/* **************************************************************/
/* dodaLA ZA INTERNO NAROÈILO
/* **************************************************************/



/* MOVE 'DA' TO FLOK5; dala na zaèetek,da upoštevam tudi pri eksternem naroèilu

                          IF FLOK3 = 'DA'; /* èe je prtej vse vredu drugaèe preskoèi

                            IN72P70(); /* ZA AŽURIRANJE INTERNEGA NAROÈILA
                          ELSE;
                          END;
                          IF FLOK5 = 'DA' AND FLOK3 = 'DA';
                            IN72P60(); /* ZA AŽURIRANJE IDENTA
/* **************************************************************/
/* dodaja za carino  prcesi p86-p89   r r35-XX
/* **************************************************************/


                            IF FLOK5 = 'DA' AND FLOK3 = 'DA' AND
                              (IN72M01.NAMEN = '1' OR
                              IN72M01.NAMEN = '5' OR
                              IN72M01.NAMEN = '7' OR
                              IN72M01.NAMEN = '8' OR
                              IN72M01.NAMEN = '9');



                              IN72P86(); /* zapis za carino

                            ELSE;
                            END;
/* **************************************************************/
/* konec  zapisa za carino
/* **************************************************************/





                            IF FLOK5 = 'DA' AND FLOK3 = 'DA';


                              EZEREPLY = 0;
                              MOVE EZESQCOD TO IN72M01.KODA;
                              EZECOMIT(); /* sprosti resurse
                              IN72S03(); /* prazni pozicijo
                              CTRP = CTRP + 1;
                              IN72S12(); /* èe je pozicij >46
                            ELSE;

                              EZEREPLY = 0;
                              EZEROLLB(); /* vraèa staro stanje
                              MOVE EZESQCOD TO IN72M01.KODA;
                            END; /* R01 ERR2


                          ELSE;
                            EZEREPLY = 0;
                            EZEROLLB(); /* vraèa staro stanje
                            MOVE EZESQCOD TO IN72M01.KODA;
/* MOVE "Pozicija ni prevzeta za namene internega naroèila " IN72M01.EZEMSG;

                          END;   /* da gre ažurirati ident
/* END;



                        END;
                      END;
                    ELSE;        /* skladišèe ni ažurirano
                      EZEREPLY = 0;
                      EZEROLLB(); /* vraèa staro stanje
                      MOVE EZESQCOD TO IN72M01.KODA;
                    END;
                  ELSE;          /* kontrola pozicije ni OK
                  END;
                  MOVE CTRP TO IN72M01.POZDOK;
                  MOVE EZESQCOD TO IN72M01.KODA;
                END;             /* za F2
              END;
            END;                 /* za while
          ELSE;                  /* glava ni O.K.
          END;
        END;                     /* flok1
      ELSE;
        MOVE "Tipka ni na voljo " TO IN72M01.EZEMSG;
      END;                       /* za enter
    END;                         /* za pf5
  END;                           /* za pf6
END;                             /* za while
:ebefore.
:efunc.

