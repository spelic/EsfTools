:func      name      = IN72P35           
           date      = '08/31/2021' time = '08:56:58' option = EXECUTE  
           desc      = 'PREVZEM NA DRUGI FIRMI'
           refine    = N  
:before.
IF FLOK3 = 'DA';
SET IN72R22 EMPTY;
  MOVE IN72M01.IDENT TO IN72R22.IDENT; /* ZAKLENE SKLADIŠÈE DRUGA FIRMA  ZA PREJEMIZDAJE
  MOVE IN72M01.PREVZEM TO IN72R22.MZ;
  MOVE IN72M01.FIRMAVEZA TO IN72R22.FIRMA;
  IN72P38();                     /* update skladišèa DRUGA FIRMA ZA PREJEM


  IF IN72R22 IS ERR;             /* ni IDENTA NA SKLADIŠÈU
    IF IN72R22 IS NRF;
      IN72P46();                 /* polnjenje  skladišèa
      IN72P47();                 /* ADD stanje skladišèa
      IF IN72R22 IS ERR;
        MOVE "NAPAKA PRI ADD SKLADIŠÈA DRUGA FIRMA "
          IN72M01.EZEMSG;
MOVE 'NE' TO FLOK3;
      ELSE;

      END;
    ELSE;
    END;
  ELSE;                          /* skladišèe obstaja
    IN72P48();                   /* zaklene skladiŠèe
    IF IN72R22 IS ERR;
    ELSE;
      IN72R22.STKOLL = IN72R22.STKOLL + IN72M01.KOLICM;
      IN72R22.KUMKOLP = IN72R22.KUMKOLP + IN72M01.KOLICM;
      IN72R22.STVREL = IN72R22.STVREL + 0;
      IN72R22.KUMVRLP = IN72R22.KUMVRLP + 0;
      IN72R22.TEKSTEV = IN72R22.TEKSTEV + 1;
      MOVE DAZZW01.TI26CTIM TO IN72R22.DATURA;

      IN72P49();                 /* REPL skladišèa
      IF IN72R22 IS ERR;
        MOVE "Skladišèe ni replase -ponovi "
          IN72M01.EZEMSG;
  MOVE 'NE' TO FLOK3;
      ELSE;

      END;
    END;
  END;

  IF FLOK3 = 'DA';
SET IN72R23 EMPTY;
    IN72P52();                   /* POLNI PREVZEM DRUGA FIRMA
    IN72P53();                   /* PREVZEM DRUGA FIRMA   DODA R23

    IF IN72R23 IS ERR;
      MOVE "NAPAKA PRI DODAJANJU PREVZEMA DRUGA FIRMA "
        IN72M01.EZEMSG;
MOVE 'NE' TO FLOK3;
    ELSE;

    END;

  ELSE;
  END;

ELSE;
END;                             /* ÈE JE PREJ NAPAKA
:ebefore.
:efunc.

