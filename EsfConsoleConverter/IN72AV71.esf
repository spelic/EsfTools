:func      name      = IN72P002          
           date      = '06/15/2022' time = '11:24:15' option = EXECUTE  
           desc      = 'ZA NAJAVO'
           refine    = N  
:before.
MOVE 'DA' TO FLOK1;
/* **************************************************************/
/* za komitenta s07
/* **************************************************************/

IF IN72W01.SDOK ^= '192';
  IF IN72M01.KOMITENT NE IN72W02.KOMITENT;
    MOVE IN72M01.KOMITENT TO IN72R04.KOMITENT;
    MOVE IN72M01.KOMITENT TO IN72W02.KOMITENT;
    IN72P13();                   /* èita komitente
    IF IN72R04 IS ERR;
      MOVE "Dobavitelj ne obstaj" TO IN72M01.EZEMSG;
      SET IN72M01.KOMITENT CURSOR,MODIFIED,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
      MOVE '   ' TO IN72W02.KOMITENT;
    ELSE;
      MOVE IN72R04.KRNAZ TO IN72M01.KRNAZ;
      ; /* SET IN72M01.KOMITENT PROTECT,BRIGHT;
    END;
  END;
ELSE;
END;

/* **************************************************************/
/* za proizvajalca s50
/* **************************************************************/


MOVE IN72M01.PROIZVAJALEC TO IN72R04.KOMITENT;

IN72P13();                       /* èita komitente
IF IN72R04 IS ERR;
  MOVE "Proizvajalec ne obstaja ne obstaj" TO IN72M01.EZEMSG;
  SET IN72M01.PROIZVAJALEC CURSOR,MODIFIED,BRIGHT;
  MOVE 'NE' TO FLOK1;            /* glava ni v redu

ELSE;


  MOVE IN72R04.KRNAZ TO IN72M01.KRNAZP;
  SET IN72M01.PROIZVAJALEC PROTECT;

END;

/* **************************************************************/
/* za konto s09
/* **************************************************************/

IF IN72M01.KONTO NE IN72W02.KONTO;
  MOVE IN72M01.KONTO TO IN72R05.SIFKTO;
  MOVE IN72M01.KONTO TO IN72W02.KONTO;
  IN72P14();                     /* èita konte
  IF IN72R05 IS ERR;
    MOVE "Konto ne obstaja" TO IN72M01.EZEMSG;
    SET IN72M01.KONTO CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
    MOVE '  ' TO IN72W02.KONTO;
  ELSE;                          /* konto O.K.
/* SET IN72M01.VP CURSOR,MODIFIED;
  END;
ELSE;
END;

/* **************************************************************/
/* za prejemnika strm sifpreje  s10
/* **************************************************************/





MOVE IN72M01.FIRMA TO IN72R17.FIRMA;
MOVE IN72M01.SIFPREJE TO IN72R17.SIFMZ;


IN72P80();
IF IN72R17 IS ERR;
  MOVE ' TA ŠIFRA PREJEMNIKA NE OBSTAJA' TO IN72M01.EZEMSG;


  SET IN72M01.SIFPREJE CURSOR,MODIFIED,BRIGHT;
  MOVE '                                   ' TO IN72M01.NAZIVP;

  MOVE 9999 TO EZEMNO;
ELSE;

  MOVE IN72R17.NAZIVMZ TO IN72M01.NAZIVP;

  IF IN72M01.SIFPREJE = '01001'; /* LIVNICA
    MOVE '011' TO IN72M01.ORGEN;
/* MOVE 'D' TO IN72M01.ZAPIS1;
  END;
  IF IN72M01.SIFPREJE = '01801'; /* KASTER
    MOVE '018' TO IN72M01.ORGEN;
/* MOVE 'D' TO IN72M01.ZAPIS1;
  END;
  IF IN72M01.SIFPREJE = '02201'; /* VALJARNA
    MOVE '021' TO IN72M01.ORGEN;
/* MOVE 'N' TO IN72M01.ZAPIS1;
  END;
  IF IN72M01.SIFPREJE = '02501'; /* FOLISKA
    MOVE '031' TO IN72M01.ORGEN;
/* MOVE 'N' TO IN72M01.ZAPIS1;
  END;
  IF IN72M01.SIFPREJE = '03301'; /* PROFILI
    MOVE '041' TO IN72M01.ORGEN;
/* MOVE 'N' TO IN72M01.ZAPIS1;
  END;
  IF IN72M01.SIFPREJE = '03201'; /* cevarna sprejema pa za livnico da na predelavo
    MOVE '051' TO IN72M01.ORGEN;
/* MOVE 'D' TO IN72M01.ZAPIS1;
  END;
  IF IN72M01.SIFPREJE = '03401'; /* PROFILI
    MOVE '034' TO IN72M01.ORGEN;
/* MOVE 'N' TO IN72M01.ZAPIS1;
  END;
  IF IN72M01.SIFPREJE = '03501'; /* PROFILI
    MOVE '035' TO IN72M01.ORGEN;
/* MOVE 'N' TO IN72M01.ZAPIS1;
  END;

  IF IN72M01.FIRMAVEZA = '11';
    MOVE 'D' TO IN72M01.ZAPIS1;
  ELSE;
    MOVE 'N' TO IN72M01.ZAPIS1;
  END;
END;
/* **************************************************************/
/* vp s08
/* **************************************************************/

IF IN72M01.VP NE IN72W02.VP;
  MOVE IN72M01.VP TO IN72R06.SIFRAVP;
  MOVE IN72M01.VP TO IN72W02.VP;
  IN72P18();                     /* èita VP
  IF IN72R06 IS ERR;
    MOVE "VP ne obstaja" TO IN72M01.EZEMSG;
    SET IN72M01.VP CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
    MOVE '  ' TO IN72W02.VP;
  ELSE;
    IF IN72W01.SDOK = '120';
      IF IN72M01.VP = '07'
        OR IN72M01.VP = '08'
        OR IN72M01.VP = '84';
        ; /* SET IN72M01.VP PROTECT,BRIGHT;
      ELSE;
        MOVE "Napaèen VP : 07, 08 ali 84" TO IN72M01.EZEMSG;
        SET IN72M01.VP CURSOR,MODIFIED,BRIGHT;
        MOVE '  ' TO IN72W02.VP;
        MOVE 'NE' TO FLOK1;      /* glava ni v redu
      END;
    END;
    IF IN72W01.SDOK = '134';
      IF IN72M01.VP = '42';
        ; /* SET IN72M01.VP PROTECT,BRIGHT;
      ELSE;
        MOVE 'NE' TO FLOK1;      /* glava ni v redu
        MOVE "Napaèen VP : 42" TO IN72M01.EZEMSG;
        SET IN72M01.VP CURSOR,MODIFIED,BRIGHT;
        MOVE '  ' TO IN72W02.VP;
      END;
    ELSE;
      IF IN72W01.SDOK = '192';
        IF IN72M01.VP = '24'
          OR IN72M01.VP = '22';
          ; /* SET IN72M01.VP PROTECT,BRIGHT;
        ELSE;
          MOVE 'NE' TO FLOK1;    /* glava ni v redu
          MOVE "Napaèen VP :(24 ali 22)" TO IN72M01.EZEMSG;
          SET IN72M01.VP CURSOR,MODIFIED,BRIGHT;
          MOVE '  ' TO IN72W02.VP;
        END;
      END;
    END;
  END;
END;

/* **************************************************************/
/* dodala za èitanje naroèila glave  19.2.2015
/* **************************************************************/
IF IN72M01.LETO = 00000;

  MOVE "  OBVEZEN VPIS LETA NAROÈILA " TO IN72M01.EZEMSG;
  SET IN72M01.LETO CURSOR,MODIFIED,BRIGHT;
  MOVE 9999 TO EZEMNO;
END;
IF IN72M01.STNAROC = 00000;

  MOVE "  OBVEZEN VPIS  ŠTEVILKE NAROÈILA " TO IN72M01.EZEMSG;
  SET IN72M01.STNAROC CURSOR,MODIFIED,BRIGHT;
  MOVE 9999 TO EZEMNO;

END;


MOVE IN72M01.LETO TO IN72W02.LETONARO;
MOVE IN72M01.STNAROC TO IN72W02.STNAROC;
MOVE IN72W02.LETONARO TO IN72R14.LETO;
MOVE IN72W02.STNAROC TO IN72R14.STNAROC;
IN72P41();
IF IN72R14 IS ERR;
  MOVE ' TO NAROÈILO NE OBSTAJA' TO IN72M01.EZEMSG;
  MOVE 0000 TO IN72M01.LETO;
  MOVE 00000 TO IN72M01.STNAROC;
  SET IN72M01.LETO CURSOR,BRIGHT;

  MOVE 9999 TO EZEMNO;
ELSE;

/* **************************************************************/
/* VALUTA  za glava naroèila
/* **************************************************************/


  MOVE '705' TO IN72R50.SIFRA3;
  MOVE IN72R14.SIFVAL32 TO IN72R50.SIFVAL32;
  IN72P50();                     /* èita MAKSIMALNI TEÈAJ ZA DATUM
  IF EZESQCOD = 0;
    MOVE IN72R50.DATUM TO IN72R51.DATUM;
    MOVE '705' TO IN72R51.SIFRA3;
    MOVE IN72R14.SIFVAL32 TO IN72R51.SIFVAL32;
    IN72P51();                   /* ÈITA TEÈAJ DSATUM
    MOVE IN72R51.RAZMERJE TO IN72W02.TECAJ;
  ELSE;
  END;
/* **************************************************************/
/* KONEC
/* **************************************************************/
  SET IN72R006 EMPTY;
  MOVE IN72M01.LETO TO IN72R006.LETO;
  MOVE IN72M01.STNAROC TO IN72R006.STNAROC;
  MOVE 1 TO IN72R006.POZNARO;
  IN72P010();                    /* èita pozicijo da pridem do pogodbe ID_NABPPOGODBA + carinski dokumenti IMP.NABPNAROCANJE

  IF EZESQCOD = 100;
    SET IN72R0013 EMPTY;
    MOVE IN72R14.KOMITENT TO IN72R0013.KOMITENT;
    IN72P0021();                 /* ÈITA DRŽAVO ZA KOMITENTA
    MOVE IN72R0013.SIFRA3 TO IN72M01.DRZODPREME;
    MOVE IN72R0013.NAZIVDR TO IN72M01.NDRZODPREME;
    MOVE "  Preveri državo odpreme " TO IN72M01.EZEMSG;
/* MOVE '000' TO IN72M01.DRZODPREME;
  ELSE;
    MOVE IN72R006.SIFRA3 TO IN72M01.DRZODPREME;
    MOVE IN72R006.NAZIVDR TO IN72M01.NDRZODPREME;
  END;
  MOVE IN72R14.KOMITENT TO IN72M01.KOMITENT;
  IF IN72R14.PROIZVAJALEC = ' ' OR IN72R14.PROIZVAJALEC = NULL;
    MOVE IN72R14.KOMITENT TO IN72M01.PROIZVAJALEC;
  ELSE;
    MOVE IN72R14.PROIZVAJALEC TO IN72M01.PROIZVAJALEC;
  END;
  SET IN72M01.KOMITENT CURSOR,BRIGHT;
  SET IN72M01.LETO AUTOSKIP,BRIGHT;
  SET IN72M01.STNAROC AUTOSKIP,BRIGHT;
  SET IN72M01.POZNARO AUTOSKIP,BRIGHT;
/* **************************************************************/
/* dodala 23.11.2009  za glavo naroèila
/* **************************************************************/
  SET IN72M01.FIRMAVEZA PROTECT;
  SET IN72M01.FIRMA3 PROTECT;
  SET IN72M01.SIFPREJE PROTECT;

/* **************************************************************/
/* konec  za glavo naroèila
/* **************************************************************/

  SET IN72M01.POZICIJAF AUTOSKIP,BRIGHT;
  MOVE IN72R14.CARPOST2 TO IN72M01.CARPOST2;
  MOVE IN72R14.SIFVAL32 TO IN72W02.SIFVAL32;
END;
/* **************************************************************/
/* konec za glavo naroèila 19.2.2015
/* **************************************************************/



/* **************************************************************/
/* kontrola namen s  14
/* **************************************************************/


IF IN72M01.NAMEN NE IN72W02.NAMEN;
  MOVE IN72M01.NAMEN TO IN72W02.NAMEN;
  IF IN72W01.SDOK = '120';
    IF IN72M01.NAMEN = '1'
      OR IN72M01.NAMEN = '2'

      OR IN72M01.NAMEN = '4'
      OR IN72M01.NAMEN = '5'
      OR IN72M01.NAMEN = '8'
      OR IN72M01.NAMEN = '9'
      OR IN72M01.NAMEN = '7';
      MOVE 'DA' TO FLOK1;        /* glava je vredu
/* **************************************************************/
/* DODAM ,KO JE PREJEM IZ SEVALA
/* **************************************************************/

      IF IN72M01.NAMEN = '8';
        SET IN72M01.STFAKTUR CURSOR,MODIFIED,BRIGHT;
        SET IN72M01.LETOF BRIGHT;
      ELSE;
        SET IN72M01.STDOBAV CURSOR,MODIFIED,BRIGHT;
      END;


    ELSE;
      MOVE "Namen je 1, 2 , 3 , 7,8,9" TO IN72M01.EZEMSG;
      SET IN72M01.NAMEN CURSOR,MODIFIED,BRIGHT;
      MOVE ' ' TO IN72W02.NAMEN;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    END;
  END;
END;
IF FLOK1 = 'DA';
  SET IN72M01.STPOZ CURSOR,MODIFIED,BRIGHT;
ELSE;
END;
