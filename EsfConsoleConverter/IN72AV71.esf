:func      name      = IN72F35           
           date      = '08/31/2021' time = '08:56:57' option = EXECUTE  
           desc      = 'PREVZEM NA TRETJI F'
           refine    = N  
:before.
IF FLOK3 = 'DA';
SET IN72R220 EMPTY;
  MOVE IN72M01.IDENT TO IN72R220.IDENT; /* ZAKLENE SKLADIŠÈE DRUGA FIRMA  ZA PREJEMIZDAJE
  MOVE IN72M01.PREVZEM TO IN72R220.MZ;
  MOVE IN72M01.FIRMA3 TO IN72R220.FIRMA;
  IN72F38();                     /* update skladišèa DRUGA FIRMA ZA PREJEM


  IF IN72R220 IS ERR;             /* ni IDENTA NA SKLADIŠÈU
    IF IN72R220 IS NRF;
      IN72F46();                 /* polnjenje  skladišèa
      IN72F47();                 /* ADD stanje skladišèa
      IF IN72R220 IS ERR;
        MOVE "NAPAKA PRI ADD SKLADIŠÈA DRUGA FIRMA "
          IN72M01.EZEMSG;
MOVE 'NE' TO FLOK3;
      ELSE;

      END;
    ELSE;
    END;
  ELSE;                          /* skladišèe obstaja
    IN72F48();                   /* zaklene skladiŠèe
    IF IN72R220 IS ERR;
    ELSE;
      IN72R220.STKOLL = IN72R220.STKOLL + IN72M01.KOLICM;
      IN72R220.KUMKOLP = IN72R220.KUMKOLP + IN72M01.KOLICM;
      IN72R220.STVREL = IN72R220.STVREL + 0;
      IN72R220.KUMVRLP = IN72R220.KUMVRLP + 0;
      IN72R220.TEKSTEV = IN72R220.TEKSTEV + 1;
      MOVE DAZZW01.TI26CTIM TO IN72R220.DATURA;

      IN72F49();                 /* REPL skladišèa
      IF IN72R220 IS ERR;
        MOVE "Skladišèe ni replase -ponovi FIRMA3 "
          IN72M01.EZEMSG;
  MOVE 'NE' TO FLOK3;
      ELSE;

      END;
    END;
  END;

  IF FLOK3 = 'DA';
SET IN72R230 EMPTY;
    IN72F52();                   /* POLNI PREVZEM DRUGA FIRMA
    IN72F53();                   /* PREVZEM DRUGA FIRMA   DODA R230

    IF IN72R230 IS ERR;
      MOVE "NAPAKA PRI DODAJANJU PREVZEMA FIRMA3 " IN72M01.EZEMSG;
MOVE 'NE' TO FLOK3;
    ELSE;

    END;

  ELSE;
  END;

ELSE;
END;                             /* ÈE JE PREJ NAPAKA
