:func      name      = IN72P44           
           date      = '08/31/2021' time = '08:56:58' option = EXECUTE  
           desc      = 'priprava naroèila za replace'
           refine    = N  
:before.

IF IN72R15.EM = 23;
  KOLNA = IN72M01.KOLICM / 1000 (R;
  IN72R15.KOLPREVZ = IN72R15.KOLPREVZ + KOLNA;
  ; /* IN72R15.KOLPREVZ = IN72R15.KOLPREVZ + IN72M01.KOLICM; /*za pretvorbo
  ; /* KOLNA = IN72R15.KOLICINA * 1000 (R;
ELSE;
  IN72R15.KOLPREVZ = IN72R15.KOLPREVZ + IN72M01.KOLICM;
  ; /* KOLNA = IN72R15.KOLICINA;
END;

/* IN72W02.V1 = (IN72R15.KOLICINA / 100) * 10;
/* IN72W02.V2 = IN72W02.V1 + IN72R15.KOLICINA;
/*
/*
/* IF IN72R15.KOLPREVZ < IN72W02.V2 OR
/* IN72R15.KOLPREVZ = IN72W02.V2 ;
/***************************************************************/
/*pozicija dobi status 8 ko prviè preseže ali doseže dobavna kolièina naroèeno kolièino definiral Dejan 12.7.2019
/***************************************************************/

IF IN72R15.KOLPREVZ > IN72R15.KOLICINA OR
  IN72R15.KOLPREVZ = IN72R15.KOLICINA;
  MOVE 8 TO IN72R15.STATUS;
ELSE;
  MOVE 2 TO IN72R15.STATUS;
END;


/* ELSE;
/* MOVE "Skupna kolièina dobave je veèja kot na eksternem naroèilu " TO  IN72M01.EZEMSG;
/* MOVE 'NE' TO FLOK5;
/*
/*
/*
/* END;
/*

MOVE DAZZW01.DA10CDAT TO IN72R15.DATPREVZ;
MOVE DAZZW01.TI26CTIM TO IN72R15.DATURA;


/* **************************************************************/
/* dodala  2m7m2019
/* **************************************************************/

IN72W02.KOLICINA10P = 0;
IN72W02.KOLICINA10 = 0;
IN72W02.KOLICINA5T = 0;
SET IN72R0020 EMPTY;
MOVE IN72M01.LETO TO IN72R0015.LETO;
MOVE IN72M01.STNAROC TO IN72R0015.STNAROC;

IN72P0027();                     /* èita dobavljeno na celi pogodbi  r0015
IN72W02.KOLICINA10P = (IN72R0015.KOLICINA / 10); /* 10 proc od naroèene kolièine
IN72W02.KOLICINA10 = ((IN72R0015.KOLICINA / 10) + IN72R0015.KOLICINA); /* kolièina z 10 proc
IN72W02.KOLICINA5T = IN72R0015.KOLICINA + 5; /* kolièina plus 10 ton
IF IN72W02.KOLICINA10P > 5;
  IN72W02.KOLKONTROLA = IN72W02.KOLICINA10;
ELSE;
  IN72W02.KOLKONTROLA = IN72W02.KOLICINA5T;
END;
/* **************************************************************/
/* konec
/* **************************************************************/
SET IN72R0020 EMPTY;
IF (IN72R15.STATUS > 0) AND ((IN72W02.KOLKONTROLA < IN72R0015.KOLPREVZ) OR (IN72W02.KOLKONTROLA = IN72R0015.KOLPREVZ));
ELSE;
  MOVE IN72M01.LETO TO IN72R0020.LETO;
  MOVE IN72M01.STNAROC TO IN72R0020.STNAROC;
  MOVE 8 TO IN72R15.STATUS;

  IN72P0050();                   /* sqlexec

  IF EZESQCOD = 0;
  ELSE;
    MOVE 'NE' TO FLOK5;
    MOVE "Napaka pri zapiranju celotnega naroèila " IN72M01.EZEMSG;
    MOVE EZESQCOD TO IN72M01.KODA;
  END;
END;
:ebefore.
:efunc.

