/* **************************************************************/
:ebefore.
:efunc.

:func      name      = IN72S06           
           date      = '01/24/2025' time = '11:51:01' option = EXECUTE  
           desc      = 'rutina na komade .pr po komadi'
           refine    = N  
:before.
/* **************************************************************/
/* dodala za prevzem po komadih      23.11.2009
/* **************************************************************/
IF EZEAID IS ENTER AND IN72M01.KOMADI IS MODIFIED;
  SET IN72R12 EMPTY;
  SET IN72W06 EMPTY;
  MOVE 1 TO IN72W06.ST5;
  WHILE IN72W06.ST5 <= 16;
    IF IN72M01.STPOZ = 0;
      MOVE 0 TO IN72M01.KOMADKG[IN72W06.ST5];
      MOVE 0 TO IN72M01.POZKG[IN72W06.ST5];
    ELSE;
    END;
    SET IN72M01.KOMADKG[IN72W06.ST5] PROTECT;
    IN72W06.ST5 = IN72W06.ST5 + 1;


  END;


  MOVE IN72M01.IDENT TO IN72R12.IDENT;
  MOVE '01' TO IN72R12.FIRMA;
  IN72P15();
  IF IN72R12 IS ERR;
    MOVE "Napaka pri branju identa za klasif. komada" TO IN72M01.EZEMSG;
    SET IN72M01.IDENT CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;
  ELSE;
    MOVE 'DA' TO FLOK1;
  END;
  IF (IN72R12.KLASIFI1 = '60' OR IN72R12.KLASIFI1 = '61' OR IN72R12.KLASIFI1 = '63'  OR  IN72R12.KLASIFI1 = '70')
    AND (IN72R12.KLASIFI2 = '02' OR IN72R12.KLASIFI2 = '06' OR IN72R12.KLASIFI2 = '51' OR IN72R12.KLASIFI2 = '59' OR IN72R12.KLASIFI2 = '95' OR IN72R12.KLASIFI2 = '97' OR IN72R12.KLASIFI2 = '96'
OR IN72R12.KLASIFI2 = '92' OR IN72R12.KLASIFI2 = 'A1' OR IN72R12.KLASIFI2 = 'A2'  OR IN72R12.KLASIFI2 = 'A3'
    OR (IN72R12.KLASIFI2 = '66' AND (IN72M01.NAMEN NE '9' AND IN72M01.NAMEN NE '7')));


    MOVE IN72M01.KOMADI TO IN72W06.ST1; /* st1 = 6
    IF IN72W06.ST1 < 17;
      MOVE 1 TO IN72W06.ST2;
      WHILE IN72W06.ST2 <= IN72W06.ST1;
        MOVE IN72W06.ST2 TO IN72M01.POZKG[IN72W06.ST2];
        SET IN72M01.KOMADKG[IN72W06.ST2] BRIGHT;
        IN72W06.ST2 = IN72W06.ST2 + 1;
      END;
      SET IN72M01.KOMADKG[1] CURSOR,BRIGHT;

      MOVE 0 TO IN72M01.KOLICM;
      SET IN72M01.KOLICM PROTECT;
    ELSE;

      MOVE "Za pozicijo prevzema je lahko najveè 16 komadov" TO IN72M01.EZEMSG;
      MOVE 'NE' TO FLOK1;
      SET IN72M01.KOMADI CURSOR,MODIFIED,BRIGHT;

    END;                         /* èe je preveè vpisanih komadov  Veè kot 16

  ELSE;
    SET IN72M01.KOLICM CURSOR,BRIGHT;
  END;
/* **************************************************************/
/* konec       23.11.2009

ELSE;
END;
:ebefore.
:efunc.

