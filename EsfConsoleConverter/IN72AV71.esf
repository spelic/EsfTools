      MOVE ' ' TO IN72M01.STDOBAV;
      MOVE IN72R001.STDOBAV TO IN72M01.STDOBAV; /* dodala 8.5.2017 Breda
    ELSE;
    END;

    IF IN72R001.VD = '134';
      MOVE '134' TO IN72M01.VD;
      MOVE '10020' TO IN72M01.PREVZEM;

      MOVE '316000' TO IN72M01.KONTO;
      MOVE '42' TO IN72M01.VP;
