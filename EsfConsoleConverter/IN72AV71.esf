  ELSE;
    MOVE "Napaka pri branju najave .Pritisni F3 in si izberi najavo " TO IN72M01.EZEMSG;
  END;



ELSE;                            /* dodala 27.5.2013  SAMO ELSE;
  IF IN72W01.SDOK = '120';
    MOVE '120' TO IN72M01.VD;
