:func      name      = IN82P23           
           date      = '03/05/2021' time = '09:59:35' option = EXECUTE  
           refine    = N  
:before.
SET IN82R03 EMPTY;
MOVE IN82M01.SPREGLED TO IN82R03.SARZA; /* za èitanje nsarze  char

IN82P21();                       /* èita char saržo v nsarze
IF EZESQCOD = 0;
  MOVE IN82R03.SARZA TO IN82W04.SARZANUM;
MOVE IN82R03.SARZA TO IN82W04.SARZAIZVORNA;
  IN82W04.SARZAWS = IN82R03.SARZA;
  SET IN82R03 EMPTY;

  MOVE IN82W04.SARZANUM TO IN82R03.IDSARZA; /* za èitanje nsarze idsarze

  IN82P22();                     /* bere idsarzo
  IF EZESQCOD = 0;
    IF IN82W04.SARZAWS = IN82R03.SARZA;
      MOVE IN82R03.SARZA TO IN82W04.SARZAIZVORNA;
    ELSE;
      MOVE IN82W04.SARZAWS TO IN82W04.SARZAIZVORNA;
      MOVE "Preveri generirana in izvorna sarža se nahajata v razliènig slogih " TO IN82M01.MSG;
    END;                         /* konec napaka pri èitanju

  END;
ELSE;
  IF EZESQCOD = 100;             /* sarza v polju char ne obstaja

    SET IN82R03 EMPTY;
    MOVE IN82W04.SARZANUM TO IN82R03.IDSARZA; /* za èitanje nsarze idsarze
    IN82P22();                   /* èita po idsarža

    IF EZESQCOD = 0;
      MOVE IN82R03.SARZA TO IN82W04.SARZAIZVORNA; /* dobim izvorno sarzo iz idsarze
    ELSE;

    END;


  ELSE;                          /* napaka v branju sarza char ne obstaja
  END;
END;
:ebefore.
:efunc.

:func      name      = IN82P60           
           date      = '10/15/2024' time = '11:52:30' option = EXECUTE  
           desc      = 'pregled dolžin sarže'
           refine    = N  
:before.
MOVE 'DA' TO FLOK3;
MOVE 'DA' TO FLOK10;
MOVE " " TO IN82M10.P1;
MOVE IN82W01.NAZIVF TO IN82M10.BESEDA1;
/* MOVE IN82M01.FIRMA TO IN82R60.FIRMA;
IF IN82M01.OPOMBA[STEV1] = '*';  /* preveri èe pgre èitati tabelo za opombe
  SET IN82R11 EMPTY;
  MOVE IN82M01.SARZAP[STEV1] TO IN82R11.SARZA;

  MOVE IN82W01.FIRMA TO IN82R11.FIRMA;
  IN82P86();
  MOVE IN82R11.TEKST1 TO IN82M10.TEKST1;
  MOVE IN82R11.TEKST2 TO IN82M10.TEKST2;
ELSE;
END;
SET IN82R601 EMPTY;
MOVE IN82M01.IDENTP[STEV1] TO IN82R61.IDENT;


IN82P67();                       /* ÈITA IDENT IZ PRVEGA SEZNAMA R61
MOVE IN82R61.DIMENZ40 TO IN82M10.DIMENZ40;


MOVE IN82M01.SARZAP[STEV1] TO IN82R60.SARZA;
MOVE IN82M01.SARZAP[STEV1] TO IN82R601.SARZA;
MOVE IN82M01.SARZAP[STEV1] TO IN82R602.SARZA;
IN82P621();                      /* èita nsarze
IF EZESQCOD = 0;
  MOVE IN82R601 TO IN82M10;
  IF IN82R601.KOMENTAR_2 NE ' ';
    MOVE IN82R601.KOMENTAR_2 TO IN82M10.KOMENTAR; /* 10/2024
  END;
END;

MOVE IN82M01.SARZAP[STEV1] TO IN82M10.SARZAP;
MOVE STEV1 TO ST10;

IN82P62();
/* **************************************************************/
/* èita dolžino za livniške drogove po šarži
/* **************************************************************/

MOVE 'DA' TO FLOK30;
MOVE 1 TO CTRL15;
WHILE FLOK30 = 'DA';
  IF EZESQCOD = 0;
    IN82P63();                   /* sqen
    IF EZESQCOD = 0 AND CTRL15 < 60;
      MOVE IN82R60.STDROGA TO IN82W02.STDROGA[CTRL15];
      MOVE IN82R60.ZLITINA TO IN82W02.ZLITINA[CTRL15];
      MOVE IN82R60.DOLZINA TO IN82W02.DOLZINA[CTRL15];

      MOVE IN82R60.TEZA TO IN82W02.TEZA[CTRL15];
      MOVE IN82R60.IDDROGA TO IN82W02.IDDROGA[CTRL15];
      MOVE "Št.droga" TO IN82M10.P1;


      CTRL15 = CTRL15 + 1;
    ELSE;
      MOVE 'NE' TO FLOK30;
    END;
  ELSE;
    MOVE 'NE' TO FLOK30;
    MOVE ' NAPAKA PRI SETINQ-PONOVE ' TO IN82M10.EZEMSG;
    MOVE 9999 TO EZEMNO;
  END;




END;                             /* */ za while flok30=da
/* **************************************************************/
/* **************************************************************/
/* konec
/* **************************************************************/
/* èita za eksterne drogove dolžino
/* **************************************************************/
IN82P622();                      /* sein
MOVE 'DA' TO FLOK30;
MOVE 1 TO CTRL15;
WHILE FLOK30 = 'DA';
  IF EZESQCOD = 0;
    IN82P632();                  /* scan
    IF EZESQCOD = 0 AND CTRL15 < 60;
      MOVE IN82R602.KOMADI TO IN82W02.STDROGA[CTRL15];
      MOVE IN82R601.ZLITINA TO IN82W02.ZLITINA[CTRL15];
      MOVE IN82R602.DOLZINA TO IN82W02.DOLZINA[CTRL15];

      MOVE IN82R602.KOLICINA TO IN82W02.TEZA[CTRL15];
      MOVE "Komadi" TO IN82M10.P1;


      CTRL15 = CTRL15 + 1;
    ELSE;
      MOVE 'NE' TO FLOK30;
    END;
  ELSE;
    MOVE 'NE' TO FLOK30;
    MOVE ' NAPAKA PRI SETINQ-PONOVE ' TO IN82M10.EZEMSG;
    MOVE 9999 TO EZEMNO;
  END;


END;                             /* */ za while flok30=da
/* **************************************************************/
/* konec
/* **************************************************************/


IN82P66();                       /* prikaz mape






MOVE 9999 TO EZEMNO;
WHILE FLOK10 = 'DA';
  MOVE 'DA' TO FLOK4;
  IN82P61();
              /* prikaz mape m10
  IF EZEAID IS PF5;              /* izpis
    IN82P07();                   /* izpis
  END;

  IF EZEAID IS PF8;
    IN82P64();
    MOVE 'DA' TO FLOK10;
  ELSE;
  END;
  IF EZEAID IS PF7;
    IN82P65();
    MOVE 'DA' TO FLOK10;
  ELSE;
  END;

  IF EZEAID IS PF3;
    MOVE 'NE' TO FLOK10;
    MOVE 41 TO STEV1;

    SET IN82M10 CLEAR;
    MOVE IN82W01.NAZIVF TO IN82M01.NAZIVF;

    MOVE 1 TO STEW1;
    WHILE STEW1 < 60;

      MOVE ' ' TO IN82W02.ZLITINA[STEW1];
      MOVE 0 TO IN82W02.DOLZINA[STEW1];
      MOVE 0 TO IN82W02.TEZA[STEW1];
      MOVE 0 TO IN82W02.IDDROGA[STEW1];
      MOVE 0 TO IN82W02.STDROGA[STEW1];
      MOVE " " TO IN82M10.P1;

      STEW1 = STEW1 + 1;
      SET IN82M01.SARZAP[ST10] CURSOR;
    END;




  END;
/* END;
END;
:ebefore.
:efunc.

