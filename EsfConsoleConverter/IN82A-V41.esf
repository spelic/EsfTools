    IF IN82W05.P1 = '%';
      IN82W05.P1 = ' ';          /* prazni
    END;
    IF IN82W05.P2 = '%';
      IN82W05.P2 = ' ';          /* prazni
    END;
    IF IN82W05.P3 = '%';
      IN82W05.P3 = ' ';          /* prazni
    END;
    IF IN82W05.P4 = '%';
      IN82W05.P4 = ' ';          /* prazni
    END;


    IF IN82W05.ZLITINA NE ' ';
      MOVE IN82W05.ZLITINA TO IN82R06.ZLITINA;
      IN82F08();                 /* inq sqluser.klasifi
