           date      = '03/05/2021' time = '09:59:35' option = EXECUTE  
           desc      = 'preverja in sestavlja saržo'
           refine    = N  
:before.
IN82W04.SARZANUM = 0;
IN82W04.SARZAIZVORNA = ' ';
MOVE IN82M01.SPREGLED TO IN82W04.SARZACHAR;

KONEC = 'NE';

/* preveri char znake èe je char je konec
STEVEC15 = 1;
WHILE STEVEC15 <= 6;             /* vpisanih prvih šest polj na mapi
  IF IN82W04.C1[STEVEC15] = '0' OR
    IN82W04.C1[STEVEC15] = '1' OR
    IN82W04.C1[STEVEC15] = '2' OR
    IN82W04.C1[STEVEC15] = '3' OR
    IN82W04.C1[STEVEC15] = '4' OR
    IN82W04.C1[STEVEC15] = '5'
    OR IN82W04.C1[STEVEC15] = '6' OR
    IN82W04.C1[STEVEC15] = '7' OR
    IN82W04.C1[STEVEC15] = '8'
    OR IN82W04.C1[STEVEC15] = '9';
  ELSE;
    KONEC = 'DA';
  END;

  STEVEC15 = STEVEC15 + 1;
END;


IF KONEC = 'DA';
  IN82W04.SARZANUM = 999999;     /* inc
  MOVE IN82W04.SARZACHAR TO IN82W04.SARZAIZVORNA; /* dobimo sarzo za lokacijo

