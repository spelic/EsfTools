:func      name      = IN82P64           
           date      = '03/05/2021' time = '09:59:35' option = EXECUTE  
           refine    = N  
:before.
IF INT14 < 60;
  CTRL16 = 1;
  WHILE CTRL16 <= 15 AND INT14 < 60;
    MOVE IN82W02.ZLITINA[INT14] TO IN82M10.ZLITINA[CTRL16];
    MOVE IN82W02.DOLZINA[INT14] TO IN82M10.DOLZINA[CTRL16];
    MOVE IN82W02.TEZA[INT14] TO IN82M10.TEZA[CTRL16];
    MOVE IN82W02.IDDROGA[INT14] TO IN82M10.IDDROGA[CTRL16];
 MOVE IN82W02.STDROGA[INT14] TO IN82M10.STDROGA[CTRL16];




    CTRL16 = CTRL16 + 1;
    INT14 = INT14 + 1;
  END;

  MOVE 'KONEC LISTE  '
    TO IN82M10.EZEMSG;
  MOVE 'DA' TO FLOK5;
END;
:ebefore.
:efunc.

:func      name      = IN82P65           
           date      = '03/05/2021' time = '09:59:35' option = EXECUTE  
           refine    = N  
:before.
IF INT14 >= 01;
  CTRL16 = 1;
  IF INT14 >= 1;
    IF INT14 <= 30;
      INT14 = 1;
      MOVE ' TO JE ZAÈETEK PREGLEDA' TO IN82M10.EZEMSG;
    ELSE;
      INT14 = INT14 - 30;
    END;
    WHILE CTRL16 <= 15 AND INT14 < 60 AND INT14 > 0;
      MOVE IN82W02.ZLITINA[INT14] TO IN82M10.ZLITINA[CTRL16];
      MOVE IN82W02.DOLZINA[INT14] TO IN82M10.DOLZINA[CTRL16];
      MOVE IN82W02.TEZA[INT14] TO IN82M10.TEZA[CTRL16];
      MOVE IN82W02.IDDROGA[INT14] TO IN82M10.IDDROGA[CTRL16];
 MOVE IN82W02.STDROGA[INT14] TO IN82M10.STDROGA[CTRL16];

      CTRL16 = CTRL16 + 1;
      INT14 = INT14 + 1;
    END;

  ELSE;
  END;
ELSE;
  MOVE ' ZAÈETEK ' TO IN82M10.EZEMSG;
  INT14 = 16;
  MOVE 'DA' TO FLOK5;
END;
:ebefore.
:efunc.

:func      name      = IN82P66           
           date      = '03/05/2021' time = '09:59:35' option = EXECUTE  
           refine    = N  
:before.
MOVE 1 TO CTRL16;                 /* na mapi
INT14 = 1;
IF CTRL15 > 0;
  IF CTRL15 >= INT14;

    WHILE CTRL16 <= 15;
      MOVE IN82W02.ZLITINA[INT14] TO IN82M10.ZLITINA[CTRL16];
      MOVE IN82W02.DOLZINA[INT14] TO IN82M10.DOLZINA[CTRL16];
      MOVE IN82W02.TEZA[INT14] TO IN82M10.TEZA[CTRL16];
      MOVE IN82W02.IDDROGA[INT14] TO IN82M10.IDDROGA[CTRL16];
 MOVE IN82W02.STDROGA[INT14] TO IN82M10.STDROGA[CTRL16];

      CTRL16 = CTRL16 + 1;
      INT14 = INT14 + 1;

    END;
  END;
END;
IF CTRL15 > INT14;
  MOVE '+' TO IN82M10.PLUS;
ELSE;
  MOVE ' ' TO IN82M10.PLUS;
END;
:ebefore.
:efunc.

