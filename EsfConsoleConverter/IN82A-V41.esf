:sql       clause    = WHERE      hostvar = '?'.
WHERE  T1.ZAPST_PCP = T2.ZAPST_PCP AND T2.ZAPST_PCP_DOD = T3.ZAPST_PCP_DOD AND T1.IDENT = T4.IDENT AND T1.STEVKZ = T5.STEVKZ AND T5.VERKZ = 1 AND T3.KOLICINA > 0 AND T2.ZAPST_PCP > 0  AND T4.KLASIFI3 LIKE ?IN82W05.SIFRA_KRIT  AND T3.PE = ?PE AND T3.LOKACIJA NOT IN ('AZ01')
AND T3.LOKACIJA LIKE ?IN82W05.LOK_KRIT

UNION ALL

SELECT 'D',T3.ZAPST_LOKZAL,T3.LOKACIJA,T1.FIRMA,T1.ORGEN,T1.IDENT,T1.SARZA,T3.KOLICINA ,T1.NAMEN,T1.POREKLO,T4.ZLITINA,T1.STEVKZ,T5.KZORG,T1.UZ,T1.ORGEN,T4.PREMER,T3.KOMADI,T4.STMASIF

 FROM SQLUSER.TT_SKLADSUR_DOD T1, SQLUSER.TT_PCP_DOD T2, SQLUSER.TT_LOKACIJAZAL T3, SQLUSER.IZDELKI T4, SQLUSER.KZGLA T5


WHERE T1.ZAPST_DOD = T2.ZAPST_DOD AND T2.ZAPST_PCP_DOD = T3.ZAPST_PCP_DOD AND T1.IDENT = T4.IDENT AND T1.STEVKZ = T5.STEVKZ AND T5.VERKZ = 1 AND T3.KOLICINA > 0 AND T2.ZAPST_DOD < 0 AND T4.KLASIFI3 LIKE ?IN82W05.SIFRA_KRIT AND T3.PE = ?PE AND T3.LOKACIJA NOT IN ('AZ01')
AND T3.LOKACIJA LIKE ?IN82W05.LOK_KRIT
