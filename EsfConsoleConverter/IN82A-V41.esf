:func      name      = IN82S05           
           date      = '03/05/2021' time = '09:59:36' option = EXECUTE  
           desc      = 'SG iz KZORG'
           refine    = N  
:before.
IF IN82M07.KZORG NE ' ' AND IN82M07.KZORG IS MODIFIED;
  SET IN82R12 EMPTY;             /* kzgla

  MOVE 0 TO IN82M07.STEVKZ;
  MOVE ' ' TO IN82M07.OPISKZ;


  MOVE '011' TO IN82R12.PROGENOT; /* livarna
  MOVE IN82M07.KZORG TO IN82R12.KZORG;

  IN82F03();                     /* inq kzgla
  IF EZESQCOD = 0;
    MOVE IN82R12.STEVKZ TO IN82M07.STEVKZ;
    MOVE IN82R12.OPISKZ TO IN82M07.OPISKZ;
  ELSE;
    IF EZESQCOD = 100;
      MOVE "Za ta KZ ni podatkov v glavi KZ!" TO IN82M07.EZEMSG;
    ELSE;
      MOVE "Napaka pri preverjanju glave KZ!" TO IN82M07.EZEMSG;
    END;
  END;
END;
:ebefore.
:efunc.

:func      name      = IN82S07           
           date      = '07/24/2023' time = '09:07:14' option = EXECUTE  
           desc      = 'SG iz Lokacija'
           refine    = N  
:before.
IF IN82M01.LOKACIJA IS MODIFIED;
  IN82M01.NAZIV = ' ';
  IF IN82M01.LOKACIJA NE ' ';

    MOVE IN82M01.LOKACIJA TO IN82R15.LOKACIJA;
    IN82F09();                   /* inq tt_siflokacija
    IF EZESQCOD = 0;
      MOVE IN82R15.NAZIV TO IN82M01.NAZIV;
    ELSE;
      SET IN82M01.LOKACIJA CURSOR;
      IF EZESQCOD = 100;
        MOVE "Lokacija ne obstaja!" TO IN82M01.MSG;
        MOVE EZESQCOD TO IN82M01.KODA;
      ELSE;
        MOVE "Napaka - lokacija!" TO IN82M01.MSG;
        MOVE EZESQCOD TO IN82M01.KODA;
      END;
      MOVE 9999 TO EZEMNO;
    END;
  END;
END;
:ebefore.
:efunc.

