:func      name      = IN82S03           
           date      = '03/05/2021' time = '09:59:36' option = EXECUTE  
           desc      = 'lista nazaj'
           refine    = N  
:before.
IF INT4 => 13;
  INT4 = INT4 - 26;
  IF INT4 =< 0;
    INT4 = 1;
    MOVE "Zaèetek liste, nazaj ni veè možno " TO IN82M01.MSG;
  END;
  INT3 = 1;
  WHILE INT3 =< 13 AND INT4 =< INT2;
    MOVE 0 TO IN82M01.ZAPSTLOKZAL[INT3];
    MOVE ' ' TO IN82M01.POLJEP[INT3];
    MOVE ' ' TO IN82M01.SARZAP[INT3];
    MOVE 0 TO IN82M01.IDSARZAP[INT3];
    MOVE 0 TO IN82M01.IDENTP[INT3];
    MOVE ' ' TO IN82M01.POLJES[INT3];
    MOVE 0 TO IN82M01.KOLICINAP[INT3];

    MOVE 0 TO IN82M01.KOMADIP[INT3];

    MOVE ' ' TO IN82M01.ZLITINAP[INT3];
    MOVE ' ' TO IN82M01.KZORG[INT3];

    MOVE 0 TO IN82M01.PREMERP[INT3];
    MOVE ' ' TO IN82M01.OPOMBA[INT3];
    MOVE ' ' TO IN82M01.UZ[INT3];
    MOVE ' ' TO IN82M01.STMASIF[INT3];
    MOVE ' ' TO IN82M01.POREKLO[INT3];

    INT3 = INT3 + 1;
  END;
  INT3 = 1;
  WHILE INT3 =< 13;
    MOVE IN82W03.ZAPSTLOKZAL[INT4] TO IN82M01.ZAPSTLOKZAL[INT3];
    MOVE IN82W03.POLJEP[INT4] TO IN82M01.POLJEP[INT3];
    MOVE IN82W03.SARZAP[INT4] TO IN82M01.SARZAP[INT3];
    MOVE IN82W03.IDSARZAP[INT4] TO IN82M01.IDSARZAP[INT3];
    MOVE IN82W03.IDENTP[INT4] TO IN82M01.IDENTP[INT3];
    MOVE IN82W03.KZORG[INT4] TO IN82M01.KZORG[INT3];

    MOVE IN82W03.POLJES[INT4] TO IN82M01.POLJES[INT3];
    MOVE IN82W03.KOLICINAP[INT4] TO IN82M01.KOLICINAP[INT3];
    MOVE IN82W03.KOMADIP[INT4] TO IN82M01.KOMADIP[INT3];

    MOVE IN82W03.ZLITINAP[INT4] TO IN82M01.ZLITINAP[INT3];

    MOVE IN82W03.PREMERP[INT4] TO IN82M01.PREMERP[INT3];
    MOVE IN82W03.OPOMBA[INT4] TO IN82M01.OPOMBA[INT3];
    MOVE IN82W03.UZ[INT4] TO IN82M01.UZ[INT3];
    MOVE IN82W03.POREKLO[INT4] TO IN82M01.POREKLO[INT3];
    MOVE IN82W03.STMASIF[INT4] TO IN82M01.STMASIF[INT3];


    SET IN82M01.IDSARZAP[INT3] WHITE;
    SET IN82M01.KOLICINAP[INT3] WHITE;
    SET IN82M01.SARZAP[INT3] YELLOW;

    SET IN82R100 EMPTY;
    MOVE IN82W03.ZAPSTLOKZAL[INT4] TO IN82R100.ZAPST_LOKZAL;
    IN82P100();                  /* ÈITA ÈE JE ŽE NA SKLADIŠÈU OZ LANSIRANO pOSLAl  MATEJ SELECT
    IF EZESQCOD = 0;
      SET IN82M01.IDSARZAP[INT3] PINK;
      SET IN82M01.KOLICINAP[INT3] PINK;
      SET IN82M01.SARZAP[INT3] PINK;

/* SET IN82M01.IDSARZAP[INT3] BLINK;
/*
/* SET IN82M01.SARZAP[INT3] BLINK;



    ELSE;
      SET IN82M01.IDSARZAP[INT3] WHITE;
      SET IN82M01.IDSARZAP[INT3] WHITE;
      SET IN82M01.KOLICINAP[INT3] WHITE;

    END;


    INT3 = INT3 + 1;
    INT4 = INT4 + 1;
  END;

ELSE;
  MOVE "   Listanje nazaj ni veè možno " TO IN82M01.MSG;
END;
:ebefore.
:efunc.

:func      name      = IN82S04           
