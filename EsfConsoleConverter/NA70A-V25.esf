:func      name      = NA70F05           
           date      = '03/16/2021' time = '06:53:22' option = EXECUTE  
           desc      = 'Opis programa'
           refine    = N  
:before.
 /* *To je glavni proces aplikacije NA70a - Pregled skladiŠ-*
 /* *Èa surovine in vsebuje naslednje bistvene dele :       *
 /* *                                                       *
 /* * - postavijo se vrednosti standardnim sist. spremenlj. *
 /* *   in v skupni WS se postavi ime aplikacije            *
 /* *                                                       *
 /* * - glavna zanka aplikacije :                           *
 /* *   - prikaz mape za izbiro kriterijev - NA70P02 za mapo*
 /* *     NA70M01                                           *
 /* *   - test na tipke F3 in PA2                           *
 /* *   - test na tipko F6 in brisanje mape NA70M01         *
 /* *   - test na tipko F9 - inventura ter klicanje procesa *
 /* *     NA70P12, ki po 6 SELECT-ih prenese vsebino na mapo*
 /* *     NA70M04                                           *
 /* *   - test na tipko F2 - pregled                        *
 /* *                                                       *
 /* *   - zanka za manipulacijo na mapi NA70M02 :           *
 /* *     - postavitev kriterijev za SETINQ - za drogove je *
 /* *       drugi (NA70P04) kot za ostalo (NA70P05)         *
 /* *     - Èe OK proces NA70P07 - SCAN                     *
 /* *     - zanka dokler ni napake pri SCAN in Števec < 151 *
 /* *        - prenos slog po slog v WS NA70W02             *
 /* *        - SCAN proces NA70P07                          *
 /* *     - sprostitev SQL CALL EZEROLLB                    *
 /* *     - prenos vrstic na ekran NA70P09 (max 15)         *
 /* *     - test na tipko F8 - NAPREJ, pogoj da Še ni na ko-*
 /* *       ncu, brisanje mape, prenos vrstic na ekran s    *
 /* *       procesom NA70P09                                *
 /* *     - test na tipko F7 - NAZAJ, pogoj da še ni na za- *
 /* *       Èetku, kazalcu na slog v WS odŠteje 15 (Èe je   *
 /* *       veÈji od 16) in s procesom NA70P09 prenese vse- *
 /* *       bino na ekran                                   *
 /* *                                                       *
 /* *     - test na tipko F4 - DETALJ :                     *
 /* *           - zanka pogoj da je < 16                    *
 /* *           - poveÈa Števec in testira na pozicijo kur- *
 /* *             zorja                                     *
 /* *           - Èe ga najde gre v proces NA70P10, kjer    *
 /* *             prikaŽe mapo NA70M03 z detalji o surovini *
 /* *                                                       *
:ebefore.
:efunc.

:func      name      = NA70F06           
           date      = '03/16/2021' time = '06:53:22' option = EXECUTE  
           desc      = 'Poz za KZ kombinacije'
           refine    = N  
:before.
SET NA70R51 EMPTY;               /* tt_naropozi
MOVE NA70M02.LETONA[CTRCURSO] TO NA70R51.LETONA; /* v slog
MOVE NA70M02.STNAROC[CTRCURSO] TO NA70R51.STNAROC; /* v slog
MOVE NA70M02.POZNARO[CTRCURSO] TO NA70R51.POZNARO; /* v slog

NA70F107();                      /* inq tt_naropozi - union koncnaro

IF EZESQCOD = 0 AND NA70R51.STEVKZ > 0;
  MOVE NA70R51.STEVKZ TO NA70W05.STEVKZ; /* v slog
  MOVE NA70R51.KZORG TO NA70W05.KZORG; /* v slog
END;

CTRCURSO = 17;                   /* skok iz zanke
:ebefore.
:efunc.

:func      name      = NA70F07           
           date      = '03/16/2021' time = '06:53:22' option = EXECUTE  
           desc      = 'KZ kombinacije za livarno'
           refine    = N  
:before.

SET NA70M07 EMPTY;
NA70F08();                       /* bere podatke


WHILE 1 = 1;

  NA70F12();                     /* primaz M3

/* **************************************************************/
/* F3 - nazaj
/* **************************************************************/
  IF EZEAID IS PF3;
    SET NA70M02.STNAROC[STEV_NAZAJ] CURSOR;
    EZERTN();
  END;


/* ******************************************************************
/* F7 - èitanje seznama nazaj
/* ******************************************************************
  IF EZEAID IS PF7;
    IF STEVTREN4 > 20;
      STEVTREN4 = STEVTREN4 - 20;
      NA70F13();                 /* prenos na ekran
    ELSE;                        /* prva stran (enter)
      NA70F08();                 /* pregled
    END;
  END;                           /* ;
/* ******************************************************************
/* F8 - èitanje seznama naprej
/* ******************************************************************
  IF EZEAID IS PF8;
    IF STEVTREN4 =< STEVWS4;
      NA70F13();                 /* prenos na ekran
    ELSE;
      MOVE "Konec liste!" TO NA70M07.EZEMSG;
    END;
  END;





END;
:ebefore.
:efunc.

:func      name      = NA70F08           
           date      = '03/16/2021' time = '06:53:22' option = EXECUTE  
           desc      = 'Bere KZ kombinacije'
           refine    = N  
:before.
SET NA70R14 EMPTY;               /* KZ_LIVARNA - KZGLA

MOVE NA70W05.STEVKZ TO NA70R14.STEVKZ_IZD; /* kz izdelka kriterij

NA70F09();                       /* setinq joina
IF EZESQCOD = 0;
  NA70F10();                     /* scan joina
  IF EZESQCOD = 0;
/* ****************************************************************
    STEVWS4 = 0;
    WHILE EZESQCOD = 0 AND STEVWS4 < 99;
      STEVWS4 = STEVWS4 + 1;

      MOVE NA70R14.ZAPST_KZLIV TO NA70W04.ZAPST_KZLIV[STEVWS4];
      MOVE NA70W05.KZORG TO NA70W04.KZORG_IZD[STEVWS4]; /* iz mape
/* MOVE NA70R14.ZLITINA_IZD TO NA70W04.ZLITINA_IZD[STEVWS4];
      MOVE NA70R14.ZLITINA_SUR TO NA70W04.ZLITINA_SUR[STEVWS4];
      MOVE NA70R14.KZORG TO NA70W04.KZORG_SUR[STEVWS4];
      MOVE NA70R14.PRIORITETA TO NA70W04.PRIORITETA[STEVWS4];
      MOVE NA70R14.DATURA TO NA70W04.DATURA[STEVWS4];
      MOVE NA70R14.VNESEL TO NA70W04.VNESEL[STEVWS4];
      MOVE '-' TO NA70W04.ZNAK[STEVWS4];

      NA70F10();                 /* scan joina

    END;

    NA70F11();                   /* close joina
    MOVE 1 TO STEVTREN4;         /* trenutna pozicija
    NA70F13();                   /* prenos na M7

/* ****************************************************************
  ELSE;
    IF EZESQCOD = 100;
      MOVE "Napaka pri branju KZ kombinacij (scan) - NI PODATKOV!" TO MSG64;
      NA70F99();                 /* koda na m7
    ELSE;
      MOVE "Napaka pri branju KZ kombinacij (scan)!" TO MSG64;
      NA70F99();                 /* koda na m7
    END;
  END;
ELSE;
  MOVE "Napaka pri branju KZ kombinacij (setinq)!" TO MSG64;
  NA70F99();                     /* koda na m7
END;
:ebefore.
:efunc.

