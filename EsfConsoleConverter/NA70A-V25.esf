           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'Prenos na M9'
           refine    = N  
:before.
MOVEA 0 TO NA70M09.STEVILOP;
MOVEA ' ' TO NA70M09.STEVSTRO;
MOVEA ' ' TO NA70M09.TEHNAVO1;
MOVEA ' ' TO NA70M09.TEHNAVO2;
MOVEA ' ' TO NA70M09.TEHNAVO3;
MOVEA 0 TO NA70M09.STEVIDEL;
MOVEA 0 TO NA70M09.TPZ;
MOVEA 0 TO NA70M09.T1;
MOVEA 0 TO NA70M09.T2;
MOVEA 0 TO NA70M09.PFO;
MOVEA ' ' TO NA70M09.KVALODPD;




/* ******************************* prenos ************************************************************
STEVMAPA6 = 1;
WHILE STEVMAPA6 <= 6 AND STEVTREN6 =< STEVWS6;


  MOVE NA70W06.STEVILOP[STEVTREN6] TO NA70M09.STEVILOP[STEVMAPA6];
  MOVE NA70W06.STEVSTRO[STEVTREN6] TO NA70M09.STEVSTRO[STEVMAPA6];
  MOVE NA70W06.TEHNAVO1[STEVTREN6] TO NA70M09.TEHNAVO1[STEVMAPA6];
  MOVE NA70W06.TEHNAVO2[STEVTREN6] TO NA70M09.TEHNAVO2[STEVMAPA6];
  MOVE NA70W06.TEHNAVO3[STEVTREN6] TO NA70M09.TEHNAVO3[STEVMAPA6];
  MOVE NA70W06.STEVIDEL[STEVTREN6] TO NA70M09.STEVIDEL[STEVMAPA6];
  MOVE NA70W06.TPZ[STEVTREN6] TO NA70M09.TPZ[STEVMAPA6];
  MOVE NA70W06.T1[STEVTREN6] TO NA70M09.T1[STEVMAPA6];
  MOVE NA70W06.T2[STEVTREN6] TO NA70M09.T2[STEVMAPA6];
  MOVE NA70W06.PFO[STEVTREN6] TO NA70M09.PFO[STEVMAPA6];
  MOVE NA70W06.KVALODPD[STEVTREN6] TO NA70M09.KVALODPD[STEVMAPA6];


  STEVMAPA6 = STEVMAPA6 + 1;
  STEVTREN6 = STEVTREN6 + 1;
END;
/* ---------- sporoèilo na ekran ----------------
IF STEVWS6 > 0;                  /* podatki obstajajo
  MOVE "Podatki za izbrane kriterije" TO NA70M09.EZEMSG;
END;
