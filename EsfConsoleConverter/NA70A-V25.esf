AND T1.KONCNATE BETWEEN ?NA70W05.KOTE_OD AND  ?NA70W05.KOTE_DO
AND (T1.KLASIFI3 LIKE ?NA70M01.KLASIFI3  OR T1.KLASIFI3 IS NULL)  /*----od 02.06.2004----
AND T2.SIFDRZ BETWEEN ?SIFRA3SP AND ?SIFRA3ZG
AND T1.INDIKTEH BETWEEN ?INDTESP AND ?INDTEZG
AND T1.ZACETNTE BETWEEN ?NA70W05.ZATE_OD AND  ?NA70W05.ZATE_DO
AND (T1.Q_IND LIKE ?NA70W02.Q_IND OR T1.Q_IND IS NULL)  /*--dodano 07.02.2007---
:esql.
