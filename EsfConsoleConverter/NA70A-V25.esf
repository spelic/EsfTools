:sql       clause    = SELECT      hostvar = '?'.
T1.ZAPST, T1.LME, T1.PREMIJAVAL, T1.LMEOP,  T2.NAZIV, T1.ZAPST_F1, T1.ID_SKUPPZ_KEM_NML, T1.ID_SKUSMB_OPISNO, T1.ID_GREP_TRAJNOSTNA_ZAHTEVA, T1.ID_TT_NAROPOZILME
:esql.
:sql       clause    = INTO      hostvar = '?'.
?ZAPST,  ?LME, ?PREMIJAVAL, ?LMEOP,  ?NAZIVLME, ?ZAPST_F1, ?ID_SKUPPZ_KEM_NML, ?ID_SKUSMB_OPISNO, ?ID_GREP_TRAJNOSTNA_ZAHTEVA, ?ID_TT_NAROPOZILME
