           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'Prenese podatke za KZ'
           refine    = N  
:before.
SET NA70R51 EMPTY;               /* tt_naropozi
MOVE NA70M02.LETONA[CTRCURSO] TO NA70R51.LETONA; /* v slog
MOVE NA70M02.STNAROC[CTRCURSO] TO NA70R51.STNAROC; /* v slog
MOVE NA70M02.POZNARO[CTRCURSO] TO NA70R51.POZNARO; /* v slog

NA70F107();                      /* inq tt_naropozi - union koncnaro

IF EZESQCOD = 0 AND NA70R51.STEVKZ > 0;
  MOVE NA70R51.STEVKZ TO NA70W03.STEVKZ; /* v slog
  MOVE NA70R51.VERKZ TO NA70W03.VERKZ; /* v slog
END;

CTRCURSO = 17;                   /* skok iz zanke
:ebefore.
:efunc.

:func      name      = NA70P777          
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'brisanje  blankov dimenzije'
           refine    = N  
:before.
NA70W05.STEVEC = 1;

/* ----zanka do zadnjega polnega v WS----------
WHILE STEVEC <= CTRLINIJ;

  NA70W05.NIZ35V = NA70W02.DIMENZ35[NA70W05.STEVEC];

  NA70W05.STEVNIZV = 1;          /* števec vhodnega
  NA70W05.STEVNIZI = 1;          /* števec izhodnega

  /* ----zanka do zadnjega znaka v nizu 35---
  WHILE NA70W05.STEVNIZV <= 35;

    IF NA70W05.NIZ1V[NA70W05.STEVNIZV] = ' '; /* je blank

      PRVI = 'DA';
      /* -----dokler je blank je zanka---------
      WHILE NA70W05.NIZ1V[NA70W05.STEVNIZV] = ' ' AND /* je blank
        NA70W05.STEVNIZV < 35;

        IF PRVI = 'DA' AND NA70W05.STEVNIZI > 1; /* pa da ni prva kolona
          NA70W05.NIZ1I[NA70W05.STEVNIZI] = ' '; /* doda blank
          NA70W05.STEVNIZI = NA70W05.STEVNIZI + 1; /* števec izhodnega
          PRVI = 'NE';
        END;
        NA70W05.STEVNIZV = NA70W05.STEVNIZV + 1; /* števec vhodnega
      END;

      NA70W05.NIZ1I[NA70W05.STEVNIZI] = NA70W05.NIZ1V[NA70W05.STEVNIZV];
      NA70W05.STEVNIZI = NA70W05.STEVNIZI + 1; /* števec izhodnega

    ELSE;                        /* --doda v NIZ35I------

      NA70W05.NIZ1I[NA70W05.STEVNIZI] = NA70W05.NIZ1V[NA70W05.STEVNIZV];
      NA70W05.STEVNIZI = NA70W05.STEVNIZI + 1; /* števec izhodnega

    END;
    NA70W05.STEVNIZV = NA70W05.STEVNIZV + 1; /* števec vhodnega
  END;

  /* --vrne nazaj v WS popravljeno dimenzijo-----
  NA70W02.DIMENZ35[NA70W05.STEVEC] = NA70W05.NIZ35I;
  NA70W05.NIZ35I = ' ';          /* briše pred naslednjim

  STEVEC = STEVEC + 1;           /* --naslednji v WS---
END;
:ebefore.
:efunc.

:func      name      = NA70S01           
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'SG za Èitanje v t.KLASIFI'
           refine    = N  
:before.
/* SG za Èitanje v tabelo KLASIFI - kolona NAZIZDEL na
/* osnovi vpisa v polje SIFRA in È e v tabeli obstaja
/* vrnitev teksta naziva na ekrana !
/* ----------------------------------------------------
MOVE NA70M01.SIFRA TO NA70R02.SIFRA;
NA70P12();                       /* INQUIRY v t.KLASIFI
IF NA70R02 IS ERR;               /* napaka
  MOVE "Neznana I/O napaka t.KLASIFI" TO MSG64;
  ER99P01();                     /* koda napake
  MOVE MSG78 TO NA70M01.EZEMSG;
  SET NA70M01.SIFRA CURSOR,MODIFIED,BRIGHT;
ELSE;                                /* OK
  IF NA70R02.NAZIZDEL EQ '  ';   /* je ni
    MOVE "Tega naziva v t.KLASIFI ni" TO NA70M01.EZEMSG;
    SET NA70M01.SIFRA CURSOR,MODIFIED,BRIGHT;
  ELSE;
    MOVE NA70R02.NAZIZDEL TO NA70M01.NAZIZDEL;
    SET NA70M01.STATNAPO CURSOR,BRIGHT;
  END;
END;
MOVE 9999 TO EZEMNO;
:ebefore.
:efunc.

:func      name      = NA70S011          
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'SG iz klasifi3-zlitina'
           refine    = N  
:before.
/* SG za Èitanje v tabelo KLASIFI - kolona NAZIZDEL na
/* osnovi vpisa v polje SIFRA in È e v tabeli obstaja
/* vrnitev teksta naziva na ekrana !
/* ----------------------------------------------------
IF NA70M01.KLASIFI3 NE ' ' AND NA70M01.KLASIFI3 NE '%%'; /* èe to ne
  MOVE NA70M01.KLASIFI3 TO NA70R02.SIFRA;
  NA70P12();                     /* INQUIRY v t.KLASIFI
  IF NA70R02 IS ERR;             /* napaka
    MOVE "Neznana I/O napaka t.KLASIFI" TO MSG64;
    ER99P01();                   /* koda napake
    MOVE MSG78 TO NA70M01.EZEMSG;
    SET NA70M01.KLASIFI3 CURSOR,MODIFIED,BRIGHT;
  ELSE;                          /* OK
    IF NA70R02.ZLITINA EQ '  ';  /* je ni
      MOVE "Te zlitine v t.KLASIFI ni" TO NA70M01.EZEMSG;
      SET NA70M01.KLASIFI3 CURSOR,MODIFIED,BRIGHT;
    ELSE;
      MOVE NA70R02.ZLITINA TO NA70M01.ZLITINA;
      SET NA70M01.STATNAPO CURSOR,BRIGHT;
    END;
  END;
  MOVE 9999 TO EZEMNO;
END;
:ebefore.
:efunc.

:func      name      = NA70S02           
           date      = '12/06/2022' time = '13:30:19' option = EXECUTE  
           desc      = 'SG za Èitanje v t.KASMESTO'
           refine    = N  
:before.
/* SG za Èitanje v tabelo KASMESTO - kolona KASMOPIS na
/* osnovi vpisa v polje KASIFSM in Èe v tabeli obstaja
/* vrnitev teksta naziva na ekrana !
/* ----------------------------------------------------
IF NA70M01.STNAROC = 0;          /* ni vpisano naroÈilo

  NA70M01.LB28 = " ";
  SET NA70M01.STEVSTRO DEFINED;  /* zaklene


  NA70M01.KASMOPIS = ' ';
  MOVE NA70M01.KASIFSM TO NA70R03.KASIFSM;
  NA70P13();                     /* INQUIRY v t.KASMESTO
  IF NA70R03 IS ERR;             /* napaka
    IF NA70R03 IS NRF;           /* je ni
      IF NA70M01.KASIFSM = ' ';
        SET NA70M01.KASIFSM CURSOR;
        NA70M01.EZEMSG = "Obvezen vpis PP, sicer pregleda ni";
        EZERTN();
      ELSE;
        MOVE "Te šifre PP v t.KASMESTO ni " TO MSG64;
      END;
    ELSE;
      MOVE "Neznana I/O napaka t.KASMESTO" TO MSG64;
    END;
    ER99P01();                   /* koda napake
    MOVE MSG78 TO NA70M01.EZEMSG;
    SET NA70M01.SIFRA CURSOR,BRIGHT;
  ELSE;                          /* OK
    MOVE NA70R03.KASMOPIS TO NA70M01.KASMOPIS;
    NA70M01.EZEMSG = "Podatki za PP!";
    SET NA70M01.KASIFSM CURSOR;
/* IF NA70M01.ZATE < 1;
/* SET NA70M01.ZATE CURSOR;
/* END;
    IF NA70M01.ZATE > 0 AND (NA70M01.STATNAPO = '4' OR NA70M01.STATNAPO = '5' OR NA70M01.STATNAPO = '6' OR NA70M01.STATNAPO = '7')
      AND NA70M01.KASIFSM = '041';
      NA70M01.LB28 = "Stroj:";
      SET NA70M01.STEVSTRO BRIGHT; /* odklene
    END;

/* ****************** avtorizacija za PP **************************************
/* INDIK = 0;
/* MOVE NA70M01.KASIFSM TO NA70R08.SIFRAUP; /* pp v šifro
/* NA70F02();                   /* preverja avtorizacijo za to PE 6/2011
/* IF INDIK = 1;
/* NA70M01.EZEMSG = "Za izbran PP nimaš avtorizacije!";
/* EZERTN();
/* END;
  END;
  MOVE 9999 TO EZEMNO;
END;
:ebefore.
:efunc.

:func      name      = NA70S03           
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'SG za kontrolo polja SIFRA3'
           refine    = N  
:before.
/* SG iz polja SIFRA3 v t.DRZAVE ter Èe je prenos naziva
/* na ekran
/* ----------------------------------------------------
MOVE NA70M01.SIFRA3 TO NA70R04.SIFRA3;
NA70P14();                       /* INQUIRY v t.DRZAVE
IF NA70R04 IS ERR;               /* napaka
  MOVE "Neznana I/O napaka t.DRZAVE" TO MSG64;
  ER99P01();                     /* koda napake
  MOVE MSG78 TO NA70M01.EZEMSG;
  SET NA70M01.SIFRA3 CURSOR,MODIFIED,BRIGHT;
ELSE;                                /* OK
  MOVE NA70R04.NAZIVDR TO NA70M01.NAZIVDR;
END;
MOVE 9999 TO EZEMNO;
:ebefore.
:efunc.

:func      name      = NA70S04           
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'SG iz polja STNAROC'
           refine    = N  
:before.
/* SG iz polja STNAROC - zapre dostop v ostala polja, ker
/* taka kombinacija ni smiselna
/* ----------------------------------------------------
IF NA70M01.STNAROC > 0;
  SET NA70M01.SIFRA3 PROTECT,BRIGHT;
  SET NA70M01.SIFRA PROTECT,BRIGHT;
  SET NA70M01.STATNAPO PROTECT,BRIGHT;
  SET NA70M01.KASIFSM PROTECT,BRIGHT;
  SET NA70M01.EZEMSG CURSOR;
  MOVE "Iskanje po številki naroèila-pritisni F4 " TO NA70M01.EZEMSG;
ELSE;                                /* OK
  MOVE "Vpiši številko naroèila > 0 " TO NA70M01.EZEMSG;
  SET NA70M01.STNAROC CURSOR,BRIGHT;
END;
MOVE 9999 TO EZEMNO;
:ebefore.
:efunc.

