:func      name      = NA70P04           
           date      = '12/16/2024' time = '13:24:48' option = SETINQ   
           object    = NA70R01           
           errrtn    = EZERTN            
           desc      = 'SETINQ-NAROPOZI,KOM-1-z prejem'
           refine    = N  
           execbld   = N  
:sql       clause    = SELECT      hostvar = '?'.
T1.STNAROC, T1.POZNARO, T1.STPREJEM, T1.KLASIFI3,
  T1.NARKOLPR, T1.DIMENZ40, T1.STATNAPO, T1.POSZAHT1,
  T1.PRIORITE, T1.REFKOM, T1.DATSTAT0, T2.KOMITENT, T2.KRNAZ, T1.STEVKZ, T1.VERKZ, T1.KZORG, T1.LETONA, T1.IDENT, T1.POREKLO, T1.PROGENOT, T1.STATUS_PREGLED, T5.ID, T3.ID_GREP_TRAJNOSTNA_ZAHTEVA
:esql.
:sql       clause    = INTO      hostvar = '?'.
?STNAROC, ?POZNARO, ?STPREJEM, ?KLASIFI3, ?NARKOLPR, ?DIMENZ40,
  ?STATNAPO, ?POSZAHT1,
  ?PRIORITE, ?REFKOM, ?DATSTAT0, ?KOMITENT, ?KRNAZ, ?STEVKZ, ?VERKZ, ?KZORG,
?LETONA, ?IDENT, ?POREKLO, ?PROGENOT, ?STATUS_PREGLED, ?NA70W05.CALLOFF_ID, ?NA70W05.TZ_ID
:esql.
:sql       clause    = WHERE      hostvar = '?'.
INNER JOIN SQLUSER.TT_NAROPOZILME T3 ON T3.LETONA = T1.LETONA AND  T3.STNAROC = T1.STNAROC AND T3.POZNARO = T1.POZNARO AND T3.ID_GREP_TRAJNOSTNA_ZAHTEVA BETWEEN ?NA70W05.TZ_OD AND ?NA70W05.TZ_DO
LEFT OUTER JOIN CALLOF.CALLOFF_HEAD_TT_POGODBGL T5 ON T5.LETONA = T1.LETONA AND T5.STNAROC = T1.STNAROC


WHERE

T1.FIRMA =?FIRMA AND
T1.LETONA >=?LETONA AND
T1.STPREJEM = T2.KOMITENT
AND T1.STNAROC >= ?NA70W02.NAROD          /*------od 02.06.2004---
AND T1.STATNAPO BETWEEN ?STATNASP AND ?STATNAZG
AND T1.STATNARO BETWEEN ?STATNAROSP AND ?STATNAROZG   /*---od 7.10.2009--
/*   AND T1.STATNAPO <> '7'
AND T1.PROGENOT = ?PROGESP
AND T1.STPREJEM = ?STPREJEM     /*----OD 17.06.2004,o 22.1.2008 = prej LIKE-----
AND T1.KONCNATE BETWEEN ?NA70W05.KOTE_OD AND  ?NA70W05.KOTE_DO
AND (T1.KLASIFI2 BETWEEN ?SIFRASP AND ?SIFRAZG OR T1.KLASIFI2 IS NULL)
AND (T1.KLASIFI3 LIKE ?NA70M01.KLASIFI3  OR T1.KLASIFI3 IS NULL)  /*----od 02.06.2004----
AND T2.SIFDRZ BETWEEN ?SIFRA3SP AND ?SIFRA3ZG
AND T1.INDIKTEH BETWEEN ?INDTESP AND ?INDTEZG
AND (T1.Q_IND LIKE ?NA70W02.Q_IND OR T1.Q_IND IS NULL)  /*--dodano 07.02.2007---

:esql.
:sql       clause    = ORDERBY      hostvar = '?'.
ORDER BY STNAROC,POZNARO
FETCH FIRST 500 ROWS ONLY /*--7.10.2009--
WITH UR

:esql.
:efunc.

