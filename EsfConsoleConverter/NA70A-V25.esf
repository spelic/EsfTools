:func      name      = NA70F21           
           date      = '03/16/2021' time = '06:53:22' option = EXECUTE  
           desc      = 'bere podatke'
           refine    = N  
:before.
SET NA70M09 EMPTY;
SET NA70R18 EMPTY;               /* naropozi
SET NA70W06 EMPTY;               /* za listanje
INDIK = 0;

/* *********** bere naropozi, da dobi ident ************************
MOVE NA70W05.LETONA TO NA70M09.LETONA;
MOVE NA70W05.STNAROC TO NA70M09.STNAROC;
MOVE NA70W05.POZNARO TO NA70M09.POZNARO;
MOVE 1 TO NA70M09.TEHNPOST;
MOVE NA70W05.LETONA TO NA70R18.LETONA;
MOVE NA70W05.STNAROC TO NA70R18.STNAROC;
MOVE NA70W05.POZNARO TO NA70R18.POZNARO;
NA70F22();                       /* inq naropozi
IF EZESQCOD = 0;
  MOVE NA70R18.IDENT TO NA70M09.IDENT;
ELSE;
  INDIK = 1;
  IF EZESQCOD = 100;
    MOVE "Napaka pri pregledu naroèil - ne obstaja (morda je že konèano)!" TO NA70M09.EZEMSG;
  ELSE;
    MOVE "Napaka pri pregledu naroèil!" TO NA70M09.EZEMSG;
  END;
END;

/* ************** bere podatke o identu ************
IF INDIK = 0;
  NA70F23();
END;

/* ************** bere podatke optehngl + ident vhoda ************
IF INDIK = 0;
  NA70F25();
END;

/* ********************************************************
/* ************** bere podatke optehnop ************
/* ********************************************************
IF INDIK = 0;
  SET NA70R17 EMPTY;             /* optehnop
  MOVE NA70W05.STNAROC TO NA70R17.STNAROC;
  MOVE NA70W05.POZNARO TO NA70R17.POZNARO;
  MOVE NA70R18.IDENT TO NA70R17.IDENT;


  NA70F28();                     /* setinq optehnop
  IF EZESQCOD = 0;
    NA70F29();                   /* scanoptehnop
    IF EZESQCOD = 0;
/* ****************************************************************
      STEVWS6 = 0;
      WHILE EZESQCOD = 0 AND STEVWS6 < 49;
        STEVWS6 = STEVWS6 + 1;

        MOVE NA70R17.STEVILOP TO NA70W06.STEVILOP[STEVWS6];
        MOVE NA70R17.STEVSTRO TO NA70W06.STEVSTRO[STEVWS6];
        MOVE NA70R17.TEHNAVO1 TO NA70W06.TEHNAVO1[STEVWS6];
        MOVE NA70R17.TEHNAVO2 TO NA70W06.TEHNAVO2[STEVWS6];
        MOVE NA70R17.TEHNAVO3 TO NA70W06.TEHNAVO3[STEVWS6];
        MOVE NA70R17.STEVIDEL TO NA70W06.STEVIDEL[STEVWS6];
        MOVE NA70R17.TPZ TO NA70W06.TPZ[STEVWS6];
        MOVE NA70R17.T1 TO NA70W06.T1[STEVWS6];
        MOVE NA70R17.T2 TO NA70W06.T2[STEVWS6];
        MOVE NA70R17.PFO TO NA70W06.PFO[STEVWS6];
        MOVE NA70R17.KVALODPD TO NA70W06.KVALODPD[STEVWS6];

        NA70F29();               /* scan optehnop

      END;

      NA70F30();                 /* close optehnop
      MOVE 1 TO STEVTREN6;       /* trenutna pozicija
      NA70F31();                 /* prenos na M9

/* ****************************************************************
    ELSE;
      IF EZESQCOD = 100;
        MOVE "Napaka pri branju pozicij op. tehnologije - NI PODATKOV!" TO NA70M09.EZEMSG;
      ELSE;
        MOVE "Napaka pri branju pozicij operativne tehnologije!" TO NA70M09.EZEMSG;
      END;
    END;
  ELSE;
    MOVE "Napaka pri branju KZ kombinacij (setinq)!" TO MSG64;
    NA70F99();                   /* koda na m7
  END;





END;                             /* od indik
