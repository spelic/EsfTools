:func      name      = NA70S15           
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'Sg iz firma'
           refine    = N  
:before.
IF NA70M01.FIRMA_VH IS MODIFIED;
  NA70M01.NAZIVF = ' ';
  IF NA70M01.FIRMA_VH = '12' OR NA70M01.FIRMA_VH = '13' OR NA70M01.FIRMA_VH = '01'; /* seval, tlm, impol

    MOVE NA70M01.FIRMA_VH TO NA70R22.FIRMA;
    NA70F106();                   /* inq tt_firma
    IF EZESQCOD = 0;
      MOVE NA70R22.NAZIVF TO NA70M01.NAZIVF;
    ELSE;
      MOVE "Napaka pri branju tabele TT_FIRMA" TO MSG64;
      IMNAPAKA();                /* koda napake
      MOVE MSG78 TO NA70M01.EZEMSG;
      SET NA70M01.FIRMA_VH CURSOR;
    END;
  ELSE;
    IF NA70M01.FIRMA_VH = ' ';   /* èe je spreznjeno

    ELSE;
      SET NA70M01.FIRMA_VH CURSOR;
      MOVE "Dovoljeno samo za firmo 01 (Impol), 12 (Seval) in 13 (Tlm)!" TO NA70M01.EZEMSG;
    END;
  END;
END;
:ebefore.
:efunc.

:func      name      = NA70S16           
           date      = '12/16/2024' time = '13:14:10' option = EXECUTE  
           desc      = 'SG iz zate'
           refine    = N  
:before.
IF NA70M01.ZATE IS MODIFIED OR NA70M01.KOTE IS MODIFIED;

  NA70M01.LB28 = " ";
  SET NA70M01.STEVSTRO DEFINED;  /* zaklene

  IF NA70M01.ZATE > 0 AND (NA70M01.STATNAPO = '4' OR NA70M01.STATNAPO = '5' OR NA70M01.STATNAPO = '6' OR NA70M01.STATNAPO = '7')
    AND NA70M01.KASIFSM = '041';
    NA70M01.LB28 = "Stroj:";
    SET NA70M01.STEVSTRO BRIGHT,CURSOR; /* odklene
  END;

  IF NA70M01.KOTE > 0 AND (NA70M01.STATNAPO = '4' OR NA70M01.STATNAPO = '5' OR NA70M01.STATNAPO = '6' OR NA70M01.STATNAPO = '7')
    AND NA70M01.KASIFSM = '041';
    NA70M01.LB28 = "Stroj:";
    SET NA70M01.STEVSTRO BRIGHT,CURSOR; /* odklene
  END;

END;
:ebefore.
:efunc.

