WHERE
T1.FIRMA =?FIRMA AND
T1.LETONA >=?LETONA AND
T1.STPREJEM = T2.KOMITENT
AND T1.STNAROC = ?STNAROC
:esql.
:sql       clause    = ORDERBY      hostvar = '?'.
ORDER BY T1.LETONA,T1.STNAROC,T1.POZNARO
FETCH FIRST 500 ROWS ONLY

:esql.
:efunc.

:func      name      = NA70P05_S         
           date      = '12/10/2024' time = '10:11:07' option = SETINQ   
           object    = NA70R01           
           errrtn    = EZERTN            
           desc      = 'SETINQ-NAROPOZI,KOMI-2-za naro'
           refine    = N  
           execbld   = N  
:sql       clause    = SELECT      hostvar = '?'.
T1.STNAROC, T1.POZNARO, T1.STPREJEM,
  T1.NARKOLPR, T1.DIMENZ40, T1.STATNAPO, T1.KLASIFI3,
  T1.PRIORITE, T1.POSZAHT1, T2.KOMITENT, T2.KRNAZ, T1.STEVKZ, T1.VERKZ, T1.KZORG,
  T1.POREKLO, T1.PROGENOT, T1.LETONA, T1.STATUS_PREGLED, T5.ID, T3.ID_GREP_TRAJNOSTNA_ZAHTEVA
:esql.
:sql       clause    = INTO      hostvar = '?'.
?STNAROC, ?POZNARO, ?STPREJEM, ?NARKOLPR, ?DIMENZ40,
  ?STATNAPO, ?KLASIFI3, ?PRIORITE, ?POSZAHT1, ?KOMITENT, ?KRNAZ, ?STEVKZ, ?VERKZ, ?KZORG,
 ?POREKLO, ?PROGENOT, ?LETONA, ?STATUS_PREGLED, ?NA70W05.CALLOFF_ID, ?NA70W05.TZ_ID
:esql.
:sql       clause    = WHERE      hostvar = '?'.
LEFT OUTER JOIN  SQLUSER.TT_NAROPOZILME T3 ON T3.LETONA = T1.LETONA AND  T3.STNAROC = T1.STNAROC AND T3.POZNARO = T1.POZNARO AND T3.ID_PLNSIZDELEK_SKUPINA 
BETWEEN ?SKUPINA_OD AND ?SKUPINA_DO AND T3.ID_GREP_TRAJNOSTNA_ZAHTEVA BETWEEN ?NA70W05.TZ_OD AND ?NA70W05.TZ_DO

LEFT OUTER JOIN CALLOF.CALLOFF_HEAD_TT_POGODBGL T5 ON T5.LETONA = T1.LETONA AND T5.STNAROC = T1.STNAROC

WHERE
T1.FIRMA =?FIRMA AND
T1.LETONA >=?LETONA AND
T1.STPREJEM = T2.KOMITENT
AND T1.STNAROC = ?STNAROC
:esql.
:sql       clause    = ORDERBY      hostvar = '?'.
ORDER BY T1.LETONA,T1.STNAROC,T1.POZNARO
FETCH FIRST 500 ROWS ONLY

