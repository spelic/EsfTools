:func      name      = NA70S08           
           date      = '03/16/2021' time = '07:17:03' option = EXECUTE  
           desc      = 'sg iz skupine izdelka'
           refine    = N  
:before.
/* ----ÈITANJE SKUPINE----
IF NA70M01.ID_PLNSIZDELEK_SKUPINA IS MODIFIED;
  NA70M01.NAZIVSK = ' ';
  IF NA70M01.ID_PLNSIZDELEK_SKUPINA > 0;
    MOVE NA70M01.ID_PLNSIZDELEK_SKUPINA TO NA70R24.ID_PLNSIZDELEK_SKUPINA;
    NA70F113();                   /* INQUIRY v  podskupina
    IF EZESQCOD = 0;
      MOVE NA70R24.NAZIV TO NA70M01.NAZIVSK;
    ELSE;
      MOVE "Napaka pri branju podskupine izdelka!" NA70M01.EZEMSG;
      SET NA70M01.ID_PLNSIZDELEK_SKUPINA CURSOR;
    END;
  END;
END;
:ebefore.
:efunc.

:func      name      = NA70S12           
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'SG iz STPREJEM'
           refine    = N  
:before.
/* SG za Èitanje v tabelo KOMITENT -
/* ----------------------------------------------------
NA70M01.KRNAZ = ' ';
IF NA70M01.STPREJEM NE ' ' AND NA70M01.STPREJEM NE '%%%%%%%%%'; /* èe to ne

  NA70R12.KOMITENT = NA70M01.STPREJEM;

  NA70P121();                    /* INQUIRY v t.KOMITENT

  IF NA70R12 IS ERR;             /* napaka
    MOVE "Neznana I/O napaka t.KOMITENT" TO MSG64;
    ER99P01();                   /* koda napake
    IF EZESQCOD = 100;
      MSG64 = "Komitenta s takšno šifro ni";
    END;
    MOVE MSG78 TO NA70M01.EZEMSG;
    SET NA70M01.STPREJEM CURSOR,BRIGHT;
  ELSE;                          /* OK
    NA70M01.KRNAZ = NA70R12.KRNAZ; /* naziv na mapo
  END;
  MOVE 9999 TO EZEMNO;
END;
:ebefore.
:efunc.

