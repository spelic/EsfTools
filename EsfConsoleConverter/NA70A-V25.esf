:efunc.

:func      name      = NA70P06           
           date      = '11/08/2024' time = '13:45:48' option = EXECUTE  
           desc      = 'postavitev kriter. za SETINQ'
           refine    = N  
:before.
/* -----od 17.06.2004-----------
IF NA70M01.STPREJEM EQ '%%%%%%%%%' OR
  NA70M01.STPREJEM EQ '        '; /* ni vpisal
  NA70R01.STPREJEM = '%%%%%%%%%'; /* v slog
ELSE;                            /* vpisal
  NA70R01.STPREJEM = NA70M01.STPREJEM; /* v slog;v slog z mape
END;

/* ********** skupina izdelka 3/2021 ***********************
IF NA70M01.ID_PLNSIZDELEK_SKUPINA > 0;
  MOVE NA70M01.ID_PLNSIZDELEK_SKUPINA TO SKUPINA_OD;
  MOVE NA70M01.ID_PLNSIZDELEK_SKUPINA TO SKUPINA_DO;
ELSE;
  MOVE 0 TO SKUPINA_OD;
  MOVE 999 TO SKUPINA_DO;
END;


IF NA70M01.SIFRA EQ ' ';         /* ni vpisal hoÈe vse
  MOVE ' ' TO SIFRASP;           /* spodnja
  MOVE 'ZZ' TO SIFRAZG;          /* zgornja
ELSE;                            /* vpisal
  MOVE NA70M01.SIFRA TO SIFRASP; /* spodnja
  MOVE NA70M01.SIFRA TO SIFRAZG; /* zgornja
END;

IF NA70M01.STATNAPO EQ ' ';      /* ni vpisal hoÈe vse
  /* ---od 7.10.2009 --MOVE '0' TO STATNASP;          /* spodnja
  /* ---od 7.10.2009 --MOVE '9' TO STATNAZG;          /* zgornja
  /* ---od 7.10.2009 ni bvzelo C,T-----
  MOVE ' ' TO STATNASP;          /* spodnja
  MOVE 'Z' TO STATNAZG;          /* zgornja
ELSE;                            /* vpisal
  MOVE NA70M01.STATNAPO TO STATNASP; /* spodnja
  MOVE NA70M01.STATNAPO TO STATNAZG; /* zgornja
END;

/* ---od 7.10.2009--Tomazin------------------
IF NA70M01.STATNARO EQ ' ';      /* ni vpisal hoÈe vse
  MOVE ' ' TO STATNAROSP;        /* spodnja
  MOVE 'ZZ' TO STATNAROZG;       /* zgornja
ELSE;                            /* vpisal
  MOVE NA70M01.STATNARO TO STATNAROSP; /* spodnja
  MOVE NA70M01.STATNARO TO STATNAROZG; /* zgornja
END;


IF NA70M01.KASIFSM EQ ' ';       /* ni vpisal hoÈe vse
  MOVE '%%%' TO PROGESP;         /* spodnja
ELSE;                            /* vpisal
  MOVE NA70M01.KASIFSM TO PROGESP; /* spodnja
END;
;
;
IF NA70M01.INDIKTEH EQ ' ';      /* ni vpisal hoÈe vse
  MOVE ' ' TO INDTESP;           /* spodnja
  MOVE '9' TO INDTEZG;           /* zgornja
ELSE;                            /* vpisal
  MOVE NA70M01.INDIKTEH TO INDTESP; /* spodnja
  MOVE NA70M01.INDIKTEH TO INDTEZG; /* zgornja
END;
;
IF NA70M01.SIFRA3 EQ ' ';        /* ni vpisal hoÈe vse
  MOVE '000' TO SIFRA3SP;        /* spodnja
  MOVE '999' TO SIFRA3ZG;        /* zgornja
ELSE;                            /* vpisal
  MOVE NA70M01.SIFRA3 TO SIFRA3SP; /* spodnja
  MOVE NA70M01.SIFRA3 TO SIFRA3ZG; /* zgornja
END;

/* ******* dodano 10/2024 - green alu **********
IF NA70M01.TZ = '%' OR NA70M01.TZ = ' ';
  NA70W05.TZ_OD = 0;
  NA70W05.TZ_DO = 99999;
END;
IF NA70M01.TZ = 'D';
  NA70W05.TZ_OD = 1;
  NA70W05.TZ_DO = 99999;
END;
IF NA70M01.TZ = 'N';
  NA70W05.TZ_OD = 0;
  NA70W05.TZ_DO = 0;
END;
IF NA70M01.TZ_KRIT > 0;
  NA70W05.TZ_OD = NA70M01.TZ_KRIT;
  NA70W05.TZ_DO = NA70M01.TZ_KRIT;
  NA70M01.TZ = 'D';
END;




