:func      name      = NA70P01           
           date      = '01/28/2025' time = '07:51:47' option = EXECUTE  
           desc      = 'glavni proces pregleda'
           refine    = N  
:before.
NA70F05();                       /* opis programa
 /* *********************************************************

 /* **********************************************************
 /* Proces ima zanko v kateri se izvaja prikaz mape NA70M01  *
 /* **********************************************************
MOVE 1 TO EZEFEC;
MOVE 1 TO EZESQISL;
MOVE 'NA70' TO EZESEGTR;         /* IME TRANSAKCIJE
MOVE EZESYS TO NA70W05.SISTEM;   /* preverja, èe je v testu
IF NA70W05.SISTEM = 'ITF' AND NA70W01.ZAPRIIM = ' '; /* dela v testu
  MOVE 2 TO NA70W01.STEVAPPL;
  MOVE 'SPINDLER M.' TO NA70W01.ZAPRIIM;
  MOVE '01' TO NA70W01.FIRMA;
END;

MOVE NA70W01.ZAPRIIM TO VGENR01.IME; /* V SLOG
VGPRINT();                       /* ÈITANJE PRINTERJA
MOVE VGENR01.PRINTER TO NA70M01.PRT; /* NA EKRAN
MOVE 'NA70A' TO NA70W01.APPL[STEVAPPL];

MOVE EZEDTEL TO NA70W05.DATUM;   /* podstr. za letona (11/2011)
NA70W05.LETONA = NA70W05.LLLL - 1; /* za  let nazaj (konèana naroèila)
MOVE NA70W05.LETONA TO NA70M01.LETONA;
MOVE '%' TO NA70M01.CALL_OFF;
MOVE '%' TO NA70M01.TZ;
MOVE '%' TO NA70M01.PPAP_EMPB;


IF NA70W01.FIRMA = '13';
  MOVE '13' NA70M01.FIRMA_VH;    /* tlm
ELSE;
  MOVE '01' NA70M01.FIRMA_VH;    /* impol
END;
MOVE NA70M01.FIRMA_VH TO NA70R22.FIRMA;
NA70F106();                      /* inq tt_firma
IF EZESQCOD = 0;
  MOVE NA70R22.NAZIVF TO NA70M01.NAZIVF;
END;



SET NA70W02 EMPTY;               /* sprazni WS, kjer se shranijo naroÈila
SET NA70M01.STNAROC CURSOR;


MOVE 'DELAM' TO FLOK;            /* indikator zanke za prikaz mape
/* ---------glavna zanka--------------------------------
WHILE FLOK EQ 'DELAM';           /* dokler je pogoj
  /* *****************************************************
  /* *prikaz mape NA70M01 - izbira kriterijev za pregled *
  /* *****************************************************

  MOVE VGENR01.PRINTER TO NA70M01.PRT; /* NA EKRAN
  NA70P02();                     /* converse mape

  /* *****************************************************
  /* * test na tipke PF3, PA2                            *
  /* *****************************************************
  IF EZEAID IS PA2;              /* izhod iz aplikacije
    EZECLOS;
  ELSE;
    IF EZEAID IS PF3;            /* prehod v predh.aplikacijo
      NA70W01.STEVAPPL = NA70W01.STEVAPPL - 1; /* Števec na predhodno
      MOVE NA70W01.APPL[STEVAPPL] TO EZEAPP; /* ime predhodne
      DXFR EZEAPP NA70W01;       /* meni aplikacija skladiŠÈa
      EZECLOS;
    END;
  END;

  /* *****************************************************
  /* *  brisanje mape NA70M01 - PF6                      *
  /* *****************************************************
  IF EZEAID IS PF6;
    SET NA70M01 CLEAR;
    MOVE EZEDTEL TO NA70W05.DATUM; /* podstr. za letona (11/2011)
    NA70W05.LETONA = NA70W05.LLLL - 1; /* za  let nazaj (konèana naroèila)
    MOVE NA70W05.LETONA TO NA70M01.LETONA;
    MOVE '%' TO NA70M01.CALL_OFF;
    MOVE '%' TO NA70M01.TZ;
    MOVE '%' TO NA70M01.PPAP_EMPB;
    SET NA70M01.STNAROC CURSOR;

    IF NA70W01.FIRMA = '13';
      MOVE '13' NA70M01.FIRMA_VH; /* tlm
    ELSE;
      MOVE '01' NA70M01.FIRMA_VH; /* impol
    END;
    MOVE NA70M01.FIRMA_VH TO NA70R22.FIRMA;
    NA70F106();                  /* inq tt_firma
    IF EZESQCOD = 0;
      MOVE NA70R22.NAZIVF TO NA70M01.NAZIVF;
    END;

    SET NA70W02 EMPTY;           /* sprazni WS, kjer se shranijo naroÈila
  END;

  /* *****************************************************
  /* *  prehod v prikaz šifer statusa naroèil NA70M10-PF12
  /* *****************************************************
  IF EZEAID IS PF12;
    SET NA70M01.STATNARO CURSOR; /* postavi sem
    NA70P-STATUSI();
  END;

  /* *****************************************************
  /* *  zanka za manipulacijo na mapi NA70M02-lista      *
  /* *****************************************************

  IF EZEAID IS PF4;              /* pregled
    NA70W02.NAROD = NA70M01.NAROD; /* v WS2 za kriterij-od 02.06.2004
    MOVE 'STOP' TO FLNAPREJ;     /* ni pogoja za naprej

    IF NA70M01.STNAROC > 0;      /* vpisana Številka naroÈila
      MOVE 'NAPREJ' TO FLNAPREJ; /* pogoj za naprej
    ELSE;
      IF NA70M01.KASIFSM EQ ' ' OR NA70M01.KASIFSM EQ '%%%';
        MOVE "Obvezen vpis šifre PP - 011,021,031,034,041,051,111,900" NA70M01.EZEMSG;
        SET NA70M01.KASIFSM CURSOR;
      ELSE;
/* ****************** avtorizacija za PP **************************************
/* INDIK = 0;
/* MOVE NA70M01.KASIFSM TO NA70R08.SIFRAUP; /* pp v šifro
/* NA70F02();               /* preverja avtorizacijo za to PE 6/2011
/* IF INDIK = 1;
/* NA70M01.EZEMSG = "Za izbran PP nimaš avtorizacije!";
/* SET NA70M01.KASIFSM CURSOR;
/* ELSE;
/* MOVE 'NAPREJ' TO FLNAPREJ; /* pogoj za naprej
/* END;


        MOVE 'NAPREJ' TO FLNAPREJ; /* pogoj za naprej
      END;
    END;


    ;
    IF FLNAPREJ EQ 'NAPREJ';     /* pogoj za nadaljevanje
      WHILE EZEAID NOT PF3;      /* DOKLER NI PF3


        SET NA70M01.STATNAPO CURSOR; /* 12/2022

        /* *****************************************************
        /* *  pregled naroÈil   - PF4                          *
        /* *****************************************************
        IF EZEAID IS PF4;        /* pregled skl.
          NA70P0100();           /* ***** procedura za pregled *******
        END;
        /* *****************************************************
        /* *  listanje naprej   - PF8                          *
        /* *****************************************************
        IF EZEAID IS PF8;        /* listanje naprej
          IF CTRSTART <= CTRLINIJ; /* da Še ni konec
            SET NA70M02.STNAROC[1] CURSOR;
            MOVE 1 TO CTRSTRAN;  /* Števec vrstic na stran
            MOVE NA70M02.SUMKG TO NA70W02.SUMKG; /* shrani v WS
            ;
            SET NA70M02 CLEAR;   /* birŠe vsebino mape
            MOVE NA70W02.SUMKG TO NA70M02.SUMKG; /* prenese na mapo
            ;
            NA70P09();           /* prenos vrstic na ekran
            ;
            IF CTRSTART < CTRLINIJ; /* Še ni konec
              MOVE "Za naprej pritisni F8, za nazaj F7 " NA70M02.EZEMSG;
            ELSE;                /* konec
              MOVE "Konec pregleda - Nazaj F7" TO NA70M02.EZEMSG;
            END;
          ELSE;                  /* ni pogoja za naprej
            MOVE 'KONEC LISTE' TO NA70M02.EZEMSG;
          END;
        END;

         /* *****************************************************
         /* *  listanje nazaj    - PF7                          *
         /* *****************************************************

        IF EZEAID IS PF7;        /* listanje naprej
          IF CTRSTART > 16;      /* da je na drugi strani > 16
            CTRSTART = CTRSTART - 15; /* za en ekran nazaj
            IF CTRSTRAN > 1;     /* pogoj da je nekaj na ekranu
              CTRSTART = CTRSTART - CTRSTRAN; /* za Število vrstic na
              CTRSTART = CTRSTART + 1;
            END;
            SET NA70M02 CLEAR;   /* birŠe vsebino mape
            MOVE 1 TO CTRSTRAN;  /* Števec vrstic na stran
            NA70P09();           /* prenos vrstic na ekran
            IF CTRSTART < CTRLINIJ; /* Še ni konec
              MOVE "Za naprej pritisni F8, za nazaj F7 " NA70M02.EZEMSG;
            ELSE;                /* konec
              MOVE "Konec pregleda - Nazaj F7" TO NA70M02.EZEMSG;
            END;
          ELSE;                  /* ni pogoja za naprej
            MOVE 'ZAÈETEK LISTE' TO NA70M02.EZEMSG;
          END;
        END;

        /* *****************************************************
        /* *  detalj naroÈila        - PF2                     *
        /* *****************************************************
        IF EZEAID IS PF2;        /* detalj
          MOVE 0 TO CTRCURSO;    /* števec na 0
          WHILE CTRCURSO < 16;
            CTRCURSO = CTRCURSO + 1;
            TEST NA70M02.STNAROC[CTRCURSO] CURSOR NA70P10; /* detalj
          END;                   /* konec zanke
        END;                     /* konec PF4 - detalj

        /* *****************************************************
        /* *  prehod v operativno tehnologijo   (5/2013 Matej)
        /* *****************************************************
        IF EZEAID IS PF9;        /* v tehnologijo
          MOVE 0 TO CTRCURSO;    /* števec na 0
          STEVEC = 0;
          WHILE CTRCURSO < 15 AND STEVEC = 0;
            CTRCURSO = CTRCURSO + 1;
            IF NA70M02.STNAROC[CTRCURSO] > 0 AND NA70M02.STNAROC[CTRCURSO] IS CURSOR;
              NA70W05.POLJE = ' '; /* inic
              MOVE NA70M02.LETONA[CTRCURSO] TO NA70W05.LETONA; /* 5/2016
              MOVE NA70M02.STNAROC[CTRCURSO] TO NA70W05.STNAROC; /* podstuktura
              MOVE NA70M02.POZNARO[CTRCURSO] TO NA70W05.POZNARO; /* podstuktura
              MOVE CTRCURSO TO STEVEC; /* za nazaj
            END;
          END;                   /* konec zanke

          IF STEVEC > 0;
            NA70F20();           /* pregled operativne tehnologije 5/2013
          END;
        END;                     /* konec PF12



/* **************************************************************/
/* v D142 tehnologija
/* **************************************************************/
        IF EZEAID IS PF12;       /* v tehnologijo
          MOVE 0 TO CTRCURSO;    /* števec na 0
          WHILE CTRCURSO < 16;
            CTRCURSO = CTRCURSO + 1;
            IF NA70M02.STNAROC[CTRCURSO] > 0 AND NA70M02.STNAROC[CTRCURSO] IS CURSOR;
              NA70W05.POLJE = ' '; /* inic
              MOVE NA70M02.STNAROC[CTRCURSO] TO NA70W01.STNAROC; /* podstuktura
              MOVE NA70M02.POZNARO[CTRCURSO] TO NA70W01.POZNARO; /* podstuktura
/* MOVE NA70W05.POLJE TO NA70W01.R1; /* št. + poz naroèila
              NA70W01.R1 = ' ';
              NA70W01.STEVAPPL = NA70W01.STEVAPPL + 1; /* števec +1
/* DXFR D214A NA70W01; /* /
              DXFR D142A NA70W01; /* /
            END;
          END;                   /* konec zanke
        END;                     /* konec PF12



/* **************************************************************/
/* v NA20  standardizacija
/* **************************************************************/
        IF EZEAID IS PF1;        /* v tehnologijo
          MOVE 0 TO CTRCURSO;    /* števec na 0
          WHILE CTRCURSO < 16;
            CTRCURSO = CTRCURSO + 1;
            IF NA70M02.STNAROC[CTRCURSO] > 0 AND NA70M02.STNAROC[CTRCURSO] IS CURSOR;
              NA70W05.POLJE = ' '; /* inic
              MOVE NA70M02.STNAROC[CTRCURSO] TO NA70W05.STNAROC; /* podstuktura
              MOVE NA70M02.POZNARO[CTRCURSO] TO NA70W05.POZNARO; /* podstuktura
              MOVE NA70W05.POLJE TO NA70W01.R1; /* št. + poz naroèila
              NA70W01.STEVAPPL = NA70W01.STEVAPPL + 1; /* števec +1
              DXFR NA20A NA70W01; /* /
            END;
          END;                   /* konec zanke
        END;                     /* konec PF12



      /* *****************************************************
        /* *  detalj KZ-ja        - PF10       (9/2004 Matej)         *
        /* *****************************************************
        IF EZEAID IS PF10;       /* detalj KZ-ja
          SET NA70W03 EMPTY;     /* ws za prenos v KZ
          MOVE 0 TO CTRCURSO;    /* števec na 0
          WHILE CTRCURSO < 16;
            CTRCURSO = CTRCURSO + 1;
            TEST NA70M02.STNAROC[CTRCURSO] CURSOR NA70P35; /* detalj
          END;                   /* konec zanke
          IF NA70W03.STEVKZ > 0; /* je nekaj našel
            CALL SL06A NA70W03 (REPLY;
          END;
        END;                     /* konec



/* **********************************************************************/
/* F6 - pregled GREEN detalja 12/2024 prehod v D333A
/* ***********************************************************************/
        IF EZEAID IS PF6;
          SET CALL_D333 EMPTY;   /* ws za parametre
          NASEL = 'NE';
          MOVE 0 TO CTRCURSO;    /* števec na 0
          WHILE CTRCURSO < 16 AND NASEL = 'NE';
            CTRCURSO = CTRCURSO + 1;
            IF NA70M02.STNAROC[CTRCURSO] > 0 AND NA70M02.STNAROC[CTRCURSO] IS CURSOR;
              NASEL = 'DA';
              MOVE NA70M02.LETONA[CTRCURSO] TO NA70R55.LETONA;
              MOVE NA70M02.STNAROC[CTRCURSO] TO NA70R55.STNAROC;
              MOVE NA70M02.POZNARO[CTRCURSO] TO NA70R55.POZNARO;
              NA70F117();        /* bere naropozilme - ID green zahteve in nafila ws CALL_D333
            END;
          END;                   /* konec while zanke

          IF NASEL = 'DA';
            IF CALL_D333.ID_GREP_TRAJNOSTNA_ZAHTEVA > 0;
              CALL D333A CALL_D333 (REPLY; /* program za detalj GREEN zahteve
              CALL_D333.ID_GREP_TRAJNOSTNA_ZAHTEVA = 0; /* inic
            END;
            SET NA70M02.STNAROC[CTRCURSO] CURSOR; /* vrne kurzor ko se vrne
          END;
        END;


      /* *****************************************************
        /* *  kombinacije KZ-ja        - PF11       (6/2011 Matej)         *
        /* *****************************************************
        IF EZEAID IS PF11;       /* kombinacije KZ-ja
          NA70W05.STEVKZ = 0;
          MOVE 0 TO CTRCURSO;    /* števec na 0
          WHILE CTRCURSO < 16;
            CTRCURSO = CTRCURSO + 1;
            TEST NA70M02.STNAROC[CTRCURSO] CURSOR NA70F06; /*  
          END;                   /* konec zanke
          IF NA70W05.STEVKZ > 0; /* je nekaj našel
            NA70F07();           /* glavni za M3
          ELSE;
            MOVE "Naroèilo nima KZ-ja!" TO NA70M02.EZEMSG;
          END;
        END;                     /* konec






        /* *****************************************************
        /* *  IZPIS             - PF5                          *
        /* *****************************************************
        IF EZEAID IS PF5 AND EZEDESTP NE '   '; /* IZPIS IN PRINTER ZNAN
          NA70P01200();          /* izpis
          SET NA70M05 PAGE;      /* nova stran na koncu
        END;

/* ****************************************************
        IF FLNAPREJ EQ 'NAPREJ';
          NA70P08();             /* prikaz mape NA70M02
        ELSE;
          NA70P01();
        END;
      END;                       /* konec zanke dokler ni PF3
                                 /* ---------------
    END;                         /* konec zanke dokler ni PF3
                                 /* ---------------
  END;                           /* pogoj PF2
  ;
END;                             /* -- konec glavne zanke----;
:ebefore.
:efunc.

:func      name      = NA70P0100         
           date      = '01/28/2025' time = '07:50:46' option = EXECUTE  
           desc      = 'F4 - Pregled'
           refine    = N  
:before.
IF NA70M01.KASIFSM = ' ' AND NA70M01.STNAROC = 0; /* niti po naroèilu
  SET NA70M01.KASIFSM CURSOR;
  FLNAPREJ = 'STOP';             /* pogoj za nadaljevanje
  NA70M01.EZEMSG = "Obvezen vpis PP, sicer pregleda ni";
  EZERTN();
END;

IF NA70M01.FIRMA_VH = ' ' OR NA70M01.NAZIVF = ' ';
  SET NA70M01.FIRMA_VH CURSOR;
  FLNAPREJ = 'STOP';             /* pogoj za nadaljevanje
  NA70M01.EZEMSG = "Obvezen vpis firme 01, 12 ali 13!";
  EZERTN();
END;


IF NA70M01.TZ = '%' OR NA70M01.TZ = 'D' OR NA70M01.TZ = 'N';
ELSE;                            /* 10/2024
  SET NA70M01.TZ CURSOR;
  FLNAPREJ = 'STOP';             /* pogoj za nadaljevanje
  NA70M01.EZEMSG = "Obvezen vpis pravilnega podatka v polje Green alu - TZ!";
  EZERTN();
END;

IF NA70M01.PPAP_EMPB = '%' OR NA70M01.PPAP_EMPB = 'D';
ELSE;                            /* 1/2025
  SET NA70M01.PPAP_EMPB CURSOR;
  FLNAPREJ = 'STOP';             /* pogoj za nadaljevanje
  NA70M01.EZEMSG = "Obvezen vpis pravilnega podatka v polje ppap_empb - (D ali %)!";
  EZERTN();
END;



/* ********** skupina izdelka 3/2021 ***********************
IF NA70M01.ID_PLNSIZDELEK_SKUPINA > 0;
  MOVE NA70M01.ID_PLNSIZDELEK_SKUPINA TO SKUPINA_OD;
  MOVE NA70M01.ID_PLNSIZDELEK_SKUPINA TO SKUPINA_DO;
ELSE;
  MOVE 0 TO SKUPINA_OD;
  MOVE 999 TO SKUPINA_DO;
END;



IF NA70M01.LETONA < 1;
  SET NA70M01.LETONA CURSOR;
  FLNAPREJ = 'STOP';             /* pogoj za nadaljevanje
  NA70M01.EZEMSG = "Obvezen vpis leta naroèila!";
  EZERTN();
END;


IF NA70M01.CALL_OFF = ' ' OR NA70M01.CALL_OFF = '%' OR NA70M01.CALL_OFF = 'N' OR NA70M01.CALL_OFF = 'D';
/* doloèeno 8/2024
ELSE;
  SET NA70M01.CALL_OFF CURSOR;
  FLNAPREJ = 'STOP';             /* pogoj za nadaljevanje
  NA70M01.EZEMSG = "Obvezen vpis kriterija za Call off!";
  EZERTN();
END;




MOVE NA70M01.FIRMA_VH TO NA70R01.FIRMA; /* 4/2016
MOVE NA70M01.LETONA TO NA70R01.LETONA; /* 4/2016

NA70F79();                       /* doloèa setinq 3/2021

IF NA70R01 IS ERR;               /* napaka
  MOVE "Napaka pri èitanju T.NAROPOZI oz t.KOMITENT" TO MSG64;
  ER99P01();                     /* koda napake
  EZEREPLY = 1;
  EZEROLLB();                    /* sprostitev SQL
ELSE;                            /* ok
  MOVE 0 TO CTRLINIJ;            /* Števec najdenih
  /* --------scan-----------------
  NA70P07();                     /* SCAN liste

  SET NA70M02 CLEAR;             /* briŠe vsebino mape

/* ********************** avtorizacija na PP 6/2011 matej ************************************
/* IF EZESQCOD = 0 AND NA70M01.STNAROC > 0; /* èe seo podatki in je vpisano naroèilo 6/2011
/* INDIK = 0;
/* MOVE NA70R01.PROGENOT TO NA70R08.SIFRAUP; /* pp v šifro
/* NA70F02();                   /* preverja avtorizacijo za to PE 6/2011
/* IF INDIK = 1;
/* NA70M02.EZEMSG = "To naroèilo ima PP za katerega nimaš avtorizacije!!";
/* EZERTN();
/* END;
/* END;
/* ******************************************************************************


  /* -----zanka za prenos v WS-NA70W02 s SCAN---------------
  WHILE CTRLINIJ < 500           /* prvi pogoj
    AND NA70R01 NOT ERR;         /* da ni napake pri SCAN
              /* ----dodano 07.02.2007-------
    FLBRISI = 'DA';              /* pogoj za dajanje v WS
    IF NA70M01.STATNAPO = '3' AND
      NA70W02.Q_IND = 'DA';      /* išèe kaj ima naroèil od Quintiq s OT
      NA70R33 = NA70R01;         /* v SLOG
      NA70P333();                /* INQUIRY v t.Q_OPTEHNGL
      IF EZESQCOD NE 0;          /* ni niè
        FLBRISI = 'NE-NI';       /* pogoj za dajanje v WS
      END;
    END;

    IF NA70M01.CALL_OFF = ' ' OR NA70M01.CALL_OFF = '%'; /* prenese vsa naroèila
      NA70F115();                /* prenos živih v WS2
    ELSE;
      IF NA70W05.CALLOFF_ID > 0 AND NA70M01.CALL_OFF = 'D'; /* prenese samo call off naroèila
        NA70F115();              /* prenos živih v WS2
      END;
      IF NA70W05.CALLOFF_ID < 1 AND NA70M01.CALL_OFF = 'N'; /* ne prenese call off naroèil
        NA70F115();              /* prenos živih v WS2
      END;
    END;

    NA70P07();                   /* SCAN liste
  END;                           /* konec while

             /* ----Èitanje t.KONCNARO-----------------
  IF NA70M01.STNAROC > 0;        /* vpisana Številka naroÈila

    MOVE NA70M01.FIRMA_VH TO NA70R10.FIRMA; /* 4/2016
    MOVE NA70M01.LETONA TO NA70R10.LETONA; /* 4/2016
    MOVE NA70M01.STNAROC TO NA70R10.STNAROC;

    IF NA70M01.ID_PLNSIZDELEK_SKUPINA > 0;
      NA70P21_S();               /* SETINQ v t.KONCNARO
    ELSE;
      NA70P21();                 /* SETINQ v t.KONCNARO
    END;

    IF NA70R10 IS ERR;           /* napaka
      MOVE "Napaka pri èitanju T.KONCNARO oz t.KOMITENT" MSG64;
      ER99P01();                 /* koda napake
      EZEREPLY = 1;
      EZEROLLB();                /* sprostitev SQL
    ELSE;                        /* ok
                 /* --------scan-----------------
      NA70P22();                 /* SCAN liste


/* ********************** avtorizacija na PP 6/2011 matej ************************************
/* IF EZESQCOD = 0 AND NA70M01.STNAROC > 0; /* èe seo podatki in je vpisano naroèilo 6/2011
/* INDIK = 0;
/* MOVE NA70R10.PROGENOT TO NA70R08.SIFRAUP; /* pp v šifro
/* NA70F02();               /* preverja avtorizacijo za to PE 6/2011
/* IF INDIK = 1;
/* NA70M02.EZEMSG = "To naroèilo ima PP za katerega nimaš avtorizacije!!";
/* EZERTN();
/* END;
/* END;
/* ******************************************************************************



                /* ---zanka za prenos v WS-NA70W02 s SCAN---------
      WHILE CTRLINIJ < 500       /* prvi pogoj
        AND NA70R10 NOT ERR;     /* da ni napake pri SCAN

        IF NA70M01.CALL_OFF = ' ' OR NA70M01.CALL_OFF = '%'; /* prenese vsa naroèila
          NA70F116();            /* prenos konèanih v WS2
        ELSE;
          IF NA70W05.CALLOFF_ID > 0 AND NA70M01.CALL_OFF = 'D'; /* prenese samo call off naroèila
            NA70F116();          /* prenos konèanih v WS2
          END;
          IF NA70W05.CALLOFF_ID < 1 AND NA70M01.CALL_OFF = 'N'; /* ne prenese call off naroèil
            NA70F116();          /* prenos konèanih v WS2
          END;
        END;

        NA70P22();               /* SCAN liste
      END;                       /* od while

    END;                         /* --- konec prenosa v slog-------
  END;                           /* -- konec prenosa v slog--------
            /* ----v vsakem primeru sprosti SQL---------------
  EZEREPLY = 1;
  EZEROLLB();
  IF NA70R01 NOT NRF             /* napaka pri SCANni NRF
    AND EZESQCOD NE 0;           /* Števec = 150
    MOVE 'NAPAKA PRI SCAN V T.NAROPOZI' TO MSG64;
    ER99P01();                   /* koda napake
    MOVE MSG78 TO NA70M01.EZEMSG;
  ELSE;                          /* ni napake-na ekran  prenos na ekran
    /* **************************************************************/
    /* dne 28.03.2008
    /* procedura za brisanje preveè blankov - v W02.DIMENZ35
    /* **************************************************************/
    NA70P777();                  /* preuredi v WS
    MOVE 1 TO CTRSTRAN;          /* Števec vrstic na stran
    MOVE 1 TO CTRSTART;          /* Števec vseh preneŠenih vrstic na
                                 /* ekran

    NA70P09();                   /* prenos vrstic na ekran

    IF CTRSTART < CTRLINIJ;      /* Še ni konec
      IF CTRLINIJ < 500;         /* so vsi na listi
        MOVE "Za naprej pritisni F8 " TO NA70M02.EZEMSG;
      ELSE;                      /* veÈ kot 100-niso vsi na listi
        MOVE "Prikaz le 500 vrstic-Za naprej pritisni F8 "
          NA70M02.EZEMSG;
      END;
    ELSE;                        /* konec
      MOVE "Konec pregleda " TO NA70M02.EZEMSG;
    END;
    ;
  END;                           /* ----konec prenosa na ekran, stran je
                                 /* polna----
END;
:ebefore.
:efunc.

:func      name      = NA70P01200        
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'izpis liste iz WS'
           refine    = N  
:before.
/* ----PRINTANJE-----------------
MOVE 5 TO CTRSTRA1;              /* VRSTIC NA STRAN - 5 = GLAVA
MOVE 1 TO NA70M05.STRAN;         /* ŠTEVEC STRANI
NA70P30();                       /* DISPLAY GLAVA IZPISA
MOVE 1 TO CTRKOPIJ;              /* ŠTEVEC IZPISANIH

/* ----prenos iz WS na ekran----------------------
WHILE CTRKOPIJ <= CTRLINIJ;      /* kontrola na Število v WS
  MOVE NA70W02.STNAROC[CTRKOPIJ] TO NA70M06.STNAROC;
  MOVE NA70W02.POZNARO[CTRKOPIJ] TO NA70M06.POZNARO;
  MOVE NA70W02.TEXT60[CTRKOPIJ] TO NA70M06.TEXT60;
  MOVE NA70W02.NARKOLPR[CTRKOPIJ] TO NA70M06.NARKOLPR;
  MOVE NA70W02.KZORG[CTRKOPIJ] TO NA70M06.KZORG; /* 5/2006 Matej
  MOVE NA70W02.VERKZ[CTRKOPIJ] TO NA70M06.VERKZ; /* ; /* 5/2006 Matej


  CTRSTRA1 = CTRSTRA1 + 1;       /* IZPISANIH NA STRAN
  CTRKOPIJ = CTRKOPIJ + 1;       /* za WS - VSEH

  NA70P31();                     /* DISPLAY VRSTICE

  IF CTRSTRA1 <= 64;             /* OK
  ELSE;                          /* NOVA STRAN
    SET NA70M05 PAGE;            /* nova stran
    NA70M05.STRAN = NA70M05.STRAN + 1;
    MOVE 5 TO CTRSTRA1;          /* VRSTIC NA STRAN - 5 = GLAVA

    NA70P30();                   /* DISPLAY GLAVA IZPISA
  END;
END;                             /* -----konec zanke za prenos na
                                 /* ekran---------
NA70P32();                       /* CLOSE VRSTICE
MOVE "Izpis je konèan" TO NA70M02.EZEMSG;
:ebefore.
:efunc.

