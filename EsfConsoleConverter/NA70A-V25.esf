  IF INDIK = 0;                  /* uspešno dodajanje
    EZEREPLY = 1;
    EZECOMIT();                  /* potrditev
  ELSE;
    EZEREPLY = 1;
    EZEROLLB();                  /* preklic
  END;


END;
