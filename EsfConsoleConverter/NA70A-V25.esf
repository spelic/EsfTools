:func      name      = NA70P09           
           date      = '11/08/2024' time = '11:54:23' option = EXECUTE  
           desc      = 'zanka za prenos iz WS na ekran'
           refine    = N  
:before.
; /* ----prenos iz WS na ekran----------------------
WHILE CTRSTRAN <= 15             /* do 15 na ekran
  AND CTRSTART <= CTRLINIJ;      /* kontrola na Število v WS
  MOVE NA70W02.LETONA[CTRSTART] TO NA70M02.LETONA[CTRSTRAN];
  MOVE NA70W02.STNAROC[CTRSTART] TO NA70M02.STNAROC[CTRSTRAN];

  IF NA70M01.KASIFSM = '051' AND NA70W02.STATUS_PREGLED[CTRSTART] = 'N';
    SET NA70M02.POZNARO[CTRSTRAN] RED;
  ELSE;
    SET NA70M02.POZNARO[CTRSTRAN] DEFINED;
  END;

/* ********************** èe je oznaka za CEVIS obdelavo ******************************************
  IF NA70M01.KASIFSM = '051' AND (NA70W02.STATNAPO[CTRSTART] = '3' OR
    NA70W02.STATNAPO[CTRSTART] = '4' OR NA70W02.STATNAPO[CTRSTART] = '5'
    OR NA70W02.STATNAPO[CTRSTART] = 'C' OR NA70W02.STATNAPO[CTRSTART] = 'T'); /* ;
    MOVE NA70W02.LETONA[CTRSTART] TO NA70R53.LETONA;
    MOVE NA70W02.STNAROC[CTRSTART] TO NA70R53.STNAROC;
    MOVE NA70W02.POZNARO[CTRSTART] TO NA70R53.POZNARO;
    NA70F110();                  /* inq joina
    IF NA70R53.KONTROLA_C = 'D';
      SET NA70M02.STNAROC[CTRSTRAN] RED;
    ELSE;
      SET NA70M02.STNAROC[CTRSTRAN] DEFINED;
    END;
  END;


  MOVE NA70W02.TZ[CTRSTART] TO NA70M02.TZ[CTRSTRAN]; /* 11/2024 - green alu
  MOVE NA70W02.POZNARO[CTRSTART] TO NA70M02.POZNARO[CTRSTRAN];
  MOVE NA70W02.TEXT60[CTRSTART] TO NA70M02.TEXT60[CTRSTRAN];
  MOVE NA70W02.NARKOLPR[CTRSTART] TO NA70M02.NARKOLPR[CTRSTRAN];
  MOVE NA70W02.KZORG[CTRSTART] TO NA70M02.KZORG[CTRSTRAN]; /* 4/2016 Matej
  MOVE NA70W02.VERKZ[CTRSTART] TO NA70M02.VERKZ[CTRSTRAN]; /* 9/2004 Matej
/* MOVE NA70W02.STEVKZ[CTRSTART] TO NA70M02.STEVKZ[CTRSTRAN]; /* 9/2004 Matej
  ; /* -----seŠtevek spodaj na ekran-------------
  NA70M02.SUMKG = NA70M02.SUMKG + NA70W02.NARKOLPR[CTRSTART] (R;
  ;
  CTRSTRAN = CTRSTRAN + 1;       /* za ekran
  CTRSTART = CTRSTART + 1;       /* za WS
END;                             /* -----konec zanke za prenos na ekran---------
:ebefore.
:efunc.

:func      name      = NA70P10           
           date      = '01/28/2025' time = '08:19:42' option = EXECUTE  
           desc      = 'detalj o naroÈilu'
           refine    = N  
:before.
/* SG po testu pozicije kurzorja za prikaz detalja o viŠku
/* -------------------------------------------------------
SET NA70M03 CLEAR;               /* sprazni vsebino ekrana
SET NA70M04 CLEAR;               /* sprazni vsebino ekrana

SET NA70M03.MEHANSKE DEFINED;    /* skrito
SET NA70M03.KEMIJA DEFINED;      /* akrito


MOVE NA70M01.FIRMA_VH TO NA70R05.FIRMA; /* 4/2016
MOVE NA70M02.LETONA[CTRCURSO] TO NA70R05.LETONA; /* v slog NAROPOZI
MOVE NA70M02.STNAROC[CTRCURSO] TO NA70R05.STNAROC; /* v slog NAROPOZI
MOVE NA70M02.POZNARO[CTRCURSO] TO NA70R05.POZNARO; /* v slog NAROPOZI

MOVE NA70R05.FIRMA TO NA70M03.FIRMA; /* na ekran
MOVE NA70R05.LETONA TO NA70M03.LETONA; /* na ekran
MOVE NA70R05.STNAROC TO NA70M03.STNAROC; /* na ekran
MOVE NA70R05.POZNARO TO NA70M03.POZNARO; /* na ekran
NA70P11();                       /* INQUIRY v t.NARGLAVA;NAROPOZI

IF NA70R05 IS ERR;               /* napaka
  IF NA70R05 IS NRF;             /* ne najde
    MOVE "Tega naroèila ne najdem " TO MSG64;
    /* ----Èitanje KONCNARO----------------------------

    MOVE NA70M01.FIRMA_VH TO NA70R11.FIRMA; /* 4/2016
    MOVE NA70M02.LETONA[CTRCURSO] TO NA70R11.LETONA; /* v slog NAROPOZI
    MOVE NA70M02.STNAROC[CTRCURSO] TO NA70R11.STNAROC; /* v slog NAROPOZI
    MOVE NA70M02.POZNARO[CTRCURSO] TO NA70R11.POZNARO; /* v slog NAROPOZI
    ;
    NA70P23();                   /* INQUIRY v t.KONCNARO
    IF NA70R11 IS ERR;           /* napaka
      MOVE "Tega naroèila ne najdem med konèanimi " TO MSG64;
      ER99P01();                 /* koda napake
      MOVE MSG78 TO NA70M03.EZEMSG;
    ELSE;
      MOVE 'T.KONCNARO' TO FLZAPIS1; /* je zakljuÈeno naroèilo
      SET NA70M03 EMPTY;         /* sprazni vsebino ekrana
      MOVE "To naroèilo je konèano " TO MSG64;
      MOVE NA70R11 TO NA70M03;   /* slog na mapo NA70M03
      MOVE NA70R11 TO NA70M04;   /* slog na mapo NA70M04


/* *************** rok odpreme - Rondal ******************************
      IF NA70M03.PROGENOT = '900'; /* rondal
        SET NA70M03.LAB_F5 BRIGHT,PROTECT;
        NA70M03.LAB_ROK = "Rok odpreme:";
        IF NA70R11.DATSTAT9 NE ' ';
          MOVE NA70R11.DATSTAT9 TO NA70M03.DATSTAT9;
        END;
      ELSE;
        SET NA70M03.LAB_F5 DEFINED;
      END;
/* ********************************************************************



      NA70F108();                /* išèe prodajno ceno iz TT_POGODBPO 9/2016


      IF NA70M03.STATNAPO EQ '0' OR NA70M03.STATNAPO EQ '1' OR NA70M03.STATNAPO EQ '2'
        OR NA70M03.STATNAPO EQ '3' OR NA70M03.STATNAPO EQ '4';
        NA70M04.PRODCENA = 0;    /* 11/2011 matej
      END;


/* ***** èekira NAROPOZILME *******
      MOVE NA70R11.FIRMA TO NA70R13.FIRMA;
      MOVE NA70R11.LETONA TO NA70R13.LETONA;
      MOVE NA70R11.STNAROC TO NA70R13.STNAROC;
      MOVE NA70R11.POZNARO TO NA70R13.POZNARO;
      NA70F01();                 /* inq naropozilme + lme_opisno
      IF EZESQCOD = 0;
/* ********* 1/2025 SIR - 2274 ******************************
        NA70F144();              /* bere PPAP_EMPB

        NA70F38();               /* èe sta bila kem ali meh spremenjena 10/2024
        MOVE NA70R13.ID_SKUPPZ_KEM_NML TO NA70M03.ID_SKUPPZ_KEM_NML; /* sklop 4/2014
        MOVE NA70R13.ID_SKUPPZ_KEM_NML TO NA70R44.ID_SKUPPZ_KEM_NML; /*  
        MOVE NA70R13.ID_GREP_TRAJNOSTNA_ZAHTEVA TO NA70M03.TZ; /* 10/2024

        NA70F89();               /* inq IMP.SKUPPZ_KEM_NML
        IF EZESQCOD = 0;
          MOVE NA70R44.SKLOP_PZ_KEM_NML TO NA70M03.SKLOP_PZ_KEM_NML;
        END;
        MOVE NA70R13 TO NA70M04;
        IF NA70R13.ZAPST_F1 > 0 OR NA70R13.ZAPST > 0;
          NA70F111();            /* išèe pravo številko SPP 2/2018
        END;
      END;
/* ******** èekira RMPREMIKI 12/2011 ***********************************
      SET NA70M04.STRAT DEFINED; /* original
      IF NA70R13.ZAPST = 0;      /* preverja samo spot
        MOVE NA70R13.LETONA TO NA70R15.LETONA;
        MOVE NA70R13.STNAROC TO NA70R15.STNAROC;
        MOVE NA70R13.POZNARO TO NA70R15.POZNARO;
        NA70F15();               /* inq rm_premiki
        IF EZESQCOD = 0;
          IF NA70R15.ZAPST > 0;
            MOVE NA70R15.ZAPST TO NA70R13.ZAPST;
            NA70F111();          /* išèe pravo številko SPP 2/2018
            SET NA70M04.STRAT BLINK,YELLOW; /* utripa rumeno
          END;
        END;
      END;
/* *************** Metal Bulletin 12/2014 *************************************
      IF NA70M04.ID_SKUSMB_OPISNO > 0;
        NA70M04.KRNAZIV = ' ';   /* inic
        SET NA70R48 EMPTY;       /* imp.skusmb_opisno
        MOVE NA70M04.ID_SKUSMB_OPISNO TO NA70R48.ID_SKUSMB_OPISNO;
        NA70F17();               /* inq
        IF EZESQCOD = 0;
          MOVE NA70R48.KRNAZIV TO NA70M04.KRNAZIV;
        END;
      END;



      MOVE NA70M03.FIRMA TO NA70R06.FIRMA; /* 4/2016
      MOVE NA70M03.IDENT TO NA70R06.IDENT; /* Šifro v slog
      NA70P16();                 /* INQUIRY v t.IZDELKI
      IF NA70R06 IS ERR;         /* napaka
        MOVE 'NAPAKA PRI ÈITANJU T.IZDELKI' TO MSG64;
        ER99P01();               /* koda napake
      ELSE;                      /* naŠel
        MOVE NA70R06 TO NA70M03; /* prenos sloga izdelki na ekran
/* ************* samo za PCP - nefiksna dolžina *************
        IF NA70R06.KLASIFI1 = '60' OR NA70R06.KLASIFI1 = '62' OR NA70R06.KLASIFI1 = '64'; /* samo PCP
          SET CALL_DIM40 EMPTY;
          MOVE NA70R06.IDENT TO CALL_DIM40.IDENT;
          CALL D282A CALL_DIM40 (REPLY; /* program sestavi dimenz40 in dimenz40_dodatek
          IF CALL_DIM40.POLJE_SES NE ' '; /* èe je kaj sestavil
            MOVE CALL_DIM40.POLJE_SES TO NA70M03.DIMENZ40; /* na mapo
          ELSE;
            MOVE NA70R06.DIMENZ40 TO NA70M03.DIMENZ40; /* na mapo
          END;
        END;


/* ************ Artikel - sestavi šifro arikla + orodje 9/2018 **************
        IF NA70R06.KLASIFI1 = '68' OR NA70R06.KLASIFI1 = 'A4';
          SET CALL_ARTIKEL EMPTY;
          MOVE NA70R06.DIMENZ40 TO CALL_ARTIKEL.DIMENZ40;
          CALL D305A CALL_ARTIKEL (REPLY; /* program sestavi artikel + podatki orodja
          IF CALL_ARTIKEL.POLJE_SES NE ' '; /* èe je kaj sestavil
            MOVE CALL_ARTIKEL.POLJE_SES TO NA70M03.DIMENZ40; /* na mapo
          ELSE;
            MOVE NA70R06.DIMENZ40 TO NA70M03.DIMENZ40; /* na mapo
          END;
        END;                     /* od artikel
/* *********************************************************************
      END;
    END;
    ;
    ;
  ELSE;
    MOVE "Napaka pri èitanju t.TT_NARGLAVA + TT_NAROPOZI  " TO MSG64;
  END;
  ER99P01();                     /* koda napake
  MOVE MSG78 TO NA70M03.EZEMSG;
  MOVE ' ' TO MSG78;
  SET NA70M03.EZEMSG CURSOR;
ELSE;                            /* OK ni napake

/* ***** èekira NAROPOZILME *******
  MOVE NA70R05.FIRMA TO NA70R13.FIRMA;
  MOVE NA70R05.LETONA TO NA70R13.LETONA;
  MOVE NA70R05.STNAROC TO NA70R13.STNAROC;
  MOVE NA70R05.POZNARO TO NA70R13.POZNARO;
  NA70F01();                     /* inq naropozilme + lme_opisno
  IF EZESQCOD = 0;
/* ********* 1/2025 SIR - 2274 ******************************
    NA70F144();                  /* bere PPAP_EMPB

    NA70F38();                   /* èe sta bila kem ali meh spremenjena 10/2024
    MOVE NA70R13.ID_SKUPPZ_KEM_NML TO NA70M03.ID_SKUPPZ_KEM_NML; /* sklop 4/2014
    MOVE NA70R13.ID_SKUPPZ_KEM_NML TO NA70R44.ID_SKUPPZ_KEM_NML; /*  
    MOVE NA70R13.ID_GREP_TRAJNOSTNA_ZAHTEVA TO NA70M03.TZ; /* 10/2024
    NA70F89();                   /* inq IMP.SKUPPZ_KEM_NML
    IF EZESQCOD = 0;
      MOVE NA70R44.SKLOP_PZ_KEM_NML TO NA70M03.SKLOP_PZ_KEM_NML;
    END;
    MOVE NA70R13 TO NA70M04;
    IF NA70R13.ZAPST_F1 > 0 OR NA70R13.ZAPST > 0;
      NA70F111();                /* išèe pravo številko SPP 2/2018
    END;
  END;
/* ******** èekira RMPREMIKI 12/2011 ***********************************
  SET NA70M04.STRAT DEFINED;     /* original
  IF NA70R13.ZAPST = 0;          /* preverja samo spot
    MOVE NA70R05.LETONA TO NA70R15.LETONA;
    MOVE NA70R05.STNAROC TO NA70R15.STNAROC;
    MOVE NA70R05.POZNARO TO NA70R15.POZNARO;
    NA70F15();                   /* inq rm_premiki
    IF EZESQCOD = 0;
      IF NA70R15.ZAPST > 0;
        MOVE NA70R15.ZAPST TO NA70R13.ZAPST;
        NA70F111();              /* išèe pravo številko SPP 2/2018
        SET NA70M04.STRAT BLINK,YELLOW; /* utripa rumeno
      END;
    END;
  END;



/* *************** Metal Bulletin 12/2014 *************************************
  IF NA70M04.ID_SKUSMB_OPISNO > 0;
    NA70M04.KRNAZIV = ' ';       /* inic
    SET NA70R48 EMPTY;           /* imp.skusmb_opisno
    MOVE NA70M04.ID_SKUSMB_OPISNO TO NA70R48.ID_SKUSMB_OPISNO;
    NA70F17();                   /* inq
    IF EZESQCOD = 0;
      MOVE NA70R48.KRNAZIV TO NA70M04.KRNAZIV;
    END;
  END;




/* ********* bere izbran TP 1/2012 Matej*************************************
  SET NA70R09 EMPTY;             /* optehngl
  MOVE NA70R05.STNAROC TO NA70R09.STNAROC;
  MOVE NA70R05.POZNARO TO NA70R09.POZNARO;
  NA70F16();                     /* inq optehngl
  IF EZESQCOD = 0;
    MOVE NA70R09.TEHNPOST TO NA70M03.TEHNPOST;
  END;
/* *************************************************************

  MOVE 'T.NAROPOZI' TO FLZAPIS1; /* je zakljuÈeno naroèilo
  MOVE NA70R05 TO NA70M03;       /* slog na mapo NA70M03
  MOVE NA70R05 TO NA70M04;       /* slog na mapo NA70M04



/* **************************************************************/
/* bere èe je kaj na zalogi 12/2024
/* **************************************************************/
  NA70F120();                    /* preverja, èe je že kaj izdelano v zalogi 12/2024 - SIR-2205



  NA70F108();                    /* išèe prodajno ceno iz TT_POGODBPO 9/2016
  ;
  IF NA70M03.STATNAPO EQ '0' OR NA70M03.STATNAPO EQ '1' OR NA70M03.STATNAPO EQ '2'
    OR NA70M03.STATNAPO EQ '3' OR NA70M03.STATNAPO EQ '4';
    NA70M04.PRODCENA = 0;        /* 11/2011 matej
  END;

/* * *************** rok odpreme - Rondal ******************************
  IF NA70M03.PROGENOT = '900';   /* rondal
