:func      name      = NA70F123          
           date      = '12/12/2024' time = '13:31:50' option = EXECUTE  
           desc      = 'Poreže nule'
           refine    = N  
:before.
STEVEC2 = 0;
STEVEC3 = 0;
KONEC = 'N';

WHILE STEVEC2 < 12;
  STEVEC2 = STEVEC2 + 1;


  IF NA70W05.KZ[STEVEC2] = '0' AND KONEC = 'N';

  ELSE;
    KONEC = 'D';
    STEVEC3 = STEVEC3 + 1;
    MOVE NA70W05.KZ[STEVEC2] TO NA70W05.KZ1[STEVEC3];
  END;

END;                             /* while
:ebefore.
:efunc.

:func      name      = NA70F13           
           date      = '03/16/2021' time = '06:53:22' option = EXECUTE  
           desc      = 'Prenos na M7'
           refine    = N  
:before.
/* ***********  prazni mapo ****************************************************************
SET NA70M07 EMPTY;

/* ******************************* prenos ************************************************************
STEVMAPA4 = 1;
WHILE STEVMAPA4 <= 10 AND STEVTREN4 =< STEVWS4;


  MOVE NA70W04.ZAPST_KZLIV[STEVTREN4] TO NA70M07.ZAPST_KZLIV[STEVMAPA4];
  MOVE NA70W04.KZORG_IZD[STEVTREN4] TO NA70M07.KZORG_IZD[STEVMAPA4];
  MOVE NA70W04.ZLITINA_SUR[STEVTREN4] TO NA70M07.ZLITINA_SUR[STEVMAPA4];
  MOVE NA70W04.KZORG_SUR[STEVTREN4] TO NA70M07.KZORG_SUR[STEVMAPA4];
  MOVE NA70W04.PRIORITETA[STEVTREN4] TO NA70M07.PRIORITETA[STEVMAPA4];
  MOVE NA70W04.DATURA[STEVTREN4] TO NA70M07.DATURA[STEVMAPA4];
  MOVE NA70W04.VNESEL[STEVTREN4] TO NA70M07.VNESEL[STEVMAPA4];
  MOVE NA70W04.ZNAK[STEVTREN4] TO NA70M07.ZNAK[STEVMAPA4];

  STEVMAPA4 = STEVMAPA4 + 1;
  STEVTREN4 = STEVTREN4 + 1;
END;
/* ---------- sporoèilo na ekran ----------------
IF STEVWS4 > 0;                  /* podatki obstajajo
  MOVE "Podatki za izbrane kriterije" TO NA70M07.EZEMSG;
END;
:ebefore.
:efunc.

:func      name      = NA70F144          
           date      = '01/28/2025' time = '09:30:53' option = EXECUTE  
           desc      = 'Bere PPAP_EMPB'
           refine    = N  
:before.
SET NA70R60 EMPTY;               /* IMP.NARPTT_NARO_LME_P_NARO_LME_ATR
SET NA70R61 EMPTY;               /* IMP.NARPTT_NAROPOZILME_P_NAR_TIP + IMP.NARS_NAROCILO_TIP
NA70W05.ODG_KAKOVOSTNIK = ' ';
NA70W05.ODG_TEHNOLOG = ' ';
DOL1 = 0;
STEVEC13 = 0;


MOVE NA70R13.ID_TT_NAROPOZILME TO NA70R60.ID_TT_NAROPOZILME;
NA70R60.ID_NARSTT_NAROPOZILME_ATR = 8;
NA70R60.STANJE_ZADNJE_SPREMEMBE = 'A';
NA70F145();                      /* inq IMP.NARPTT_NARO_LME_P_NARO_LME_ATR
IF EZESQCOD = 0;
  IF NA70R60.VREDNOST = 'D';

    IF NA70R60.KOMENTAR NE ' ';  /* èe je uporabnik not
      NASEL = 'NE';
      STEVEC_P80 = 0;
      NA70W05.POLJE80 = ' ';     /* inic
      MOVE NA70R60.KOMENTAR TO NA70W05.POLJE80;
      DOL1 = EZESTLEN( NA70W05.POLJE80); /* pove dolžino polja


      WHILE STEVEC_P80 =< DOL1;
        STEVEC_P80 = STEVEC_P80 + 1;

        IF NA70W05.P80[STEVEC_P80] = '%';
          NASEL = 'DA';
          STEVEC_P80 = STEVEC_P80 + 1;
          STEVEC13 = 0;
        ELSE;
          IF NASEL = 'NE';       /* najprej tehnolog
            STEVEC13 = STEVEC13 + 1;
            MOVE NA70W05.P80[STEVEC_P80] TO NA70W05.ODG_T[STEVEC13];
          ELSE;                  /* 2. string je kakovostnik
            STEVEC13 = STEVEC13 + 1;
            MOVE NA70W05.P80[STEVEC_P80] TO NA70W05.ODG_K[STEVEC13];
          END;
        END;
      END;                       /* od while
    END;                         /* èe je komentar nafilan

/* ******** sestavi msg *********************************
    NA70M04.PPAP_EMPB = 'D';
    NA70W05.PPAP_MSG = ' ';
    IF NA70W05.ODG_TEHNOLOG NE ' '; /* je nekaj sestavil
      NA70W05.PP1 = "Odg. teh.:";
      NA70W05.PP2 = NA70W05.ODG_TEHNOLOG;
      NA70W05.PP3 = "Odg. kak.:";
      NA70W05.PP4 = NA70W05.ODG_KAKOVOSTNIK;
    END;
    MOVE NA70W05.PPAP_MSG TO NA70M04.PPAP_MSG; /* na ekran


/* **************** bere še šifrant vzroka *************************************************************
    MOVE NA70R13.ID_TT_NAROPOZILME TO NA70R61.ID_TT_NAROPOZILME;
    NA70F146();                  /* inq IMP.NARPTT_NAROPOZILME_P_NAR_TIP + IMP.NARS_NAROCILO_TIP
    IF EZESQCOD = 0;
/* pusti v recordu
    END;
  END;
END;
:ebefore.
:efunc.

