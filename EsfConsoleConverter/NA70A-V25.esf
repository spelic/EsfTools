:func      name      = NA70F79           
           date      = '12/16/2024' time = '13:43:19' option = EXECUTE  
           desc      = 'Doloèa setinq'
           refine    = N  
:before.
/* ******* dodano 10/2024 - green alu **********
IF NA70M01.TZ = '%' OR NA70M01.TZ = ' ';
  NA70W05.TZ_OD = 0;
  NA70W05.TZ_DO = 99999;
END;
IF NA70M01.TZ = 'D';
  NA70W05.TZ_OD = 1;
  NA70W05.TZ_DO = 99999;
END;
IF NA70M01.TZ = 'N';
  NA70W05.TZ_OD = 0;
  NA70W05.TZ_DO = 0;
END;
IF NA70M01.TZ_KRIT > 0;
  NA70W05.TZ_OD = NA70M01.TZ_KRIT;
  NA70W05.TZ_DO = NA70M01.TZ_KRIT;
  NA70M01.TZ = 'D';
END;


IF NA70M01.KOTE > 0;             /* 12/2024
  NA70W05.KOTE_OD = NA70M01.KOTE;
  NA70W05.KOTE_DO = NA70M01.KOTE;
ELSE;
  NA70W05.KOTE_OD = 0;
  NA70W05.KOTE_DO = 206001;
END;


IF NA70M01.ZATE > 0;             /* 12/2024
  NA70W05.ZATE_OD = NA70M01.ZATE;
  NA70W05.ZATE_DO = NA70M01.ZATE;
ELSE;
  NA70W05.ZATE_OD = 0;
  NA70W05.ZATE_DO = 206001;
END;

/***************************************************************/
/* akcija
/***************************************************************/
IF NA70M01.ID_PLNSIZDELEK_SKUPINA < 1; /* èe NI skupine izdelka
  IF NA70M01.STNAROC < 1;        /* ni vpisana Številka naroÈila
    IF NA70M01.REFKOM EQ '               ' OR
      NA70M01.REFKOM EQ '%%%%%%%%%%%%%%%'; /* ni vpis v polje REFKOM
      NA70P06();                 /* postavitev kriterijev za SETINQ
      IF NA70M01.ZATE < 1 AND NA70M01.KOTE < 1; /* ni vpisan termin kot kriterij
        IF NA70M01.STPREJEM = ' '; /* NI PREJEMNIKA-22.01.2008
          NA70P041();            /* SETINQ-brez prejemnika
        ELSE;                    /* je
          NA70P04();             /* SETINQ-vsebuje prejemnika
        END;
      ELSE;                      /* je vpisan ZAÈETNI termin
        IF NA70M01.STPREJEM = ' '; /* NI PREJEMNIKA-22.01.2008
          IF NA70M01.STEVSTRO = ' ';
            NA70P191();          /* SETINQ-brez prejemnika
          ELSE;
            MOVE NA70M01.STEVSTRO TO NA70W05.STEVSTRO;
            NA70P191_ST();       /* SETINQ-brez prejemnika - stroj
          END;
        ELSE;
          NA70P19();             /* SETINQ-vsebuje prejemnika
        END;
      END;
    ELSE;                        /* vpisan referent
      IF NA70M01.STATNAPO EQ ' '; /* ni vpisal hoÈe vse
        MOVE '0' TO STATNASP;    /* spodnja
        MOVE '9' TO STATNAZG;    /* zgornja
      ELSE;                      /* vpisal
        MOVE NA70M01.STATNAPO TO STATNASP; /* spodnja
        MOVE NA70M01.STATNAPO TO STATNAZG; /* zgornja
      END;
      IF NA70M01.STPREJEM = ' '; /* NI PREJEMNIKA-22.01.2008
        NA70P181();              /* SETINQ-brez prejemnika
      ELSE;
        NA70P18();               /* SETINQ-vsebuje prejemnika
      END;
    END;
  ELSE;                          /* vpisana Številka naroÈila
    MOVE NA70M01.STNAROC TO NA70R01.STNAROC;
    NA70P05();                   /* SETINQ
  END;

ELSE;                            /* èe je skupine izdelka


  IF NA70M01.STNAROC < 1;        /* ni vpisana Številka naroÈila
    IF NA70M01.REFKOM EQ '               ' OR
      NA70M01.REFKOM EQ '%%%%%%%%%%%%%%%'; /* ni vpis v polje REFKOM
      NA70P06();                 /* postavitev kriterijev za SETINQ
      IF NA70M01.ZATE < 1 AND NA70M01.KOTE < 1; /* ni vpisan termin kot kriterij
        IF NA70M01.STPREJEM = ' '; /* NI PREJEMNIKA-22.01.2008
          NA70P041_S();          /* SETINQ-brez prejemnika
        ELSE;                    /* je
          NA70P04_S();           /* SETINQ-vsebuje prejemnika
        END;
      ELSE;                      /* je vpisan ZAÈETNI termin
        IF NA70M01.STPREJEM = ' '; /* NI PREJEMNIKA-22.01.2008
          NA70P191_S();          /* SETINQ-brez prejemnika
        ELSE;
          NA70P19_S();           /* SETINQ-vsebuje prejemnika
        END;
      END;
    ELSE;                        /* vpisan referent
      IF NA70M01.STATNAPO EQ ' '; /* ni vpisal hoÈe vse
        MOVE '0' TO STATNASP;    /* spodnja
        MOVE '9' TO STATNAZG;    /* zgornja
      ELSE;                      /* vpisal
        MOVE NA70M01.STATNAPO TO STATNASP; /* spodnja
        MOVE NA70M01.STATNAPO TO STATNAZG; /* zgornja
      END;
      IF NA70M01.STPREJEM = ' '; /* NI PREJEMNIKA-22.01.2008
        NA70P181_S();            /* SETINQ-brez prejemnika
      ELSE;
        NA70P18_S();             /* SETINQ-vsebuje prejemnika
      END;
    END;
  ELSE;                          /* vpisana Številka naroÈila
    MOVE NA70M01.STNAROC TO NA70R01.STNAROC;
    NA70P05_S();                 /* SETINQ
  END;




END;
:ebefore.
:efunc.

