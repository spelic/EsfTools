:func      name      = NA70F94           
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'F5-zapis Metal Bulletin'
           refine    = N  
:before.
INDIK = 0;


IF NA70M03.PROGENOT = '111' OR NA70M03.PROGENOT = '900';
ELSE;
  INDIK = 1;
  MOVE "Obraèa lahko samo Alumat in Rondal - ostali v grafiènem okolju!!!" TO NA70M04.EZEMSG;
END;



/* *** * metal bulletin 12/2014 ******************
IF INDIK = 0;
  IF NA70M04.KRNAZIV = ' ' OR NA70M04.ID_SKUSMB_OPISNO < 1;
    SET NA70M04.ID_SKUSMB_OPISNO CURSOR;
    INDIK = 1;
    MOVE "Obvezen vnos Metal Bulletin formule!!!" TO NA70M04.EZEMSG;
  END;
END;

IF INDIK = 0;


  MOVE NA70R13.LETONA TO NA70R49.LETONA;
  MOVE NA70R13.STNAROC TO NA70R49.STNAROC;
  MOVE NA70R13.POZNARO TO NA70R49.POZNARO;
  MOVE NA70M04.ID_SKUSMB_OPISNO TO NA70R49.ID_SKUSMB_OPISNO; /* formila MB
  NA70F95();                     /* sqlexec

  IF EZESQCOD = 0;
    MOVE "Uspešen zapis Metal Bulletin formule!!!" TO NA70M04.EZEMSG;
  ELSE;
    INDIK = 1;
    MOVE "Napaka pri spremembi Metal Bulletin formule!" TO MSG64;
    NA70F97();                   /* koda na m4
  END;


/* **************************************************************/
/* COMMIT ali ROLLBACK
/* **************************************************************/
  IF INDIK = 0;                  /* uspešno dodajanje
    EZEREPLY = 1;
    EZECOMIT();                  /* potrditev
  ELSE;
    EZEREPLY = 1;
    EZEROLLB();                  /* preklic
  END;
END;

MOVE 9999 TO EZEMNO;
