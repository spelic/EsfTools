:before.
NA70F21();                       /* bere operativno


WHILE 1 = 1;

  NA70F26();                     /* prikaz mape

/* **************************************************************/
/* F3 - nazaj
/* **************************************************************/
  IF EZEAID IS PF3;
    SET NA70M02.STNAROC[STEVEC] CURSOR; /* tukaj je bilo
    EZERTN();
  END;

/* ******************************************************************
/* F7 - èitanje seznama nazaj
/* ******************************************************************
  IF EZEAID IS PF7;
    IF STEVTREN6 > 12;
      STEVTREN6 = STEVTREN6 - 12;
      NA70F31();                 /* prenos na ekran
    ELSE;                        /* prva stran (enter)
      NA70F21();                 /* pregled
    END;
  END;                           /* ;
/* ******************************************************************
/* F8 - èitanje seznama naprej
/* ******************************************************************
  IF EZEAID IS PF8;
    IF STEVTREN6 =< STEVWS6;
      NA70F31();                 /* prenos na ekran
    ELSE;
      MOVE "Konec liste!" TO NA70M09.EZEMSG;
    END;
  END;




END;
