           desc      = 'Prenos živih v WS2'
           refine    = N  
:before.
IF FLBRISI = 'DA';               /* pogoj za dajanje v WS

  IF NA70M01.PPAP_EMPB = 'D';    /* 1/2025
    IF NA70W05.PPAP_EMPB = 'D';
      CTRLINIJ = CTRLINIJ + 1;   /* Števec +1
      MOVE NA70R01.LETONA TO NA70W02.LETONA[CTRLINIJ];
      MOVE NA70R01.STNAROC TO NA70W02.STNAROC[CTRLINIJ];
      MOVE NA70R01.POZNARO TO NA70W02.POZNARO[CTRLINIJ];
      MOVE NA70R01.STATNAPO TO NA70W02.STATNAPO[CTRLINIJ];
      MOVE NA70R01.DIMENZ40 TO NA70W02.DIMENZ35[CTRLINIJ];
      MOVE NA70R01.PRIORITE TO NA70W02.PRIORNUM[CTRLINIJ];
      MOVE NA70R01.KRNAZ TO NA70W02.KRNAZ[CTRLINIJ];
      MOVE NA70R01.NARKOLPR TO NA70W02.NARKOLPR[CTRLINIJ];
      MOVE NA70R01.STATUS_PREGLED TO NA70W02.STATUS_PREGLED[CTRLINIJ]; /* 7/2017
      MOVE NA70R01.KLASIFI3 TO NA70W02.KLASIFI3[CTRLINIJ];
      MOVE NA70R01.POSZAHT1 TO NA70W02.POR-X; /* Rondal-Alumat
      MOVE NA70W05.CALLOFF_ID TO NA70W02.CALL_ID[CTRLINIJ]; /* èe je preko call off-a 8/2024
      MOVE NA70W05.TZ_ID TO NA70W02.TZ[CTRLINIJ]; /* green alu - TZ 11/2024
      MOVE NA70W05.PPAP_EMPB TO NA70W02.PPAP[CTRLINIJ]; /* PPAP_EMPB 1/2025
      IF NA70R01.PROGENOT = '021' OR NA70R01.PROGENOT = '031' OR NA70R01.PROGENOT = '034' OR
        NA70R01.PROGENOT = '041' OR NA70R01.PROGENOT = '051' OR NA70R01.PROGENOT = '061' OR NA70R01.PROGENOT = '071'
        OR NA70R01.PROGENOT = '072' OR NA70R01.PROGENOT = '073' OR NA70R01.PROGENOT = '074';
        NA70W02.POR[CTRLINIJ] = NA70R01.POREKLO; /* poreklo je zdaj KOLONA
      ELSE;
        NA70W02.POR[CTRLINIJ] = NA70W02.POR-X; /* Rondal+Alumat delajo po starem
        IF NA70W02.POR[CTRLINIJ] = 'D' OR
          NA70W02.POR[CTRLINIJ] = 'N'; /* to je za te možno
        ELSE;
          NA70W02.POR[CTRLINIJ] = ' '; /* ni ne D ne N
        END;
      END;
      MOVE NA70R01.KZORG TO NA70W02.KZORG[CTRLINIJ]; /* 9/2004 Matej
      MOVE NA70R01.VERKZ TO NA70W02.VERKZ[CTRLINIJ]; /* 9/2004 Matej
    END;                         /* ********** ni zahteve za ppap_empb **********************
  ELSE;
    CTRLINIJ = CTRLINIJ + 1;     /* Števec +1
    MOVE NA70R01.LETONA TO NA70W02.LETONA[CTRLINIJ];
    MOVE NA70R01.STNAROC TO NA70W02.STNAROC[CTRLINIJ];
    MOVE NA70R01.POZNARO TO NA70W02.POZNARO[CTRLINIJ];
    MOVE NA70R01.STATNAPO TO NA70W02.STATNAPO[CTRLINIJ];
    MOVE NA70R01.DIMENZ40 TO NA70W02.DIMENZ35[CTRLINIJ];
    MOVE NA70R01.PRIORITE TO NA70W02.PRIORNUM[CTRLINIJ];
    MOVE NA70R01.KRNAZ TO NA70W02.KRNAZ[CTRLINIJ];
    MOVE NA70R01.NARKOLPR TO NA70W02.NARKOLPR[CTRLINIJ];
    MOVE NA70R01.STATUS_PREGLED TO NA70W02.STATUS_PREGLED[CTRLINIJ]; /* 7/2017
    MOVE NA70R01.KLASIFI3 TO NA70W02.KLASIFI3[CTRLINIJ];
    MOVE NA70R01.POSZAHT1 TO NA70W02.POR-X; /* Rondal-Alumat
    MOVE NA70W05.CALLOFF_ID TO NA70W02.CALL_ID[CTRLINIJ]; /* èe je preko call off-a 8/2024
    MOVE NA70W05.TZ_ID TO NA70W02.TZ[CTRLINIJ]; /* green alu - TZ 11/2024
    MOVE NA70W05.PPAP_EMPB TO NA70W02.PPAP[CTRLINIJ]; /* PPAP_EMPB 1/2025
    IF NA70R01.PROGENOT = '021' OR NA70R01.PROGENOT = '031' OR NA70R01.PROGENOT = '034' OR
      NA70R01.PROGENOT = '041' OR NA70R01.PROGENOT = '051' OR NA70R01.PROGENOT = '061' OR NA70R01.PROGENOT = '071'
      OR NA70R01.PROGENOT = '072' OR NA70R01.PROGENOT = '073' OR NA70R01.PROGENOT = '074';
      NA70W02.POR[CTRLINIJ] = NA70R01.POREKLO; /* poreklo je zdaj KOLONA
    ELSE;
      NA70W02.POR[CTRLINIJ] = NA70W02.POR-X; /* Rondal+Alumat delajo po starem
      IF NA70W02.POR[CTRLINIJ] = 'D' OR
        NA70W02.POR[CTRLINIJ] = 'N'; /* to je za te možno
      ELSE;
        NA70W02.POR[CTRLINIJ] = ' '; /* ni ne D ne N
      END;
    END;
    MOVE NA70R01.KZORG TO NA70W02.KZORG[CTRLINIJ]; /* 9/2004 Matej
    MOVE NA70R01.VERKZ TO NA70W02.VERKZ[CTRLINIJ]; /* 9/2004 Matej
  END;
END;
:ebefore.
