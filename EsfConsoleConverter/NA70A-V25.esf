:func      name      = VGPRINT           
           date      = '02/14/2020' time = '09:54:47' option = EXECUTE  
           refine    = N  
:before.
/* ISKANJE ADRESE PRINTERJA
/* V GLAVNO ZANKO VKLJUÈI POGOJ EZEDESTP <> ' '
/* ---VKLJUÈI V GL.PROCES ZA CONVERSE-------
/* IF EZEDESTP EQ ' ';            /* NI ADRESE PRINTANJA
/* MOVE "Printanje NI mogoèe - ni adrese printerja" TO DL94M02.EZEMSG
/* ;                          /* MOVE 1500 TO TE99W11.TEMN10D0;/* 15
/* PERFORM DL94P05;             /* converse mape
/* DL94W01.STEVAPPL = DL94W01.STEVAPPL - 1; /* Števec na predhodno
/* MOVE DL94W01.APPL(STEVAPPL) TO EZEAPP; /* ime predhodne
/* ;
/* DXFR EZEAPP DL94W01;         /* meni aplikacija skladiŠÈa
/* END;
/*

/* ---------------------------------------------------


VGENP01();                       /* INQUIRY V T.PRIJAVA

IF EZESQCOD = 0;                 /* NAŠEL
  MOVE VGENR01.PRINTER TO EZEDESTP; /* PRINTER
ELSE;
  MOVE ' ' TO EZEDESTP;          /* PRINTER
END;
