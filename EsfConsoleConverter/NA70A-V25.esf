:func      name      = NA70F120          
           date      = '12/12/2024' time = '13:34:49' option = EXECUTE  
           desc      = 'Bere, èe je kaj na zalogi'
           refine    = N  
:before.
SET NA70R34 EMPTY;               /* tt_zaloga_paketi
SET NA70M03.NA_ZALOGI DEFINED;
SET NA70M04.NA_ZALOGI DEFINED;

IF NA70M03.IDENT > 0;
  MOVE NA70M03.IDENT TO NA70R34.IDENT;
  NA70W05.NA_ZALOGI = ' ';       /* inic
  NA70W05.KOL_ZAL = ' ';
  NA70W05.KOL_ZAL1 = ' ';
  STEVEC = 0;

  NA70F121();                    /* setinq tt_zaloga_skupaj
  NA70F122();                    /* scan tt_zaloga_skupaj
  IF EZESQCOD = 0;

    IF NA70W01.FIRMA = '13';       /* tlm
      MOVE "Na zalihi " TO NA70W05.PO1;
      MOVE "Na zalihi" TO NA70M03.NA_ZALOGI; /* mapa 3
    ELSE;
      MOVE "Na zalogi " TO NA70W05.PO1;
      MOVE "Na zalogi" TO NA70M03.NA_ZALOGI; /* mapa 3
    END;

    WHILE EZESQCOD = 0 AND STEVEC < 3;
      STEVEC = STEVEC + 1;

      IF STEVEC = 1;             /* prva firma
        MOVE "Pe:" TO NA70W05.PO2;
        MOVE NA70R34.PROGENOT TO NA70W05.PO4;
        MOVE ' -' TO NA70W05.PO4A;
        MOVE NA70R34.SUMNETOKG TO NA70W05.KOL_ZAL; /* podstr
        NA70F123();              /* poreže nule
        MOVE NA70W05.KOL_ZAL1 TO NA70W05.PO5;
        MOVE "Kg" TO NA70W05.PO6;
      END;

      IF STEVEC = 2;             /* druga firma
        MOVE "Fir.:" TO NA70W05.PO8;
        MOVE NA70R34.PROGENOT TO NA70W05.PO10;
        MOVE ' -' TO NA70W05.PO10A;
        MOVE NA70R34.SUMNETOKG TO NA70W05.KOL_ZAL; /* podstr
        NA70F123();              /* poreže nule
        MOVE NA70W05.KOL_ZAL1 TO NA70W05.PO11;
        MOVE "Kg" TO NA70W05.PO12;
      END;

      NA70F122();                /* scan tt_zaloga_skupaj
    END;

    MOVE NA70W05.NA_ZALOGI TO NA70M04.NA_ZALOGI; /* sestavljeno - zaèasno sem
    SET NA70M04.NA_ZALOGI AUTOSKIP,BLINK;
    SET NA70M03.NA_ZALOGI AUTOSKIP,BLINK;
  END;
END;
:ebefore.
:efunc.

