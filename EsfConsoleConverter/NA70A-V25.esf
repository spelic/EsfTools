           desc      = 'F11 - inteno navodilo'
           refine    = N  
:before.
INDIK = 0;


/* ************* pravilo Dovnik 12/2014 *******************************************
IF NA70M03.STATNAPO = '0' OR NA70M03.STATNAPO = '1' OR NA70M03.STATNAPO = '2'
  OR NA70M03.STATNAPO = '3' OR NA70M03.STATNAPO = '4' OR NA70M03.STATNAPO = '5'
  OR NA70M03.STATNAPO = '6' OR NA70M03.STATNAPO = 'C' OR NA70M03.STATNAPO = 'T';

ELSE;
  SET NA70M03.POSZAHT1 CURSOR;
  MOVE "Sprememba  je možna samo za statuse manjše od 7!!!" TO NA70M03.EZEMSG;
  EZERTN();
END;


/* ***************** živo naroèilo *********************

SET NA70R18 EMPTY;               /* naropozi
MOVE NA70R05.LETONA TO NA70R18.LETONA;
MOVE NA70R05.STNAROC TO NA70R18.STNAROC;
MOVE NA70R05.POZNARO TO NA70R18.POZNARO;
MOVE NA70M03.POSZAHT1 TO NA70R18.POSZAHT1; /* iz mape
MOVE NA70M03.POSZAHT2 TO NA70R18.POSZAHT2; /* iz mape

MOVE NA70W01.ZAPRIIM TO NA70R18.REFKOM; /* ne vem kam naj zapišem????

NA70F105();                      /* sqlexec

IF EZESQCOD = 0;
  MOVE "Uspešna sprememba internega navodila!" TO NA70M03.EZEMSG;
ELSE;
  INDIK = 1;
  MOVE "Napaka pri spremembi naroèila!" TO MSG64;
  NA70F98();                     /* koda na m3
END;

SET NA70M03.POSZAHT1 CURSOR;


/* * **************************************************************/
/* commit ali rollback
/* **************************************************************/
IF INDIK = 0;                    /* uspešno dodajanje
  EZEREPLY = 1;
  EZECOMIT();                    /* potrditev
ELSE;
  EZEREPLY = 1;
  EZEROLLB();                    /* preklic
END;
:ebefore.
:efunc.

