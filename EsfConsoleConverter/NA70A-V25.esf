:func      name      = NA70P-STATUSI     
           date      = '03/16/2021' time = '06:53:23' option = EXECUTE  
           desc      = 'prikaz šifer statusov naroèil'
           refine    = N  
:before.
NA70P-STATUSI-C();               /* èita listo

IF EZESQCOD NE 0;
  EZERTN();
END;

NA70P-STATUSI-S();               /* èita listo po ena
STEVEC = 1;

WHILE STEVEC < 30 AND
  EZESQCOD = 0;

  NA70M08.STATNARO[STEVEC] = NA70R40.STATNARO; /* slog na mapo
  NA70M08.NAZIVSN[STEVEC] = NA70R40.NAZIVSN; /* slog na mapo

  NA70P-STATUSI-S();             /* èita listo po ena

  STEVEC = STEVEC + 1;
END;


NA70P-STATUSI-M();               /* mapa

/* ------tst èe je v koloni STATNARO-----
STEVEC = 1;

WHILE STEVEC <= 30;

  IF NA70M08.STATNARO[STEVEC] IS CURSOR; /* je tu
    NA70M01.STATNARO = NA70M08.STATNARO[STEVEC]; /* prenos na mapo 1
    EZERTN();
  END;

  STEVEC = STEVEC + 1;
END;
:ebefore.
:efunc.

