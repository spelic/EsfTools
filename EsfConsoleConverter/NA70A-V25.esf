           desc      = 'F4 - detalj 2'
           refine    = N  
:before.
IF FLZAPIS1 EQ 'T.NAROPOZI';     /* je v NAROPOZI
  MOVE DA10CDAT TO NA70M04.DATUMSPR; /* datum spremembe
  MOVE NA70R05.DATSTAT0 TO NA70W02.DAT10;
  MOVE NA70R05.DATSTAT0 TO NA70M04.DATSTAT0;
  MOVE NA70R05.DATSTAT2 TO NA70W02.DAT10;
  MOVE NA70R05.DATSTAT2 TO NA70M04.DATSTAT2;
  MOVE NA70R05.DATSTAT3 TO NA70W02.DAT10;
  MOVE NA70R05.DATSTAT3 TO NA70M04.DATSTAT3;
  MOVE NA70R05.DATSTAT4 TO NA70W02.DAT10;
  MOVE NA70R05.DATSTAT4 TO NA70M04.DATSTAT4;
  MOVE NA70R05.DATSTAT5 TO NA70W02.DAT10;
  MOVE NA70R05.DATSTAT5 TO NA70M04.DATSTAT5;
  MOVE NA70R05.DATSTAT6 TO NA70W02.DAT10;
  MOVE NA70R05.DATSTAT6 TO NA70M04.DATSTAT6;
  MOVE NA70R05.DATSTAT9 TO NA70W02.DAT10;
  MOVE NA70R05.DATSTAT9 TO NA70M04.DATSTAT9;
ELSE;
  MOVE NA70R11.DATSTAT0 TO NA70W02.DAT10;
  MOVE NA70R11.DATSTAT2 TO NA70W02.DAT10;
  MOVE NA70R11.DATSTAT2 TO NA70M04.DATSTAT2;
  MOVE NA70R11.DATSTAT3 TO NA70W02.DAT10;
  MOVE NA70R11.DATSTAT3 TO NA70M04.DATSTAT3;
  MOVE NA70R11.DATSTAT4 TO NA70W02.DAT10;
  MOVE NA70R11.DATSTAT4 TO NA70M04.DATSTAT4;
  MOVE NA70R11.DATSTAT5 TO NA70W02.DAT10;
  MOVE NA70R11.DATSTAT5 TO NA70M04.DATSTAT5;
  MOVE NA70R11.DATSTAT6 TO NA70W02.DAT10;
  MOVE NA70R11.DATSTAT6 TO NA70M04.DATSTAT6;
  MOVE NA70R11.DATSTAT9 TO NA70W02.DAT10;
  MOVE NA70R11.DATSTAT9 TO NA70M04.DATSTAT9;
END;
;

MOVE NA70M03.FIRMA TO NA70R06.FIRMA; /* v slog
MOVE NA70M04.IDENTSUR TO NA70R06.IDENT; /* v slog
NA70P16();                       /* INQUIRY v t.IZDELKI
IF NA70R06 IS ERR;               /* napaka
  MOVE 'NAPAKA PRI ÈITANJU T.IZDELKI-IDENTSUR' TO MSG64;
  ER99P01();                     /* koda napake
ELSE;                            /* naŠel
  MOVE NA70R06.DIMENZ40 TO NA70M04.DIMEN401; /* dimenzija surovine
  MOVE NA70R06.NAZIZDEL TO NA70M04.NAZIZDE1; /* naziv surovine
  MOVE NA70R06.KOMADKG TO NA70M04.KOMADKG; /* teŽa komada
END;
MOVE MSG78 TO NA70M04.EZEMSG;
MOVE ' ' TO MSG78;

NA70F90();                       /* podatki o DN 9/2014

NA70F101();                      /* bere novi rok 1/2015


WHILE 2 = 2;


  NA70P20();                     /* CONVERSE mape NA70M04

/* **************************************************************/
/* F5 - zapis MB 12/2014
/* **************************************************************/
  IF EZEAID IS PF5;
    NA70F94();
  END;


/* **************************************************************/
/* F10 - prehod v novi rok D283A - 1/2015
/* **************************************************************/
  IF EZEAID IS PF10;

    IF NA70M03.LETONA > 0 AND NA70M03.STNAROC > 0 AND NA70M03.POZNARO > 0;
      MOVE NA70M03.LETONA TO CALL_NOVI_ROK.LETONA;
      MOVE NA70M03.STNAROC TO CALL_NOVI_ROK.STNAROC;
      MOVE NA70M03.POZNARO TO CALL_NOVI_ROK.POZNARO;
      MOVE NA70W01.ZAPRIIM TO CALL_NOVI_ROK.OSEBA;
      CALL_NOVI_ROK.NOVI_ROK = 0; /* inic

      CALL D283A CALL_NOVI_ROK (REPLY; /* ; /* klièe program za doloèanje novegaroka

      IF CALL_NOVI_ROK.NOVI_ROK > 0; /* èe je dodal
        MOVE CALL_NOVI_ROK.NOVI_ROK TO NA70M04.NOVI_ROK;
        IF NA70M04.NOVI_ROK > NA70M04.KONCNATE;
          SET NA70M04.NOVI_ROK RED,PROTECT;
        ELSE;
          SET NA70M04.NOVI_ROK DEFINED;
        END;
      END;
    ELSE;
      MOVE "Za pregled obvezni: leto, št. in pozicija naroèila!" TO NA70M04.EZEMSG;
    END;
  END;




/* **************************************************************/
/* f3 nazaj
/* **************************************************************/
  IF EZEAID IS PF3 OR EZEAID IS ENTER;
    EZERTN();
  END;

END;
:ebefore.
:efunc.

