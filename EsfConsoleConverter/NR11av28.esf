/* **************************************************************/



IF NR11W02.KOLIC11 > 0 AND NR11W03.INTNAROC > 0;

  STEVEC20 = STEVEC20 + 1;
  NR11R66.KOLICINA = NR11W02.KOLIC11; /* ENAKO KOLIÈINI IZ MAPE
  NR11W02.KOLIC11 = NR11W02.KOLIC11 - NR11R66.KOLICINA; /* KOLIÈINA ŠE ZA KNJIŽITI

