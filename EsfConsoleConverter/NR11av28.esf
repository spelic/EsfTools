:func      name      = NR11P002          
           date      = '11/07/2017' time = '08:21:02' option = EXECUTE  
           desc      = 'ZA NAJAVO'
           refine    = N  
:before.
MOVE 'DA' TO FLOK1;
/* **************************************************************/
/* za komitenta s07
/* **************************************************************/

IF NR11W01.SDOK ^= '192';
  IF NR11M01.KOMITENT NE NR11W02.KOMITENT;
    MOVE NR11M01.KOMITENT TO NR11R04.KOMITENT;
    MOVE NR11M01.KOMITENT TO NR11W02.KOMITENT;
    NR11P13();                   /* èita komitente
    IF NR11R04 IS ERR;
      MOVE "Dobavitelj ne obstaj" TO NR11M01.EZEMSG;
      SET NR11M01.KOMITENT CURSOR,MODIFIED,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
      MOVE '   ' TO NR11W02.KOMITENT;
    ELSE;
      MOVE NR11R04.KRNAZ TO NR11M01.KRNAZ;
      ; /* SET nr11M01.KOMITENT PROTECT,BRIGHT;
    END;
  END;
ELSE;
END;

/* **************************************************************/
/* za proizvajalca s50
/* **************************************************************/


MOVE NR11M01.PROIZVAJALEC TO NR11R04.KOMITENT;

NR11P13();                       /* èita komitente
IF NR11R04 IS ERR;
  MOVE "Proizvajalec ne obstaja ne obstaj" TO NR11M01.EZEMSG;
  SET NR11M01.PROIZVAJALEC CURSOR,MODIFIED,BRIGHT;
  MOVE 'NE' TO FLOK1;            /* glava ni v redu

ELSE;


  MOVE NR11R04.KRNAZ TO NR11M01.KRNAZP;
  SET NR11M01.PROIZVAJALEC PROTECT;

END;

/* **************************************************************/
/* za konto s09
/* **************************************************************/

IF NR11M01.KONTO NE NR11W02.KONTO;
  MOVE NR11M01.KONTO TO NR11R05.SIFKTO;
  MOVE NR11M01.KONTO TO NR11W02.KONTO;
  NR11P14();                     /* èita konte
  IF NR11R05 IS ERR;
    MOVE "Konto ne obstaja" TO NR11M01.EZEMSG;
    SET NR11M01.KONTO CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
    MOVE '  ' TO NR11W02.KONTO;
  ELSE;                          /* konto O.K.
/* SET nr11M01.VP CURSOR,MODIFIED;
  END;
ELSE;
END;

/* **************************************************************/
/* za prejemnika strm sifpreje  s10
/* **************************************************************/





MOVE NR11M01.FIRMA TO NR11R17.FIRMA;
MOVE NR11M01.SIFPREJE TO NR11R17.SIFMZ;


NR11P80();
IF NR11R17 IS ERR;
  MOVE ' TA ŠIFRA PREJEMNIKA NE OBSTAJA' TO NR11M01.EZEMSG;


  SET NR11M01.SIFPREJE CURSOR,MODIFIED,BRIGHT;
  MOVE '                                   ' TO NR11M01.NAZIVP;

  MOVE 9999 TO EZEMNO;
ELSE;

  MOVE NR11R17.NAZIVMZ TO NR11M01.NAZIVP;

  IF NR11M01.SIFPREJE = '01001'; /* LIVNICA
    MOVE '011' TO NR11M01.ORGEN;
 MOVE 'D' TO NR11M01.ZAPIS1;
  END;
  IF NR11M01.SIFPREJE = '01801'; /* KASTER
    MOVE '018' TO NR11M01.ORGEN;
 MOVE 'D' TO NR11M01.ZAPIS1;
  END;
  IF NR11M01.SIFPREJE = '02201'; /* VALJARNA
    MOVE '021' TO NR11M01.ORGEN;
 MOVE 'N' TO NR11M01.ZAPIS1;
  END;
  IF NR11M01.SIFPREJE = '02501'; /* FOLISKA
    MOVE '031' TO NR11M01.ORGEN;
MOVE 'N' TO NR11M01.ZAPIS1;
  END;
  IF NR11M01.SIFPREJE = '03301'; /* PROFILI
    MOVE '041' TO NR11M01.ORGEN;
 MOVE 'N' TO NR11M01.ZAPIS1;
  END;
  IF NR11M01.SIFPREJE = '03201'; /* cevarna sprejema pa za livnico da na predelavo
    MOVE '051' TO NR11M01.ORGEN;
 MOVE 'N' TO NR11M01.ZAPIS1;
  END;
  IF NR11M01.SIFPREJE = '03401'; /* PROFILI
    MOVE '034' TO NR11M01.ORGEN;
 MOVE 'N' TO NR11M01.ZAPIS1;
  END;
/*  IF nr11M01.FIRMAVEZA = '11';
/*    MOVE 'D' TO nr11M01.ZAPIS1;
/*  ELSE;
/*    MOVE 'N' TO nr11M01.ZAPIS1;
/*  END;
END;
/* **************************************************************/
/* vp s08
/* **************************************************************/

IF NR11M01.VP NE NR11W02.VP;
  MOVE NR11M01.VP TO NR11R06.SIFRAVP;
  MOVE NR11M01.VP TO NR11W02.VP;
  NR11P18();                     /* èita VP
  IF NR11R06 IS ERR;
    MOVE "VP ne obstaja" TO NR11M01.EZEMSG;
    SET NR11M01.VP CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
    MOVE '  ' TO NR11W02.VP;
  ELSE;
    IF NR11W01.SDOK = '120';
      IF NR11M01.VP = '07'
        OR NR11M01.VP = '08'
        OR NR11M01.VP = '84';
        ; /* SET nr11M01.VP PROTECT,BRIGHT;
      ELSE;
        MOVE "Napaèen VP : 07, 08 ali 84" TO NR11M01.EZEMSG;
        SET NR11M01.VP CURSOR,MODIFIED,BRIGHT;
        MOVE '  ' TO NR11W02.VP;
        MOVE 'NE' TO FLOK1;      /* glava ni v redu
      END;
    END;
    IF NR11W01.SDOK = '134';
      IF NR11M01.VP = '42';
        ; /* SET nr11M01.VP PROTECT,BRIGHT;
      ELSE;
        MOVE 'NE' TO FLOK1;      /* glava ni v redu
        MOVE "Napaèen VP : 42" TO NR11M01.EZEMSG;
        SET NR11M01.VP CURSOR,MODIFIED,BRIGHT;
        MOVE '  ' TO NR11W02.VP;
      END;
    ELSE;
      IF NR11W01.SDOK = '192';
        IF NR11M01.VP = '24'
          OR NR11M01.VP = '22';
          ; /* SET nr11M01.VP PROTECT,BRIGHT;
        ELSE;
          MOVE 'NE' TO FLOK1;    /* glava ni v redu
          MOVE "Napaèen VP :(24 ali 22)" TO NR11M01.EZEMSG;
          SET NR11M01.VP CURSOR,MODIFIED,BRIGHT;
          MOVE '  ' TO NR11W02.VP;
        END;
      END;
    END;
  END;
END;

/* **************************************************************/
/* kontrola namen s  14
/* **************************************************************/


IF NR11M01.NAMEN NE NR11W02.NAMEN;
  MOVE NR11M01.NAMEN TO NR11W02.NAMEN;
  IF NR11W01.SDOK = '120';
    IF NR11M01.NAMEN = '1'
      OR NR11M01.NAMEN = '2'

      OR NR11M01.NAMEN = '4'
      OR NR11M01.NAMEN = '5'
      OR NR11M01.NAMEN = '8'
      OR NR11M01.NAMEN = '9'
      OR NR11M01.NAMEN = '7';
      MOVE 'DA' TO FLOK1;        /* glava je vredu
/* **************************************************************/
/* DODAM ,KO JE PREJEM IZ SEVALA
/* **************************************************************/

/*      IF nr11M01.NAMEN = '8';
/*        SET nr11M01.STFAKTUR CURSOR,MODIFIED,BRIGHT;
/*        SET nr11M01.LETOF BRIGHT;
/*      ELSE;
/*        SET nr11M01.STDOBAV CURSOR,MODIFIED,BRIGHT;
/*      END;


    ELSE;
      MOVE "Namen je 1, 2 , 3 , 7,8,9" TO NR11M01.EZEMSG;
      SET NR11M01.NAMEN CURSOR,MODIFIED,BRIGHT;
      MOVE ' ' TO NR11W02.NAMEN;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    END;
  END;
END;
IF FLOK1 = 'DA';
  SET NR11M01.STPOZ CURSOR,MODIFIED,BRIGHT;
ELSE;
END;
:ebefore.
:efunc.

