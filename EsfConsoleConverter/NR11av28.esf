      MOVE 'N' TO NR11M01.ZAPIS1;
    END;

    IF NR11M01.SIFPREJE = '07101'; /* tlm livnica
      MOVE '071' TO NR11M01.ORGEN;
      MOVE 'N' TO NR11M01.ZAPIS1;
    END;
    IF NR11M01.SIFPREJE = '07201'; /* tlm
      MOVE '072' TO NR11M01.ORGEN;
      MOVE 'N' TO NR11M01.ZAPIS1;
    END;
    IF NR11M01.SIFPREJE = '07301'; /* tlm
      MOVE '073' TO NR11M01.ORGEN;
      MOVE 'N' TO NR11M01.ZAPIS1;
    END;

    IF NR11M01.SIFPREJE = '07401'; /* LIVNICA
