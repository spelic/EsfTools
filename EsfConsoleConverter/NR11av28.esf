                        IF NR11R07 IS ERR;
                          MOVE "Skladišèe ni replase -ponovi "
                            NR11M01.EZEMSG;
                        ELSE;
                          MOVE 'DA' TO FLOK3;
                        END;
                      END;
                    END;
                    IF FLOK3 = 'DA'; /* skladišèe je ažurirano
                      NR11S04(); /* gen.št.dokumenta
                    END;

                    IF FLOK3 = 'DA'; /* èe je generirana številka vredu
                      NR11P02(); /* polni za odložišèe
                    END;

                    IF FLOK3 = 'DA'; /* parameter je ažuriran
                      NR11P10(); /* polnjenje  prevzema
                      NR11P28(); /* ADD  prevzem
                      IF NR11R08 IS ERR;
                        EZEREPLY = 0;
                        EZEROLLB(); /* vraèa staro stanje
                        MOVE "Pozicija ni prevzeta -ponovi " NR11M01.EZEMSG;
                      ELSE;
                        NR11P39(); /* polnjenje  za naroèilo
                        NR11P40(); /* ADD  v mnpromet
                        IF NR11R13 IS ERR;
                          EZEREPLY = 0;
                          EZEROLLB(); /* vraèa staro stanje
                          MOVE "Pozicija ni prevzeta v mnpromet -ponovi "
                            NR11M01.EZEMSG;
                          MOVE EZESQCOD TO NR11M01.KODA;
                        ELSE;


                          NR11P43(); /* zaklene POZICIJO NAROÈILA
                          IF NR11R15 IS ERR;
                            MOVE "NAPAKA PRI UPDATE NAROÈILA " TO
                              NR11M01.EZEMSG;
                            MOVE EZESQCOD TO NR11M01.KODA;

                            EZEREPLY = 0;
                            EZEROLLB(); /* vraèa staro stanje
                          ELSE;

                            NR11P44(); /* PRIPRAVA ZA REPLACE
                                 /* MNPOZNARO
                            NR11P45(); /* REPLACE MNPOZNARO
                            IF NR11R15 IS ERR;
                              EZEREPLY = 0;
                              EZEROLLB(); /* vraèa staro stanje
                            ELSE;


                            END;
                          END;


/* **************************************************************/
/* dodaLA ZA INTERNO NAROÈILO
/* **************************************************************/
/* MOVE 'DA' TO FLOK5; dala na zaèetek,da upoštevam tudi pri eksternem naroèilu



                          NR11P70(); /* ZA AŽURIRANJE INTERNEGA NAROÈILA
                          IF FLOK5 = 'DA';
                            NR11P60(); /* ZA AŽURIRANJE IDENTA






                            IF FLOK5 = 'DA';


                              EZEREPLY = 0;
                              MOVE EZESQCOD TO NR11M01.KODA;
                              EZECOMIT(); /* sprosti resurse
                              NR11S03(); /* prazni pozicijo
                              CTRP = CTRP + 1;
                              NR11S12(); /* èe je pozicij >46
                            ELSE;

                              EZEREPLY = 0;
                              EZEROLLB(); /* vraèa staro stanje
                              MOVE EZESQCOD TO NR11M01.KODA;
                            END; /* R01 ERR2


                          ELSE;

                            MOVE "Pozicija ni prevzeta za namene internega naroèila -ponovi " NR11M01.EZEMSG;

                          END;   /* da gre ažurirati ident
/* END;



                        END;
                      END;
                    ELSE;        /* skladišèe ni ažurirano
                      EZEREPLY = 0;
                      EZEROLLB(); /* vraèa staro stanje
                      MOVE EZESQCOD TO NR11M01.KODA;
                    END;
                  ELSE;          /* kontrola pozicije ni OK
                  END;
                  MOVE CTRP TO NR11M01.POZDOK;
                  MOVE EZESQCOD TO NR11M01.KODA;
                END;             /* za F2
              END;
            END;                 /* za while
          ELSE;                  /* glava ni O.K.
          END;
        END;                     /* flok1
      ELSE;
        MOVE "Tipka ni na voljo " TO NR11M01.EZEMSG;
      END;                       /* za enter
    END;                         /* za pf5
  END;                           /* za pf6
END;                             /* za while
:ebefore.
:efunc.

:func      name      = NR11P001          
           date      = '11/07/2017' time = '08:21:02' option = INQUIRY  
           object    = NR11R001          
           errrtn    = EZERTN            
           desc      = 'ÈITA  NAJAVO + NAROÈILO'
           refine    = N  
           execbld   = N  
           singrow   = N  
:sql       clause    = SELECT      hostvar = '?'.
T1.ID_NABPNAJAVA_GL, T1.DATUM_VNOS,T1. STDOBAV,T1. LETOF,T1. STFAKTUR,T1. VD,T1. LETONA, T1.STNAROC,T1. SIFPREJE,T1. FIRMAVEZA,T1. FIRMA3,T1. KONTO,T1. VP,T1. NAMEN,T1. STANJE_ZADNJE_SPREMEMBE, T1.DATURA_ZADNJE_SPREMEMBE, T1.OSEBA_ZADNJE_SPREMEMBE, T2.KOMITENT, T2.PROIZVAJALEC, T2.LETO
:esql.
