:func      name      = NR11S07           
           date      = '11/07/2017' time = '08:21:03' option = EXECUTE  
           desc      = 'rutina na komitenta'
           refine    = N  
:before.
;  /* edit rutina na komitenta
; /* **************************
IF NR11W01.SDOK ^= '192';
  IF NR11M01.KOMITENT NE NR11W02.KOMITENT;
    MOVE NR11M01.KOMITENT TO NR11R04.KOMITENT;
    MOVE NR11M01.KOMITENT TO NR11W02.KOMITENT;
    NR11P13();                    /* èita komitente
    IF NR11R04 IS ERR;
      MOVE "Dobavitelj ne obstaj" TO NR11M01.EZEMSG;
      SET NR11M01.KOMITENT CURSOR,MODIFIED,BRIGHT;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
