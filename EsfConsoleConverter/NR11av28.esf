:func      name      = NR11S05           
           date      = '02/04/2021' time = '13:06:22' option = EXECUTE  
           desc      = 'kontrola pozicije'
           refine    = N  
:before.
; /* kontrola  pozicije
; /* **********************
MOVE 'DA' TO FLOK3;
IF NR11W01.SDOK ^= '192';
  IF NR11M01.POZNARO = 0;
    MOVE "Vpiši pozicijo " TO NR11M01.EZEMSG;
    SET NR11M01.POZNARO CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK3;          /* pozicija ni vredu
  ELSE;
  END;
END;
IF NR11M01.KZORG = ' ';

ELSE;

  MOVE NR11M01.KZORG TO NR11R16.KZORG;

  NR11P99();                     /* èita kzorg
  IF NR11R16 IS ERR;
    MOVE "Kz ne obstaja vpiši pravilnega" TO NR11M01.EZEMSG;
    SET NR11M01.KZORG CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK3;          /* glava ni v redu

  ELSE;



