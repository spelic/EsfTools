:func      name      = NR11S03           
           date      = '01/30/2018' time = '13:55:12' option = EXECUTE  
           desc      = 'prazni pozicije mape'
           refine    = N  
:before.
SET NR11W06 EMPTY;
SET NR11W07 EMPTY;
MOVE 0 TO NR11M01.IDENT;
MOVE 0 TO NR11M01.KOLICM;
MOVE 0 TO NR11M01.CENAM;
MOVE 0 TO NR11M01.LME;
MOVE 0 TO NR11M01.POS;
MOVE 0 TO NR11M01.STATCENE;
MOVE '    ' TO NR11M01.ORGENP;
MOVE 0 TO NR11M01.PREMIJA;
SET NR11R12 EMPTY;
SET NR11W06 EMPTY;
MOVE 1 TO NR11W06.ST5;
WHILE NR11W06.ST5 <= 20;
  MOVE 0 TO NR11M01.KOMADKG[NR11W06.ST5];
  MOVE 0 TO NR11M01.POZKG[NR11W06.ST5];
  MOVE 0 TO NR11M01.TRAN_ENOTA[NR11W06.ST5];
  MOVE 0 TO NR11M01.POZKOM[NR11W06.ST5];
  MOVE 0 TO NR11M01.TRE_EXT[NR11W06.ST5];
 SET NR11M01.KOMADKG[NR11W06.ST5] PROTECT;
 SET NR11M01.POZKG[NR11W06.ST5] PROTECT;
 SET NR11M01.TRAN_ENOTA[NR11W06.ST5] PROTECT;
 SET NR11M01.POZKOM[NR11W06.ST5] PROTECT;
 SET NR11M01.TRE_EXT[NR11W06.ST5] PROTECT;

  NR11W06.ST5 = NR11W06.ST5 + 1;

END;

MOVE 1 TO NR11M01.KOMADI;
MOVE 0 TO NR11M01.POZNARO;
MOVE 0 TO NR11M01.EM;
NR11M01.ZAPSTEV = 0;

MOVE '    ' TO NR11M01.KRNAZEM;
MOVE '                                   ' TO NR11M01.NAZIV;
MOVE '                  ' TO NR11M01.NAZIVDI;
SET NR11M01.POZNARO CURSOR,BRIGHT;
