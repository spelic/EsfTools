MOVE NR11M01.POZNARO TO NR11R70.POZNARO;
MOVE NR11M01.KOLICM TO NR11W02.KOLIC11;

MOVE 1 TO STEVEC20;
NR11P71();                       /* setinq r70   veè slogov
MOVE 'DA' TO FLOK9;


NR11P92();
WHILE FLOK9 = 'DA';
  SET NR11R66 EMPTY;
  IF EZESQCOD = 0 AND KOLIC11 > 0;
    MOVE NR11R70 TO NR11W03;


    NR11W02.KOLIC22 = NR11R70.KOLICINA - NR11R70.KOLICINA2; /* DOBILI PROSTO KOLIÈINA ZA  IZ EKST NAROÈILA
    IF NR11W02.KOLIC22 < NR11W02.KOLIC11
      OR NR11W02.KOLIC22 = NR11W02.KOLIC11; /* ÈE RAZLIKA NE PRESEGA PROSTI KOLIÈINI ALI JE ENAKA
      NR11R66.KOLICINA = NR11W02.KOLIC22; /* ZA DODAJO SLOGA INTPROMETD
      NR11W02.KOLIC11 = NR11W02.KOLIC11 - NR11W02.KOLIC22; /* KOLIÈINA ŠE ZA KNJIŽITI
    ELSE;
      NR11R66.KOLICINA = NR11W02.KOLIC11; /* ENAKO KOLIÈINI IZ MAPE
      NR11W02.KOLIC11 = NR11W02.KOLIC11 - NR11R66.KOLICINA; /* KOLIÈINA ŠE ZA KNJIŽITI
    END;
    NR11P93();                   /* priprava   za add INTPROMETD    priprava r66   doda inprometd   doda dobave
    NR11P94();                   /* add   sloga intnard  doda dobavo za interno naroèilo
    STEVEC20 = STEVEC20 + 1;
    IF NR11R66 NOT ERR;
/* **************************************************************/
/* SEŠTEVA  NA NAROÈILU KOLIÈINO INTPROMETN
/* **************************************************************/
      NR11R70.KOLICINA2 = NR11R70.KOLICINA2 + NR11R66.KOLICINA;
      IF NR11R70.KOLICINA2 = NR11R70.KOLICINA
        OR NR11R70.KOLICINA2 > NR11R70.KOLICINA;
        MOVE '3' TO NR11R70.STATUS3;
