:func      name      = NR11S14           
           date      = '11/07/2017' time = '08:21:03' option = EXECUTE  
           desc      = 'RUTINA NA NAMEN'
           refine    = N  
:before.
;  /* edit rutina na namen
; /* **********************
IF NR11M01.NAMEN NE NR11W02.NAMEN;
  MOVE NR11M01.NAMEN TO NR11W02.NAMEN;
  IF NR11W01.SDOK = '120';
    IF NR11M01.NAMEN = '1'
      OR NR11M01.NAMEN = '2'
  OR NR11M01.NAMEN = '3'

      OR NR11M01.NAMEN = '4'
OR NR11M01.NAMEN = '5'
 OR NR11M01.NAMEN = '8'
OR NR11M01.NAMEN = '9'
OR NR11M01.NAMEN = '7';
      MOVE 'DA' TO FLOK1;        /* glava je vredu
    ELSE;
      MOVE "Namen je 1, 2 , 3 , 7,8,9" TO NR11M01.EZEMSG;
      SET NR11M01.NAMEN CURSOR,MODIFIED,BRIGHT;
      MOVE ' ' TO NR11W02.NAMEN;
      MOVE 'NE' TO FLOK1;        /* glava ni v redu
    END;
  END;
END;
