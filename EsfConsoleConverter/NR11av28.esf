:func      name      = NR11S13           
           date      = '02/04/2021' time = '12:53:00' option = EXECUTE  
           desc      = 'RUTINA NA poz NAROÈILA'
           refine    = N  
:before.
IF EZEAID IS ENTER AND
  NR11M01.POZNARO IS MODIFIED;
  SET NR11R15 EMPTY;
  MOVE NR11M01.POZNARO TO NR11W02.STPOZNAR;
  MOVE NR11M01.LETO TO NR11W02.LETONARO;
  MOVE NR11M01.STNAROC TO NR11W02.STNAROC;
  MOVE NR11W02.STPOZNAR TO NR11R15.POZNARO;
  MOVE NR11W02.LETONARO TO NR11R15.LETO;
  MOVE NR11W02.STNAROC TO NR11R15.STNAROC;
  NR11P42();
  IF NR11R15 IS ERR;
    MOVE ' TO NAROÈILO NE OBSTAJA' TO NR11M01.EZEMSG;
    MOVE 00 TO NR11M01.POZNARO;
    SET NR11M01.POZNARO CURSOR,MODIFIED,BRIGHT;
    MOVE '                                   ' TO NR11M01.NAZIV;
    MOVE '                  ' TO NR11M01.NAZIVDI;
    MOVE 0 TO NR11M01.EM;
    MOVE '    ' TO NR11M01.KRNAZEM;
    MOVE '                                   ' TO NR11M01.NAZIVNAR;
    MOVE 0 TO NR11M01.IDENT;
    MOVE 0 TO NR11M01.KOLICM;
    MOVE 0 TO NR11M01.CENAM;
    MOVE 9999 TO EZEMNO;
  ELSE;
/* **************************************************************/
/* dodala 16.10.2014
/* **************************************************************/
    NR11W02.KOLICINA10P = 0;
    NR11W02.KOLICINA10 = 0;
    NR11W02.KOLICINA5T = 0;
    MOVE NR11M01.LETO TO NR11R0016.LETO;
    MOVE NR11M01.STNAROC TO NR11R0016.STNAROC;
    NR11P0027();                 /* èita dobavljeno na celi pogodbi  r0015
    NR11W02.KOLICINA10P = (NR11R0016.KOLICINA / 10); /* 10 proc od naroèene kolièine
    NR11W02.KOLICINA10 = ((NR11R0016.KOLICINA / 10) + NR11R0016.KOLICINA); /* kolièina z 10 proc
    NR11W02.KOLICINA5T = NR11R0016.KOLICINA + 5; /* kolièina plus 10 ton
    IF NR11W02.KOLICINA10P > 5;
      NR11W02.KOLKONTROLA = NR11W02.KOLICINA10;
    ELSE;
      NR11W02.KOLKONTROLA = NR11W02.KOLICINA5T;
    END;
/* **************************************************************/
/* konec
/* **************************************************************/
    IF (NR11R15.STATUS > 0) AND (NR11W02.KOLKONTROLA > NR11R0016.KOLPREVZ); /* AND nr11R15.STATUS < 8 - prej preverjala tudi status  od 15.10.2014 se preverja 5 t ali 10 procentov
/* IF nr11R15.STATUS > 0 AND nr11R15.STATUS < 8;
      MOVE NR11R15.IDENT TO NR11M01.IDENT;
      MOVE NR11R15.KOLPREVZ TO NR11M01.KOLPREVZ;
      MOVE NR11R15.DRZPOR TO NR11M01.DRZPOREKLA;
      MOVE NR11R15.IDENT TO NR11M01.IDENT;
      MOVE NR11R15.PROGENOT TO NR11M01.ORGENP;
      IF NR11M01.ORGENP = '040';
        NR11M01.ORGENP = '111';
      ELSE;
      END;
      IF NR11M01.POZDOK = 1;
        MOVE NR11R15.PROGENOT TO NR11M01.ORGEN;
/* **************************************************************/
/* dodala 26.8.2014
/* **************************************************************/

        IF NR11M01.ORGEN = '040'; /* alumat
          MOVE '04001' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '011'; /* LIVNICA
          MOVE '01001' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '018'; /* LIVNICA
          MOVE '01801' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '021'; /* LIVNICA
          MOVE '02201' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '031'; /* LIVNICA
          MOVE '02501' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '041'; /* LIVNICA
          MOVE '03301' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '051'; /* LIVNICA
          MOVE '03201' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '034'; /* LIVNICA
          MOVE '03401' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '071'; /* LIVNICA
          MOVE '07101' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '072'; /* LIVNICA
          MOVE '07201' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '073'; /* LIVNICA
          MOVE '07301' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '074'; /* LIVNICA
          MOVE '07401' TO NR11M01.SIFPREJE;
        END;

        IF NR11M01.ORGEN = '027'; /* LIVNICA
          MOVE '02701' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '028'; /* LIVNICA
          MOVE '02801' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.ORGEN = '190'; /* rondal
          MOVE '19001' TO NR11M01.SIFPREJE;
        END;
        IF NR11M01.FIRMA = '11';
          MOVE 'D' TO NR11M01.ZAPIS1;
        ELSE;
          MOVE 'N' TO NR11M01.ZAPIS1;
        END;
        MOVE NR11M01.FIRMA TO NR11R17.FIRMA;
        MOVE NR11M01.SIFPREJE TO NR11R17.SIFMZ;

        NR11P80();
        IF NR11R17 IS ERR;
          MOVE ' TA ŠIFRA PREJEMNIKA NE OBSTAJA VPIŠI PRAVILNO ORG.ENOTO' TO NR11M01.EZEMSG;
/* MOVE ' ' TO nr11M01.FIRMA3;
          MOVE ' ' TO NR11M01.SIFPREJE;
          SET NR11M01.ORGEN CURSOR,MODIFIED,BRIGHT;
          MOVE '                                   ' TO NR11M01.NAZIVP;

          MOVE 9999 TO EZEMNO;
        ELSE;

          MOVE NR11R17.NAZIVMZ TO NR11M01.NAZIVP;


        END;
      ELSE;
      END;


/* **************************************************************/
/* konec
/* **************************************************************/



      SET NR11R005 EMPTY;
      MOVE NR11R15.DRZPOR TO NR11R005.SIFRA3;
      NR11P009();
      MOVE NR11R005.NAZIVDR TO NR11M01.NDRZPOREKLA;
      MOVE NR11R15.BLAGO TO NR11M01.POREKLO;
/* MOVE nr11R15.NAZIV1 TO nr11M01.NAZIVNAR;
/* MOVE nr11R15.NAZIV2 TO nr11M01.NAZIVNAR2;

      MOVE '                                   ' TO NR11M01.NAZIV;
      MOVE '                  ' TO NR11M01.NAZIVDI;
      MOVE 0 TO NR11M01.EM;

      MOVE '    ' TO NR11M01.KRNAZEM;
      MOVE NR11R15.IDNAMEN TO NR11W02.IDNAMEN;
      MOVE NR11R15.TARIFCA TO NR11W02.TARIFAC;
      IF NR11R15.EM = 23;

        KOLEM = NR11R15.KOLICINA * 1000;
        MOVE KOLEM TO NR11M01.KOLICM;
        MOVE NR11R15.STATCENE TO NR11M01.STATCENE;
        MOVE NR11R15.STATUS_PREMIJE TO NR11M01.STATUS_PREMIJE;
      ELSE;

        MOVE NR11R15.KOLICINA TO NR11M01.KOLICM;
        MOVE NR11R15.STATCENE TO NR11M01.STATCENE;
        MOVE NR11R15.STATUS_PREMIJE TO NR11M01.STATUS_PREMIJE;
      END;
/* IF nr11W02.SIFVAL32 = '111';
/* **************************************************************/
/* CENA JE SIT  IZLOÈILA 27.3.2014
/* **************************************************************/

/* IF nr11W02.SIFVAL32 = '978'; /*
