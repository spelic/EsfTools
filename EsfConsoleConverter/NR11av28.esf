        ELSE;
          MOVE ' NAPAKA PRI ZAKLEPANJU INTPROMETN ' TO NR11M01.EZEMSG;
/* MOVE 9999 TO EZEMNO;
/* MOVE EZESQCOD TO nr11M01.KODA;
        END;

      ELSE;
      END;




      NR11P92();                 /* SCAN ZA naslednjo eksterno naroèilo
    ELSE;
      MOVE 'NE' TO FLOK9;
      MOVE 'NE' TO FLOK5;
      MOVE ' NAPAKA PRI ADD PROMETA DOBAVE  ' TO NR11M01.EZEMSG;
      MOVE 9999 TO EZEMNO;
      MOVE EZESQCOD TO NR11M01.KODA;
      MOVE 'NE' TO FLOK3;
    END;
  ELSE;                          /* koda ni 0   za flok9i
    MOVE 'NE' TO FLOK9;
  END;                           /* koda ni 0
END;                             /* */ za while flok9=da





/* **************************************************************/
