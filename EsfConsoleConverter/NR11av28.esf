?ID_NABPNAJAVA_GL, ?DATUM_VNOS, ?STDOBAV, ?LETOF, ?STFAKTUR, ?VD, ?LETONA, ?STNAROC, ?SIFPREJE, ?FIRMAVEZA, ?FIRMA3, ?KONTO, ?VP, ?NAMEN, ?STANJE_ZADNJE_SPREMEMBE, ?DATURA_ZADNJE_SPREMEMBE, ?OSEBA_ZADNJE_SPREMEMBE, ?KOMITENT, ?PROIZVAJALEC, ?LETO
:esql.
