:func      name      = NR11S06           
           date      = '11/17/2025' time = '08:36:56' option = EXECUTE  
           desc      = 'rutina na komade .pr po komadi'
           refine    = N  
:before.
/* **************************************************************/
/* dodala za prevzem po komadih      23.11.2009 dogradila 8.11.2017
/* **************************************************************/
IF EZEAID IS ENTER AND NR11M01.KOMADI IS MODIFIED;
  SET NR11R12 EMPTY;
  SET NR11W06 EMPTY;
  MOVE 1 TO NR11W06.ST5;
  WHILE NR11W06.ST5 <= 20;
    MOVE 0 TO NR11M01.TRE_EXT[NR11W06.ST5];
    MOVE 0 TO NR11M01.KOMADKG[NR11W06.ST5];
    MOVE 0 TO NR11M01.POZKOM[NR11W06.ST5];
    MOVE 0 TO NR11M01.POZKG[NR11W06.ST5];
    SET NR11M01.KOMADKG[NR11W06.ST5] PROTECT;
    SET NR11M01.TRE_EXT[NR11W06.ST5] PROTECT;
    SET NR11M01.TRAN_ENOTA[NR11W06.ST5] PROTECT;
    SET NR11M01.POZKOM[NR11W06.ST5] PROTECT;
    NR11W06.ST5 = NR11W06.ST5 + 1;

  END;


  MOVE NR11M01.IDENT TO NR11R12.IDENT;
  MOVE '01' TO NR11R12.FIRMA;
  NR11P15();
  IF NR11R12 IS ERR;
    MOVE "Napaka pri branju identa za klasif. komada" TO NR11M01.EZEMSG;
    SET NR11M01.IDENT CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;
  ELSE;
    MOVE 'DA' TO FLOK1;
  END;


  IF (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '31') OR
    (NR11R12.KLASIFI1 = '64' AND NR11R12.KLASIFI2 = '31') OR
    (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '55') OR
(NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '53') OR
(NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '68') OR
    (NR11R12.KLASIFI1 = '64' AND NR11R12.KLASIFI2 = '55') OR
    (NR11R12.KLASIFI1 = '63' AND NR11R12.KLASIFI2 = '06') OR
  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '88') OR
  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '32') OR

  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '57') OR
  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '33') OR

    (NR11R12.KLASIFI1 = '61' AND NR11R12.KLASIFI2 = '06') OR
    (NR11R12.KLASIFI1 = '60' AND NR11R12.KLASIFI2 = '52') OR
  (NR11R12.KLASIFI1 = '60' AND NR11R12.KLASIFI2 = '03') OR
    (NR11R12.KLASIFI1 = '61' AND NR11R12.KLASIFI2 = '05') OR
    (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '06') OR
    (NR11R12.KLASIFI1 = '61' AND NR11R12.KLASIFI2 = '52') OR 
(NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '84') OR 
 (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '14') OR 
 (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '60') OR 
 (NR11R12.KLASIFI1 = '64' AND NR11R12.KLASIFI2 = '14') OR

 ( NR11M01.FIRMA = '19') OR 
 ( NR11M01.FIRMA = '04');


    MOVE NR11M01.KOMADI TO NR11W06.ST1; /* st1 = 6
    IF NR11W06.ST1 < 21;
      MOVE 1 TO NR11W06.ST2;
      WHILE NR11W06.ST2 <= NR11W06.ST1;
        MOVE NR11W06.ST2 TO NR11M01.POZKG[NR11W06.ST2];

        IF (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '31') OR
          (NR11R12.KLASIFI1 = '64' AND NR11R12.KLASIFI2 = '31') OR
          (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '55') OR
  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '53') OR
   (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '68') OR
   (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '60') OR
          (NR11R12.KLASIFI1 = '61' AND NR11R12.KLASIFI2 = '05') OR
  (NR11R12.KLASIFI1 = '60' AND NR11R12.KLASIFI2 = '03') OR
  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '32') OR
  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '88') OR
  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '14') OR
(NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '84') OR

  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '57') OR
  (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '33') OR
 (NR11R12.KLASIFI1 = '62' AND NR11R12.KLASIFI2 = '60') OR
(NR11R12.KLASIFI1 = '64' AND NR11R12.KLASIFI2 = '14') OR

          (NR11R12.KLASIFI1 = '64' AND NR11R12.KLASIFI2 = '55');

          MOVE 0 TO NR11M01.POZKOM[NR11W06.ST2];
          SET NR11M01.KOMADKG[NR11W06.ST2] BRIGHT;
          SET NR11M01.POZKOM[1] CURSOR,BRIGHT;
          SET NR11M01.TRAN_ENOTA[NR11W06.ST2] BRIGHT;
          SET NR11M01.TRAN_ENOTA[1] CURSOR,BRIGHT;


        ELSE;
          MOVE 1 TO NR11M01.POZKOM[NR11W06.ST2];
          SET NR11M01.KOMADKG[NR11W06.ST2] BRIGHT;
          SET NR11M01.TRAN_ENOTA[NR11W06.ST2] BRIGHT;
          SET NR11M01.TRAN_ENOTA[1] CURSOR,BRIGHT;
        END;
/***************************************************************/
/*DODALA 30.1.2018
/***************************************************************/

        IF NR11R12.KLASIFI2 = '06' ; prej komitent TENT = '47251000';
          SET NR11M01.TRE_EXT[NR11W06.ST2] BRIGHT;
        ELSE;
        END;
/***************************************************************/
/* KONEC 30.1.2018
/***************************************************************/

        NR11W06.ST2 = NR11W06.ST2 + 1;
      END;


      MOVE 0 TO NR11M01.KOLICM;
      SET NR11M01.KOLICM PROTECT;
    ELSE;

      MOVE "Za pozicijo prevzema je lahko najveè 20 komadov ,vezov..." TO NR11M01.EZEMSG;
      MOVE 'NE' TO FLOK1;
      SET NR11M01.KOMADI CURSOR,MODIFIED,BRIGHT;

    END;                         /* èe je preveè vpisanih komadov  Veè kot 20

  ELSE;


    SET NR11M01.KOLICM CURSOR,BRIGHT;
  END;
/* **************************************************************/
/* konec       23.11.2009

ELSE;
END;
