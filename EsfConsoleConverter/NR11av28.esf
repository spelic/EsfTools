:func      name      = NR11P44           
           date      = '07/17/2019' time = '12:48:28' option = EXECUTE  
           refine    = N  
:before.

IF NR11R15.EM = 23;
  KOLNA = NR11M01.KOLICM / 1000 (R;
  NR11R15.KOLPREVZ = NR11R15.KOLPREVZ + KOLNA;
  ; /* nr11R15.KOLPREVZ = nr11R15.KOLPREVZ + nr11M01.KOLICM; /*za pretvorbo
  ; /* KOLNA = nr11R15.KOLICINA * 1000 (R;
ELSE;
  NR11R15.KOLPREVZ = NR11R15.KOLPREVZ + NR11M01.KOLICM;
  ; /* KOLNA = nr11R15.KOLICINA;
END;

/* **************************************************************/
/* IZLOÈILA 27.11.2009
/* **************************************************************/


/* nr11W02.V1 = (nr11R15.KOLICINA / 100) * 10;
/* nr11W02.V2 = nr11W02.V1 + nr11R15.KOLICINA;
/*
/*
/* IF nr11R15.KOLPREVZ < nr11W02.V2 OR
/* nr11R15.KOLPREVZ = nr11W02.V2 ;

/* **************************************************************/
/* KONEC
/* **************************************************************/


IF NR11R15.KOLPREVZ > NR11R15.KOLICINA OR
  NR11R15.KOLPREVZ = NR11R15.KOLICINA;
  MOVE 8 TO NR11R15.STATUS;
ELSE;
  MOVE 2 TO NR11R15.STATUS;
END;

/* ELSE;
/* MOVE "Skupna kolièina dobave je veèja kot na eksternem naroèilu " TO  nr11M01.EZEMSG;
/* MOVE 'NE' TO FLOK5;
/*
/*
/*
/* END;


MOVE DAZZW01.DA10CDAT TO NR11R15.DATPREVZ;
MOVE DAZZW01.TI26CTIM TO NR11R15.DATURA;

/* **************************************************************/
/* dodala  2m7m2019
/* **************************************************************/

NR11W02.KOLICINA10P = 0;
NR11W02.KOLICINA10 = 0;
NR11W02.KOLICINA5T = 0;
SET NR11R0020 EMPTY;
MOVE NR11M01.LETO TO NR11R0016.LETO;
MOVE NR11M01.STNAROC TO NR11R0016.STNAROC;

NR11P0027();                     /* èita dobavljeno na celi pogodbi  R0016
NR11W02.KOLICINA10P = (NR11R0016.KOLICINA / 10); /* 10 proc od naroèene kolièine
NR11W02.KOLICINA10 = ((NR11R0016.KOLICINA / 10) + NR11R0016.KOLICINA); /* kolièina z 10 proc
NR11W02.KOLICINA5T = NR11R0016.KOLICINA + 5; /* kolièina plus 10 ton
IF NR11W02.KOLICINA10P > 5;
  NR11W02.KOLKONTROLA = NR11W02.KOLICINA10;
ELSE;
  NR11W02.KOLKONTROLA = NR11W02.KOLICINA5T;
END;
/* **************************************************************/
/* konec
/* **************************************************************/
SET NR11R0020 EMPTY;
IF (NR11R15.STATUS > 0) AND ((NR11W02.KOLKONTROLA < NR11R0016.KOLPREVZ) OR (NR11W02.KOLKONTROLA = NR11R0016.KOLPREVZ));
ELSE;
  MOVE NR11M01.LETO TO NR11R0020.LETO;
  MOVE NR11M01.STNAROC TO NR11R0020.STNAROC;
  MOVE 8 TO NR11R15.STATUS;

  NR11P0050();                   /* sqlexec

  IF EZESQCOD = 0;
  ELSE;
    MOVE 'NE' TO FLOK5;
    MOVE "Napaka pri zapiranju celotnega naroèila " NR11M01.EZEMSG;
    MOVE EZESQCOD TO NR11M01.KODA;
  END;
END;


:ebefore.
:efunc.

