:func      name      = NR11P0022         
           date      = '02/04/2021' time = '12:58:25' option = EXECUTE  
           refine    = N  
:before.
IF EZEAID IS ENTER AND
  NR11M01.ORGEN IS MODIFIED;

  IF NR11M01.POZDOK = 1;
/* **************************************************************/
/* dodala 26.8.2014
/* **************************************************************/

    IF NR11M01.ORGEN = '011';    /* LIVNICA
      MOVE '01001' TO NR11M01.SIFPREJE;
/* MOVE '11' TO nr11M01.FIRMA3;


    ELSE;
      IF NR11M01.ORGEN = '018';  /* LIVNICA
        MOVE '01801' TO NR11M01.SIFPREJE;
/* MOVE '11' TO nr11M01.FIRMA3;

      ELSE;
        IF NR11M01.ORGEN = '021'; /* LIVNICA
          MOVE '02201' TO NR11M01.SIFPREJE;
/* MOVE '02' TO nr11M01.FIRMA3;

        ELSE;
          IF NR11M01.ORGEN = '031'; /* LIVNICA
            MOVE '02501' TO NR11M01.SIFPREJE;
/* MOVE '02' TO nr11M01.FIRMA3;

          ELSE;
            IF NR11M01.ORGEN = '041'; /* LIVNICA
              MOVE '03301' TO NR11M01.SIFPREJE;
/* MOVE '03' TO nr11M01.FIRMA3;

            ELSE;
              IF NR11M01.ORGEN = '051'; /* LIVNICA
                MOVE '03201' TO NR11M01.SIFPREJE;
/* MOVE '03' TO nr11M01.FIRMA3;

              ELSE;
                IF NR11M01.ORGEN = '034'; /* LIVNICA
                  MOVE '03401' TO NR11M01.SIFPREJE;
/* MOVE '03' TO nr11M01.FIRMA3;

                ELSE;

                  IF NR11M01.ORGEN = '071'; /* LIVNICA
                    MOVE '07101' TO NR11M01.SIFPREJE;


                  ELSE;
                    IF NR11M01.ORGEN = '072'; /* LIVNICA
                      MOVE '07201' TO NR11M01.SIFPREJE;
                    ELSE;
                      IF NR11M01.ORGEN = '073'; /* LIVNICA
                        MOVE '07301' TO NR11M01.SIFPREJE;
                      ELSE;
                        IF NR11M01.ORGEN = '074'; /* LIVNICA
                          MOVE '07401' TO NR11M01.SIFPREJE;

                        ELSE;
                          IF NR11M01.ORGEN = '019'; /* LIVNICA
                            MOVE '19001' TO NR11M01.SIFPREJE;
                          ELSE;
                            IF NR11M01.ORGEN = '027'; /* LIVNICA
                              MOVE '02701' TO NR11M01.SIFPREJE;
                            ELSE;

                              MOVE ' ' TO NR11M01.SIFPREJE;
                            END;

                          END;
                        END;
                      END;
                    END;
                  END;
                END;
              END;
            END;
          END;
        END;
      END;
    END;

    IF NR11M01.ORGEN = '028';    /* LIVNICA
      MOVE '02801' TO NR11M01.SIFPREJE;

    ELSE;

    END;

    IF NR11M01.ORGEN = '040' OR NR11M01.ORGEN = '111'; /* alumat
      MOVE '04001' TO NR11M01.SIFPREJE;

    ELSE;

    END;
    IF NR11M01.ORGEN = '190';    /* stampalLIVNICA
      MOVE '19001' TO NR11M01.SIFPREJE;

    ELSE;

    END;
    IF NR11M01.FIRMA = '11';
      MOVE 'D' TO NR11M01.ZAPIS1;
    ELSE;
      MOVE 'N' TO NR11M01.ZAPIS1;
    END;


    MOVE NR11M01.FIRMA TO NR11R17.FIRMA;
    MOVE NR11M01.SIFPREJE TO NR11R17.SIFMZ;


    NR11P80();
    IF NR11R17 IS ERR;
      MOVE ' TA ŠIFRA PREJEMNIKA NE OBSTAJA VPIŠI PRAVILNO ORG.ENOTO' TO NR11M01.EZEMSG;

      MOVE ' ' TO NR11M01.SIFPREJE;
      SET NR11M01.ORGEN CURSOR,MODIFIED,BRIGHT;
      MOVE '                                   ' TO NR11M01.NAZIVP;

      MOVE 9999 TO EZEMNO;
    ELSE;

      MOVE NR11R17.NAZIVMZ TO NR11M01.NAZIVP;
      SET NR11M01.IDENT CURSOR,MODIFIED,BRIGHT;

    END;
  ELSE;                          /* drugaèe polni  nazaj iz prejemnika prve pozicije
    IF NR11M01.SIFPREJE = '01001'; /* LIVNICA
      MOVE '011' TO NR11M01.ORGEN;
/* MOVE '11' TO nr11M01.FIRMA3;
/* MOVE 'D' TO nr11M01.ZAPIS1;
    END;
    IF NR11M01.SIFPREJE = '04001'; /* Kalumat
      MOVE '111' TO NR11M01.ORGEN;
      MOVE '111' TO NR11M01.ORGENP;
/* MOVE '11' TO nr11M01.FIRMA3;
/* MOVE 'D' TO nr11M01.ZAPIS1;
    END;
    IF NR11M01.SIFPREJE = '01801'; /* KASTER
      MOVE '018' TO NR11M01.ORGEN;
/* MOVE '11' TO nr11M01.FIRMA3;
/* MOVE 'D' TO nr11M01.ZAPIS1;
    END;
    IF NR11M01.SIFPREJE = '02201'; /* VALJARNA
      MOVE '021' TO NR11M01.ORGEN;
/* MOVE '02' TO nr11M01.FIRMA3;
/* MOVE 'N' TO nr11M01.ZAPIS1;
    END;
    IF NR11M01.SIFPREJE = '02501'; /* FOLISKA
      MOVE '031' TO NR11M01.ORGEN;
/* MOVE '02' TO nr11M01.FIRMA3;
/* MOVE 'N' TO nr11M01.ZAPIS1;
    END;
    IF NR11M01.SIFPREJE = '03301'; /* PROFILI
      MOVE '041' TO NR11M01.ORGEN;
/* MOVE '03' TO nr11M01.FIRMA3;
/* MOVE 'N' TO nr11M01.ZAPIS1;
    END;
    IF NR11M01.SIFPREJE = '03201'; /* cevarna sprejema pa za livnico da na predelavo
      MOVE '051' TO NR11M01.ORGEN;
/* MOVE '03' TO nr11M01.FIRMA3;
/* MOVE 'D' TO nr11M01.ZAPIS1;
    END;
    IF NR11M01.SIFPREJE = '03401'; /* PROFILI
      MOVE '034' TO NR11M01.ORGEN;
/* MOVE '03' TO nr11M01.FIRMA3;
/* MOVE 'N' TO nr11M01.ZAPIS1;
    END;
    SET NR11M01.IDENT CURSOR,MODIFIED,BRIGHT;

  END;
ELSE;


END;
