/* IF nr11R15.EM1 = 23;
/* CENASLT = nr11R15.CENAN / 239,640 (R; /* * nr11W02.TECAJ; DOBIMO EVRE IZ TOLARJEVI
/* CENAEM = CENASLT / 1000;
/* MOVE CENAEM TO nr11M01.CENAM;
/* ELSE;
