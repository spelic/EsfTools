:func      name      = NR11S08           
           date      = '11/07/2017' time = '08:21:03' option = EXECUTE  
           desc      = 'edit rutina na vp'
           refine    = N  
:before.
;  /* edit rutina na VP
; /* **********************
IF NR11M01.VP NE NR11W02.VP;
  MOVE NR11M01.VP TO NR11R06.SIFRAVP;
  MOVE NR11M01.VP TO NR11W02.VP;
  NR11P18();                      /* èita VP
  IF NR11R06 IS ERR;
    MOVE "VP ne obstaja" TO NR11M01.EZEMSG;
    SET NR11M01.VP CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK1;          /* glava ni v redu
    MOVE '  ' TO NR11W02.VP;
  ELSE;
    IF NR11W01.SDOK = '120';
      IF NR11M01.VP = '07'
        OR NR11M01.VP = '08'
        OR NR11M01.VP = '84';
;        /* SET nr11M01.VP PROTECT,BRIGHT;
      ELSE;
        MOVE "Napaèen VP : 07, 08 ali 84" TO NR11M01.EZEMSG;
        SET NR11M01.VP CURSOR,MODIFIED,BRIGHT;
        MOVE '  ' TO NR11W02.VP;
        MOVE 'NE' TO FLOK1;      /* glava ni v redu
      END;
    END;
    IF NR11W01.SDOK = '134';
      IF NR11M01.VP = '42';
;        /* SET nr11M01.VP PROTECT,BRIGHT;
      ELSE;
        MOVE 'NE' TO FLOK1;      /* glava ni v redu
        MOVE "Napaèen VP : 42" TO NR11M01.EZEMSG;
        SET NR11M01.VP CURSOR,MODIFIED,BRIGHT;
        MOVE '  ' TO NR11W02.VP;
      END;
    ELSE;
      IF NR11W01.SDOK = '192';
        IF NR11M01.VP = '24'
          OR NR11M01.VP = '22';
;          /* SET nr11M01.VP PROTECT,BRIGHT;
        ELSE;
          MOVE 'NE' TO FLOK1;    /* glava ni v redu
          MOVE "Napaèen VP :(24 ali 22)" TO NR11M01.EZEMSG;
          SET NR11M01.VP CURSOR,MODIFIED,BRIGHT;
          MOVE '  ' TO NR11W02.VP;
        END;
      END;
    END;
  END;
END;
