/* END;
/* **************************************************************/
/* KONEC IZRAÈUN CENE
/* **************************************************************/

/* **************************************************************/
/* dodala za prenovo Nabave 17.5.2013,  7.3.2014-bREDA  za izraèun cene prevzema
/* **************************************************************/
      MOVE NR11R15.IDENT TO NR11R0015.IDENT; /* preveri ident
      NR11P0023();               /* èita matuni za klasifikacijo
      IF NR11R0015.PANOGA = '12'; /* legirni elementi
        MOVE NR11R15.CENAN TO NR11M01.CENAM;
        IF NR11M01.FIRMA = '13' OR NR11M01.FIRMA = '14';

          NR11M01.CENAM = NR11M01.CENAM * NR11W02.TECAJ_HR;
        ELSE;
          MOVE NR11R15.CENAN TO NR11M01.CENAM;
        END;

        MOVE 'K' TO NR11M01.STATCENE;
        MOVE 'K' TO NR11M01.STATUS_PREMIJE;
        MOVE 'K' TO NR11M01.STATUS_CENE_LME;

      ELSE;
        IF NR11R15.STATUS_CENE_LME = 'Z';
          IF NR11R15.LMEOP ^= 4;
            IF NR11R15.LMEOP IS NULL;
            ELSE;
