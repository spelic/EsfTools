:func      name      = NR11S15           
           date      = '11/07/2017' time = '08:21:03' option = EXECUTE  
           desc      = 'RUTINA ST DOKUM GLAVA'
           refine    = N  
:before.
IF EZEAID IS ENTER AND
  NR11M01.STNAROC IS MODIFIED;
  IF NR11M01.LETO = 00000;

    MOVE "  OBVEZEN VPIS LETA NAROÈILA " TO NR11M01.EZEMSG;
    SET NR11M01.LETO CURSOR,MODIFIED,BRIGHT;
    MOVE 9999 TO EZEMNO;
  END;
  IF NR11M01.STNAROC = 00000;

    MOVE "  OBVEZEN VPIS  ŠTEVILKE NAROÈILA " TO NR11M01.EZEMSG;
    SET NR11M01.STNAROC CURSOR,MODIFIED,BRIGHT;
    MOVE 9999 TO EZEMNO;

  END;


  MOVE NR11M01.LETO TO NR11W02.LETONARO;
  MOVE NR11M01.STNAROC TO NR11W02.STNAROC;
  MOVE NR11W02.LETONARO TO NR11R14.LETO;
  MOVE NR11W02.STNAROC TO NR11R14.STNAROC;
  NR11P41();
  IF NR11R14 IS ERR;
    MOVE ' TO NAROÈILO NE OBSTAJA' TO NR11M01.EZEMSG;
    MOVE 0000 TO NR11M01.LETO;
    MOVE 00000 TO NR11M01.STNAROC;
    SET NR11M01.LETO CURSOR,BRIGHT;

    MOVE 9999 TO EZEMNO;
  ELSE;

/* **************************************************************/
/* VALUTA
/* **************************************************************/
IF NR11M01.FIRMA = '13' OR NR11M01.FIRMA = '14';
 MOVE '191' TO NR11R50.SIFRA3;
      MOVE NR11R14.SIFVAL32 TO NR11R50.SIFVAL32;
      NR11P50();                 /* èita MAKSIMALNI TEÈAJ ZA DATUM
