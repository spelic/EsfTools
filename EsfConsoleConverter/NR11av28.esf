:func      name      = NR11S04           
           date      = '11/07/2017' time = '08:21:03' option = EXECUTE  
           desc      = 'GENERIRA ŠTEVILKO DOKUMENTA'
           refine    = N  
:before.
;  /* generira št.dokumenta
; /* ***********************
IF CTRP = 1;
  MOVE NR11M01.PREVZEM TO NR11R02.MZ;
  MOVE NR11M01.FIRMA TO NR11R02.FIRMA;
  NR11P30();                     /* èita PARAMET za replase
  IF NR11R02 IS ERR;
    MOVE "Napaka pri èitanju parametrov-ponovi" TO NR11M01.EZEMSG;
    SET NR11M01.STNAROC CURSOR,BRIGHT;
    MOVE 'NE' TO FLOK3;
    EZEREPLY = 0;
    EZEROLLB();
    SET NR11M01.PREVZEM CURSOR,BRIGHT;
  ELSE;
    NR11R02.STDOK = NR11R02.STDOK + 1;
    NR11R02.STDOKP = NR11R02.STDOKP + 1;
    NR11P32();                   /* replase PARAMET
    IF NR11R02 IS ERR;
      MOVE 'NE' TO FLOK3;
      MOVE "Napaka pri replase parametrov-ponovi" TO NR11M01.EZEMSG;
      EZEREPLY = 0;
      EZEROLLB();
      SET NR11M01.PREVZEM CURSOR,BRIGHT;
    ELSE;
      MOVE NR11R02.STDOK TO NR11M01.STDOK;
      MOVE NR11R02.STDOKP TO NR11M01.STDOKP;
      MOVE 'DA' TO FLOK3;
    END;
  END;
ELSE;
END;
