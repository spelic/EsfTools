/* **************************************************************/


IF FLOK3 = 'DA';
  IF NR11M01.IDENT > 0;
    IF NR11M01.KOLICM > 0;
    ELSE;

      SET NR11R12 EMPTY;
      MOVE NR11M01.IDENT TO NR11R12.IDENT;
      MOVE '01' TO NR11R12.FIRMA;
      NR11P15();

      IF EZESQCOD = 0 AND (NR11W01.FIRMA = '02' OR NR11W01.FIRMA = '13');
        IF (NR11R12.KLASIFI1 = '60' OR NR11R12.KLASIFI1 = '61' OR NR11R12.KLASIFI1 = '63')
          AND (NR11R12.KLASIFI2 = '02' OR NR11R12.KLASIFI2 = '06' OR NR11R12.KLASIFI2 = '51' OR NR11R12.KLASIFI2 = '59' OR NR11R12.KLASIFI2 = '95' OR NR11R12.KLASIFI2 = '97');
          IF NR11W01.PODRGOV = 'S';
            MOVE "Obvezen vpis  kolièine po komdih ali F4- seštevek kg " TO NR11M01.EZEMSG;
          ELSE;
          END;

          IF NR11W01.PODRGOV = 'H';
            MOVE "Obvezen vpis  koliÈine po komdih ali F4- zbroj  kg " TO NR11M01.EZEMSG;
          ELSE;
          END;



          SET NR11M01.KOMADI CURSOR,BRIGHT;
          MOVE 'NE' TO FLOK3;    /* pozicija ni vredu
        ELSE;
          MOVE 'NE' TO FLOK3;    /* pozicija ni vredu
          SET NR11M01.KOLICM CURSOR,BRIGHT;
          MOVE "Obvezen vpis koliÈine " TO NR11M01.EZEMSG;
        END;
      ELSE;
        MOVE "Napaka pri èitanju izdelka za klasifikacijo pri kontroli poz. " TO NR11M01.EZEMSG;
        SET NR11M01.KOMADI CURSOR,BRIGHT;
        MOVE 'NE' TO FLOK3;      /* pozicija ni vredu
      END;
    END;
  ELSE;
    MOVE "Obvezno vnesi ident " TO NR11M01.EZEMSG;
    SET NR11M01.IDENT CURSOR,MODIFIED,BRIGHT;
    MOVE 'NE' TO FLOK3;          /* pozicija ni vredu
  END;
END;
