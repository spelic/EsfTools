        MOVE NR11R50.DATUM TO NR11R51.DATUM;
        MOVE '191' TO NR11R51.SIFRA3;
        MOVE NR11R14.SIFVAL32 TO NR11R51.SIFVAL32;
        NR11P51();    ÈITA TEÈAJ DSATUM
        MOVE NR11R51.RAZMERJE TO NR11W02.TECAJ;
      ELSE;
      END;
MOVE '191' TO NR11R50.SIFRA3;
      MOVE '978' TO NR11R50.SIFVAL32;
      NR11P50();                 /* èita MAKSIMALNI TEÈAJ ZA DATUM
      IF EZESQCOD = 0;
        MOVE NR11R50.DATUM TO NR11R51.DATUM;
        MOVE '191' TO NR11R51.SIFRA3;
 MOVE NR11R14.SIFVAL32 TO NR11R51.SIFVAL32;
