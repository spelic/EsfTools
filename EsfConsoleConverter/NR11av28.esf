      ELSE;
      END;                       /* I
      MOVE NR11R70 TO NR11R25;
      NR11P55();                 /* update r26 dobave    intprometn
      IF EZESQCOD = 0;
        MOVE NR11R70.KOLICINA2 TO NR11R25.KOLICINA2;
